<div id="saailSearchModal" class="search-modal" role="dialog" aria-modal="true" aria-labelledby="saailSearchLabel" hidden>
	<div class="search-backdrop" data-close-search></div>
	<div class="search-panel">
		<div class="search-top">
			<svg class="search-modal-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
				<circle cx="11" cy="11" r="8"></circle>
				<path d="M21 21l-4.35-4.35"></path>
			</svg>
			<label id="saailSearchLabel" for="saailSearchInput" class="sr-only">Search SAAIL Lab papers, projects, datasets, and pages</label>
			<input
				id="saailSearchInput"
				type="search"
				role="combobox"
				aria-autocomplete="list"
				aria-expanded="false"
				aria-controls="saailSearchResults"
				placeholder="Search 20 lab papers, projects, datasets, tools, people..."
				autocomplete="off"
				spellcheck="false"
			/>
			<button type="button" class="search-close-btn" data-close-search aria-label="Close search modal">Esc</button>
		</div>
		<ul id="saailSearchResults" class="search-results" role="listbox" aria-label="Matching SAAIL Lab entries"></ul>
		<div class="search-foot">
			<span><kbd>&uarr;</kbd> <kbd>&darr;</kbd> Navigate</span>
			<span><kbd>Enter</kbd> Open</span>
			<span><kbd>Esc</kbd> Close</span>
		</div>
	</div>
</div>

<script>
	(function initSaailQuickSearch() {
		const modal = document.getElementById('saailSearchModal');
		const input = document.getElementById('saailSearchInput') as HTMLInputElement | null;
		const list = document.getElementById('saailSearchResults');
		const triggerBtn = document.getElementById('siteSearchBtn');
		if (!modal || !input || !list) return;

		type Entry = { title: string; subtitle: string; category: string; url: string; keywords: string };
		let entries: Entry[] | null = null;
		let loadingPromise: Promise<Entry[]> | null = null;
		let activeIdx = 0;
		let lastFocused: HTMLElement | null = null;
		let visibleItems: Entry[] = [];

		async function ensureIndex(): Promise<Entry[]> {
			if (entries) return entries;
			if (!loadingPromise) {
				loadingPromise = fetch('/search-index.json')
					.then((r) => (r.ok ? r.json() : []))
					.then((data) => {
						entries = Array.isArray(data) ? data : [];
						return entries;
					})
					.catch(() => {
						entries = [];
						return entries;
					});
			}
			return loadingPromise;
		}

		function renderResults(query: string) {
			if (!list) return;
			if (!entries) {
				list.innerHTML = '<li class="search-empty">Loading search index...</li>';
				return;
			}
			const tokens = query.trim().toLowerCase().split(/\s+/).filter(Boolean);
			visibleItems = tokens.length === 0
				? entries.slice(0, 10)
				: entries.filter((item) => {
					const hay = `${item.title} ${item.subtitle} ${item.category} ${item.keywords}`.toLowerCase();
					return tokens.every((tok) => hay.includes(tok));
				}).slice(0, 12);

			activeIdx = 0;
			list.innerHTML = '';

			if (visibleItems.length === 0) {
				input?.setAttribute('aria-expanded', 'false');
				input?.removeAttribute('aria-activedescendant');
				const li = document.createElement('li');
				li.className = 'search-empty';
				li.textContent = 'No SAAIL Lab pages match those terms.';
				list.appendChild(li);
				return;
			}
			input?.setAttribute('aria-expanded', 'true');

			visibleItems.forEach((item, idx) => {
				const li = document.createElement('li');
				li.id = `saailSearchOpt-${idx}`;
				li.setAttribute('role', 'option');
				li.setAttribute('aria-selected', idx === 0 ? 'true' : 'false');
				const a = document.createElement('a');
				a.href = item.url;
				a.className = idx === 0 ? 'search-row is-selected' : 'search-row';

				const main = document.createElement('div');
				main.className = 'search-row-main';
				const t = document.createElement('span');
				t.className = 'search-row-title';
				t.textContent = item.title;
				const s = document.createElement('span');
				s.className = 'search-row-sub';
				s.textContent = item.subtitle;
				main.appendChild(t);
				main.appendChild(s);

				const badge = document.createElement('span');
				badge.className = 'search-row-cat';
				badge.textContent = item.category;

				a.appendChild(main);
				a.appendChild(badge);
				li.appendChild(a);
				list.appendChild(li);
			});
			input?.setAttribute('aria-activedescendant', 'saailSearchOpt-0');
		}

		function updateSelection(nextIdx: number) {
			if (!list || visibleItems.length === 0) return;
			activeIdx = (nextIdx + visibleItems.length) % visibleItems.length;
			const rows = list.querySelectorAll('.search-row');
			const options = list.querySelectorAll('li[role="option"]');
			rows.forEach((el, i) => el.classList.toggle('is-selected', i === activeIdx));
			options.forEach((el, i) => el.setAttribute('aria-selected', String(i === activeIdx)));
			input?.setAttribute('aria-activedescendant', `saailSearchOpt-${activeIdx}`);
			(rows[activeIdx] as HTMLElement | undefined)?.scrollIntoView({ block: 'nearest' });
		}

		async function openSearch() {
			if (!modal || !input) return;
			lastFocused = document.activeElement as HTMLElement | null;
			modal.hidden = false;
			document.body.style.overflow = 'hidden';
			input.value = '';
			renderResults('');
			requestAnimationFrame(() => input.focus());
			await ensureIndex();
			if (!modal.hidden) renderResults(input.value);
		}

		function closeSearch() {
			if (!modal) return;
			modal.hidden = true;
			document.body.style.overflow = '';
			input?.setAttribute('aria-expanded', 'false');
			input?.removeAttribute('aria-activedescendant');
			lastFocused?.focus();
		}

		triggerBtn?.addEventListener('pointerenter', () => { ensureIndex(); }, { once: true });
		triggerBtn?.addEventListener('focus', () => { ensureIndex(); }, { once: true });
		triggerBtn?.addEventListener('click', openSearch);
		modal.querySelectorAll('[data-close-search]').forEach((el) => el.addEventListener('click', closeSearch));

		input.addEventListener('input', () => renderResults(input.value));
		input.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowDown') {
				e.preventDefault();
				updateSelection(activeIdx + 1);
			} else if (e.key === 'ArrowUp') {
				e.preventDefault();
				updateSelection(activeIdx - 1);
			} else if (e.key === 'Enter' && visibleItems[activeIdx]) {
				e.preventDefault();
				window.location.href = visibleItems[activeIdx].url;
			}
		});

		document.addEventListener('keydown', (e) => {
			if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
				e.preventDefault();
				if (modal.hidden) openSearch();
				else closeSearch();
			} else if (e.key === 'Escape' && !modal.hidden) {
				e.preventDefault();
				closeSearch();
			} else if (e.key === 'Tab' && !modal.hidden) {
				const focusables = Array.from(
					modal.querySelectorAll('input, button, a[href]')
				).filter((el) => !(el as HTMLElement).hasAttribute('disabled')) as HTMLElement[];
				if (focusables.length === 0) return;
				const first = focusables[0];
				const last = focusables[focusables.length - 1];
				if (e.shiftKey && document.activeElement === first) {
					e.preventDefault();
					last.focus();
				} else if (!e.shiftKey && document.activeElement === last) {
					e.preventDefault();
					first.focus();
				}
			}
		});
	})();
</script>

