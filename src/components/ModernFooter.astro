<script is:inline>
	(function () {
		const nowEat = new Date(Date.now() + 3 * 3600 * 1000);
		const pad2 = function (n) { return String(n).padStart(2, '0'); };
		const dayKey = nowEat.getUTCFullYear() + '-' + pad2(nowEat.getUTCMonth() + 1) + '-' + pad2(nowEat.getUTCDate());
		const monthKey = nowEat.getUTCFullYear() + '-' + pad2(nowEat.getUTCMonth() + 1);
		const isoTmp = new Date(Date.UTC(nowEat.getUTCFullYear(), nowEat.getUTCMonth(), nowEat.getUTCDate()));
		const isoDay = isoTmp.getUTCDay() || 7;
		isoTmp.setUTCDate(isoTmp.getUTCDate() + 4 - isoDay);
		const isoYear = isoTmp.getUTCFullYear();
		const isoYearStart = new Date(Date.UTC(isoYear, 0, 1));
		const isoWeek = Math.ceil(((isoTmp.getTime() - isoYearStart.getTime()) / 86400000 + 1) / 7);
		const weekKey = isoYear + '-W' + pad2(isoWeek);

		const keyByPeriod = {
			day: { key: dayKey, label: 'Today' },
			week: { key: weekKey, label: 'This%20Week' },
			month: { key: monthKey, label: 'This%20Month' }
		};

		document.querySelectorAll('img[data-visitor-period]').forEach(function (img) {
			const period = img.getAttribute('data-visitor-period');
			const cfg = period && keyByPeriod[period];
			if (!cfg) return;
			const currentKey = img.getAttribute('data-period-key');
			if (currentKey !== cfg.key) {
				img.setAttribute('data-period-key', cfg.key);
				img.setAttribute(
					'src',
					'https://visitor-badge.laobi.icu/badge?page_id=saaillab.github.io.' +
						period +
						'.' +
						cfg.key +
						'&left_color=1e293b&right_color=15803d&left_text=' +
						cfg.label
				);
			}
		});
	})();
</script>

