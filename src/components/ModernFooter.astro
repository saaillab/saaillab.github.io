<footer class="modern-footer">
	<div class="container">
		<div class="footer-grid">
			<!-- Identity & Institutions -->
			<div class="footer-brand-col">
				<a href="/" class="footer-logo-link" aria-label="SAAIL Lab Home">
					<img src="/images/logo/saail-logo.png" alt="SAAIL Lab Logo" class="footer-full-logo" />
				</a>
				<p class="footer-desc">
					Sustainable AI for Agriculture &amp; Intelligent Livelihoods Lab at the School of Engineering and Science, Indian Institute of Technology Madras Zanzibar, Tanzania.
				</p>
				<div class="institution-row">
					<a href="https://www.iitmz.ac.in/" target="_blank" rel="noopener" title="IIT Madras Zanzibar">
						<img src="/images/logo/iitmz-logo.png" alt="IIT Madras Zanzibar" class="inst-badge" />
					</a>
				</div>
				<div class="social-row">
					<a href="mailto:saail_lab@iitmz.ac.in" class="footer-email">saail_lab@iitmz.ac.in</a>
					<span class="dot-sep">·</span>
					<a href="https://github.com/saaillab" target="_blank" rel="noopener">GitHub</a>
					<span class="dot-sep">·</span>
					<a href="https://www.linkedin.com/company/saail-lab/" target="_blank" rel="noopener">LinkedIn</a>
					<span class="dot-sep">·</span>
					<a href="https://scholar.google.com/citations?user=jYVzIZUAAAAJ&hl=en" target="_blank" rel="noopener">Scholar</a>
				</div>
			</div>

			<!-- Research -->
			<div class="footer-col">
				<h2 class="footer-col-head">Research</h2>
				<ul class="footer-list">
					<li><a href="/research/">Research Pillars</a></li>
					<li><a href="/projects/">Active Projects &amp; Grants</a></li>
					<li><a href="/publications/">Publications</a></li>
					<li><a href="/datasets/">Datasets &amp; Benchmarks</a></li>
					<li><a href="/tools/">Mobile Apps &amp; Software</a></li>
				</ul>
			</div>

			<!-- Lab & Campus -->
			<div class="footer-col">
				<h2 class="footer-col-head">Lab &amp; Campus</h2>
				<ul class="footer-list">
					<li><a href="/people/">People &amp; Alumni</a></li>
					<li><a href="/gallery/">Gallery &amp; Posters</a></li>
					<li><a href="/collaborations/">Global Collaborations</a></li>
					<li><a href="/hiring/">Join SAAIL Lab</a></li>
					<li><a href="/contact/">Contact</a></li>
				</ul>
				<p class="footer-address">
					Room 105 (F1), School of Engineering &amp; Science<br />
					IIT Madras Zanzibar, Bweleo, Zanzibar
				</p>
			</div>
		</div>

		<div class="footer-bottom">
			<p>&copy; 2026 SAAIL Lab · School of Engineering &amp; Science, IIT Madras Zanzibar.</p>
			<div class="footer-bottom-links">
				<a href="/publications/">Publications</a>
				<a href="/github/">Open-Source Code</a>
				<a href="https://inyalala.github.io/" target="_blank" rel="author noopener">PI Profile</a>
			</div>
		</div>
	</div>
</footer>

<style>
	.modern-footer {
		background: var(--bg-secondary);
		border-top: 1px solid var(--border-color);
		color: var(--text-secondary);
		margin-top: auto;
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 1.7fr 1fr 1.1fr;
		gap: 3rem;
		padding: 3.5rem 0 2.75rem;
	}

	.footer-full-logo {
		height: 52px;
		width: auto;
		object-fit: contain;
		border-radius: 6px;
		margin-bottom: 1rem;
		background: #ffffff;
		padding: 4px 10px;
		border: 1px solid var(--border-color);
	}

	.footer-desc {
		font-size: 0.92rem;
		line-height: 1.65;
		color: var(--text-secondary);
		margin-bottom: 1.15rem;
		max-width: 440px;
	}

	.institution-row {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 1.15rem;
	}

	.inst-badge {
		height: 34px;
		width: auto;
		object-fit: contain;
		border-radius: 6px;
		background: #ffffff;
		padding: 3px 8px;
		border: 1px solid var(--border-color);
	}

	.social-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.45rem;
		font-size: 0.88rem;
		font-weight: 600;
	}

	.social-row a {
		color: var(--accent-primary);
		text-decoration: none;
	}

	.social-row a:hover {
		text-decoration: underline;
	}

	.dot-sep {
		color: var(--text-muted);
	}

	.footer-col h2.footer-col-head {
		font-size: 0.85rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--text-primary);
		margin-bottom: 1rem;
	}

	.footer-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.footer-list li {
		margin-bottom: 0.55rem;
	}

	.footer-list a {
		color: var(--text-secondary);
		text-decoration: none;
		font-size: 0.92rem;
		transition: color 0.16s ease;
	}

	.footer-list a:hover {
		color: var(--accent-primary);
	}

	.footer-address {
		margin-top: 1.15rem;
		font-size: 0.82rem;
		line-height: 1.55;
		color: var(--text-muted);
	}

	.footer-bottom {
		border-top: 1px solid var(--border-color);
		padding: 1.35rem 0;
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 1rem;
		font-size: 0.85rem;
		color: var(--text-muted);
	}

	.footer-bottom-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.5rem;
	}

	.footer-bottom-links a {
		color: var(--text-muted);
		text-decoration: none;
		font-weight: 500;
	}

	.footer-bottom-links a:hover {
		color: var(--accent-primary);
	}

	@media (max-width: 900px) {
		.footer-grid {
			grid-template-columns: 1fr 1fr;
			gap: 2rem;
		}
		.footer-brand-col {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 600px) {
		.footer-grid {
			grid-template-columns: 1fr;
		}
		.footer-bottom {
			flex-direction: column;
			text-align: center;
		}
	}
</style>
