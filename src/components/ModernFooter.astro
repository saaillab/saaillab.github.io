---
const nowEat = new Date(Date.now() + 3 * 3600 * 1000);
const pad2 = (n: number) => String(n).padStart(2, '0');
const dayKey = `${nowEat.getUTCFullYear()}-${pad2(nowEat.getUTCMonth() + 1)}-${pad2(nowEat.getUTCDate())}`;
const monthKey = `${nowEat.getUTCFullYear()}-${pad2(nowEat.getUTCMonth() + 1)}`;
const isoTmp = new Date(Date.UTC(nowEat.getUTCFullYear(), nowEat.getUTCMonth(), nowEat.getUTCDate()));
const isoDay = isoTmp.getUTCDay() || 7;
isoTmp.setUTCDate(isoTmp.getUTCDate() + 4 - isoDay);
const isoYear = isoTmp.getUTCFullYear();
const isoYearStart = new Date(Date.UTC(isoYear, 0, 1));
const isoWeek = Math.ceil(((isoTmp.getTime() - isoYearStart.getTime()) / 86400000 + 1) / 7);
const weekKey = `${isoYear}-W${pad2(isoWeek)}`;
