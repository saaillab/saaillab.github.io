  <!-- Full-Resolution Figure Lightbox -->
  <div id="imgLightbox" class="img-lightbox" hidden role="dialog" aria-modal="true" aria-label="Enlarged figure preview">
    <button id="closeLightbox" type="button" class="lightbox-close" aria-label="Close enlarged view">&times;</button>
    <img id="lightboxImg" alt="" />
  </div>

  <script is:inline>
    (function () {
      const btn = document.getElementById('moreWorksBtn');
      const dropdown = document.getElementById('moreWorksDropdown');
      const closeBtn = document.getElementById('closeMoreWorks');
      const chevron = document.getElementById('moreWorksChevron');

      function setOpen(open) {
        if (!btn || !dropdown) return;
        dropdown.hidden = !open;
        btn.setAttribute('aria-expanded', String(open));
        document.body.classList.toggle('more-works-open', open);
        if (chevron) {
          chevron.style.transform = open ? 'rotate(180deg)' : 'rotate(0deg)';
        }
      }

      if (btn && dropdown) {
        btn.addEventListener('click', function (e) {
          e.stopPropagation();
          setOpen(dropdown.hidden);
        });
        if (closeBtn) {
          closeBtn.addEventListener('click', function () {
            setOpen(false);
            btn.focus();
          });
        }
        document.addEventListener('click', function (e) {
          if (!dropdown.hidden && !dropdown.contains(e.target) && !btn.contains(e.target)) {
            setOpen(false);
          }
        });
      }

      const lightbox = document.getElementById('imgLightbox');
      const lightboxImg = document.getElementById('lightboxImg');
      const closeLightbox = document.getElementById('closeLightbox');
      let lastFocusEl = null;

      function openLightbox(triggerEl, imgEl) {
        if (!lightbox || !lightboxImg || !imgEl) return;
        lastFocusEl = triggerEl;
        lightboxImg.src = imgEl.src;
        lightboxImg.alt = imgEl.alt || 'Figure';
        lightbox.hidden = false;
        document.body.style.overflow = 'hidden';
        if (closeLightbox) closeLightbox.focus();
      }

      function hideLightbox() {
        if (!lightbox) return;
        lightbox.hidden = true;
        document.body.style.overflow = '';
        if (lastFocusEl && typeof lastFocusEl.focus === 'function') {
          lastFocusEl.focus();
        }
      }

      document.querySelectorAll('.zoom-trigger').forEach(function (triggerEl) {
        const imgEl = triggerEl.querySelector('img');
        if (!imgEl) return;
        triggerEl.title = 'Click to view full size';
        triggerEl.addEventListener('click', function () { openLightbox(triggerEl, imgEl); });
      });

      if (closeLightbox && lightbox) {
        closeLightbox.addEventListener('click', hideLightbox);
        lightbox.addEventListener('click', function (e) {
          if (e.target === lightbox) hideLightbox();
        });
      }

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Tab' && lightbox && !lightbox.hidden && closeLightbox) {
          e.preventDefault();
          closeLightbox.focus();
        }
        if (e.key === 'Escape') {
          if (dropdown && !dropdown.hidden) {
            setOpen(false);
            if (btn) btn.focus();
          }
          if (lightbox && !lightbox.hidden) hideLightbox();
        }
      });

      const copyBtn = document.getElementById('copyBibBtn');
      if (copyBtn) {
        const originalHtml = copyBtn.innerHTML;
        copyBtn.addEventListener('click', async function () {
          const el = document.getElementById('bibtexCode');
          const text = el ? (el.textContent || '').trim() : '';
          if (!text) return;
          let copied = false;
          try {
            await navigator.clipboard.writeText(text);
            copied = true;
          } catch (_err) {
            const area = document.createElement('textarea');
            area.value = text;
            area.style.position = 'fixed';
            area.style.opacity = '0';
            document.body.appendChild(area);
            area.select();
            try { copied = document.execCommand('copy'); } catch (_e2) {}
            document.body.removeChild(area);
          }
          if (copied) {
            copyBtn.classList.add('copied');
            copyBtn.innerHTML = '<span>&#10003; Copied!</span>';
            setTimeout(function () {
              copyBtn.classList.remove('copied');
              copyBtn.innerHTML = originalHtml;
            }, 1800);
          }
        });
      }
    })();
  </script>

