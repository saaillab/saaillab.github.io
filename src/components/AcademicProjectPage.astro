---
import type { Publication } from '../data/publications';
import { PUBLICATIONS } from '../data/publications';

export interface Props {
  pub: Publication;
}

const { pub } = Astro.props;

const cleanDoi = pub.doi ? pub.doi.replace(/^https?:\/\/(dx\.)?doi\.org\//i, '').trim() : '';
const doiUrl = cleanDoi ? `https://doi.org/${cleanDoi}` : '';
const isPreprint = pub.category === 'preprint';
const isThesis = pub.slug === 'intelligent-greenhouse-arduino-2016';
const isPdfUrl = Boolean(pub.paperUrl && (/\.pdf($|\?)/i.test(pub.paperUrl) || /openreview\.net\/pdf/i.test(pub.paperUrl)));
const pdfTarget = pub.pdfUrl || (isPdfUrl ? pub.paperUrl : '');
const absPdfUrl = pdfTarget
  ? (pdfTarget.startsWith('http') ? pdfTarget : `https://saaillab.github.io${pdfTarget}`)
  : '';
const canonicalUrl = `https://saaillab.github.io/papers/${pub.slug}/`;
const ogImageUrl = pub.teaserImage
  ? (pub.teaserImage.endsWith('.svg')
      ? 'https://saaillab.github.io/images/og/saail-lab-zanzibar-og.jpg'
      : `https://saaillab.github.io${pub.teaserImage}`)
  : 'https://saaillab.github.io/images/og/saail-lab-zanzibar-og.jpg';
const isSvgTeaser = Boolean(pub.teaserImage && pub.teaserImage.endsWith('.svg'));

function escapeHtmlAttr(val: string): string {
  return String(val)
    .replace(/&/g, '&amp;')
    .replace(/"/g, '&quot;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
}

const keywordsMeta = [...pub.keywords, 'SAAIL Lab', 'IIT Madras Zanzibar', 'Innocent Nyalala', 'Zanzibar AI'].join(', ');
const authorsMeta = pub.authors.map((a) => a.name).join(', ');
const headMetaLines: string[] = [
  `<meta name="description" content="${escapeHtmlAttr(pub.tldr)}" />`,
  `<meta name="keywords" content="${escapeHtmlAttr(keywordsMeta)}" />`,
  `<meta name="author" content="${escapeHtmlAttr(authorsMeta)}" />`,
  `<link rel="canonical" href="${escapeHtmlAttr(canonicalUrl)}" />`,
  `<link rel="alternate" hreflang="en" href="${escapeHtmlAttr(canonicalUrl)}" />`,
  `<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />`,
  `<meta name="theme-color" content="#2563eb" />`,
  `<meta name="thumbnail" content="${escapeHtmlAttr(ogImageUrl)}" />`,
  `<meta property="og:type" content="article" />`,
  `<meta property="og:locale" content="en_US" />`,
  `<meta property="og:title" content="${escapeHtmlAttr(pub.title)}" />`,
  `<meta property="og:description" content="${escapeHtmlAttr(pub.tldr)}" />`,
  `<meta property="og:url" content="${escapeHtmlAttr(canonicalUrl)}" />`,
  `<meta property="og:site_name" content="SAAIL Lab | IIT Madras Zanzibar" />`,
  `<meta property="og:image" content="${escapeHtmlAttr(ogImageUrl)}" />`,
  `<meta property="og:image:alt" content="${escapeHtmlAttr(pub.title)}" />`,
  `<meta name="twitter:card" content="summary_large_image" />`,
  `<meta name="twitter:site" content="@saaillab" />`,
  `<meta name="twitter:title" content="${escapeHtmlAttr(pub.title)}" />`,
  `<meta name="twitter:description" content="${escapeHtmlAttr(pub.tldr)}" />`,
  `<meta name="twitter:image" content="${escapeHtmlAttr(ogImageUrl)}" />`,
  `<meta name="citation_title" content="${escapeHtmlAttr(pub.title)}" />`,
  ...pub.authors.map((a) => `<meta name="citation_author" content="${escapeHtmlAttr(a.name)}" />`),
  ...pub.affiliations.map((aff) => `<meta name="citation_author_institution" content="${escapeHtmlAttr(aff)}" />`),
  `<meta name="citation_publication_date" content="${escapeHtmlAttr(pub.dateISO || String(pub.year))}" />`,
  `<meta name="citation_public_url" content="${escapeHtmlAttr(canonicalUrl)}" />`,
  `<meta name="citation_language" content="en" />`,
  `<meta name="citation_abstract" content="${escapeHtmlAttr(pub.abstract)}" />`,
  `<meta name="citation_keywords" content="${escapeHtmlAttr(pub.keywords.join('; '))}" />`,
];
if (pub.category === 'journal' && !isThesis) {
  headMetaLines.push(`<meta name="citation_journal_title" content="${escapeHtmlAttr(pub.venue)}" />`);
}
if (pub.category === 'conference' || pub.category === 'workshop') {
  headMetaLines.push(`<meta name="citation_conference_title" content="${escapeHtmlAttr(pub.venue)}" />`);
}
if (isThesis) {
  headMetaLines.push(`<meta name="citation_dissertation_institution" content="Nanjing Agricultural University" />`);
}
if (cleanDoi) {
  headMetaLines.push(`<meta name="citation_doi" content="${escapeHtmlAttr(cleanDoi)}" />`);
}
if (absPdfUrl) {
  headMetaLines.push(`<meta name="citation_pdf_url" content="${escapeHtmlAttr(absPdfUrl)}" />`);
}
headMetaLines.push(`<meta name="DC.title" content="${escapeHtmlAttr(pub.title)}" />`);
headMetaLines.push(`<meta name="DC.date" content="${escapeHtmlAttr(pub.dateISO || String(pub.year))}" />`);
headMetaLines.push(`<meta name="DC.publisher" content="SAAIL Lab, IIT Madras Zanzibar" />`);
const headMetaHtml = headMetaLines.join('\n  ');

const saailDropdownPubs = PUBLICATIONS.filter((p) => p.isSaailLab !== false).sort((a, b) => {
  if (a.slug === 'cropguardnet') return -1;
  if (b.slug === 'cropguardnet') return 1;
  if (b.year !== a.year) return b.year - a.year;
  return b.dateISO.localeCompare(a.dateISO);
});

// Remap affiliations sequentially 1..k so numbers never skip (e.g. 1, 2, 5, 6 -> 1, 2, 3, 4)
const rawUsedIndices: number[] = [];
pub.authors.forEach((a) => {
  (a.affiliations || []).forEach((idx) => {
    if (!rawUsedIndices.includes(idx)) rawUsedIndices.push(idx);
  });
});
rawUsedIndices.sort((a, b) => a - b);

const remapAff = new Map<number, number>();
const visibleAffiliations: { num: number; label: string }[] = [];
if (rawUsedIndices.length > 0) {
  rawUsedIndices.forEach((origIdx) => {
    const label = pub.affiliations[origIdx - 1];
    if (label) {
      const seq = visibleAffiliations.length + 1;
      remapAff.set(origIdx, seq);
      visibleAffiliations.push({ num: seq, label });
    }
  });
} else {
  pub.affiliations.forEach((label, idx) => {
    visibleAffiliations.push({ num: idx + 1, label });
  });
}

function formatContributionSentence(raw: string, idx: number): string {
  const s = raw.trim();
  if (!s) return '';
  if (/^(This|We|The|These|Across|Under|Evaluation|Experimental|Together)\b/.test(s)) return s;
  const firstWord = s.split(/\s+/)[0].replace(/[^A-Za-z]/g, '');
  const present3rd = [
    'Demonstrates',
    'Quantifies',
    'Proves',
    'Delivers',
    'Defines',
    'Establishes',
    'Reproduces',
    'Introduces',
    'Profiles',
    'Unifies',
    'Proposes',
    'Documents',
    'Advances',
    'Builds',
    'Integrates',
    'Reconciles',
    'Audits',
    'Exposes',
    'Formulates',
    'Categorizes',
    'Critiques',
    'Identifies'
  ];
  if (present3rd.includes(firstWord)) {
    const subj = idx === 0 ? 'This study ' : idx === 1 ? 'The analysis ' : 'This work ';
    return subj + s.charAt(0).toLowerCase() + s.slice(1);
  }
  const subj = idx === 0 ? 'We ' : idx === 1 ? 'In addition, we ' : 'We also ';
  return subj + s.charAt(0).toLowerCase() + s.slice(1);
}

const teaserSummaryText = pub.teaserSummary || pub.teaserCaption || pub.tldr;
const allFigs = (pub.figures || []).slice(0, 3);
const bodyFigs = allFigs.length >= 2 ? allFigs.slice(0, -1) : allFigs;
const resultsFig = allFigs.length >= 2 ? allFigs[allFigs.length - 1] : null;
const resultsNarrative =
  pub.resultsSummary ||
  (pub.contributions && pub.contributions.length > 0
    ? pub.contributions.map((c, idx) => formatContributionSentence(c, idx)).join(' ')
    : '');
const hasResults = Boolean(
  resultsNarrative || resultsFig || pub.protocolBox || (pub.tables && pub.tables.length > 0)
);
const extraDetails = pub.detailSections || [];

// Band alternation after light Abstract band:
// Abstract = light, bodyFigs[0] = white, bodyFigs[1] = light, ...
const resultsBand = hasResults
  ? bodyFigs.length % 2 === 0
    ? 'section-white'
    : 'section-light'
  : '';
const afterResultsIndex = bodyFigs.length + (hasResults ? 1 : 0);
const afterDetailsIndex = afterResultsIndex + extraDetails.length;
const bibtexBand = afterDetailsIndex % 2 === 0 ? 'section-white' : 'section-light';
const footerBand = bibtexBand === 'section-white' ? 'footer-light' : 'footer-white';

const scholarLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  headline: pub.title,
  name: pub.title,
  datePublished: pub.dateISO,
  description: pub.tldr,
  abstract: pub.abstract,
  keywords: pub.keywords,
  inLanguage: 'en',
  url: canonicalUrl,
  mainEntityOfPage: canonicalUrl,
  image: ogImageUrl,
  author: pub.authors.map((a) => ({
    '@type': 'Person',
    name: a.name,
    ...(a.url ? { url: a.url } : {})
  })),
  sourceOrganization: {
    '@type': 'ResearchOrganization',
    '@id': 'https://saaillab.github.io/#organization',
    name: 'SAAIL Lab at IIT Madras Zanzibar',
    url: 'https://saaillab.github.io/'
  },
  ...(doiUrl ? { sameAs: doiUrl, identifier: cleanDoi } : {})
};

if (!isPreprint && !isThesis) {
  scholarLd.isPartOf = {
    '@type': pub.category === 'journal' ? 'Periodical' : 'PublicationVolume',
    name: pub.venue
  };
}

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'SAAIL Lab Home',
      item: 'https://saaillab.github.io/'
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Publications',
      item: 'https://saaillab.github.io/publications/'
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: pub.shortTitle || pub.title,
      item: canonicalUrl
    }
  ]
};
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pub.shortTitle || pub.title} | SAAIL Lab · IIT Madras Zanzibar</title>
  <Fragment set:html={headMetaHtml} />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <script type="application/ld+json" set:html={JSON.stringify(scholarLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />

  <script async src="https://www.googletagmanager.com/gtag/js?id=G-4MEPY7MLVN"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-4MEPY7MLVN');
  </script>
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to main content</a>

  <!-- More Works Dropdown (far right, matching Academic Project Page Template) -->
  <div class="more-works-container">
    <button
      id="moreWorksBtn"
      type="button"
      class="more-works-btn"
      aria-expanded="false"
      aria-controls="moreWorksDropdown"
      title="View More Works from Our Lab"
    >
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M9 3h6M10 3v5.5L5.2 17.6A2 2 0 0 0 7 20.5h10a2 2 0 0 0 1.8-2.9L14 8.5V3"/>
      </svg>
      <span>More Works</span>
      <svg id="moreWorksChevron" class="dropdown-arrow" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
        <path d="M6 9l6 6 6-6"/>
      </svg>
    </button>

    <div id="moreWorksDropdown" class="more-works-dropdown" hidden>
      <div class="dropdown-head">
        <span>More Works from Our Lab</span>
        <button id="closeMoreWorks" type="button" class="close-btn" aria-label="Close">&times;</button>
      </div>
      <div class="dropdown-links">
        {saailDropdownPubs.map((item) => {
          const kickerLabel = item.venueShort.includes(String(item.year))
            ? item.venueShort
            : `${item.venueShort} · ${item.year}`;
          const isCurrent = item.slug === pub.slug;
          return (
            <a
              href={`/papers/${item.slug}/`}
              class:list={['dropdown-item', { 'dropdown-item-active': isCurrent }]}
              aria-current={isCurrent ? 'page' : undefined}
            >
              <span class="item-kicker">{kickerLabel}{isCurrent ? ' · Current' : ''}</span>
              <span class="item-title">{item.shortTitle || item.title}</span>
            </a>
          );
        })}
      </div>
    </div>
  </div>

  <main id="main-content">
    <!-- Hero Block -->
    <header class="paper-hero">
      <div class="container-desktop">
        <h1 class="paper-title">{pub.title}</h1>

        <div class="authors-row">
          {pub.authors.map((author, idx) => {
            const mappedAffs = (author.affiliations || [])
              .map((num) => remapAff.get(num))
              .filter((n): n is number => typeof n === 'number');
            const supText = mappedAffs.join(',');
            const comma = idx < pub.authors.length - 1 ? ', ' : '';
            return (
              <span class="author-token">
                {author.url ? (
                  <a href={author.url} target="_blank" rel="noopener" class="author-link">{author.name}</a>
                ) : (
                  <span class="author-name">{author.name}</span>
                )}
                {supText && <sup class="aff-sup">{supText}</sup>}
                {comma}
              </span>
            );
          })}
        </div>

        <div class="affiliations-stack">
          {visibleAffiliations.map((aff) => (
            <div class="aff-line">
              <sup>{aff.num}</sup>{aff.label}
            </div>
          ))}
        </div>

        <div class="venue-line">
          {isPreprint ? (
            <span>Manuscript Under Peer Review ({pub.year})</span>
          ) : (
            <span>{pub.venue}</span>
          )}
        </div>
        {pub.award && <div class="award-line">{pub.award}</div>}

        <div class="action-buttons" role="navigation" aria-label="Paper resources">
          {pub.paperUrl && pub.paperUrl !== doiUrl && (
            <a href={pub.paperUrl} target="_blank" rel="noopener" class="action-pill">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
              </svg>
              <span>Paper</span>
            </a>
          )}
          {pub.pdfUrl && pub.pdfUrl !== pub.paperUrl && (
            <a href={pub.pdfUrl} target="_blank" rel="noopener" class="action-pill">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="7 10 12 15 17 10"/>
                <line x1="12" y1="15" x2="12" y2="3"/>
              </svg>
              <span>PDF</span>
            </a>
          )}
          {doiUrl && (
            <a href={doiUrl} target="_blank" rel="noopener" class="action-pill">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                <polyline points="15 3 21 3 21 9"/>
                <line x1="10" y1="14" x2="21" y2="3"/>
              </svg>
              <span>DOI</span>
            </a>
          )}
          {pub.codeUrl && (
            <a href={pub.codeUrl} target="_blank" rel="noopener" class="action-pill">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.09-.745.083-.729.083-.729 1.205.084 1.84 1.237 1.84 1.237 1.07 1.835 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.31.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .322.216.698.825.576C20.565 21.795 24 17.298 24 12c0-6.63-5.37-12-12-12z"/>
              </svg>
              <span>Code</span>
            </a>
          )}
          {pub.datasetUrl && pub.datasetUrl !== pub.codeUrl && (
            <a href={pub.datasetUrl} target="_blank" rel="noopener" class="action-pill">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <ellipse cx="12" cy="5" rx="9" ry="3"/>
                <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/>
                <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>
              </svg>
              <span>Dataset</span>
            </a>
          )}
          {pub.posterUrl && (
            <a href={pub.posterUrl} target="_blank" rel="noopener" class="action-pill">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="2"/>
                <circle cx="8.5" cy="8.5" r="1.5"/>
                <polyline points="21 15 16 10 5 21"/>
              </svg>
              <span>Poster</span>
            </a>
          )}
        </div>
      </div>
    </header>

    <!-- Teaser Figure + Left-Aligned Research Summary Paragraph -->
    <section class:list={['teaser-section', { 'teaser-compact': !pub.teaserImage }]}>
      <div class="container-desktop">
        {pub.teaserImage && (
          <figure class="teaser-figure">
            <button
              type="button"
              class="zoom-trigger"
              aria-label={`View full size: ${pub.title}`}
            >
              <img
                src={pub.teaserImage}
                alt={pub.title}
                class:list={['teaser-img', 'zoomable-img', { 'teaser-svg': isSvgTeaser }]}
                loading="eager"
              />
            </button>
          </figure>
        )}
        <p class="teaser-summary">{teaserSummaryText}</p>
      </div>
    </section>

    <!-- Abstract Band -->
    <section id="abstract" class="section-band section-light">
      <div class="container-desktop">
        <div class="section-title-block section-title-center">
          <h2>Abstract</h2>
          <div class="title-bar title-bar-center"></div>
        </div>
        <div class="abstract-prose">
          <p>{pub.abstract}</p>
        </div>
      </div>
    </section>

    <!-- Individual Figure Sections (max 2 before Results, max 3 body figures total) -->
    {bodyFigs.map((fig, idx) => {
      const bandClass = idx % 2 === 0 ? 'section-white' : 'section-light';
      const heading = fig.title || (idx === 0 ? (pub.figureHeading || 'Methodology & Analysis') : `Analysis ${idx + 1}`);
      return (
        <section id={idx === 0 ? 'methodology' : `analysis-${idx + 1}`} class:list={['section-band', bandClass]}>
          <div class="container-desktop">
            <div class="section-title-block section-title-left">
              <h2>{heading}</h2>
              <div class="title-bar title-bar-left"></div>
            </div>
            <figure class="analysis-figure">
              <button
                type="button"
                class="zoom-trigger"
                aria-label={`View full size: ${fig.alt || fig.caption}`}
              >
                <img
                  src={fig.src}
                  alt={fig.alt || fig.caption}
                  class="analysis-img zoomable-img"
                  loading="lazy"
                />
              </button>
              <figcaption class="figure-prose">{fig.caption}</figcaption>
            </figure>
          </div>
        </section>
      );
    })}

    <!-- Results Section -->
    {hasResults && (
      <section id="results" class:list={['section-band', resultsBand]}>
        <div class="container-desktop">
          <div class="section-title-block section-title-left">
            <h2>Results</h2>
            <div class="title-bar title-bar-left"></div>
          </div>

          {resultsNarrative && (
            <p class="section-prose">{resultsNarrative}</p>
          )}

          {resultsFig && (
            <figure class="analysis-figure results-figure">
              <button
                type="button"
                class="zoom-trigger"
                aria-label={`View full size: ${resultsFig.alt || resultsFig.caption}`}
              >
                <img
                  src={resultsFig.src}
                  alt={resultsFig.alt || resultsFig.caption}
                  class="analysis-img zoomable-img"
                  loading="lazy"
                />
              </button>
              <figcaption class="figure-prose">{resultsFig.caption}</figcaption>
            </figure>
          )}

          {pub.protocolBox && (
            <div class="protocol-card">
              <h3>{pub.protocolBox.title}</h3>
              {pub.protocolBox.subtitle && <p class="protocol-sub">{pub.protocolBox.subtitle}</p>}
              {pub.protocolBox.formula && (
                <pre class="protocol-formula"><code>{pub.protocolBox.formula}</code></pre>
              )}
              <ol class="protocol-steps">
                {pub.protocolBox.steps.map((step) => (
                  <li>{step}</li>
                ))}
              </ol>
            </div>
          )}

          {pub.tables && pub.tables.length > 0 && (
            <div class="tables-stack">
              {pub.tables.map((table) => (
                <div class="table-block">
                  <div class="table-header-text">
                    <h3>{table.title}</h3>
                    {table.caption && <p>{table.caption}</p>}
                  </div>
                  <div class="table-scroll">
                    <table>
                      <thead>
                        <tr>
                          {table.headers.map((h) => (
                            <th>{h}</th>
                          ))}
                        </tr>
                      </thead>
                      <tbody>
                        {table.rows.map((row) => {
                          const cell0 = row[0] || '';
                          const isOurs =
                            cell0.includes('(Ours)') ||
                            cell0.startsWith('Total') ||
                            cell0.includes('CropGuardNet') ||
                            cell0.startsWith('Compositional') ||
                            cell0.includes('(Decomposed)');
                          return (
                            <tr class:list={[{ 'row-highlight': isOurs }]}>
                              {row.map((cell) => (
                                <td>{cell}</td>
                              ))}
                            </tr>
                          );
                        })}
                      </tbody>
                    </table>
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>
      </section>
    )}

