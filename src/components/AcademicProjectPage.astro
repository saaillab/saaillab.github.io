---
import type { Publication } from '../data/publications';
import { PUBLICATIONS } from '../data/publications';

export interface Props {
  pub: Publication;
}

const { pub } = Astro.props;

const cleanDoi = pub.doi ? pub.doi.replace(/^https?:\/\/(dx\.)?doi\.org\//i, '').trim() : '';
const doiUrl = cleanDoi ? `https://doi.org/${cleanDoi}` : '';
const isPriorWork = pub.isSaailLab === false;
const isPreprint = pub.category === 'preprint';
const isThesis = pub.slug === 'intelligent-greenhouse-arduino-2016';
const isPdfUrl = Boolean(pub.paperUrl && (/\.pdf($|\?)/i.test(pub.paperUrl) || /openreview\.net\/pdf/i.test(pub.paperUrl)));
const canonicalUrl = `https://saaillab.github.io/papers/${pub.slug}/`;
const ogImageUrl = pub.teaserImage
  ? `https://saaillab.github.io${pub.teaserImage}`
  : 'https://saaillab.github.io/images/logo/saail-logo.png';

const citedPubs = PUBLICATIONS.filter((p) => p.slug !== pub.slug).slice(0, 8);

// Remap affiliations sequentially 1..k so numbers never skip (e.g. 1, 2, 5, 6 -> 1, 2, 3, 4)
const rawUsedIndices: number[] = [];
pub.authors.forEach((a) => {
  (a.affiliations || []).forEach((idx) => {
    if (!rawUsedIndices.includes(idx)) rawUsedIndices.push(idx);
  });
});
rawUsedIndices.sort((a, b) => a - b);

const remapAff = new Map<number, number>();
const visibleAffiliations: { num: number; label: string }[] = [];
if (rawUsedIndices.length > 0) {
  rawUsedIndices.forEach((origIdx) => {
    const label = pub.affiliations[origIdx - 1];
    if (label) {
      const seq = visibleAffiliations.length + 1;
      remapAff.set(origIdx, seq);
      visibleAffiliations.push({ num: seq, label });
    }
  });
} else {
  pub.affiliations.forEach((label, idx) => {
    visibleAffiliations.push({ num: idx + 1, label });
  });
}

const hasFigures = Boolean(pub.figures && pub.figures.length > 0);
const hasResults = Boolean(
  (pub.tables && pub.tables.length > 0) || (pub.contributions && pub.contributions.length > 0)
);
const resultsAltBand = hasFigures ? 'section-band' : 'section-white';
const bibtexAltBand =
  hasResults
    ? resultsAltBand === 'section-band'
      ? 'section-white'
      : 'section-band'
    : hasFigures
      ? 'section-band'
      : 'section-white';

const scholarLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  headline: pub.title,
  name: pub.title,
  datePublished: pub.dateISO,
  description: pub.tldr,
  url: canonicalUrl,
  image: ogImageUrl,
  author: pub.authors.map((a) => ({
    '@type': 'Person',
    name: a.name,
    ...(a.url ? { url: a.url } : {})
  })),
  ...(doiUrl ? { sameAs: doiUrl, identifier: cleanDoi } : {})
};

if (!isPreprint && !isThesis) {
  scholarLd.isPartOf = {
    '@type': pub.category === 'journal' ? 'Periodical' : 'PublicationVolume',
    name: pub.venue
  };
}
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pub.shortTitle || pub.title} | SAAIL Lab</title>
  <meta name="description" content={pub.tldr} />
  <meta name="keywords" content={pub.keywords.join(', ')} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="alternate" hreflang="en" href={canonicalUrl} />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <link rel="icon" type="image/png" href="/images/logo/saail-crest.png" />
  <link rel="apple-touch-icon" href="/images/logo/saail-crest.png" />

  <meta property="og:type" content="article" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:title" content={pub.title} />
  <meta property="og:description" content={pub.tldr} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content="SAAIL Lab | IIT Madras Zanzibar" />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:alt" content={pub.title} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@saaillab" />
  <meta name="twitter:title" content={pub.title} />
  <meta name="twitter:description" content={pub.tldr} />
  <meta name="twitter:image" content={ogImageUrl} />

  <meta name="citation_title" content={pub.title} />
  {pub.authors.map((a) => (
    <meta name="citation_author" content={a.name} />
  ))}
  <meta name="citation_publication_date" content={String(pub.year)} />
  {pub.category === 'journal' && !isThesis && (
    <meta name="citation_journal_title" content={pub.venue} />
  )}
  {(pub.category === 'conference' || pub.category === 'workshop') && (
    <meta name="citation_conference_title" content={pub.venue} />
  )}
  {isThesis && <meta name="citation_dissertation_institution" content="Nanjing Agricultural University" />}
  {cleanDoi && <meta name="citation_doi" content={cleanDoi} />}
  {isPdfUrl && pub.paperUrl && <meta name="citation_pdf_url" content={pub.paperUrl} />}

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

  <script type="application/ld+json" set:html={JSON.stringify(scholarLd)} />

  <script async src="https://www.googletagmanager.com/gtag/js?id=G-4MEPY7MLVN"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-4MEPY7MLVN');
  </script>
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to main content</a>

  <nav class="top-utility" aria-label="Paper navigation">
    <div class="more-works-wrap">
      <button id="moreWorksBtn" type="button" class="more-works-btn" aria-expanded="false" aria-controls="moreWorksDropdown">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <rect x="3" y="3" width="7" height="7" rx="1"/>
          <rect x="14" y="3" width="7" height="7" rx="1"/>
          <rect x="3" y="14" width="7" height="7" rx="1"/>
          <rect x="14" y="14" width="7" height="7" rx="1"/>
        </svg>
        <span>More Research</span>
        <svg id="moreWorksChevron" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
          <path d="M6 9l6 6 6-6"/>
        </svg>
      </button>

      <div id="moreWorksDropdown" class="more-works-dropdown" hidden>
        <div class="dropdown-head">
          <span>SAAIL Lab · Research Directory</span>
          <button id="closeMoreWorks" type="button" class="close-btn" aria-label="Close">&times;</button>
        </div>
        <div class="dropdown-links">
          <a href="/" class="dropdown-item dropdown-home">
            <span class="item-kicker">Lab Homepage</span>
            <span class="item-title">SAAIL Lab · IIT Madras Zanzibar</span>
          </a>
          <a href="/publications/" class="dropdown-item dropdown-home">
            <span class="item-kicker">Full Archive</span>
            <span class="item-title">View All {PUBLICATIONS.length} Papers &amp; Preprints</span>
          </a>
          <a href="/projects/" class="dropdown-item dropdown-home">
            <span class="item-kicker">Grants &amp; Systems</span>
            <span class="item-title">Active Lab Projects</span>
          </a>
          <div class="dropdown-divider"></div>
          {citedPubs.map((item) => {
            const kickerLabel = item.venueShort.includes(String(item.year))
              ? item.venueShort
              : `${item.venueShort} · ${item.year}`;
            return (
              <a href={`/papers/${item.slug}/`} class="dropdown-item">
                <span class="item-kicker">{kickerLabel}</span>
                <span class="item-title">{item.shortTitle || item.title}</span>
              </a>
            );
          })}
        </div>
      </div>
    </div>

    <a href="/publications/" class="back-pub-link">&larr; All Publications</a>
  </nav>

  <main id="main-content">
    <!-- Hero Block (horwitz.ai/probex clean white layout) -->
    <header class="paper-hero">
      <div class="container">
        <h1 class="paper-title">{pub.title}</h1>

        <div class="authors-row">
          {pub.authors.map((author, idx) => {
            const mappedAffs = (author.affiliations || [])
              .map((num) => remapAff.get(num))
              .filter((n): n is number => typeof n === 'number');
            const supText = mappedAffs.join(',');
            const comma = idx < pub.authors.length - 1 ? ', ' : '';
            const authorClass = author.name === 'Innocent Nyalala' ? 'author-link pi-link' : 'author-link';
            const spanClass = author.name === 'Innocent Nyalala' ? 'author-name pi-link' : 'author-name';
            return (
              <span class="author-token">{author.url ? <a href={author.url} target="_blank" rel="noopener" class={authorClass}>{author.name}</a> : <span class={spanClass}>{author.name}</span>}{supText && <sup class="aff-sup">{supText}</sup>}{comma}</span>
            );
          })}
        </div>

        <div class="affiliations-stack">
          {visibleAffiliations.map((aff) => (
            <div class="aff-line">
              <sup>{aff.num}</sup>{aff.label}
            </div>
          ))}
        </div>

        <div class="venue-line">
          {isPreprint ? (
            <span>Manuscript Under Peer Review ({pub.year})</span>
          ) : (
            <span>{pub.venue}</span>
          )}
        </div>
        {pub.award && <div class="award-line">{pub.award}</div>}

        <div class="action-buttons" role="navigation" aria-label="Paper resources">
          {pub.paperUrl && pub.paperUrl !== doiUrl && (
            <a href={pub.paperUrl} target="_blank" rel="noopener" class="action-pill">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
              </svg>
              <span>Paper</span>
            </a>
          )}
          {doiUrl && (
            <a href={doiUrl} target="_blank" rel="noopener" class="action-pill">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                <polyline points="15 3 21 3 21 9"/>
                <line x1="10" y1="14" x2="21" y2="3"/>
              </svg>
              <span>DOI</span>
            </a>
          )}
          {pub.codeUrl && (
            <a href={pub.codeUrl} target="_blank" rel="noopener" class="action-pill">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.09-.745.083-.729.083-.729 1.205.084 1.84 1.237 1.84 1.237 1.07 1.835 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.31.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .322.216.698.825.576C20.565 21.795 24 17.298 24 12c0-6.63-5.37-12-12-12z"/>
              </svg>
              <span>Code</span>
            </a>
          )}
          {pub.datasetUrl && pub.datasetUrl !== pub.codeUrl && (
            <a href={pub.datasetUrl} target="_blank" rel="noopener" class="action-pill">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <ellipse cx="12" cy="5" rx="9" ry="3"/>
                <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/>
                <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>
              </svg>
              <span>Dataset</span>
            </a>
          )}
          {pub.posterUrl && (
            <a href={pub.posterUrl} target="_blank" rel="noopener" class="action-pill">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="2"/>
                <circle cx="8.5" cy="8.5" r="1.5"/>
                <polyline points="21 15 16 10 5 21"/>
              </svg>
              <span>Poster</span>
            </a>
          )}
          <a href="#bibtex" class="action-pill">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M10 11H6a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h3a1 1 0 0 1 1 1v6c0 2.667-1.333 4.333-4 5"/>
              <path d="M19 11h-4a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h3a1 1 0 0 1 1 1v6c0 2.667-1.333 4.333-4 5"/>
            </svg>
            <span>BibTeX</span>
          </a>
        </div>
      </div>
    </header>

    <!-- Teaser Figure + Plain Editorial Summary Paragraph -->
    <section class:list={['teaser-section', { 'teaser-compact': !pub.teaserImage }]}>
      <div class="container container-wide">
        {pub.teaserImage && (
          <figure class="teaser-figure">
            <button
              type="button"
              class="zoom-trigger"
              aria-label={`View full size: ${pub.title}`}
            >
              <img
                src={pub.teaserImage}
                alt={pub.title}
                class="teaser-img zoomable-img"
                loading="eager"
              />
            </button>
          </figure>
        )}
        <p class="teaser-summary">{pub.tldr}</p>
      </div>
    </section>

    <!-- Abstract Band -->
    <section id="abstract" class="section-band">
      <div class="container container-reading">
        <div class="section-title-block">
          <h2>Abstract</h2>
          <div class="title-bar"></div>
        </div>
        <div class="abstract-prose">
          <p>{pub.abstract}</p>
        </div>
      </div>
    </section>

    <!-- Descriptive Visual Figure Section -->
    {hasFigures && (
      <section id="methodology" class="section-white">
        <div class="container container-wide">
          <div class="section-title-block">
            <h2>{pub.figureHeading || 'Visual Methodology & Analysis'}</h2>
            <div class="title-bar"></div>
          </div>

          <div class="figures-stack">
            {pub.figures!.map((fig) => (
              <figure class="analysis-figure">
                <button
                  type="button"
                  class="zoom-trigger"
                  aria-label={`View full size: ${fig.alt || fig.caption}`}
                >
                  <img
                    src={fig.src}
                    alt={fig.alt || fig.caption}
                    class="analysis-img zoomable-img"
                    loading="lazy"
                  />
                </button>
                <figcaption class="analysis-caption">{fig.caption}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Results Section -->
    {hasResults && (
      <section id="results" class={resultsAltBand}>
        <div class="container container-wide">
          <div class="section-title-block">
            <h2>Results</h2>
            <div class="title-bar"></div>
          </div>

          {pub.contributions && pub.contributions.length > 0 && (
            <div class="results-narrative">
              <ul>
                {pub.contributions.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          )}

          {pub.tables && pub.tables.length > 0 && (
            <div class="tables-stack">
              {pub.tables.map((table) => (
                <div class="table-block">
                  <div class="table-header-text">
                    <h3>{table.title}</h3>
                    {table.caption && <p>{table.caption}</p>}
                  </div>
                  <div class="table-scroll">
                    <table>
                      <thead>
                        <tr>
                          {table.headers.map((h) => (
                            <th>{h}</th>
                          ))}
                        </tr>
                      </thead>
                      <tbody>
                        {table.rows.map((row) => {
                          const cell0 = row[0] || '';
                          const isOurs =
                            cell0.includes('(Ours)') ||
                            cell0.startsWith('Total') ||
                            cell0.includes('CropGuardNet') ||
                            cell0.startsWith('Compositional') ||
                            cell0.includes('(Decomposed)');
                          return (
                            <tr class:list={[{ 'row-highlight': isOurs }]}>
                              {row.map((cell) => (
                                <td>{cell}</td>
                              ))}
                            </tr>
                          );
                        })}
                      </tbody>
                    </table>
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>
      </section>
    )}

    <!-- BibTeX & Citation -->
    <section id="bibtex" class={bibtexAltBand}>
      <div class="container container-reading">
        <div class="bibtex-header">
          <h2>BibTeX</h2>
          <button type="button" id="copyBibBtn" class="copy-btn" data-copy-target="bibtexCode">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
            </svg>
            <span>Copy</span>
          </button>
        </div>
        <pre class="bibtex-pre"><code id="bibtexCode">{pub.bibtex}</code></pre>

        <div class="apa-box">
          <div class="apa-header">
            <span class="apa-label">APA Citation</span>
            <button type="button" id="copyApaBtn" class="copy-btn copy-btn-subtle" data-copy-target="apaText">
              <span>Copy APA</span>
            </button>
          </div>
          <p id="apaText" class="apa-text">{pub.apa}</p>
        </div>
      </div>
    </section>
  </main>

  <footer class="project-footer">
    <div class="container container-reading">
      <div class="footer-brand">
        <img src="/images/logo/saail-crest.png" alt="SAAIL Lab Crest" width="24" height="24" />
        {isPriorWork ? (
          <span>
            Prior institutional publication by <a href="https://inyalala.github.io/" target="_blank" rel="noopener">Dr. Innocent Nyalala</a> ({pub.year}, prior to joining IIT Madras Zanzibar)
          </span>
        ) : (
          <span>
            <a href="/">SAAIL Lab</a> · School of Engineering and Science, Indian Institute of Technology Madras Zanzibar
          </span>
        )}
      </div>
      <p class="template-credit">
        Layout adapted from the <a href="https://github.com/eliahuhorwitz/Academic-project-page-template" target="_blank" rel="noopener">Academic Project Page Template</a> under the <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="license noopener">CC BY-SA 4.0 License</a>.
      </p>
      <div class="footer-links">
        <a href="/">SAAIL Lab Home</a>
        <span>·</span>
        <a href="/publications/">Publications</a>
        <span>·</span>
        <a href="/projects/">Projects</a>
        <span>·</span>
        <a href="https://github.com/saaillab" target="_blank" rel="noopener">GitHub</a>
      </div>
    </div>
  </footer>

  <!-- Full-Resolution Figure Lightbox -->
  <div id="imgLightbox" class="img-lightbox" hidden role="dialog" aria-modal="true" aria-label="Enlarged figure preview">
    <button id="closeLightbox" type="button" class="lightbox-close" aria-label="Close enlarged view">&times;</button>
    <img id="lightboxImg" alt="" />
  </div>

  <script is:inline>
    (function () {
      const btn = document.getElementById('moreWorksBtn');
      const dropdown = document.getElementById('moreWorksDropdown');
      const closeBtn = document.getElementById('closeMoreWorks');
      const chevron = document.getElementById('moreWorksChevron');

      function setOpen(open) {
        if (!btn || !dropdown) return;
        dropdown.hidden = !open;
        btn.setAttribute('aria-expanded', String(open));
        if (chevron) {
          chevron.style.transform = open ? 'rotate(180deg)' : 'rotate(0deg)';
        }
      }

      if (btn && dropdown) {
        btn.addEventListener('click', function (e) {
          e.stopPropagation();
          setOpen(dropdown.hidden);
        });
        if (closeBtn) {
          closeBtn.addEventListener('click', function () {
            setOpen(false);
            btn.focus();
          });
        }
        document.addEventListener('click', function (e) {
          if (!dropdown.hidden && !dropdown.contains(e.target) && !btn.contains(e.target)) {
            setOpen(false);
          }
        });
      }

      const lightbox = document.getElementById('imgLightbox');
      const lightboxImg = document.getElementById('lightboxImg');
      const closeLightbox = document.getElementById('closeLightbox');
      let lastFocusEl = null;

      function openLightbox(triggerEl, imgEl) {
        if (!lightbox || !lightboxImg || !imgEl) return;
        lastFocusEl = triggerEl;
        lightboxImg.src = imgEl.src;
        lightboxImg.alt = imgEl.alt || 'Figure';
        lightbox.hidden = false;
        document.body.style.overflow = 'hidden';
        if (closeLightbox) closeLightbox.focus();
      }

      function hideLightbox() {
        if (!lightbox) return;
        lightbox.hidden = true;
        document.body.style.overflow = '';
        if (lastFocusEl && typeof lastFocusEl.focus === 'function') {
          lastFocusEl.focus();
        }
      }

      document.querySelectorAll('.zoom-trigger').forEach(function (triggerEl) {
        const imgEl = triggerEl.querySelector('img');
        if (!imgEl) return;
        triggerEl.title = 'Click to view full size';
        triggerEl.addEventListener('click', function () { openLightbox(triggerEl, imgEl); });
      });

      if (closeLightbox && lightbox) {
        closeLightbox.addEventListener('click', hideLightbox);
        lightbox.addEventListener('click', function (e) {
          if (e.target === lightbox) hideLightbox();
        });
      }

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Tab' && lightbox && !lightbox.hidden && closeLightbox) {
          e.preventDefault();
          closeLightbox.focus();
        }
        if (e.key === 'Escape') {
          if (dropdown && !dropdown.hidden) {
            setOpen(false);
            if (btn) btn.focus();
          }
          if (lightbox && !lightbox.hidden) hideLightbox();
        }
      });

      function attachCopy(btnId) {
        const copyBtn = document.getElementById(btnId);
        if (!copyBtn) return;
        const originalHtml = copyBtn.getAttribute('data-orig-html') || copyBtn.innerHTML;
        copyBtn.setAttribute('data-orig-html', originalHtml);
        copyBtn.addEventListener('click', async function () {
          const targetId = copyBtn.getAttribute('data-copy-target');
          const el = targetId ? document.getElementById(targetId) : null;
          const text = el ? (el.textContent || '').trim() : '';
          if (!text) return;
          let copied = false;
          try {
            await navigator.clipboard.writeText(text);
            copied = true;
          } catch (_err) {
            const area = document.createElement('textarea');
            area.value = text;
            area.style.position = 'fixed';
            area.style.opacity = '0';
            document.body.appendChild(area);
            area.select();
            try { copied = document.execCommand('copy'); } catch (_e2) {}
            document.body.removeChild(area);
          }
          if (copied) {
            copyBtn.classList.add('copied');
            copyBtn.innerHTML = '<span>&#10003; Copied</span>';
            setTimeout(function () {
              copyBtn.classList.remove('copied');
              copyBtn.innerHTML = copyBtn.getAttribute('data-orig-html') || originalHtml;
            }, 1800);
          }
        });
      }
      attachCopy('copyBibBtn');
      attachCopy('copyApaBtn');
    })();
  </script>

