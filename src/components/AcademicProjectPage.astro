---
import { getRelatedWorks, PUBLICATIONS, type Publication } from '../data/publications';

export interface Props {
  pub: Publication;
}

const { pub } = Astro.props;

const canonicalUrl = `https://saaillab.github.io/papers/${pub.slug}/`;
const relatedWorks = getRelatedWorks(pub.slug, 6);
const cleanDoi = pub.doi
  ? pub.doi.replace(/^https?:\/\/(dx\.)?doi\.org\//i, '').trim()
  : '';
const doiUrl = cleanDoi ? `https://doi.org/${cleanDoi}` : undefined;
const ogImage = pub.teaserImage
  ? `https://saaillab.github.io${pub.teaserImage}`
  : 'https://saaillab.github.io/images/logo/saail-logo.png';
const hasEqualAuthors = pub.authors.some((a) => a.equal);

const isPriorWork = pub.isSaailLab === false;
const isUnderReview = pub.category === 'preprint';

// Anonymize venue text for active under-review manuscripts to protect peer review
const displayVenueShort = isUnderReview ? `Under Peer Review · ${pub.year}` : pub.venueShort;
const displayVenueFull = isUnderReview ? `Manuscript Under Peer Review (${pub.year})` : `${pub.venue} (${pub.month} ${pub.year})`;
const displayStatus = isUnderReview ? 'Under Peer Review' : pub.status;

// One primary result figure per section (matching horwitz.ai/probex layout discipline)
const primaryFigure = pub.figures && pub.figures.length > 0 ? pub.figures[0] : undefined;

const schemaJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  headline: pub.title,
  name: pub.title,
  description: pub.tldr || pub.abstract,
  datePublished: pub.dateISO,
  url: canonicalUrl,
  image: ogImage,
  keywords: pub.keywords.join(', '),
  inLanguage: 'en',
  isAccessibleForFree: true,
  author: pub.authors.map((a) => ({
    '@type': 'Person',
    name: a.name,
    ...(a.url ? { url: a.url } : {})
  })),
  publisher: {
    '@type': 'Organization',
    name: isUnderReview ? 'Under Peer Review' : pub.venue
  },
  ...(doiUrl ? { sameAs: doiUrl, identifier: cleanDoi } : {})
});

const breadcrumbJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'SAAIL Lab',
      item: 'https://saaillab.github.io/'
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Publications',
      item: 'https://saaillab.github.io/publications/'
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: pub.shortTitle || pub.title,
      item: canonicalUrl
    }
  ]
});

const totalPapersCount = PUBLICATIONS.filter((p) => p.isSaailLab !== false).length;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pub.shortTitle ? `${pub.shortTitle} | ` : ''}{pub.title}</title>
  <meta name="description" content={pub.tldr || pub.abstract.slice(0, 160)} />
  <meta name="keywords" content={pub.keywords.join(', ')} />
  <meta name="author" content={pub.authors.map((a) => a.name).join(', ')} />
  <link rel="icon" type="image/png" href="/images/logo/saail-crest.png" />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Highwire Press / Google Scholar Academic Meta Tags -->
  <meta name="citation_title" content={pub.title} />
  {pub.authors.map((author) => (
    <meta name="citation_author" content={author.name} />
  ))}
  <meta name="citation_publication_date" content={pub.dateISO.replace(/-/g, '/')} />
  {!isUnderReview && (pub.category === 'conference' || pub.category === 'workshop' ? (
    <meta name="citation_conference_title" content={pub.venue} />
  ) : (
    <meta name="citation_journal_title" content={pub.venue} />
  ))}
  {cleanDoi && <meta name="citation_doi" content={cleanDoi} />}
  {pub.paperUrl && pub.paperUrl.toLowerCase().endsWith('.pdf') && (
    <meta name="citation_pdf_url" content={pub.paperUrl} />
  )}
  <meta name="citation_public_url" content={canonicalUrl} />

  <!-- Open Graph & Social Previews -->
  <meta property="og:type" content="article" />
  <meta property="og:site_name" content={isPriorWork ? 'Innocent Nyalala · Publication Archive' : 'SAAIL Lab · IIT Madras Zanzibar'} />
  <meta property="og:title" content={pub.title} />
  <meta property="og:description" content={pub.tldr} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImage} />
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:title" content={pub.shortTitle || pub.title} />
  <meta property="twitter:description" content={pub.tldr} />
  <meta property="twitter:image" content={ogImage} />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-4MEPY7MLVN"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-4MEPY7MLVN');
  </script>

  <!-- Structured Data -->
  <script type="application/ld+json" set:html={schemaJson} />
  <script type="application/ld+json" set:html={breadcrumbJson} />
</head>
<body>
  <!-- Clean Floating Controls (horwitz.ai/probex minimalist header chrome) -->
  <a href="/publications" class="floating-back-btn" aria-label="Back to Publications">
    <img src="/images/logo/saail-crest.png" alt="SAAIL Lab" width="22" height="22" class="floating-crest" />
    <span>{isPriorWork ? 'Publications' : 'SAAIL Lab'}</span>
  </a>

  <div class="more-works-container">
    <button
      id="moreWorksBtn"
      class="more-works-btn"
      type="button"
      aria-expanded="false"
      aria-controls="moreWorksDropdown"
    >
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M9 3h6v2l-1 1v4.5l4.8 7.6A2 2 0 0 1 17.1 21H6.9a2 2 0 0 1-1.7-2.9L10 10.5V6L9 5V3z"/>
      </svg>
      <span>More Works</span>
      <svg id="moreWorksChevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
        <path d="M6 9l6 6 6-6"/>
      </svg>
    </button>

    <div id="moreWorksDropdown" class="more-works-dropdown" role="menu" hidden>
      <div class="dropdown-header">
        <span>{isPriorWork ? 'Related Publications' : 'More Works from SAAIL Lab'}</span>
        <button id="closeMoreWorks" type="button" class="close-dropdown" aria-label="Close menu">&times;</button>
      </div>
      <div class="dropdown-list">
        {relatedWorks.map((work) => (
          <a href={`/papers/${work.slug}/`} class="dropdown-item" role="menuitem">
            <div class="dropdown-item-title">{work.shortTitle || work.title}</div>
            <div class="dropdown-item-meta">
              <span>{work.category === 'preprint' ? `Under Review · ${work.year}` : work.venueShort}</span>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/>
              </svg>
            </div>
          </a>
        ))}
      </div>
      <a href="/publications" class="dropdown-footer-link">Browse all {totalPapersCount} SAAIL Lab publications &rarr;</a>
    </div>
  </div>

  <main>
    <!-- Hero Section -->
    <section class="hero-section">
      <div class="container">
        <div class="hero-badges">
          <span class="venue-badge">{displayVenueShort}</span>
          {pub.award && <span class="award-badge">{pub.award}</span>}
          {!isUnderReview && pub.impactFactor && <span class="metric-pill">{pub.impactFactor}</span>}
          {typeof pub.citations === 'number' && pub.citations > 0 && (
            <span class="metric-pill">{pub.citations}+ Citations</span>
          )}
          {isPriorWork ? (
            <span class="prior-badge">Prior Institutional Research · Pre-IITMZ ({pub.year})</span>
          ) : (
            <span class="status-pill">{displayStatus}</span>
          )}
        </div>

        <h1 class="publication-title">{pub.title}</h1>

        <div class="publication-authors">
          {pub.authors.map((author, idx) => (
            <span class="author-block">
              {author.url ? (
                <a href={author.url} target="_blank" rel="noopener">{author.name}</a>
              ) : (
                <span>{author.name}</span>
              )}
              {author.affiliations && author.affiliations.length > 0 && (
                <sup>{author.affiliations.join(',')}</sup>
              )}
              {author.equal && <sup>*</sup>}
              {idx < pub.authors.length - 1 && <span class="author-comma">, </span>}
            </span>
          ))}
        </div>

        <div class="publication-affiliations">
          {pub.affiliations.map((aff, i) => (
            <div class="affiliation-line">
              <sup>{i + 1}</sup><span>{aff}</span>
            </div>
          ))}
        </div>

        <div class="publication-venue-full">
          <span>{displayVenueFull}</span>
          {hasEqualAuthors && <span class="equal-note"> · *Indicates Equal Contribution</span>}
        </div>

        <!-- Action Buttons -->
        <div class="action-buttons">
          {!isUnderReview && pub.paperUrl && (
            <a href={pub.paperUrl} target="_blank" rel="noopener" class="action-btn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
                <line x1="16" y1="13" x2="8" y2="13"/>
                <line x1="16" y1="17" x2="8" y2="17"/>
              </svg>
              <span>Paper</span>
            </a>
          )}

          {!isUnderReview && doiUrl && (
            <a href={doiUrl} target="_blank" rel="noopener" class="action-btn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/>
                <line x1="2" y1="12" x2="22" y2="12"/>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
              </svg>
              <span>DOI</span>
            </a>
          )}

          {pub.codeUrl && (
            <a href={pub.codeUrl} target="_blank" rel="noopener" class="action-btn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
              </svg>
              <span>Code</span>
            </a>
          )}

          {pub.datasetUrl && (
            <a href={pub.datasetUrl} target="_blank" rel="noopener" class="action-btn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <ellipse cx="12" cy="5" rx="9" ry="3"/>
                <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/>
                <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>
              </svg>
              <span>Dataset / Split</span>
            </a>
          )}

          {pub.posterUrl && (
            <a href={pub.posterUrl} target="_blank" rel="noopener" class="action-btn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="2"/>
                <circle cx="8.5" cy="8.5" r="1.5"/>
                <polyline points="21 15 16 10 5 21"/>
              </svg>
              <span>Poster</span>
            </a>
          )}

          <a href="#BibTeX" class="action-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M6 17h3l2-4V7H5v6h3M15 17h3l2-4V7h-6v6h3"/>
            </svg>
            <span>BibTeX</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Teaser Visual + Summary (Single Clean Visual per Section, horwitz.ai/probex style) -->
    <section class="teaser-section">
      <div class="container container-narrow">
        {pub.teaserImage && (
          <figure class="teaser-figure">
            <img
              src={pub.teaserImage}
              alt={pub.title}
              loading="eager"
              class="teaser-img zoomable-img"
            />
          </figure>
        )}
        <div class={`tldr-block ${pub.teaserImage ? '' : 'tldr-standalone'}`}>
          <p>
            <strong>Summary:</strong> {pub.teaserCaption || pub.tldr}
          </p>
        </div>
      </div>
    </section>

    <!-- Abstract Section -->
    <section class="band-section band-light" id="Abstract">
      <div class="container container-reading">
        <h2 class="section-heading">Abstract</h2>
        <div class="abstract-text">
          <p>{pub.abstract}</p>
        </div>
        <div class="keywords-row">
          <span class="keywords-label">Keywords:</span>
          {pub.keywords.map((kw) => (
            <span class="keyword-chip">{kw}</span>
          ))}
        </div>
      </div>
    </section>

    <!-- Quantitative Highlights & Contributions -->
    {((pub.highlights && pub.highlights.length > 0) || (pub.contributions && pub.contributions.length > 0)) && (
      <section class="band-section" id="Findings">
        <div class="container container-reading">
          <h2 class="section-heading">Key Findings &amp; Contributions</h2>

          {pub.highlights && pub.highlights.length > 0 && (
            <div class="highlights-grid">
              {pub.highlights.map((item) => (
                <div class="highlight-card">
                  <div class="highlight-value">{item.value}</div>
                  <div class="highlight-label">{item.label}</div>
                  {item.sublabel && <div class="highlight-sub">{item.sublabel}</div>}
                </div>
              ))}
            </div>
          )}

          {pub.contributions && pub.contributions.length > 0 && (
            <ol class="contributions-list">
              {pub.contributions.map((c) => (
                <li>{c}</li>
              ))}
            </ol>
          )}
        </div>
      </section>
    )}

    <!-- Single Primary Result Visual Section (One image per section) -->
    {primaryFigure && (
      <section class="band-section band-light" id="Results">
        <div class="container container-narrow">
          <h2 class="section-heading">Key Empirical Figure</h2>
          <figure class="single-result-figure">
            <div class="single-img-frame">
              <img src={primaryFigure.src} alt={primaryFigure.alt || primaryFigure.caption} loading="lazy" class="zoomable-img" />
            </div>
            <figcaption class="single-caption">{primaryFigure.caption}</figcaption>
          </figure>
        </div>
      </section>
    )}

    <!-- Quantitative Benchmark Tables -->
    {pub.tables && pub.tables.length > 0 && (
      <section class={`band-section ${primaryFigure ? '' : 'band-light'}`} id="Benchmarks">
        <div class="container container-reading">
          <h2 class="section-heading">Benchmark Results</h2>
          {pub.tables.slice(0, 2).map((tbl) => (
            <div class="table-block">
              <h3 class="table-title">{tbl.title}</h3>
              {tbl.caption && <p class="table-caption">{tbl.caption}</p>}
              <div class="table-scroll">
                <table class="academic-table">
                  <thead>
                    <tr>
                      {tbl.headers.map((h) => <th>{h}</th>)}
                    </tr>
                  </thead>
                  <tbody>
                    {tbl.rows.map((row) => (
                      <tr>
                        {row.map((cell, ci) => (
                          <td class={ci === 0 ? 'cell-lead' : ''}>{cell}</td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- BibTeX Citation Section -->
    <section class={`band-section ${(primaryFigure && !(pub.tables && pub.tables.length > 0)) ? '' : 'band-light'}`} id="BibTeX">
      <div class="container container-reading">
        <div class="bibtex-header">
          <h2>BibTeX</h2>
          <button type="button" id="copyBibBtn" class="copy-btn" data-copy-target="bibtexCode">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
            </svg>
            <span>Copy</span>
          </button>
        </div>
        <pre class="bibtex-pre"><code id="bibtexCode">{pub.bibtex}</code></pre>

        <div class="apa-box">
          <div class="apa-header">
            <span class="apa-label">APA Citation</span>
            <button type="button" id="copyApaBtn" class="copy-btn copy-btn-subtle" data-copy-target="apaText">
              <span>Copy APA</span>
            </button>
          </div>
          <p id="apaText" class="apa-text">{pub.apa}</p>
        </div>
      </div>
    </section>
  </main>

  <!-- Minimalist Clean Footer (horwitz.ai/probex inspired) -->
  <footer class="project-footer">
    <div class="container container-reading">
      <div class="footer-brand">
        <img src="/images/logo/saail-crest.png" alt="SAAIL Lab Crest" width="24" height="24" />
        {isPriorWork ? (
          <span>
            Prior institutional publication by <a href="https://inyalala.github.io" target="_blank" rel="noopener">Dr. Innocent Nyalala</a> ({pub.year}, prior to joining IIT Madras Zanzibar)
          </span>
        ) : (
          <span>
            <a href="/">SAAIL Lab</a> · Indian Institute of Technology Madras Zanzibar &amp; WSDSAI IIT Madras
          </span>
        )}
      </div>
      <p class="template-credit">
        This page was adapted from the <a href="https://github.com/eliahuhorwitz/Academic-project-page-template" target="_blank" rel="noopener">Academic Project Page Template</a> and is licensed under a <a href="http://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="license noopener">Creative Commons Attribution-ShareAlike 4.0 International License</a>.
      </p>
      <div class="footer-links">
        <a href="/">SAAIL Lab Home</a>
        <span>·</span>
        <a href="/publications">Publications</a>
        <span>·</span>
        <a href="/projects">Projects</a>
        <span>·</span>
        <a href="https://github.com/saaillab" target="_blank" rel="noopener">GitHub</a>
      </div>
    </div>
  </footer>

  <!-- Lightbox Modal for Full-Resolution Figure Inspection -->
  <div id="imgLightbox" class="img-lightbox" hidden role="dialog" aria-modal="true" aria-label="Enlarged figure preview">
    <button id="closeLightbox" type="button" class="lightbox-close" aria-label="Close enlarged view">&times;</button>
    <img id="lightboxImg" src="" alt="" />
  </div>

  <script is:inline>
    (function () {
      const btn = document.getElementById('moreWorksBtn');
      const dropdown = document.getElementById('moreWorksDropdown');
      const closeBtn = document.getElementById('closeMoreWorks');
      const chevron = document.getElementById('moreWorksChevron');

      function setOpen(open) {
        if (!btn || !dropdown) return;
        dropdown.hidden = !open;
        btn.setAttribute('aria-expanded', String(open));
        if (chevron) {
          chevron.style.transform = open ? 'rotate(180deg)' : 'rotate(0deg)';
        }
      }

      if (btn && dropdown) {
        btn.addEventListener('click', function (e) {
          e.stopPropagation();
          setOpen(dropdown.hidden);
        });
        if (closeBtn) {
          closeBtn.addEventListener('click', function () { setOpen(false); });
        }
        document.addEventListener('click', function (e) {
          if (!dropdown.hidden && !dropdown.contains(e.target) && !btn.contains(e.target)) {
            setOpen(false);
          }
        });
      }

      const lightbox = document.getElementById('imgLightbox');
      const lightboxImg = document.getElementById('lightboxImg');
      const closeLightbox = document.getElementById('closeLightbox');
      document.querySelectorAll('.zoomable-img').forEach(function (imgEl) {
        imgEl.title = 'Click to view full size';
        imgEl.addEventListener('click', function () {
          if (!lightbox || !lightboxImg) return;
          lightboxImg.src = imgEl.src;
          lightboxImg.alt = imgEl.alt || 'Figure';
          lightbox.hidden = false;
        });
      });
      if (closeLightbox && lightbox) {
        closeLightbox.addEventListener('click', function () { lightbox.hidden = true; });
        lightbox.addEventListener('click', function (e) {
          if (e.target === lightbox) lightbox.hidden = true;
        });
      }

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
          if (dropdown && !dropdown.hidden) setOpen(false);
          if (lightbox && !lightbox.hidden) lightbox.hidden = true;
        }
      });

      function attachCopy(btnId) {
        const copyBtn = document.getElementById(btnId);
        if (!copyBtn) return;
        const originalHtml = copyBtn.innerHTML;
        copyBtn.addEventListener('click', async function () {
          const targetId = copyBtn.getAttribute('data-copy-target');
          const el = targetId ? document.getElementById(targetId) : null;
          const text = el ? (el.textContent || '').trim() : '';
          if (!text) return;
          try {
            await navigator.clipboard.writeText(text);
            copyBtn.classList.add('copied');
            copyBtn.innerHTML = '<span>&#10003; Copied</span>';
            setTimeout(function () {
              copyBtn.classList.remove('copied');
              copyBtn.innerHTML = originalHtml;
            }, 1800);
          } catch (_err) {
            const area = document.createElement('textarea');
            area.value = text;
            document.body.appendChild(area);
            area.select();
            document.execCommand('copy');
            document.body.removeChild(area);
          }
        });
      }
      attachCopy('copyBibBtn');
      attachCopy('copyApaBtn');
    })();
  </script>

  <style>
    :root {
      --bg-page: #ffffff;
      --bg-band: #f7f7f2;
      --bg-card: #ffffff;
      --text-main: #0c1a12;
      --text-secondary: #2b3a32;
      --text-muted: #5a6b61;
      --border-light: #e2e6e0;
      --accent-primary: #14532d;
      --accent-hover: #0f3f22;
      --accent-gold: #b45309;
      --btn-dark: #132219;
      --shadow-sm: 0 2px 8px rgba(12, 26, 18, 0.05);
      --shadow-md: 0 10px 28px rgba(12, 26, 18, 0.08);
      --shadow-lg: 0 18px 42px rgba(12, 26, 18, 0.14);
    }

    *, *::before, *::after { box-sizing: border-box; }
    html { scroll-behavior: smooth; }

    body {
      margin: 0;
      padding: 0;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: var(--bg-page);
      color: var(--text-main);
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
    }

    a { color: var(--accent-primary); text-decoration: none; }
    a:hover { text-decoration: underline; }

    .container {
      width: 100%;
      max-width: 1020px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }
    .container-narrow { max-width: 920px; }
    .container-reading { max-width: 820px; }

    /* Floating Controls */
    .floating-back-btn {
      position: fixed;
      top: 1rem;
      left: 1rem;
      z-index: 60;
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      padding: 0.42rem 0.9rem 0.42rem 0.55rem;
      background: rgba(255, 255, 255, 0.96);
      color: var(--text-main);
      border: 1px solid var(--border-light);
      border-radius: 999px;
      font-size: 0.85rem;
      font-weight: 700;
      box-shadow: var(--shadow-sm);
      backdrop-filter: blur(8px);
      text-decoration: none;
      transition: all 0.2s ease;
    }
    .floating-crest {
      display: block;
      border-radius: 50%;
      object-fit: contain;
    }
    .floating-back-btn:hover {
      background: #ffffff;
      border-color: var(--accent-primary);
      color: var(--accent-primary);
      text-decoration: none;
      transform: translateY(-1px);
    }

    .more-works-container {
      position: fixed;
      top: 1rem;
      right: 1rem;
      z-index: 60;
    }

    .more-works-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      padding: 0.52rem 1rem;
      background: rgba(255, 255, 255, 0.96);
      color: var(--text-main);
      border: 1px solid var(--border-light);
      border-radius: 999px;
      font-family: inherit;
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      box-shadow: var(--shadow-sm);
      backdrop-filter: blur(8px);
      transition: all 0.2s ease;
    }
    .more-works-btn:hover {
      border-color: var(--accent-primary);
      color: var(--accent-primary);
      box-shadow: var(--shadow-md);
    }

    .more-works-dropdown {
      position: absolute;
      top: calc(100% + 0.55rem);
      right: 0;
      width: 340px;
      max-width: calc(100vw - 2rem);
      background: #ffffff;
      border: 1px solid var(--border-light);
      border-radius: 14px;
      box-shadow: var(--shadow-lg);
      overflow: hidden;
    }

    .dropdown-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.8rem 1rem;
      font-size: 0.82rem;
      font-weight: 700;
      color: var(--text-main);
      border-bottom: 1px solid var(--border-light);
      background: var(--bg-band);
    }

    .close-dropdown {
      border: none;
      background: transparent;
      color: var(--text-muted);
      font-size: 1.2rem;
      line-height: 1;
      cursor: pointer;
    }

    .dropdown-list {
      max-height: 360px;
      overflow-y: auto;
      padding: 0.4rem;
    }

    .dropdown-item {
      display: block;
      padding: 0.65rem 0.75rem;
      border-radius: 10px;
      color: var(--text-main);
      text-decoration: none;
      transition: background 0.15s ease;
    }
    .dropdown-item:hover {
      background: #ecfdf5;
      text-decoration: none;
    }
    .dropdown-item-title {
      font-size: 0.86rem;
      font-weight: 600;
      color: var(--text-main);
      line-height: 1.35;
    }
    .dropdown-item-meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 0.25rem;
      font-size: 0.75rem;
      color: var(--accent-primary);
    }

    .dropdown-footer-link {
      display: block;
      text-align: center;
      padding: 0.7rem 1rem;
      font-size: 0.8rem;
      font-weight: 600;
      background: var(--bg-band);
      border-top: 1px solid var(--border-light);
      color: var(--accent-primary);
    }

    /* Hero */
    .hero-section {
      padding: 5.25rem 0 2rem;
      text-align: center;
    }

    .hero-badges {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.5rem;
      margin-bottom: 1.2rem;
    }

    .venue-badge, .award-badge, .metric-pill, .status-pill, .prior-badge {
      display: inline-block;
      padding: 0.26rem 0.78rem;
      border-radius: 999px;
      font-size: 0.78rem;
      font-weight: 600;
    }
    .venue-badge {
      background: #ecfdf5;
      color: #14532d;
      border: 1px solid #bbf7d0;
    }
    .award-badge {
      background: #fef3c7;
      color: #92400e;
      border: 1px solid #fde68a;
    }
    .metric-pill {
      background: #f4f4ef;
      color: #1c2d23;
      border: 1px solid #d7dcd5;
    }
    .status-pill {
      background: #f8faf8;
      color: #4b5c52;
      border: 1px solid var(--border-light);
    }
    .prior-badge {
      background: #f1f5f9;
      color: #334155;
      border: 1px solid #cbd5e1;
    }

    .publication-title {
      font-size: clamp(1.65rem, 3.1vw, 2.55rem);
      font-weight: 800;
      line-height: 1.22;
      letter-spacing: -0.02em;
      color: var(--text-main);
      margin: 0 auto 1.35rem;
      max-width: 920px;
    }

    .publication-authors {
      font-size: 1.12rem;
      line-height: 1.75;
      margin-bottom: 0.75rem;
      color: var(--text-secondary);
    }
    .publication-authors a {
      color: var(--accent-primary);
      font-weight: 600;
    }
    .publication-authors sup {
      font-size: 0.72em;
      color: var(--text-muted);
      margin-left: 1px;
    }

    /* Affiliations: each affiliation strictly on its own dedicated line */
    .publication-affiliations {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.25rem;
      font-size: 0.93rem;
      color: var(--text-secondary);
      max-width: 820px;
      margin: 0 auto 0.75rem;
    }
    .affiliation-line {
      line-height: 1.45;
    }
    .affiliation-line sup {
      margin-right: 4px;
      font-weight: 700;
      color: var(--accent-primary);
    }

    .publication-venue-full {
      font-size: 0.98rem;
      font-weight: 600;
      color: var(--text-main);
      margin-bottom: 1.65rem;
    }
    .equal-note {
      font-weight: 400;
      font-size: 0.85rem;
      color: var(--text-muted);
      font-style: italic;
    }

    .action-buttons {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.65rem;
    }
    .action-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      padding: 0.6rem 1.25rem;
      background: var(--btn-dark);
      color: #ffffff;
      border-radius: 999px;
      font-size: 0.9rem;
      font-weight: 600;
      text-decoration: none;
      transition: transform 0.16s ease, background 0.16s ease, box-shadow 0.16s ease;
    }
    .action-btn:hover {
      background: var(--accent-primary);
      color: #ffffff;
      text-decoration: none;
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
    }

    /* Teaser */
    .teaser-section {
      padding: 1.25rem 0 3.25rem;
    }
    .teaser-figure {
      margin: 0 0 1.25rem;
      background: #ffffff;
      border: 1px solid var(--border-light);
      border-radius: 14px;
      padding: 0.9rem;
      box-shadow: var(--shadow-sm);
    }
    .teaser-img {
      display: block;
      width: 100%;
      max-height: 520px;
      object-fit: contain;
      border-radius: 8px;
      margin: 0 auto;
    }
    .zoomable-img {
      cursor: zoom-in;
    }
    .tldr-block {
      font-size: 1.03rem;
      line-height: 1.72;
      color: var(--text-secondary);
      text-align: left;
    }
    .tldr-standalone {
      background: var(--bg-band);
      border: 1px solid var(--border-light);
      border-left: 4px solid var(--accent-primary);
      padding: 1.25rem 1.5rem;
      border-radius: 12px;
    }
    .tldr-block p { margin: 0; }

    /* Bands */
    .band-section { padding: 3.5rem 0; }
    .band-light { background: var(--bg-band); border-top: 1px solid #ebece6; border-bottom: 1px solid #ebece6; }

    .section-heading {
      font-size: 1.85rem;
      font-weight: 800;
      text-align: center;
      color: var(--text-main);
      margin: 0 0 2rem;
      position: relative;
      letter-spacing: -0.015em;
    }
    .section-heading::after {
      content: '';
      display: block;
      width: 48px;
      height: 3px;
      margin: 0.65rem auto 0;
      border-radius: 2px;
      background: var(--accent-primary);
    }

    .abstract-text {
      font-size: 1.04rem;
      line-height: 1.82;
      color: var(--text-secondary);
      text-align: justify;
    }
    .abstract-text p { margin: 0 0 1rem; }

    .keywords-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.45rem;
      margin-top: 1.5rem;
      padding-top: 1.25rem;
      border-top: 1px solid var(--border-light);
    }
    .keywords-label {
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--text-main);
      margin-right: 0.25rem;
    }
    .keyword-chip {
      padding: 0.25rem 0.65rem;
      background: #ffffff;
      border: 1px solid var(--border-light);
      border-radius: 6px;
      font-size: 0.8rem;
      color: var(--text-secondary);
    }

    /* Highlights & Contributions */
    .highlights-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(175px, 1fr));
      gap: 1rem;
      margin-bottom: 2rem;
    }
    .highlight-card {
      background: var(--bg-band);
      border: 1px solid var(--border-light);
      border-radius: 12px;
      padding: 1.2rem 1rem;
      text-align: center;
    }
    .highlight-value {
      font-size: 1.45rem;
      font-weight: 800;
      color: var(--accent-primary);
      line-height: 1.2;
      margin-bottom: 0.3rem;
      font-variant-numeric: tabular-nums;
    }
    .highlight-label {
      font-size: 0.86rem;
      font-weight: 700;
      color: var(--text-main);
    }
    .highlight-sub {
      font-size: 0.76rem;
      color: var(--text-muted);
      margin-top: 0.2rem;
    }

    .contributions-list {
      margin: 0;
      padding-left: 1.35rem;
      color: var(--text-secondary);
      font-size: 1rem;
      line-height: 1.72;
    }
    .contributions-list li {
      margin-bottom: 0.75rem;
    }

    /* Single Clean Empirical Figure */
    .single-result-figure {
      margin: 0;
      background: #ffffff;
      border: 1px solid var(--border-light);
      border-radius: 14px;
      padding: 1.15rem;
      box-shadow: var(--shadow-sm);
    }
    .single-img-frame {
      text-align: center;
      background: #ffffff;
      border-radius: 8px;
      overflow: hidden;
    }
    .single-img-frame img {
      max-width: 100%;
      max-height: 520px;
      width: auto;
      height: auto;
      object-fit: contain;
      display: block;
      margin: 0 auto;
    }
    .single-caption {
      margin-top: 1rem;
      padding: 0.85rem 1rem;
      background: var(--bg-band);
      border-radius: 10px;
      font-size: 0.94rem;
      color: var(--text-secondary);
      line-height: 1.6;
    }

    /* Tables */
    .table-block {
      margin-bottom: 2.25rem;
    }
    .table-block:last-child { margin-bottom: 0; }
    .table-title {
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--text-main);
      margin: 0 0 0.3rem;
    }
    .table-caption {
      font-size: 0.88rem;
      color: var(--text-muted);
      margin: 0 0 0.75rem;
    }
    .table-scroll {
      overflow-x: auto;
      border: 1px solid var(--border-light);
      border-radius: 12px;
      background: #ffffff;
    }
    .academic-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.9rem;
      font-variant-numeric: tabular-nums;
    }
    .academic-table th {
      background: var(--bg-band);
      color: var(--text-main);
      font-weight: 700;
      text-align: left;
      padding: 0.75rem 0.95rem;
      border-bottom: 2px solid var(--border-light);
      white-space: nowrap;
    }
    .academic-table td {
      padding: 0.7rem 0.95rem;
      border-bottom: 1px solid #eef1ec;
      color: var(--text-secondary);
      white-space: nowrap;
    }
    .academic-table tbody tr:last-child td { border-bottom: none; }
    .academic-table tbody tr:hover { background: #f8faf8; }
    .academic-table .cell-lead { font-weight: 600; color: var(--text-main); }

    /* BibTeX */
    .bibtex-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 0.85rem;
    }
    .bibtex-header h2 {
      margin: 0;
      font-size: 1.55rem;
      font-weight: 800;
      color: var(--text-main);
    }
    .copy-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.45rem 0.95rem;
      background: var(--accent-primary);
      color: #ffffff;
      border: none;
      border-radius: 8px;
      font-family: inherit;
      font-size: 0.84rem;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.16s ease;
    }
    .copy-btn:hover { background: var(--accent-hover); }
    .copy-btn.copied { background: var(--accent-gold); }
    .copy-btn-subtle {
      background: #e5e8e2;
      color: var(--text-main);
      padding: 0.3rem 0.75rem;
      font-size: 0.78rem;
    }
    .copy-btn-subtle:hover { background: #d5dad1; }

    .bibtex-pre {
      margin: 0 0 1.25rem;
      padding: 1.25rem;
      background: #ffffff;
      border: 1px solid var(--border-light);
      border-radius: 12px;
      overflow-x: auto;
      font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.84rem;
      line-height: 1.6;
      color: var(--text-main);
    }

    .apa-box {
      background: #ffffff;
      border: 1px solid var(--border-light);
      border-radius: 12px;
      padding: 1rem 1.25rem;
    }
    .apa-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 0.4rem;
    }
    .apa-label {
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--text-muted);
    }
    .apa-text {
      margin: 0;
      font-size: 0.92rem;
      color: var(--text-secondary);
      line-height: 1.6;
    }

    /* Footer */
    .project-footer {
      padding: 2.5rem 0 2.75rem;
      text-align: center;
      font-size: 0.86rem;
      color: var(--text-muted);
      border-top: 1px solid var(--border-light);
      background: #ffffff;
    }
    .footer-brand {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.55rem;
      margin-bottom: 0.65rem;
      font-weight: 600;
      color: var(--text-main);
    }
    .footer-brand img {
      border-radius: 50%;
    }
    .template-credit {
      max-width: 680px;
      margin: 0 auto 0.85rem;
      line-height: 1.55;
      font-size: 0.8rem;
    }
    .footer-links {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.6rem;
      font-weight: 600;
      font-size: 0.84rem;
    }

    /* Lightbox */
    .img-lightbox {
      position: fixed;
      inset: 0;
      z-index: 100;
      background: rgba(9, 19, 13, 0.88);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem;
    }
    .img-lightbox[hidden] { display: none; }
    .img-lightbox img {
      max-width: 94vw;
      max-height: 90vh;
      object-fit: contain;
      border-radius: 8px;
      background: #ffffff;
      padding: 0.4rem;
    }
    .lightbox-close {
      position: fixed;
      top: 1rem;
      right: 1.25rem;
      background: #ffffff;
      color: var(--text-main);
      border: none;
      width: 38px;
      height: 38px;
      border-radius: 999px;
      font-size: 1.45rem;
      line-height: 1;
      cursor: pointer;
    }

    @media (max-width: 768px) {
      .hero-section { padding-top: 4.5rem; }
      .abstract-text { text-align: left; }
      .floating-back-btn span { display: none; }
      .floating-back-btn { padding: 0.42rem; }
    }
  </style>
</body>
</html>
