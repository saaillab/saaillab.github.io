---
import { CROPGUARD_SERIES, getRelatedWorks, type Publication } from '../data/publications';

export interface Props {
  pub: Publication;
}

const { pub } = Astro.props;

const canonicalUrl = `https://saaillab.github.io/papers/${pub.slug}/`;
const relatedWorks = getRelatedWorks(pub.slug, 6);
const cleanDoi = pub.doi
  ? pub.doi.replace(/^https?:\/\/(dx\.)?doi\.org\//i, '').trim()
  : '';
const doiUrl = cleanDoi ? `https://doi.org/${cleanDoi}` : undefined;
const ogImage = pub.teaserImage
  ? `https://saaillab.github.io${pub.teaserImage}`
  : 'https://saaillab.github.io/images/og-saaillab.png';
const hasEqualAuthors = pub.authors.some((a) => a.equal);

const schemaJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  headline: pub.title,
  name: pub.title,
  description: pub.tldr || pub.abstract,
  datePublished: pub.dateISO,
  url: canonicalUrl,
  image: ogImage,
  keywords: pub.keywords.join(', '),
  inLanguage: 'en',
  isAccessibleForFree: true,
  author: pub.authors.map((a) => ({
    '@type': 'Person',
    name: a.name,
    ...(a.url ? { url: a.url } : {})
  })),
  publisher: {
    '@type': 'Organization',
    name: pub.venue
  },
  ...(doiUrl ? { sameAs: doiUrl, identifier: cleanDoi } : {})
});

const breadcrumbJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'SAAIL Lab',
      item: 'https://saaillab.github.io/'
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Publications',
      item: 'https://saaillab.github.io/publications/'
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: pub.shortTitle || pub.title,
      item: canonicalUrl
    }
  ]
});

const allFigures = pub.figures ?? [];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pub.shortTitle ? `${pub.shortTitle} | ` : ''}{pub.title} - SAAIL Lab</title>
  <meta name="description" content={pub.tldr || pub.abstract.slice(0, 160)} />
  <meta name="keywords" content={pub.keywords.join(', ')} />
  <meta name="author" content={pub.authors.map((a) => a.name).join(', ')} />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Highwire Press / Google Scholar Academic Meta Tags -->
  <meta name="citation_title" content={pub.title} />
  {pub.authors.map((author) => (
    <meta name="citation_author" content={author.name} />
  ))}
  <meta name="citation_publication_date" content={pub.dateISO.replace(/-/g, '/')} />
  {pub.category === 'conference' || pub.category === 'workshop' ? (
    <meta name="citation_conference_title" content={pub.venue} />
  ) : (
    <meta name="citation_journal_title" content={pub.venue} />
  )}
  {cleanDoi && <meta name="citation_doi" content={cleanDoi} />}
  {pub.paperUrl && pub.paperUrl.toLowerCase().endsWith('.pdf') && (
    <meta name="citation_pdf_url" content={pub.paperUrl} />
  )}
  <meta name="citation_public_url" content={canonicalUrl} />

  <!-- Open Graph & Social Previews -->
  <meta property="og:type" content="article" />
  <meta property="og:site_name" content="SAAIL Lab · IIT Madras Zanzibar" />
  <meta property="og:title" content={pub.title} />
  <meta property="og:description" content={pub.tldr} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImage} />
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:title" content={pub.shortTitle || pub.title} />
  <meta property="twitter:description" content={pub.tldr} />
  <meta property="twitter:image" content={ogImage} />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-4MEPY7MLVN"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-4MEPY7MLVN');
  </script>

  <!-- Structured Data -->
  <script type="application/ld+json" set:html={schemaJson} />
  <script type="application/ld+json" set:html={breadcrumbJson} />
</head>
<body>
  <!-- Back & Navigation Floating Controls (Inspired by horwitz.ai / Academic Project Page Template) -->
  <a href="/publications" class="floating-back-btn" aria-label="Back to SAAIL Lab Publications">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
      <path d="M19 12H5M12 19l-7-7 7-7"/>
    </svg>
    <span>SAAIL Lab</span>
  </a>

  <div class="more-works-container">
    <button
      id="moreWorksBtn"
      class="more-works-btn"
      type="button"
      aria-expanded="false"
      aria-controls="moreWorksDropdown"
    >
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M9 3h6v2l-1 1v4.5l4.8 7.6A2 2 0 0 1 17.1 21H6.9a2 2 0 0 1-1.7-2.9L10 10.5V6L9 5V3z"/>
      </svg>
      <span>More Works</span>
      <svg id="moreWorksChevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
        <path d="M6 9l6 6 6-6"/>
      </svg>
    </button>

    <div id="moreWorksDropdown" class="more-works-dropdown" role="menu" hidden>
      <div class="dropdown-header">
        <span>More Works from SAAIL Lab</span>
        <button id="closeMoreWorks" type="button" class="close-dropdown" aria-label="Close menu">&times;</button>
      </div>
      <div class="dropdown-list">
        {relatedWorks.map((work) => (
          <a href={`/papers/${work.slug}/`} class="dropdown-item" role="menuitem">
            <div class="dropdown-item-title">{work.shortTitle || work.title}</div>
            <div class="dropdown-item-meta">
              <span>{work.venueShort}</span>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/>
              </svg>
            </div>
          </a>
        ))}
      </div>
      <a href="/publications" class="dropdown-footer-link">Browse all 45+ SAAIL Lab papers &rarr;</a>
    </div>
  </div>

  <!-- CropGuard Series Banner (for CropGuard Series papers) -->
  {pub.seriesId === 'cropguard' && (
    <nav class="series-banner" aria-label="CropGuard Research Series">
      <div class="series-banner-inner">
        <a href="/cropguard/" class="series-hub-link">
          <span class="series-pill-label">CROPGUARD ECOSYSTEM</span>
          <span class="series-hub-name">Papers 1-6 Umbrella Hub &rarr;</span>
        </a>
        <div class="series-steps">
          {CROPGUARD_SERIES.map((item) => {
            const isCurrent = item.slug === pub.slug;
            const href = item.slug ? `/papers/${item.slug}/` : '/cropguard/';
            return (
              <a
                href={href}
                class={`series-step ${isCurrent ? 'is-current' : ''} ${!item.slug ? 'is-upcoming' : ''}`}
                title={item.title}
              >
                P{item.number}: {item.codeName}
              </a>
            );
          })}
        </div>
      </div>
    </nav>
  )}

  <main>
    <!-- Hero Section -->
    <section class="hero-section">
      <div class="container">
        <div class="hero-badges">
          <span class="venue-badge">{pub.venueShort}</span>
          {pub.award && <span class="award-badge">{pub.award}</span>}
          {pub.impactFactor && <span class="metric-pill">{pub.impactFactor}</span>}
          {typeof pub.citations === 'number' && pub.citations > 0 && (
            <span class="metric-pill">{pub.citations}+ Citations</span>
          )}
          <span class="status-pill">{pub.status}</span>
        </div>

        <h1 class="publication-title">{pub.title}</h1>

        <div class="publication-authors">
          {pub.authors.map((author, idx) => (
            <span class="author-block">
              {author.url ? (
                <a href={author.url} target="_blank" rel="noopener">{author.name}</a>
              ) : (
                <span>{author.name}</span>
              )}
              {author.affiliations && author.affiliations.length > 0 && (
                <sup>{author.affiliations.join(',')}</sup>
              )}
              {author.equal && <sup>*</sup>}
              {idx < pub.authors.length - 1 && <span class="author-comma">, </span>}
            </span>
          ))}
        </div>

        <div class="publication-affiliations">
          {pub.affiliations.map((aff, i) => (
            <span class="affiliation-item">
              <sup>{i + 1}</sup>{aff}{i < pub.affiliations.length - 1 ? '  ·  ' : ''}
            </span>
          ))}
        </div>

        <div class="publication-venue-full">
          <span>{pub.venue} ({pub.month} {pub.year})</span>
          {hasEqualAuthors && <span class="equal-note"> · *Indicates Equal Contribution</span>}
        </div>

        <!-- Action Buttons (Classic Academic Template Dark Pill Buttons) -->
        <div class="action-buttons">
          {pub.paperUrl && (
            <a href={pub.paperUrl} target="_blank" rel="noopener" class="action-btn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
                <line x1="16" y1="13" x2="8" y2="13"/>
                <line x1="16" y1="17" x2="8" y2="17"/>
              </svg>
              <span>Paper</span>
            </a>
          )}

          {doiUrl && doiUrl !== pub.paperUrl && (
            <a href={doiUrl} target="_blank" rel="noopener" class="action-btn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/>
                <line x1="2" y1="12" x2="22" y2="12"/>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
              </svg>
              <span>DOI</span>
            </a>
          )}

          {pub.codeUrl && (
            <a href={pub.codeUrl} target="_blank" rel="noopener" class="action-btn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
              </svg>
              <span>Code</span>
            </a>
          )}

          {pub.datasetUrl && (
            <a href={pub.datasetUrl} target="_blank" rel="noopener" class="action-btn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <ellipse cx="12" cy="5" rx="9" ry="3"/>
                <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/>
                <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>
              </svg>
              <span>Dataset / Split</span>
            </a>
          )}

          {pub.posterUrl && (
            <a href={pub.posterUrl} target="_blank" rel="noopener" class="action-btn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="2"/>
                <circle cx="8.5" cy="8.5" r="1.5"/>
                <polyline points="21 15 16 10 5 21"/>
              </svg>
              <span>Poster</span>
            </a>
          )}

          {pub.seriesId === 'cropguard' && (
            <a href="/cropguard/" class="action-btn action-btn-accent">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M12 2L2 7l10 5 10-5-10-5z"/>
                <path d="M2 17l10 5 10-5"/>
                <path d="M2 12l10 5 10-5"/>
              </svg>
              <span>CropGuard Series (1-6)</span>
            </a>
          )}

          <a href="#BibTeX" class="action-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M6 17h3l2-4V7H5v6h3M15 17h3l2-4V7h-6v6h3"/>
            </svg>
            <span>BibTeX</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Teaser Visual + TL;DR Caption -->
    <section class="teaser-section">
      <div class="container container-narrow">
        {pub.teaserImage && (
          <figure class="teaser-figure">
            <img
              src={pub.teaserImage}
              alt={pub.title}
              loading="eager"
              class="teaser-img"
            />
          </figure>
        )}
        <div class={`tldr-block ${pub.teaserImage ? '' : 'tldr-standalone'}`}>
          <p>
            <strong>TL;DR:</strong> {pub.teaserCaption || pub.tldr}
          </p>
        </div>
      </div>
    </section>

    <!-- Abstract Section -->
    <section class="band-section band-light" id="Abstract">
      <div class="container container-reading">
        <h2 class="section-heading">Abstract</h2>
        <div class="abstract-text">
          <p>{pub.abstract}</p>
        </div>
        <div class="keywords-row">
          <span class="keywords-label">Keywords:</span>
          {pub.keywords.map((kw) => (
            <span class="keyword-chip">{kw}</span>
          ))}
        </div>
      </div>
    </section>

    <!-- Highlights & Contributions -->
    {((pub.highlights && pub.highlights.length > 0) || (pub.contributions && pub.contributions.length > 0)) && (
      <section class="band-section">
        <div class="container container-reading">
          <h2 class="section-heading">Key Findings &amp; Contributions</h2>

          {pub.highlights && pub.highlights.length > 0 && (
            <div class="highlights-grid">
              {pub.highlights.map((item) => (
                <div class="highlight-card">
                  <div class="highlight-value">{item.value}</div>
                  <div class="highlight-label">{item.label}</div>
                  {item.sublabel && <div class="highlight-sub">{item.sublabel}</div>}
                </div>
              ))}
            </div>
          )}

          {pub.contributions && pub.contributions.length > 0 && (
            <ol class="contributions-list">
              {pub.contributions.map((c) => (
                <li>{c}</li>
              ))}
            </ol>
          )}
        </div>
      </section>
    )}

    <!-- Interactive Results & Architecture Figure Carousel -->
    {allFigures.length > 0 && (
      <section class="band-section band-light" id="Results">
        <div class="container">
          <h2 class="section-heading">Visual Results &amp; Figures</h2>
          <div class="carousel-wrapper" data-total={allFigures.length}>
            <div class="carousel-viewport">
              {allFigures.map((fig, index) => (
                <figure class={`carousel-slide ${index === 0 ? 'is-active' : ''}`} data-index={index}>
                  <div class="carousel-img-frame">
                    <img src={fig.src} alt={fig.alt || fig.caption} loading={index < 2 ? 'eager' : 'lazy'} />
                  </div>
                  <figcaption class="carousel-caption">
                    <span class="figure-num">Figure {index + 1} of {allFigures.length}.</span> {fig.caption}
                  </figcaption>
                </figure>
              ))}
            </div>

            {allFigures.length > 1 && (
              <div class="carousel-controls">
                <button type="button" id="prevSlideBtn" class="carousel-nav-btn" aria-label="Previous figure">&larr; Previous</button>
                <div class="carousel-dots" id="carouselDots">
                  {allFigures.map((_, index) => (
                    <button
                      type="button"
                      class={`carousel-dot ${index === 0 ? 'is-active' : ''}`}
                      data-slide-to={index}
                      aria-label={`View figure ${index + 1}`}
                    />
                  ))}
                </div>
                <button type="button" id="nextSlideBtn" class="carousel-nav-btn" aria-label="Next figure">Next &rarr;</button>
              </div>
            )}
          </div>
        </div>
      </section>
    )}

    <!-- Quantitative Benchmark Tables -->
    {pub.tables && pub.tables.length > 0 && (
      <section class="band-section" id="Benchmarks">
        <div class="container container-reading">
          <h2 class="section-heading">Benchmark Results</h2>
          {pub.tables.map((tbl) => (
            <div class="table-block">
              <h3 class="table-title">{tbl.title}</h3>
              {tbl.caption && <p class="table-caption">{tbl.caption}</p>}
              <div class="table-scroll">
                <table class="academic-table">
                  <thead>
                    <tr>
                      {tbl.headers.map((h) => <th>{h}</th>)}
                    </tr>
                  </thead>
                  <tbody>
                    {tbl.rows.map((row) => (
                      <tr>
                        {row.map((cell, ci) => (
                          <td class={ci === 0 ? 'cell-lead' : ''}>{cell}</td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- BibTeX Citation Section (Matches horwitz.ai/probex Copy Box) -->
    <section class="band-section band-light" id="BibTeX">
      <div class="container container-reading">
        <div class="bibtex-header">
          <h2>BibTeX</h2>
          <button type="button" id="copyBibBtn" class="copy-btn" data-copy-target="bibtexCode">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
            </svg>
            <span>Copy</span>
          </button>
        </div>
        <pre class="bibtex-pre"><code id="bibtexCode">{pub.bibtex}</code></pre>

        <div class="apa-box">
          <div class="apa-header">
            <span class="apa-label">APA Citation</span>
            <button type="button" id="copyApaBtn" class="copy-btn copy-btn-subtle" data-copy-target="apaText">
              <span>Copy APA</span>
            </button>
          </div>
          <p id="apaText" class="apa-text">{pub.apa}</p>
        </div>
      </div>
    </section>
  </main>

  <footer class="project-footer">
    <div class="container container-reading">
      <p>
        Hosted by <a href="/">SAAIL Lab (Scientific &amp; Applied AI Lab)</a> at
        <a href="https://www.iitmz.ac.in/" target="_blank" rel="noopener">IIT Madras Zanzibar</a> &amp;
        <a href="https://wsai.iitm.ac.in/" target="_blank" rel="noopener">WSDSAI IIT Madras</a>, led by
        <a href="https://inyalala.github.io" target="_blank" rel="noopener">Dr. Innocent Nyalala</a>.
      </p>
      <p class="template-credit">
        Page architecture inspired by the open-source <a href="https://github.com/eliahuhorwitz/Academic-project-page-template" target="_blank" rel="noopener">Academic Project Page Template</a>.
        Licensed under <a href="http://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="license noopener">Creative Commons Attribution-ShareAlike 4.0 International</a>.
      </p>
      <div class="footer-links">
        <a href="/">SAAIL Lab Home</a>
        <span>·</span>
        <a href="/publications">All Publications</a>
        <span>·</span>
        <a href="/cropguard/">CropGuard Ecosystem</a>
        <span>·</span>
        <a href="/github">Open-Source Repositories</a>
        <span>·</span>
        <a href="/contact">Contact</a>
      </div>
    </div>
  </footer>

  <script is:inline>
    // More Works floating dropdown
    (function () {
      const btn = document.getElementById('moreWorksBtn');
      const dropdown = document.getElementById('moreWorksDropdown');
      const closeBtn = document.getElementById('closeMoreWorks');
      const chevron = document.getElementById('moreWorksChevron');

      function setOpen(open) {
        if (!btn || !dropdown) return;
        dropdown.hidden = !open;
        btn.setAttribute('aria-expanded', String(open));
        if (chevron) {
          chevron.style.transform = open ? 'rotate(180deg)' : 'rotate(0deg)';
        }
      }

      if (btn && dropdown) {
        btn.addEventListener('click', function (e) {
          e.stopPropagation();
          setOpen(dropdown.hidden);
        });
        if (closeBtn) {
          closeBtn.addEventListener('click', function () { setOpen(false); });
        }
        document.addEventListener('click', function (e) {
          if (!dropdown.hidden && !dropdown.contains(e.target) && !btn.contains(e.target)) {
            setOpen(false);
          }
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && !dropdown.hidden) setOpen(false);
        });
      }

      // Figure carousel
      const slides = Array.from(document.querySelectorAll('.carousel-slide'));
      const dots = Array.from(document.querySelectorAll('.carousel-dot'));
      const prevBtn = document.getElementById('prevSlideBtn');
      const nextBtn = document.getElementById('nextSlideBtn');
      let current = 0;

      function showSlide(idx) {
        if (slides.length === 0) return;
        current = (idx + slides.length) % slides.length;
        slides.forEach(function (s, i) { s.classList.toggle('is-active', i === current); });
        dots.forEach(function (d, i) { d.classList.toggle('is-active', i === current); });
      }

      if (prevBtn) prevBtn.addEventListener('click', function () { showSlide(current - 1); });
      if (nextBtn) nextBtn.addEventListener('click', function () { showSlide(current + 1); });
      dots.forEach(function (d) {
        d.addEventListener('click', function () {
          const target = parseInt(d.getAttribute('data-slide-to') || '0', 10);
          showSlide(target);
        });
      });

      // Clipboard Copy buttons
      function attachCopy(btnId) {
        const copyBtn = document.getElementById(btnId);
        if (!copyBtn) return;
        const originalHtml = copyBtn.innerHTML;
        copyBtn.addEventListener('click', async function () {
          const targetId = copyBtn.getAttribute('data-copy-target');
          const el = targetId ? document.getElementById(targetId) : null;
          const text = el ? (el.textContent || '').trim() : '';
          if (!text) return;
          try {
            await navigator.clipboard.writeText(text);
            copyBtn.classList.add('copied');
            copyBtn.innerHTML = '<span>&#10003; Copied</span>';
            setTimeout(function () {
              copyBtn.classList.remove('copied');
              copyBtn.innerHTML = originalHtml;
            }, 1800);
          } catch (_err) {
            const area = document.createElement('textarea');
            area.value = text;
            document.body.appendChild(area);
            area.select();
            document.execCommand('copy');
            document.body.removeChild(area);
          }
        });
      }
      attachCopy('copyBibBtn');
      attachCopy('copyApaBtn');
    })();
  </script>

