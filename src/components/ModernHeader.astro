---
import SearchModal from './SearchModal.astro';
export interface Props {
	currentPage?: string;
}
const { currentPage = '' } = Astro.props;
---

<header class="modern-header" data-page={currentPage}>
	<nav class="navbar" aria-label="Main Navigation">
		<div class="container">
			<div class="nav-content">
				<a href="/" class="logo" aria-label="SAAIL Lab Home">
					<img src="/images/logo/saail-crest.png" alt="SAAIL Lab Crest" width="38" height="38" class="logo-crest" />
					<div class="logo-text">
						<span class="logo-title">SAAIL Lab</span>
						<span class="logo-sub">IIT Madras Zanzibar</span>
					</div>
				</a>

				<div class="nav-menu">
					<div class="nav-item">
						<a href="/" data-i18n="nav.home" class:list={['nav-link', { active: currentPage === 'home' }]}>Home</a>
					</div>

					<div class="nav-item dropdown">
						<a href="/research/" class:list={['nav-link', { active: currentPage === 'research' }]} aria-haspopup="true" aria-expanded="false">
							<span data-i18n="nav.research">Research</span>
							<svg class="dropdown-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
								<path d="M6 9l6 6 6-6"/>
							</svg>
						</a>
						<div class="dropdown-menu">
							<a href="/research/" data-i18n="nav.research_pillars" class="dropdown-link">Research Pillars</a>
							<a href="/projects/" data-i18n="nav.projects" class="dropdown-link">Active Projects &amp; Grants</a>
							<a href="/collaborations/" data-i18n="nav.collaborations" class="dropdown-link">Global Collaborations</a>
						</div>
					</div>

					<div class="nav-item">
						<a href="/publications/" data-i18n="nav.publications" class:list={['nav-link', { active: currentPage === 'publications' }]}>Publications</a>
					</div>

					<div class="nav-item">
						<a href="/people/" data-i18n="nav.people" class:list={['nav-link', { active: currentPage === 'people' }]}>People</a>
					</div>

					<div class="nav-item dropdown">
						<a href="/resources/" class:list={['nav-link', { active: currentPage === 'resources' || currentPage === 'gallery' || currentPage === 'news' }]} aria-haspopup="true" aria-expanded="false">
							<span data-i18n="nav.resources">Resources</span>
							<svg class="dropdown-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
								<path d="M6 9l6 6 6-6"/>
							</svg>
						</a>
						<div class="dropdown-menu">
							<a href="/datasets/" data-i18n="nav.datasets" class="dropdown-link">Datasets &amp; Benchmarks</a>
							<a href="/tools/" data-i18n="nav.tools" class="dropdown-link">Mobile Apps &amp; Software</a>
							<a href="/annual-report/" data-i18n="nav.annual_report" class="dropdown-link">Annual Impact Report</a>
							<a href="/news/" data-i18n="nav.news" class="dropdown-link">News &amp; Milestones</a>
							<a href="/github/" data-i18n="nav.github" class="dropdown-link">Open-Source GitHub</a>
							<a href="/gallery/" data-i18n="nav.gallery" class="dropdown-link">Gallery &amp; Posters</a>
						</div>
					</div>

					<div class="nav-item">
						<a href="/hiring/" data-i18n="nav.join" class:list={['nav-link', { active: currentPage === 'hiring' }]}>Join Us</a>
					</div>

					<div class="nav-item">
						<a href="/contact/" data-i18n="nav.contact" class:list={['nav-link', { active: currentPage === 'contact' }]}>Contact</a>
					</div>
				</div>

				<div class="nav-actions">
					<button id="langToggle" class="lang-toggle" type="button" aria-label="Switch language to Kiswahili" aria-pressed="false" title="Toggle English / Kiswahili">SW</button>
					<button id="siteSearchBtn" class="search-trigger" type="button" aria-label="Search SAAIL Lab site (Ctrl K)" aria-haspopup="dialog" aria-controls="saailSearchModal">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<circle cx="11" cy="11" r="8"></circle>
							<path d="M21 21l-4.35-4.35"></path>
						</svg>
						<span class="search-trigger-label" data-i18n="nav.search">Search</span>
						<kbd class="search-trigger-kbd">Ctrl K</kbd>
					</button>

					<button id="themeToggle" class="theme-toggle" aria-label="Toggle color theme" aria-pressed="false" type="button">
						<svg class="sun-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<circle cx="12" cy="12" r="5"></circle>
							<path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
						</svg>
						<svg class="moon-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
						</svg>
					</button>

					<button class="mobile-menu-btn" id="mobileMenuBtn" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobileMenu">
						<span></span>
						<span></span>
						<span></span>
					</button>
				</div>
			</div>

			<div class="mobile-menu" id="mobileMenu">
				<a href="/" data-i18n="nav.home" class="mobile-link">Home</a>
				<a href="/research/" data-i18n="nav.research_pillars" class="mobile-link">Research Pillars</a>
				<a href="/projects/" data-i18n="nav.projects" class="mobile-link">Active Projects &amp; Grants</a>
				<a href="/publications/" data-i18n="nav.publications" class="mobile-link">Publications</a>
				<a href="/people/" data-i18n="nav.people" class="mobile-link">People</a>
				<a href="/datasets/" data-i18n="nav.datasets" class="mobile-link">Datasets &amp; Benchmarks</a>
				<a href="/tools/" data-i18n="nav.tools" class="mobile-link">Mobile Apps &amp; Software</a>
				<a href="/annual-report/" data-i18n="nav.annual_report" class="mobile-link">Annual Impact Report</a>
				<a href="/gallery/" data-i18n="nav.gallery" class="mobile-link">Gallery &amp; Posters</a>
				<a href="/news/" data-i18n="nav.news" class="mobile-link">News &amp; Milestones</a>
				<a href="/github/" data-i18n="nav.github" class="mobile-link">GitHub</a>
				<a href="/collaborations/" data-i18n="nav.collaborations" class="mobile-link">Collaborations</a>
				<a href="/resources/" data-i18n="nav.resources" class="mobile-link">Resources</a>
				<a href="/hiring/" data-i18n="nav.join" class="mobile-link">Join Us</a>
				<a href="/contact/" data-i18n="nav.contact" class="mobile-link">Contact</a>
			</div>
		</div>
	</nav>
</header>

<SearchModal />

<style>
	.modern-header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		width: 100%;
		height: var(--header-height, 74px);
		z-index: 1000;
		background: rgba(255, 255, 255, 0.92);
		backdrop-filter: blur(18px);
		-webkit-backdrop-filter: blur(18px);
		border-bottom: 1px solid var(--border-color);
	}

	:global([data-theme="dark"]) .modern-header {
		background: rgba(8, 18, 12, 0.92);
	}

	.navbar {
		height: 100%;
		display: flex;
		align-items: center;
	}

	.nav-content {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1.5rem;
		width: 100%;
	}

	.logo {
		display: inline-flex;
		align-items: center;
		gap: 0.7rem;
		text-decoration: none;
		color: var(--text-primary);
		flex-shrink: 0;
	}

	.logo-crest {
		width: 38px;
		height: 38px;
		border-radius: 999px;
		object-fit: contain;
		border: 1px solid var(--border-color);
		background: #ffffff;
		padding: 2px;
	}

	.logo-text {
		display: flex;
		flex-direction: column;
		line-height: 1.15;
	}

	.logo-title {
		font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
		font-size: 1.12rem;
		font-weight: 800;
		color: var(--text-primary);
		letter-spacing: -0.02em;
	}

	.logo-sub {
		font-size: 0.72rem;
		font-weight: 600;
		color: var(--accent-primary);
		letter-spacing: 0.01em;
	}

	.nav-menu {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}

	.nav-item {
		position: relative;
	}

	.nav-link {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		color: var(--text-secondary);
		text-decoration: none;
		font-size: 0.9rem;
		font-weight: 600;
		padding: 0.45rem 0.78rem;
		border-radius: 999px;
		transition: color 0.16s ease, background 0.16s ease;
		white-space: nowrap;
	}

	.nav-link:hover,
	.nav-link.active {
		color: var(--accent-primary);
		background: rgba(20, 83, 45, 0.08);
	}

	:global([data-theme="dark"]) .nav-link:hover,
	:global([data-theme="dark"]) .nav-link.active {
		background: rgba(34, 197, 94, 0.12);
	}

	.dropdown-chevron {
		transition: transform 0.2s ease;
	}

	.dropdown:hover .dropdown-chevron {
		transform: rotate(180deg);
	}

	.dropdown-menu {
		position: absolute;
		top: calc(100% + 0.5rem);
		left: 0;
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		border-radius: 0.85rem;
		padding: 0.45rem;
		min-width: 230px;
		box-shadow: 0 14px 34px var(--shadow-medium);
		opacity: 0;
		visibility: hidden;
		transform: translateY(-6px);
		transition: all 0.18s ease;
		z-index: 1002;
	}

	.dropdown:not(.is-dismissed):hover .dropdown-menu,
	.dropdown:not(.is-dismissed):focus-within .dropdown-menu {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}

	.dropdown.is-dismissed .dropdown-menu {
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
	}

	.dropdown-link {
		display: block;
		padding: 0.55rem 0.85rem;
		color: var(--text-secondary);
		text-decoration: none;
		font-size: 0.88rem;
		font-weight: 500;
		border-radius: 0.5rem;
		transition: background 0.15s ease, color 0.15s ease;
	}

	.dropdown-link:hover,
	.dropdown-link.active {
		background: var(--bg-secondary);
		color: var(--accent-primary);
		font-weight: 700;
	}
	:global([data-theme="dark"]) .dropdown-link:hover,
	:global([data-theme="dark"]) .dropdown-link.active {
		background: var(--bg-tertiary);
	}

	.nav-actions {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		flex-shrink: 0;
	}

	.search-trigger {
		display: inline-flex;
		align-items: center;
		gap: 0.42rem;
		min-height: 44px;
		padding: 0 0.82rem;
		border-radius: 999px;
		border: 1px solid var(--border-color);
		background: var(--bg-secondary);
		color: var(--text-secondary);
		font-family: inherit;
		font-size: 0.82rem;
		font-weight: 600;
		cursor: pointer;
		transition: all 0.18s ease;
	}
	.search-trigger:hover,
	.lang-toggle:hover {
		border-color: var(--accent-primary);
		color: var(--accent-primary);
	}
	.lang-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 44px;
		min-width: 44px;
		padding: 0 0.6rem;
		border-radius: 999px;
		border: 1px solid var(--border-color);
		background: var(--bg-secondary);
		color: var(--text-primary);
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.76rem;
		font-weight: 700;
		cursor: pointer;
		transition: all 0.18s ease;
	}
	.lang-toggle[aria-pressed="true"] {
		background: var(--accent-primary);
		border-color: var(--accent-primary);
		color: #ffffff;
	}
	:global([data-theme="dark"]) .lang-toggle[aria-pressed="true"] {
		color: #062111;
	}
	.search-trigger-kbd {
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.68rem;
		padding: 0.08rem 0.35rem;
		border-radius: 4px;
		border: 1px solid var(--border-color);
		background: var(--bg-card);
		color: var(--text-muted);
	}
	@media (max-width: 1120px) {
		.search-trigger-label, .search-trigger-kbd { display: none; }
		.search-trigger { width: 44px; min-width: 44px; height: 44px; padding: 0; justify-content: center; }
	}

	.theme-toggle {
		width: 44px;
		height: 44px;
		border-radius: 999px;
		border: 1px solid var(--border-color);
		background: var(--bg-secondary);
		color: var(--text-secondary);
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		transition: all 0.18s ease;
	}

	.theme-toggle:hover {
		border-color: var(--accent-primary);
		color: var(--accent-primary);
	}

	:global([data-theme="dark"]) .sun-icon { display: block; }
	:global([data-theme="dark"]) .moon-icon { display: none; }
	.sun-icon { display: none; }
	.moon-icon { display: block; }

	.mobile-menu-btn {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 4px;
		width: 44px;
		height: 44px;
		background: var(--bg-secondary);
		border: 1px solid var(--border-color);
		border-radius: 10px;
		cursor: pointer;
		padding: 0 9px;
	}

	.mobile-menu-btn span {
		display: block;
		width: 100%;
		height: 2px;
		background: var(--text-primary);
		border-radius: 2px;
	}

	.mobile-menu {
		display: none;
		position: fixed;
		top: var(--header-height, 74px);
		left: 0;
		right: 0;
		background: var(--bg-card);
		border-bottom: 1px solid var(--border-color);
		padding: 0.85rem 1.25rem 1.25rem;
		box-shadow: 0 18px 36px var(--shadow-medium);
		max-height: calc(100vh - var(--header-height, 74px));
		overflow-y: auto;
	}

	.mobile-link {
		display: flex;
		align-items: center;
		min-height: 44px;
		padding: 0.5rem 0.8rem;
		color: var(--text-secondary);
		text-decoration: none;
		font-size: 0.9rem;
		font-weight: 600;
		border-radius: 0.5rem;
		transition: background 0.15s ease, color 0.15s ease;
	}

	.mobile-link:hover,
	.mobile-link.active {
		background: var(--bg-secondary);
		color: var(--accent-primary);
		font-weight: 700;
	}

	:global([data-theme="dark"]) .mobile-link:hover,
	:global([data-theme="dark"]) .mobile-link.active {
		background: var(--bg-tertiary);
	}

	@media (max-width: 1024px) {
		.nav-menu { display: none; }
		.mobile-menu-btn { display: flex; }
		.mobile-menu.active {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 0.4rem;
		}
	}

	@media (min-width: 1025px) {
		.mobile-menu.active { display: none; }
	}
	@media (max-width: 480px) {
		.navbar .container { padding: 0 0.75rem; }
		.logo { gap: 0.4rem; }
		.logo-sub { display: none; }
		.logo-title { font-size: 0.9rem; }
		.logo-crest { width: 30px; height: 30px; }
		.nav-content { gap: 0.35rem; }
		.nav-actions { gap: 0.25rem; }
	}
</style>

<script>
	document.addEventListener('DOMContentLoaded', function() {
		const mobileMenuBtn = document.getElementById('mobileMenuBtn');
		const mobileMenu = document.getElementById('mobileMenu');
		const themeToggle = document.getElementById('themeToggle');

		function setMobileDrawerState(open: boolean, restoreFocus = false) {
			if (!mobileMenu || !mobileMenuBtn) return;
			mobileMenu.classList.toggle('active', open);
			mobileMenuBtn.setAttribute('aria-expanded', String(open));
			document.querySelectorAll('main, footer').forEach((el) => {
				(el as HTMLElement).inert = open;
			});
			if (open) {
				const firstLink = mobileMenu.querySelector('.mobile-link') as HTMLElement | null;
				requestAnimationFrame(() => firstLink?.focus());
			} else if (restoreFocus) {
				mobileMenuBtn.focus();
			}
		}

		const currentPath = window.location.pathname.replace(/\/$/, '') || '/';
		document.querySelectorAll('.nav-link, .dropdown-link, .mobile-link').forEach((link) => {
			const href = (link.getAttribute('href') || '').replace(/\/$/, '') || '/';
			if (href === currentPath) {
				link.classList.add('active');
				link.setAttribute('aria-current', 'page');
			}
		});

		document.querySelectorAll('.nav-item.dropdown').forEach((dropdown) => {
			const trigger = dropdown.querySelector('.nav-link');
			const syncExpanded = (open: boolean) => trigger?.setAttribute('aria-expanded', String(open));
			dropdown.addEventListener('mouseenter', () => {
				dropdown.classList.remove('is-dismissed');
				syncExpanded(true);
			});
			dropdown.addEventListener('mouseleave', () => {
				dropdown.classList.remove('is-dismissed');
				syncExpanded(false);
			});
			dropdown.addEventListener('focusin', () => {
				if (!dropdown.classList.contains('is-dismissed')) syncExpanded(true);
			});
			dropdown.addEventListener('focusout', (e) => {
				const fe = e as FocusEvent;
				if (!dropdown.contains(fe.relatedTarget as Node | null)) {
					dropdown.classList.remove('is-dismissed');
					syncExpanded(false);
				}
			});
		});

		const desktopMq = window.matchMedia('(min-width: 1025px)');
		desktopMq.addEventListener('change', (e) => {
			if (e.matches && mobileMenu?.classList.contains('active')) {
				setMobileDrawerState(false);
			}
		});

		mobileMenuBtn?.addEventListener('click', function(e) {
			e.stopPropagation();
			const nextOpen = !mobileMenu?.classList.contains('active');
			setMobileDrawerState(nextOpen);
		});

		const syncThemePressed = () => {
			const isDark = (document.documentElement.getAttribute('data-theme') || 'light') === 'dark';
			themeToggle?.setAttribute('aria-pressed', String(isDark));
		};
		syncThemePressed();

		themeToggle?.addEventListener('click', function() {
			const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
			const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
			document.documentElement.setAttribute('data-theme', newTheme);
			localStorage.setItem('theme', newTheme);
			syncThemePressed();
		});

		document.addEventListener('click', function(e) {
			if (mobileMenu?.classList.contains('active') && !mobileMenu.contains(e.target as Node) && !mobileMenuBtn?.contains(e.target as Node)) {
				setMobileDrawerState(false);
			}
		});

		document.addEventListener('keydown', function(e) {
			if (e.key === 'Tab' && mobileMenu?.classList.contains('active')) {
				const links = Array.from(mobileMenu.querySelectorAll('a[href]')) as HTMLElement[];
				const focusables = mobileMenuBtn ? [mobileMenuBtn, ...links] : links;
				if (focusables.length > 0) {
					const first = focusables[0];
					const last = focusables[focusables.length - 1];
					if (e.shiftKey && document.activeElement === first) {
						e.preventDefault();
						last.focus();
					} else if (!e.shiftKey && document.activeElement === last) {
						e.preventDefault();
						first.focus();
					}
				}
			}
			if (e.key === 'Escape') {
				if (mobileMenu?.classList.contains('active')) {
					setMobileDrawerState(false, true);
				}
				document.querySelectorAll('.nav-item.dropdown').forEach((dd) => {
					if (dd.matches(':hover') || dd.contains(document.activeElement)) {
						dd.classList.add('is-dismissed');
						const trigger = dd.querySelector('.nav-link') as HTMLElement | null;
						trigger?.setAttribute('aria-expanded', 'false');
						if (dd.contains(document.activeElement)) trigger?.focus();
					}
				});
			}
		});
	});
</script>
