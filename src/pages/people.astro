	<script define:vars={{ teamMembers, collaborators, alumni }}>
		const allMembers = [
			...teamMembers.map(m => ({ ...m, _type: 'member' })),
			...collaborators.map(c => ({ ...c, _type: 'collaborator', location: c.institution })),
			...alumni.map(a => ({ ...a, _type: 'alumni' }))
		];

		// ── Filter nav ──
		const showOnAll = new Set(['leadership', 'zanzibar', 'chennai']);
		document.querySelectorAll('.filter-btn').forEach(btn => {
			btn.addEventListener('click', () => {
				document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
				btn.classList.add('active');
				const f = btn.getAttribute('data-filter');
				document.querySelectorAll('.campus-group').forEach(g => {
					const gn = g.getAttribute('data-group');
					g.style.display = (f === 'all' ? showOnAll.has(gn) : gn === f) ? 'block' : 'none';
				});
			});
		});

		// ── Card clicks → modal ──
		document.querySelectorAll('[data-member-id]').forEach(card => {
			card.addEventListener('click', () => {
				const id = card.getAttribute('data-member-id');
				const member = allMembers.find(m => m.id === id);
				if (member) openModal(member);
			});
			card.addEventListener('keydown', e => {
				if (e.key === 'Enter' || e.key === ' ') {
					e.preventDefault();
					card.click();
				}
			});
		});

		// ── Open modal ──
		function openModal(m) {
			const modal = document.getElementById('profile-modal');
			if (!modal) return;

			// Photo — always show initials first, swap to photo once fully loaded
			const photo = document.getElementById('modal-photo-el');
			const initials = document.getElementById('modal-initials-el');
			if (photo && initials) {
				photo.style.display = 'none';
				photo.src = '';
				initials.textContent = getInitials(m.name);
				initials.style.display = 'flex';

				if (m.photo_url) {
					photo.alt = m.name;
					photo.onload = () => {
						photo.style.display = 'block';
						initials.style.display = 'none';
					};
					photo.onerror = () => {
						photo.style.display = 'none';
						initials.style.display = 'flex';
					};
					photo.src = m.photo_url;
				}
			}

			// Text fields
			const nameEl = document.getElementById('modal-name-el');
			const roleEl = document.getElementById('modal-role-el');
			const locEl = document.getElementById('modal-location-el');
			if (nameEl) nameEl.textContent = m.name;
			if (roleEl) roleEl.textContent = m.role || m.current_position || '';
			if (locEl) locEl.textContent = (m.country_flag ? m.country_flag + ' ' : '') + (m.location || m.institution || m.affiliation || '');

			// Bio
			const bioEl = document.getElementById('modal-bio-el');
			if (bioEl) {
				bioEl.innerHTML = m.bio
					? `<div class="modal-section-label">About</div><p class="modal-bio-text">${m.bio}</p>`
					: '';
			}

			// Research interests as pill tags
			const researchEl = document.getElementById('modal-research-el');
			if (researchEl) {
				if (m.research_interests && m.research_interests.length) {
					const tags = m.research_interests.map(t => `<span class="modal-tag">${t}</span>`).join('');
					researchEl.innerHTML = `<div class="modal-section-label">Research Focus</div><div class="modal-tags-wrap">${tags}</div>`;
				} else {
					researchEl.innerHTML = '';
				}
			}

			// Social links
			const socialEl = document.getElementById('modal-social-el');
			if (socialEl) {
				const links = [];
				if (m.linkedin_url)    links.push({ href: m.linkedin_url, label: 'LinkedIn',        cls: 'ms-linkedin',    icon: 'in' });
				if (m.scholar_url)     links.push({ href: m.scholar_url, label: 'Google Scholar',   cls: 'ms-scholar',     icon: 'G' });
				if (m.orcid_url)       links.push({ href: m.orcid_url, label: 'ORCID',              cls: 'ms-orcid',       icon: 'iD' });
				if (m.researchgate_url)links.push({ href: m.researchgate_url, label: 'ResearchGate',cls: 'ms-rgate',       icon: 'RG' });
				if (m.personal_website)links.push({ href: m.personal_website, label: 'Website',     cls: 'ms-web',         icon: '↗' });
				if (m.email)           links.push({ href: `mailto:${m.email}`, label: 'Email',      cls: 'ms-email',       icon: '✉' });

				socialEl.innerHTML = links.map(l =>
					`<a href="${l.href}" target="${l.href.startsWith('mailto') ? '_self' : '_blank'}" rel="noopener noreferrer" class="modal-social-btn ${l.cls}">
						<span class="msb-icon">${l.icon}</span>
						<span class="msb-label">${l.label}</span>
					</a>`
				).join('');
			}

			modal.classList.add('active');
			document.body.style.overflow = 'hidden';
			modal.querySelector('.modal-close-btn')?.focus();
		}

		function getInitials(name) {
			return name.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase();
		}

		function closeModal() {
			const modal = document.getElementById('profile-modal');
			if (modal) {
				modal.classList.remove('active');
				document.body.style.overflow = '';
			}
		}

		document.querySelector('.modal-close-btn')?.addEventListener('click', closeModal);
		document.querySelector('.modal-backdrop')?.addEventListener('click', closeModal);
		document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });
	</script>

