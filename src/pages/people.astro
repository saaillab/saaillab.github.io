---
import Layout from '../layouts/Layout.astro';
import ModernHeader from '../components/ModernHeader.astro';
import ModernFooter from '../components/ModernFooter.astro';
import metrics from '../data/scholar-metrics.json';
---

<Layout
	title="People & AI Researchers in Zanzibar | SAAIL Lab · IIT Madras Zanzibar"
	description="Principal Investigator Innocent Nyalala, PhD candidates, MTech Data Science & AI researchers, BS fellows, and alumni at SAAIL Lab, IIT Madras Zanzibar, Tanzania."
	canonical="https://saaillab.github.io/people/"
>
	<ModernHeader currentPage="people" />

	<main id="main-content">
		<section class="page-hero">
			<div class="container">
				<span class="page-eyebrow" data-i18n="people.eyebrow">Research Group &amp; Alumni · IIT Madras Zanzibar</span>
				<h1 class="page-title" data-i18n="people.title">AI Researchers at SAAIL Lab, Zanzibar</h1>
				<p class="page-lead" data-i18n="people.lead">
					Led by Innocent Nyalala at the School of Engineering and Science, IIT Madras Zanzibar, our group unites doctoral, MTech, and BS researchers across deep learning, computer vision, Swahili NLP, responsible AI governance, and healthcare machine learning.
				</p>
			</div>
		</section>

		<!-- Principal Investigator -->
		<section class="section">
			<div class="container">
				<div class="pi-card">
					<div class="pi-photo-wrap">
						<img src="/images/people/innocent-nyalala-saail-lab-zanzibar.jpg" alt="Innocent Nyalala, Assistant Professor and Principal Investigator of SAAIL Lab at IIT Madras Zanzibar" class="pi-photo" />
					</div>
					<div class="pi-info">
						<span class="role-badge">Principal Investigator</span>
						<h2>Innocent Nyalala</h2>
						<div class="pi-titles">
							<div>Assistant Professor, <a href="https://www.iitmz.ac.in/schools/engineering-and-science/faculty/prof-innocent-nyalala" target="_blank" rel="noopener">School of Engineering &amp; Science, IIT Madras Zanzibar</a></div>
							<div>Associate Research Fellow, <a href="https://wsai.iitm.ac.in/" target="_blank" rel="noopener">Wadhwani School of Data Science and AI</a>, IIT Madras</div>
						</div>
						<p class="pi-bio">
							Innocent Nyalala founded SAAIL Lab at IIT Madras Zanzibar in October 2024. His work spans lightweight computer vision for agricultural commodities and field crop pathology, culturally grounded multilingual AI safety evaluation, deployment gap auditing, and clinical healthcare machine learning. He serves on the Editorial Board of <em>Discover Artificial Intelligence</em> (Springer Nature) and as a reviewer for ICML and NeurIPS.
						</p>
						<div class="pi-stats">
							<div><strong>{metrics.citations.toLocaleString()}</strong><span>Citations</span></div>
							<div><strong>{metrics.hIndex}</strong><span>h-index</span></div>
							<div><strong>{metrics.i10Index}</strong><span>i10-index</span></div>
							<div><strong>{metrics.saailPublishedCount} + {metrics.saailUnderReviewCount}</strong><span>SAAIL Lab Papers</span></div>
						</div>
						<div class="pi-links">
							<a href="https://www.iitmz.ac.in/schools/engineering-and-science/faculty/prof-innocent-nyalala" target="_blank" rel="noopener" class="btn btn-primary">IITMZ Faculty Profile ↗</a>
							<a href="https://inyalala.github.io/" target="_blank" rel="noopener" class="btn btn-secondary">Personal Portfolio ↗</a>
							<a href="https://scholar.google.com/citations?user=jYVzIZUAAAAJ&hl=en" target="_blank" rel="noopener" class="btn btn-secondary">Google Scholar ↗</a>
							<a href="https://orcid.org/0000-0002-7969-437X" target="_blank" rel="noopener" class="btn btn-secondary">ORCID ↗</a>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- PhD Candidates (5) -->
		<section class="section alt-band">
			<div class="container">
				<div class="group-head">
					<h2>PhD Candidates (Co-Supervised, 5)</h2>
					<p>Joint doctoral supervision spanning autonomous agricultural agents and public health molecular modeling.</p>
				</div>
				<div class="cards-grid cols-3">
					<article class="member-card">
						<span class="cohort-tag">Joint PhD · Deakin Univ. &amp; IITMZ</span>
						<h3>B. C. Bhattarai</h3>
						<p class="focus">Agentic AI for Agricultural Technologies &amp; Orchards</p>
						<p class="meta">Co-supervised with A/Prof. Sunil Aryal &amp; Kallol Karmakar (Deakin University, Australia).</p>
						<div class="topic-links">
							<a href="/projects/cashew-ai/" class="topic-pill">CashewAI</a>
							<a href="/projects/cropguard-pathology/" class="topic-pill">Crop Pathology</a>
						</div>
					</article>
					<article class="member-card">
						<span class="cohort-tag">PhD · Public Health AI (2025-)</span>
						<h3>S. A. Mbarak &amp; A. S. Ali</h3>
						<p class="focus">Molecular Biology &amp; Maternal/Neonatal Health Analytics</p>
						<p class="meta">Co-supervised with Prof. Sunil Sazawal at CPHK Pemba &amp; Swami Vivekanand Subharti University.</p>
						<div class="topic-links">
							<a href="/projects/placentavision/" class="topic-pill">PlacentaVision</a>
							<a href="/collaborations/" class="topic-pill">CPHK Pemba</a>
						</div>
					</article>
					<article class="member-card">
						<span class="cohort-tag">PhD · Public Health AI (2025-)</span>
						<h3>I. B. Kabole &amp; B. A. Bakari</h3>
						<p class="focus">Cohort Biomarker &amp; Clinical Risk Prediction in Pemba</p>
						<p class="meta">Co-supervised with Prof. Sunil Sazawal at the Center for Public Health Kinetics, Pemba, Tanzania.</p>
						<div class="topic-links">
							<a href="/projects/placentavision/" class="topic-pill">Maternal &amp; Neonatal AI</a>
							<a href="/research/#healthcare" class="topic-pill">Clinical ML</a>
						</div>
					</article>
				</div>
			</div>
		</section>

		<!-- Current MTech Researchers (3) -->
		<section class="section">
			<div class="container">
				<div class="group-head">
					<h2>Current MTech Researchers (3)</h2>
					<p>MTech in Data Science &amp; AI thesis researchers at IIT Madras Zanzibar.</p>
				</div>
				<div class="cards-grid cols-3">
					<article class="member-card">
						<div class="member-head">
							<img src="/images/people/Twamaa.png" alt="Twamaa Hababuu Makame" class="member-avatar" loading="lazy" />
							<div>
								<span class="cohort-tag">MTech DSAI · Current</span>
								<h3>Twamaa Hababuu Makame</h3>
							</div>
						</div>
						<p class="focus">PlacentaVision Clinical Imaging &amp; Crop Pathology Transfer Learning</p>
						<p class="meta">Co-author on DSA 2026 few-shot cassava study; clinical placental perfusion and morphology AI.</p>
						<div class="topic-links">
							<a href="/projects/placentavision/" class="topic-pill">PlacentaVision</a>
							<a href="/papers/few-shot-cassava-dsa2026/" class="topic-pill">DSA 2026 Paper</a>
						</div>
					</article>
					<article class="member-card">
						<div class="member-head">
							<img src="/images/people/SurabhiGudla_Photo.png" alt="Surabhi Gudla" class="member-avatar" loading="lazy" />
							<div>
								<span class="cohort-tag">MTech DSAI · Current</span>
								<h3>Surabhi Gudla</h3>
							</div>
						</div>
						<p class="focus">Deployment Gap Auditing &amp; Balanced Evaluation Protocols</p>
						<p class="meta">Co-author on DGS-Bench (Best Poster Award, DLI 2026) and DSA 2026 field transfer benchmarks.</p>
						<div class="topic-links">
							<a href="/papers/dgs-bench/" class="topic-pill">DGS-Bench</a>
							<a href="/papers/dcgan-cassava-dsa2026/" class="topic-pill">DCGAN Audit</a>
						</div>
					</article>
					<article class="member-card">
						<div class="member-head">
							<img src="/images/people/khamis.jpg" alt="Khamis K. Haji" class="member-avatar" loading="lazy" />
							<div>
								<span class="cohort-tag">MTech DSAI · Current</span>
								<h3>Khamis K. Haji</h3>
							</div>
						</div>
						<p class="focus">Coastal Blue Economy &amp; Dataset Representativeness Auditing</p>
						<p class="meta">Co-author across three DSA 2026 Kampala studies and Zanzibar coastal seaweed monitoring.</p>
						<div class="topic-links">
							<a href="/projects/seaweed-blue-economy/" class="topic-pill">Blue Economy</a>
							<a href="/papers/auditing-crop-datasets-dsa2026/" class="topic-pill">AgriAI Audit</a>
						</div>
					</article>
				</div>
			</div>
		</section>

		<!-- BS Undergraduate Researchers (3) -->
		<section class="section alt-band">
			<div class="container">
				<div class="group-head">
					<h2>BS Undergraduate Researchers (3)</h2>
					<p>IIT Madras Zanzibar BS in Data Science &amp; AI student researchers contributing to the Zanzibar Swahili Corpus, Dira provenance detection, and coastal blue economy sensing.</p>
				</div>
				<div class="cards-grid cols-3">
					<article class="member-card member-compact">
						<div class="member-head">
							<div class="member-avatar-initials" aria-hidden="true">UM</div>
							<div>
								<span class="cohort-tag">Blue Economy</span>
								<h3>Umniya Maulid</h3>
							</div>
						</div>
						<p class="focus">Coastal Seaweed Ice-Ice Disease &amp; Heatwave Sensing</p>
						<div class="topic-links">
							<a href="/projects/seaweed-blue-economy/" class="topic-pill">Seaweed AI</a>
						</div>
					</article>
					<article class="member-card member-compact">
						<div class="member-head">
							<div class="member-avatar-initials" aria-hidden="true">SA</div>
							<div>
								<span class="cohort-tag tag-gold">Swahili NLP · Modeling</span>
								<h3>Sri Advaita</h3>
							</div>
						</div>
						<p class="focus">Dira Native vs. Translated Swahili Provenance Detection Models</p>
						<div class="topic-links">
							<a href="/projects/swahili-dira/" class="topic-pill">Dira Benchmark</a>
						</div>
					</article>
					<article class="member-card member-compact">
						<div class="member-head">
							<div class="member-avatar-initials" aria-hidden="true">SS</div>
							<div>
								<span class="cohort-tag tag-gold">Swahili NLP</span>
								<h3>Saleh Saleh</h3>
							</div>
						</div>
						<p class="focus">Zanzibar Swahili Corpus, Spoken QA &amp; Dialect Annotation</p>
						<div class="topic-links">
							<a href="/projects/swahili-dira/" class="topic-pill">Zanzibar Swahili Corpus</a>
						</div>
					</article>
				</div>
			</div>
		</section>

		<!-- Graduated MTech Alumni (4) -->
		<section class="section" id="alumni">
			<div class="container">
				<div class="group-head">
					<h2>Graduated MTech Alumni (4) · Theses &amp; Research Profiles</h2>
					<p>Inaugural MTech Data Science &amp; AI cohorts graduated from SAAIL Lab at IIT Madras Zanzibar.</p>
				</div>
				<div class="cards-grid cols-2">
					<article class="member-card alumni-card">
						<div class="member-head">
							<img src="/images/people/Patrick.jpg" alt="Patrick Vincent Ndowo" class="member-avatar" loading="lazy" />
							<div>
								<span class="cohort-tag">MTech Graduated · Alumni</span>
								<h3>Patrick Vincent Ndowo</h3>
							</div>
						</div>
						<dl class="alumni-meta-grid">
							<div>
								<dt>Program</dt>
								<dd>MTech Data Science &amp; AI · IIT Madras Zanzibar</dd>
							</div>
							<div>
								<dt>Thesis Focus</dt>
								<dd>Auditable Multi-Task &amp; Compositional Vision for Zanzibar Clove Grading</dd>
							</div>
							<div>
								<dt>Deliverables</dt>
								<dd>Lead student author on ETRI Journal (2026), CVPR 2026 V4A, ICLR 2026 Trustworthy AI, AI4EAC 2026 ($980 Travel Grant), and ACM AfriCHI 2025; built the Ubora-AI Flutter/Android TFLite INT8 app.</dd>
							</div>
						</dl>
						<div class="topic-links">
							<a href="/projects/ubora-ai/" class="topic-pill">Ubora-AI</a>
							<a href="/papers/clove-xai-etri2026/" class="topic-pill">ETRI Journal</a>
							<a href="/papers/cloves-4603/" class="topic-pill">CLOVES-4603</a>
						</div>
					</article>
					<article class="member-card alumni-card">
						<div class="member-head">
							<img src="/images/people/Duen.jpg" alt="Duen Michael Chombo" class="member-avatar" loading="lazy" />
							<div>
								<span class="cohort-tag">MTech Graduated · Alumni</span>
								<h3>Duen Michael Chombo</h3>
							</div>
						</div>
						<dl class="alumni-meta-grid">
							<div>
								<dt>Program</dt>
								<dd>MTech Data Science &amp; AI · IIT Madras Zanzibar</dd>
							</div>
							<div>
								<dt>Thesis Focus</dt>
								<dd>DeepLabV3+ Segmentation &amp; MobileViT Maize Disease Diagnostics</dd>
							</div>
							<div>
								<dt>Deliverables</dt>
								<dd>Built the offline Android TFLite INT8 mobile application pairing leaf lesion segmentation with cultivar disease classification for East African extension officers.</dd>
							</div>
						</dl>
						<div class="topic-links">
							<a href="/tools/" class="topic-pill">Maize Mobile App</a>
							<a href="/projects/cropguard-pathology/" class="topic-pill">Crop Pathology</a>
						</div>
					</article>
					<article class="member-card alumni-card">
						<div class="member-head">
							<img src="/images/people/shivam_photo.png" alt="Shivam Vyas" class="member-avatar" loading="lazy" />
							<div>
								<span class="cohort-tag">MTech Graduated · Alumni</span>
								<h3>Shivam Vyas</h3>
							</div>
						</div>
						<dl class="alumni-meta-grid">
							<div>
								<dt>Program</dt>
								<dd>MTech Data Science &amp; AI · IIT Madras Zanzibar</dd>
							</div>
							<div>
								<dt>Thesis Focus</dt>
								<dd>Privacy-Preserving Facial Recognition under Federated Learning</dd>
							</div>
							<div>
								<dt>Deliverables</dt>
								<dd>Co-author on DSA 2026 few-shot cassava evaluation; developed decentralized facial identity protection protocols across edge clients.</dd>
							</div>
						</dl>
						<div class="topic-links">
							<a href="/papers/few-shot-cassava-dsa2026/" class="topic-pill">DSA 2026 Study</a>
							<a href="/projects/responsible-ai-global-south/" class="topic-pill">Privacy &amp; Safety</a>
						</div>
					</article>
					<article class="member-card alumni-card">
						<div class="member-head">
							<div class="member-avatar-initials" aria-hidden="true">MH</div>
							<div>
								<span class="cohort-tag">MTech Graduated · Alumni</span>
								<h3>Makame Mohammed Haji</h3>
							</div>
						</div>
						<dl class="alumni-meta-grid">
							<div>
								<dt>Program</dt>
								<dd>MTech Data Science &amp; AI · IIT Madras Zanzibar</dd>
							</div>
							<div>
								<dt>Thesis Focus</dt>
								<dd>Explainable Machine Learning for Preterm Birth Prediction</dd>
							</div>
							<div>
								<dt>Deliverables</dt>
								<dd>Developed SHAP-guided clinical biomarker prediction pipelines for maternal serum screening in Zanzibar and Pemba health cohorts.</dd>
							</div>
						</dl>
						<div class="topic-links">
							<a href="/projects/placentavision/" class="topic-pill">PlacentaVision</a>
							<a href="/research/#healthcare" class="topic-pill">Healthcare AI</a>
						</div>
					</article>
				</div>

				<p class="alumni-note">
					<strong>Alumni Updates:</strong> SAAIL Lab graduates who wish to add recent career or doctoral placement links can reach out at <a href="mailto:saail_lab@iitmz.ac.in">saail_lab@iitmz.ac.in</a>.
				</p>

				<div class="join-callout">
					<h3>Join SAAIL Lab</h3>
					<p>We welcome prospective PhD, MTech, and undergraduate researchers interested in agricultural AI, Swahili NLP/safety, and healthcare vision.</p>
					<a href="/hiring/" class="btn btn-primary">Explore Open Positions &rarr;</a>
				</div>
			</div>
		</section>
	</main>

	<ModernFooter />
</Layout>

<style>
	.alt-band {
		background: var(--bg-secondary);
		border-top: 1px solid var(--border-color);
		border-bottom: 1px solid var(--border-color);
	}

	.pi-card {
		display: grid;
		grid-template-columns: 280px 1fr;
		gap: 2.5rem;
		align-items: center;
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		border-radius: 1.25rem;
		padding: 2.25rem;
		box-shadow: 0 8px 26px var(--shadow-light);
	}

	.pi-photo {
		width: 100%;
		aspect-ratio: 1;
		object-fit: cover;
		object-position: center top;
		background: #ffffff;
		border-radius: 1rem;
		border: 1px solid var(--border-color);
	}

	.role-badge {
		display: inline-block;
		font-size: 0.74rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--accent-primary);
		background: rgba(20, 83, 45, 0.1);
		padding: 0.24rem 0.7rem;
		border-radius: 999px;
		margin-bottom: 0.6rem;
	}

	.pi-info h2 {
		font-size: 2rem;
		margin-bottom: 0.45rem;
		color: var(--text-primary);
	}

	.pi-titles {
		font-size: 0.94rem;
		font-weight: 600;
		color: var(--accent-primary);
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		margin-bottom: 1rem;
	}

	.pi-titles a {
		color: inherit;
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.pi-bio {
		font-size: 0.96rem;
		color: var(--text-secondary);
		line-height: 1.7;
		margin-bottom: 1.35rem;
	}

	.pi-stats {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.75rem;
		margin-bottom: 1.35rem;
	}

	.pi-stats > div {
		background: var(--bg-secondary);
		border: 1px solid var(--border-color);
		border-radius: 0.75rem;
		padding: 0.7rem;
		text-align: center;
	}

	.pi-stats strong {
		display: block;
		font-size: 1.2rem;
		font-weight: 800;
		color: var(--accent-primary);
	}

	.pi-stats span {
		font-size: 0.75rem;
		color: var(--text-muted);
		font-weight: 600;
	}

	.pi-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
	}

	.group-head {
		margin-bottom: 2rem;
	}

	.group-head h2 {
		font-size: 1.75rem;
		color: var(--text-primary);
		margin-bottom: 0.35rem;
	}

	.group-head p {
		color: var(--text-secondary);
		font-size: 1rem;
	}

	.cards-grid {
		display: grid;
		gap: 1.35rem;
	}
	.cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	.cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
	.cols-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }

	.member-card {
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		border-radius: 1rem;
		padding: 1.4rem;
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		box-shadow: 0 3px 10px var(--shadow-light);
	}

	.member-head {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		margin-bottom: 0.25rem;
	}

	.member-avatar {
		width: 56px;
		height: 56px;
		border-radius: 50%;
		object-fit: cover;
		object-position: center top;
		flex-shrink: 0;
		border: 2px solid var(--border-color);
	}

	.member-avatar-initials {
		width: 56px;
		height: 56px;
		border-radius: 50%;
		flex-shrink: 0;
		display: grid;
		place-items: center;
		font-weight: 800;
		font-size: 0.95rem;
		background: rgba(20, 83, 45, 0.12);
		color: var(--accent-primary);
		border: 2px solid var(--border-color);
	}

	.cohort-tag {
		display: inline-block;
		width: fit-content;
		font-size: 0.7rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		padding: 0.18rem 0.55rem;
		border-radius: 6px;
		background: rgba(20, 83, 45, 0.1);
		color: var(--accent-primary);
	}

	.tag-gold {
		background: rgba(180, 83, 9, 0.14);
		color: #92400e;
	}
	:global([data-theme="dark"]) .tag-gold {
		background: rgba(245, 158, 11, 0.18);
		color: #fbbf24;
	}

	.member-card h3 {
		font-size: 1.12rem;
		color: var(--text-primary);
	}

	.focus {
		font-size: 0.88rem;
		font-weight: 600;
		color: var(--text-primary);
		line-height: 1.45;
	}

	.meta {
		font-size: 0.84rem;
		color: var(--text-secondary);
		line-height: 1.55;
	}

	.alumni-meta-grid {
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
		margin: 0.25rem 0;
		padding: 0.85rem 0.95rem;
		background: var(--bg-secondary);
		border: 1px solid var(--border-color);
		border-radius: 0.75rem;
	}
	.alumni-meta-grid > div {
		display: grid;
		grid-template-columns: 108px minmax(0, 1fr);
		gap: 0.6rem;
		align-items: baseline;
	}
	.alumni-meta-grid dt {
		font-size: 0.72rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--accent-primary);
	}
	.alumni-meta-grid dd {
		margin: 0;
