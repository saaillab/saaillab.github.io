---

<Layout
	title="People - SAAIL Lab"
	description="Meet the SAAIL Lab team — researchers, students, and collaborators building transformative AI for sustainable agriculture across East Africa."
>
	<ModernHeader />

	<main class="people-page">

		<!-- ══════════ HERO ══════════ -->
		<section class="hero">
			<div class="hero-grid-pattern"></div>
			<div class="hero-orb hero-orb-1"></div>
			<div class="hero-orb hero-orb-2"></div>
			<div class="hero-orb hero-orb-3"></div>
			<div class="container">
				<span class="hero-eyebrow">SAAIL Lab · IIT Madras Zanzibar</span>
				<h1 class="hero-title">Minds Behind<br/>the Mission</h1>
				<p class="hero-sub">Researchers, innovators, and students building transformative AI solutions for sustainable agriculture and intelligent livelihoods across Africa</p>
				<div class="hero-stats">
					<div class="stat-item">
						<span class="stat-num">7+</span>
						<span class="stat-lbl">Team Members</span>
					</div>
					<div class="stat-sep"></div>
					<div class="stat-item">
						<span class="stat-num">3</span>
						<span class="stat-lbl">Countries</span>
					</div>
					<div class="stat-sep"></div>
					<div class="stat-item">
						<span class="stat-num">6+</span>
						<span class="stat-lbl">Active Projects</span>
					</div>
					<div class="stat-sep"></div>
					<div class="stat-item">
						<span class="stat-num">6</span>
						<span class="stat-lbl">Global Collaborators</span>
					</div>
				</div>
			</div>
		</section>

		<!-- ══════════ TEAM ══════════ -->
		<section class="team-section">
			<div class="container">
				<div class="section-head">
					<h2>Meet the Team</h2>
					<p>Click any card to explore full profiles, research focus, and contact links</p>
				</div>

				<nav class="filter-nav" role="navigation" aria-label="Team filter">
					<button class="filter-btn active" data-filter="all">All Members</button>
					<button class="filter-btn" data-filter="leadership">Leadership</button>
					<button class="filter-btn" data-filter="zanzibar">🇹🇿 Zanzibar</button>
					<button class="filter-btn" data-filter="chennai">🇮🇳 Chennai</button>
					<button class="filter-btn" data-filter="collaborators">Collaborators</button>
					<button class="filter-btn" data-filter="alumni">Alumni</button>
				</nav>

				<!-- Leadership -->
				<div class="campus-group" data-group="leadership">
					<div class="campus-divider">
						<div class="divider-line"></div>
						<div class="divider-content">
							<span class="divider-flag">⭐</span>
							<span class="divider-name">Leadership</span>
						</div>
						<div class="divider-line"></div>
					</div>
					<div class="member-grid">
						<div class="member-card member-card--pi" data-member-id={director.id} style="--delay:0s" role="button" tabindex="0" aria-label={`View ${director.name}'s profile`}>
							<div class="card-photo-area">
								<img src={director.photo_url} alt={director.name} class="card-img" loading="lazy"
									style="object-position: 50% 0%"
									onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
								<div class="card-initials-avatar" style="display:none">{getInitials(director.name)}</div>
								<div class="card-hover-overlay">
									<p class="overlay-label">Research Focus</p>
									{director.research_interests.slice(0,3).map(tag => (
										<span class="overlay-tag">{tag}</span>
									))}
									<span class="overlay-cta">View Profile →</span>
								</div>
							</div>
							<div class="card-body">
								<h4 class="card-name">{director.name}</h4>
								<p class="card-role">{director.role}</p>
								<div class="card-footer-row">
									<span class="card-flag">{director.country_flag}</span>
									<div class="card-quick-links">
										{director.linkedin_url && <a href={director.linkedin_url} target="_blank" rel="noopener" class="quick-link ql-li" onclick="event.stopPropagation()" title="LinkedIn">in</a>}
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>

				<!-- Zanzibar Campus -->
				<div class="campus-group" data-group="zanzibar">
					<div class="campus-divider">
						<div class="divider-line"></div>
						<div class="divider-content">
							<span class="divider-flag">🇹🇿</span>
							<span class="divider-name">Zanzibar Campus</span>
							<span class="divider-tag">IIT Madras Zanzibar</span>
						</div>
						<div class="divider-line"></div>
					</div>
					<div class="member-grid">
						{zanzibarStudents.map((m, i) => (
							<div class="member-card" data-member-id={m.id} style={`--delay:${i * 0.08}s`} role="button" tabindex="0" aria-label={`View ${m.name}'s profile`}>
								<div class="card-photo-area">
									<img
										src={m.photo_url}
										alt={m.name}
										class="card-img"
										loading="lazy"
										style={`object-position: ${m.photo_position || '50% 10%'}`}
										onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
									/>
									<div class="card-initials-avatar" style="display:none">{getInitials(m.name)}</div>
									<div class="card-hover-overlay">
										<p class="overlay-label">Research Focus</p>
										{m.research_interests.slice(0,3).map(tag => (
											<span class="overlay-tag">{tag}</span>
										))}
										<span class="overlay-cta">View Profile →</span>
									</div>
								</div>
								<div class="card-body">
									<h4 class="card-name">{m.name}</h4>
									<p class="card-role">{m.role}</p>
									{m.since && <p class="card-since">Since {m.since}</p>}
									<div class="card-footer-row">
										<span class="card-flag">{m.country_flag}</span>
										<div class="card-quick-links">
											{m.linkedin_url && <a href={m.linkedin_url} target="_blank" rel="noopener" class="quick-link ql-li" onclick="event.stopPropagation()" title="LinkedIn">in</a>}
										</div>
									</div>
								</div>
							</div>
						))}
					</div>
				</div>

				<!-- Chennai Campus -->
				<div class="campus-group" data-group="chennai">
					<div class="campus-divider">
						<div class="divider-line"></div>
						<div class="divider-content">
							<span class="divider-flag">🇮🇳</span>
							<span class="divider-name">Chennai Campus</span>
							<span class="divider-tag">IIT Madras Chennai</span>
						</div>
						<div class="divider-line"></div>
					</div>
					<div class="member-grid">
						{chennaiStudents.map((m, i) => (
							<div class="member-card" data-member-id={m.id} style={`--delay:${i * 0.08}s`} role="button" tabindex="0" aria-label={`View ${m.name}'s profile`}>
								<div class="card-photo-area">
									<img
										src={m.photo_url}
										alt={m.name}
										class="card-img"
										loading="lazy"
										style={`object-position: ${m.photo_position || '50% 10%'}`}
										onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
									/>
									<div class="card-initials-avatar" style="display:none">{getInitials(m.name)}</div>
									<div class="card-hover-overlay">
										<p class="overlay-label">Research Focus</p>
										{m.research_interests.slice(0,3).map(tag => (
											<span class="overlay-tag">{tag}</span>
										))}
										<span class="overlay-cta">View Profile →</span>
									</div>
								</div>
								<div class="card-body">
									<h4 class="card-name">{m.name}</h4>
									<p class="card-role">{m.role}</p>
									{m.since && <p class="card-since">Since {m.since}</p>}
									<div class="card-footer-row">
										<span class="card-flag">{m.country_flag}</span>
										<div class="card-quick-links">
											{m.linkedin_url && <a href={m.linkedin_url} target="_blank" rel="noopener" class="quick-link ql-li" onclick="event.stopPropagation()" title="LinkedIn">in</a>}
										</div>
									</div>
								</div>
							</div>
						))}
					</div>
				</div>

				<!-- Collaborators -->
				<div class="campus-group collab-group" data-group="collaborators" style="display:none">
					<div class="campus-divider">
						<div class="divider-line"></div>
						<div class="divider-content">
							<span class="divider-name">International Collaborators</span>
						</div>
						<div class="divider-line"></div>
					</div>
					<div class="collab-grid">
						{collaborators.map(c => (
							<div class="collab-card" data-member-id={c.id} role="button" tabindex="0">
								<div class="collab-flag-box">{c.country_flag}</div>
								<div class="collab-info">
									<h4 class="collab-name">{c.name}</h4>
									<p class="collab-role">{c.role}</p>
									<p class="collab-inst">{c.institution}</p>
									<div class="collab-tags">
										{c.research_interests.map(t => <span class="collab-tag">{t}</span>)}
									</div>
								</div>
								{c.personal_website && (
									<a href={c.personal_website} target="_blank" rel="noopener" class="collab-visit-btn" onclick="event.stopPropagation()">Visit →</a>
								)}
							</div>
						))}
					</div>
				</div>

				<!-- Alumni -->
				<div class="campus-group alumni-group" data-group="alumni" style="display:none">
					<div class="campus-divider">
						<div class="divider-line"></div>
						<div class="divider-content">
							<span class="divider-name">Alumni</span>
						</div>
						<div class="divider-line"></div>
					</div>
					<div class="alumni-grid">
						{alumni.map(a => (
							<div class="alumni-card" data-member-id={a.id} role="button" tabindex="0">
								<div class="alumni-top">
									<div class="alumni-avatar">{getInitials(a.name)}</div>
									<span class="alumni-grad-badge">{a.graduation_year}</span>
								</div>
								<h4 class="alumni-name">{a.name}</h4>
								<p class="alumni-position">{a.current_position} {a.country_flag}</p>
								<div class="alumni-tags">
									{a.research_interests.slice(0,3).map(t => <span class="alumni-tag">{t}</span>)}
								</div>
							</div>
						))}
					</div>
