---
import Layout from '../layouts/Layout.astro';
import ModernHeader from '../components/ModernHeader.astro';
import ModernFooter from '../components/ModernFooter.astro';
---

<Layout
	title="Research Pillars | SAAIL Lab | IIT Madras Zanzibar"
	description="Scientific pillars of SAAIL Lab across Precision Agriculture and the Blue Economy (CashewAI, Cloves, Seaweed, CropGuardNet), Swahili NLP and CultureSEEDS AI Safety, Responsible AI, and Healthcare."
	canonical="https://saaillab.github.io/research"
>
	<ModernHeader currentPage="research" />

	<main>
		<section class="page-hero">
			<div class="container">
				<span class="page-eyebrow">Research Agenda</span>
				<h1 class="page-title">Four Scientific Pillars Grounded in East Africa</h1>
				<p class="page-lead">
					Every research pillar pairs empirical ML theory with regional field data across Tanzania, Kenya, Uganda, and India, producing open datasets, edge-deployable models, and audited benchmarks.
				</p>
			</div>
		</section>

		<section class="section">
			<div class="container pillars-stack">
				<!-- Pillar 1: Agriculture & Blue Economy (includes CropGuard!) -->
				<article id="agriculture" class="pillar-panel">
					<div class="panel-header panel-agri">
						<div class="panel-header-inner">
							<span class="panel-index">Pillar 01</span>
							<h2>Precision Agriculture &amp; Coastal Blue Economy</h2>
							<div class="panel-tags">
								<span>CashewAI</span>
								<span>Zanzibar Cloves</span>
								<span>Seaweed &amp; Blue Economy</span>
								<span>CropGuard Cross-Crop Vision</span>
								<span>Food Supply Chains</span>
							</div>
						</div>
					</div>
					<div class="panel-body">
						<p class="panel-intro">
							Smallholder commodities across East Africa suffer acute yield and grading losses under manual inspection, climate shocks, and field disease pressure. We build lightweight vision and multimodal models validated directly on Zanzibar warehouses, coastal seaweed plots, cashew orchards, and smallholder fields.
						</p>
						<div class="subgrid">
							<div class="subbox">
								<h4>Commodity &amp; Crop Systems</h4>
								<ul>
									<li><strong>Clove Quality Grading:</strong> ETRI Journal (2026) compositional XAI grading (99.45% F1, 100% EER), CVPR 2026 V4A CLOVES-4603 benchmark (4,603 images, 99.67% ResNet-50), ZSTC-Clove-V1 feasibility (5,298 single cloves), and participatory AfriCHI co-design.</li>
									<li><strong>CropGuard Cross-Crop Diagnostics:</strong> CropGuardNet (481,574 params, 5.00 ms CPU ONNX) unites leak-free UUID/pHash deduplication (35,420 unique leaf images across 8 crops, 38 classes) with four-method XAI faithfulness.</li>
									<li><strong>Cashew, Cassava &amp; Maize:</strong> ICSR-funded <em>CashewAI</em> dual-stream yield and pest forecasting; <em>COMPAG</em> (2024, 2025) &amp; <em>AIIA</em> (2024) cassava pathology; mobile DeepLabV3+/MobileViT maize segmentation.</li>
								</ul>
							</div>
							<div class="subbox">
								<h4>Coastal Blue Economy &amp; Telemetry</h4>
								<ul>
									<li><strong>Seaweed Heatwave &amp; Disease Early Warning:</strong> Tracking <em>Eucheuma</em> and <em>Kappaphycus</em> Ice-Ice disease outbreaks triggered by sea-surface heatwaves across Zanzibar coastal farms.</li>
									<li><strong>Aquaculture &amp; Coral Restoration:</strong> Computer vision monitoring for coastal mariculture and reef biodiversity health in partnership with Zafiri and regional marine institutions.</li>
									<li><strong>3D Livestock &amp; Horticultural Grading:</strong> Kinect v2 depth reconstruction (`Poultry Science 2024`, `R² = 0.9988`), tomato/egg volume grading under occlusion, and RuTAG IoT crop hubs.</li>
								</ul>
							</div>
						</div>
						<div class="panel-actions">
							<a href="/papers/clove-xai-etri2026/" class="btn btn-primary">ETRI 2026 Clove XAI</a>
							<a href="/papers/cropguardnet/" class="btn btn-secondary">CropGuardNet Paper</a>
							<a href="/projects#agri" class="btn btn-secondary">Funded Ag Projects &rarr;</a>
						</div>
					</div>
				</article>

				<!-- Pillar 2: Language AI, CultureSEEDS & Swahili NLP -->
				<article id="language" class="pillar-panel">
					<div class="panel-header panel-lang">
						<div class="panel-header-inner">
							<span class="panel-index">Pillar 02 · US$100K Google Award</span>
							<h2>Swahili NLP, Cultural Preservation &amp; Multilingual Safety</h2>
							<div class="panel-tags">
								<span>CultureSEEDS (GDM / Google.org)</span>
								<span>Zanzibar Swahili Corpus</span>
								<span>Dira Provenance</span>
								<span>Storytelling &amp; ML</span>
							</div>
						</div>
					</div>
					<div class="panel-body">
						<p class="panel-intro">
							Large language models frequently conflate cultural norms with harm or default to unnatural translated Swahili. Supported by a US$100,000 Google Research unrestricted award linked to Google DeepMind and Google.org CultureSEEDS, we build authentic East African linguistic corpora and safety benchmarks.
						</p>
						<div class="subgrid">
							<div class="subbox">
								<h4>CultureSEEDS &amp; East African Evaluation</h4>
								<ul>
									<li><strong>CultureSEEDS East Africa Track:</strong> Designing culturally grounded safety vs. appropriateness evaluation datasets across 10+ African languages anchored in Swahili (Kiunguja/standard variants), Dholuo, Gikuyu, and regional speech registers.</li>
									<li><strong>Multimodal &amp; Domain Spoken QA:</strong> Joint work with Prof. Nirav Bhatt and student teams developing spoken health and agricultural advisory benchmarks across Kiswahili dialects.</li>
								</ul>
							</div>
							<div class="subbox">
								<h4>Zanzibar Swahili Corpus &amp; Dira</h4>
								<ul>
									<li><strong>Dira Native vs. Translated Detector:</strong> Built with BTech researchers to measure and detect machine-translated ("translationese") Swahili vs. authentic coastal native prose across zero-shot, prompted, and fine-tuned LLMs.</li>
									<li><strong>Storytelling &amp; Cultural Preservation:</strong> IITMZ grant (Rs. 10.00 lakhs with Co-PI Hope K. McCoy) preserving East African oral and community narratives through participatory machine learning.</li>
								</ul>
							</div>
						</div>
						<div class="panel-actions">
							<a href="/projects#cultureseeds" class="btn btn-primary">CultureSEEDS Project</a>
							<a href="/datasets#language" class="btn btn-secondary">Swahili Datasets</a>
						</div>
					</div>
				</article>

				<!-- Pillar 3: Responsible, Explainable & Sovereign AI -->
				<article id="responsible" class="pillar-panel">
					<div class="panel-header panel-resp">
						<div class="panel-header-inner">
							<span class="panel-index">Pillar 03 · 2x DLI Best Poster</span>
							<h2>Responsible AI, Evaluation Audits &amp; Governance</h2>
							<div class="panel-tags">
								<span>DGS-Bench (DLI 2026)</span>
								<span>ICLR 2026 Trustworthy AI</span>
								<span>CARA-FM (PMLR 302)</span>
								<span>Oxford TAIS 2026</span>
								<span>AAAI 2026 Sovereignty</span>
							</div>
						</div>
					</div>
					<div class="panel-body">
						<p class="panel-intro">
							Deploying models imported from well-resourced labs without local audits produces silent field failures and deepens technological dependency. We formalize evaluation protocols, explainability guarantees, and regional AI policies anchored in African institutional agency.
						</p>
						<div class="subgrid">
							<div class="subbox">
								<h4>Technical Auditing &amp; Edge Compression</h4>
								<ul>
									<li><strong>Deployment Gap Score (DGS-Bench):</strong> Best Poster Award at Deep Learning Indaba 2026 (18/114 accepted); exposes negative raw-accuracy mirages (-5.96 pp) where macro-F1 confirms +8.19 pp field degradation.</li>
									<li><strong>Procedural &amp; Data Boundaries:</strong> Documenting DCGAN failure modes (-23.2 pp at n=25), few-shot budget curves (DSA 2026), and the AgriAI Bias Card across PlantVillage (4/10) vs. iCassava (9/10).</li>
								</ul>
							</div>
							<div class="subbox">
								<h4>African AI Governance &amp; CARA-FM</h4>
								<ul>
									<li><strong>CARA-FM Theoretical Agenda:</strong> Best Poster at DLI 2025 (PMLR Vol. 302), defining 5M-50M Tiny/Lite/Edge architectures matching 1-3 GB East African hardware.</li>
									<li><strong>Policy Harmonization:</strong> Comparative national strategy analysis across Ethiopia, Kenya, and Rwanda (Oxford TAIS 2026), the Draft EAC Strategy (AAIAC 2026), and AU-ASEAN AI sovereignty (AAAI 2026, NeurIPS 2025).</li>
								</ul>
							</div>
						</div>
						<div class="panel-actions">
							<a href="/papers/dgs-bench/" class="btn btn-primary">DGS-Bench Paper</a>
							<a href="/papers/cara-fm/" class="btn btn-secondary">CARA-FM Framework</a>
							<a href="/papers/ai-policy-harmonization-tais2026/" class="btn btn-secondary">TAIS 2026 Policy</a>
						</div>
					</div>
				</article>

				<!-- Pillar 4: Healthcare & Assistive AI -->
				<article id="healthcare" class="pillar-panel">
					<div class="panel-header panel-health">
						<div class="panel-header-inner">
							<span class="panel-index">Pillar 04</span>
							<h2>Maternal Healthcare AI &amp; Assistive Systems</h2>
							<div class="panel-tags">
								<span>PlacentaVision</span>
								<span>BAFNet Polyp Seg.</span>
								<span>Preterm Risk ML</span>
								<span>E-Vision Assistive App</span>
							</div>
						</div>
					</div>
					<div class="panel-body">
						<p class="panel-intro">
							High-stakes clinical AI requires tight anatomical boundary fidelity and calibrated risk scoring in low-resource clinics. Through international partnerships, we advance maternal ultrasound/optical analysis, endoscopic segmentation, and mobile assistive tools.
						</p>
						<div class="subgrid">
							<div class="subbox">
								<h4>Clinical Imaging &amp; Biomarker Modeling</h4>
								<ul>
									<li><strong>PlacentaVision Consortium:</strong> International collaboration with Prof. Alison Gernand (Penn State University) and maternal health clinics predicting placental weight, perfusion, and dysfunction risk non-invasively.</li>
									<li><strong>BAFNet Colorectal Segmentation:</strong> Published in <em>Expert Systems with Applications</em> (2025, IF 7.5), reaching 0.914 EndoScene Dice in 5.98M params (3.59 GFLOPs).</li>
									<li><strong>Maternal &amp; Neonatal Risk ML:</strong> Metabolomic preterm birth prediction with Center for Public Health Kinetics (Pemba) and 4 co-supervised PhD researchers.</li>
								</ul>
							</div>
							<div class="subbox">
								<h4>Privacy-Preserving &amp; Assistive Mobile Systems</h4>
								<ul>
									<li><strong>E-Vision Spatial Navigation:</strong> On-device Android depth estimation and object detection delivering low-latency voice guidance for visually impaired users without internet reliance.</li>
									<li><strong>Federated Facial Privacy:</strong> MTech research protecting sensitive identity biometrics under distributed federated training.</li>
								</ul>
							</div>
						</div>
						<div class="panel-actions">
							<a href="/papers/bafnet-polyp-2025/" class="btn btn-primary">BAFNet Paper</a>
							<a href="/tools" class="btn btn-secondary">Assistive &amp; Field Apps &rarr;</a>
						</div>
					</div>
				</article>
			</div>
		</section>
	</main>

	<ModernFooter />
</Layout>

<style>
	.pillars-stack {
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
	}

	.pillar-panel {
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		border-radius: 1.15rem;
		overflow: hidden;
		box-shadow: 0 6px 20px var(--shadow-light);
	}

	.panel-header {
		padding: 2rem 2.25rem;
		color: #ffffff;
	}

	.panel-agri { background: linear-gradient(125deg, #0d3b22 0%, #166534 100%); }
	.panel-lang { background: linear-gradient(125deg, #451a03 0%, #b45309 100%); }
	.panel-resp { background: linear-gradient(125deg, #0c1a12 0%, #1e3a2f 100%); }
	.panel-health { background: linear-gradient(125deg, #133845 0%, #0f766e 100%); }

	.panel-index {
		display: inline-block;
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.78rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		opacity: 0.9;
		margin-bottom: 0.45rem;
	}

	.panel-header h2 {
		font-size: clamp(1.45rem, 2.5vw, 1.95rem);
		margin-bottom: 0.9rem;
		color: #ffffff;
	}

	.panel-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
	}

	.panel-tags span {
		font-size: 0.76rem;
		font-weight: 600;
		padding: 0.22rem 0.68rem;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.16);
		color: #ffffff;
		border: 1px solid rgba(255, 255, 255, 0.25);
	}

	.panel-body {
		padding: 2rem 2.25rem;
	}

	.panel-intro {
		font-size: 1.03rem;
		line-height: 1.72;
		color: var(--text-secondary);
		margin-bottom: 1.65rem;
	}

	.subgrid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.5rem;
		margin-bottom: 1.75rem;
	}

	.subbox {
		background: var(--bg-secondary);
		border: 1px solid var(--border-color);
		border-radius: 0.85rem;
		padding: 1.35rem 1.45rem;
	}

	.subbox h4 {
		font-size: 1rem;
		color: var(--accent-primary);
		margin-bottom: 0.75rem;
	}

	.subbox ul {
		margin: 0;
		padding-left: 1.15rem;
		color: var(--text-secondary);
		font-size: 0.92rem;
		line-height: 1.62;
	}

	.subbox li {
		margin-bottom: 0.6rem;
	}

	.subbox li:last-child {
		margin-bottom: 0;
	}

	.panel-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	@media (max-width: 820px) {
		.panel-header, .panel-body {
			padding: 1.5rem;
		}
		.subgrid {
			grid-template-columns: 1fr;
		}
	}
</style>
