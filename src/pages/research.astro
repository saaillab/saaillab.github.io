---
import Layout from '../layouts/Layout.astro';
import ModernHeader from '../components/ModernHeader.astro';
import ModernFooter from '../components/ModernFooter.astro';
---

<Layout 
	title="Research - SAAIL Lab"
	description="Explore our cutting-edge research in AI for sustainable agriculture, intelligent healthcare, and responsible AI frameworks at SAAIL Lab, IIT Madras Zanzibar."
>
	<ModernHeader />
	
	<main class="research-page">
		<!-- Hero Section -->
		<section class="research-hero">
			<div class="container">
				<div class="hero-content">
					<div class="hero-badge">SAAIL Lab · IIT Madras Zanzibar</div>
					<h1>Research Areas</h1>
					<p class="hero-description">
						Three transformative research thrusts tackling critical challenges in East Africa
						— from crop intelligence and healthcare imaging to responsible AI for the Global South.
					</p>
					<div class="hero-stats">
						<div class="hstat">
							<span class="hstat-num">33+</span>
							<span class="hstat-lbl">Publications</span>
						</div>
						<div class="hstat-divider"></div>
						<div class="hstat">
							<span class="hstat-num">1,185+</span>
							<span class="hstat-lbl">Citations</span>
						</div>
						<div class="hstat-divider"></div>
						<div class="hstat">
							<span class="hstat-num">4</span>
							<span class="hstat-lbl">Institutions</span>
						</div>
						<div class="hstat-divider"></div>
						<div class="hstat">
							<span class="hstat-num">6+</span>
							<span class="hstat-lbl">Top Venues</span>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Research Areas Section -->
		<section id="areas" class="research-areas">
			<div class="container">
				<div class="areas-grid">
					<div class="research-area primary">
						<div class="area-image area-image--agri">
							<div class="area-image-overlay">
								<div class="area-image-icon">
									<svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" fill="none">
										<circle cx="40" cy="40" r="36" fill="rgba(255,255,255,0.15)" stroke="rgba(255,255,255,0.3)" stroke-width="1.5"/>
										<!-- Leaf -->
										<path d="M40 60 C40 60 20 48 20 32 C20 24 28 16 40 16 C52 16 60 24 60 32 C60 48 40 60 40 60Z" fill="rgba(255,255,255,0.9)" stroke="rgba(255,255,255,1)" stroke-width="1"/>
										<path d="M40 60 L40 32" stroke="#059669" stroke-width="2" stroke-linecap="round"/>
										<path d="M40 44 C36 40 28 38 24 36" stroke="#059669" stroke-width="1.5" stroke-linecap="round"/>
										<path d="M40 38 C44 34 52 32 56 30" stroke="#059669" stroke-width="1.5" stroke-linecap="round"/>
									</svg>
								</div>
								<div class="area-image-text">
									<div class="area-image-label">Research Area 01</div>
									<div class="area-image-title">AI for Agriculture</div>
									<div class="area-image-stat">
										<span class="stat-pill">Clove Grading</span>
										<span class="stat-pill">Computer Vision</span>
										<span class="stat-pill">Food Systems</span>
									</div>
								</div>
							</div>
						</div>
						<div class="area-header">
							<div class="area-icon">🌾</div>
							<h2>AI for Sustainable Agriculture & Food Systems</h2>
						</div>
						<p class="area-description">
							Developing AI solutions to revolutionize agriculture through precision crop management, 
							agricultural data ecosystems, and supply chain innovation.
						</p>
						<div class="area-topics">
							<div class="topic-tag">Precision Crop Management</div>
							<div class="topic-tag">Agricultural Data Ecosystems</div>
							<div class="topic-tag">Supply Chain Innovation</div>
							<div class="topic-tag">International PhD Programs</div>
						</div>
						<div class="area-projects">
							<h4>Current Projects</h4>
							<ul>
								<li><a href="/projects#cloves">Deep Learning for Zanzibar Cloves Quality Grading</a></li>
								<li><a href="/projects#data-ecosystems">Agricultural Data Ecosystems Development</a></li>
								<li><a href="/projects#blockchain">Blockchain for Spice Supply Chain</a></li>
							</ul>
						</div>
					</div>

					<div class="research-area secondary">
						<div class="area-image area-image--health">
							<div class="area-image-overlay">
								<div class="area-image-icon">
									<svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" fill="none">
										<circle cx="40" cy="40" r="36" fill="rgba(255,255,255,0.15)" stroke="rgba(255,255,255,0.3)" stroke-width="1.5"/>
										<!-- Cross -->
										<rect x="33" y="20" width="14" height="40" rx="4" fill="rgba(255,255,255,0.9)"/>
										<rect x="20" y="33" width="40" height="14" rx="4" fill="rgba(255,255,255,0.9)"/>
										<!-- Heartbeat line -->
										<polyline points="8,56 16,56 20,46 24,62 30,50 34,56 46,56 50,44 54,58 60,52 64,56 72,56" stroke="rgba(255,255,255,0.7)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
									</svg>
								</div>
								<div class="area-image-text">
									<div class="area-image-label">Research Area 02</div>
									<div class="area-image-title">Healthcare AI</div>
									<div class="area-image-stat">
										<span class="stat-pill">Medical Imaging</span>
										<span class="stat-pill">Assistive Tech</span>
										<span class="stat-pill">Environmental</span>
									</div>
								</div>
							</div>
						</div>
						<div class="area-header">
							<div class="area-icon">🏥</div>
							<h2>AI for Intelligent & Healthy Livelihoods</h2>
						</div>
						<p class="area-description">
							Leveraging AI expertise for healthcare informatics, assistive technologies, 
							and environmental monitoring to improve quality of life.
						</p>
						<div class="area-topics">
							<div class="topic-tag">Medical Image Analysis</div>
							<div class="topic-tag">Assistive Technologies</div>
							<div class="topic-tag">Environmental AI</div>
							<div class="topic-tag">Healthcare Informatics</div>
						</div>
						<div class="area-projects">
							<h4>Current Projects</h4>
							<ul>
								<li><a href="/projects#placental">Placental Weight & Volume Estimation</a></li>
								<li><a href="/projects#evision">E-Vision: Assistive Technology for Visually Impaired</a></li>
								<li><a href="/projects#air-quality">AI-Driven Air Quality Monitoring</a></li>
							</ul>
						</div>
					</div>

					<div class="research-area tertiary">
						<div class="area-image area-image--ethics">
							<div class="area-image-overlay">
								<div class="area-image-icon">
									<svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" fill="none">
										<circle cx="40" cy="40" r="36" fill="rgba(255,255,255,0.15)" stroke="rgba(255,255,255,0.3)" stroke-width="1.5"/>
										<!-- Network nodes -->
										<circle cx="40" cy="24" r="6" fill="rgba(255,255,255,0.9)"/>
										<circle cx="22" cy="52" r="6" fill="rgba(255,255,255,0.9)"/>
										<circle cx="58" cy="52" r="6" fill="rgba(255,255,255,0.9)"/>
										<line x1="40" y1="30" x2="26" y2="46" stroke="rgba(255,255,255,0.7)" stroke-width="2"/>
										<line x1="40" y1="30" x2="54" y2="46" stroke="rgba(255,255,255,0.7)" stroke-width="2"/>
										<line x1="28" y1="52" x2="52" y2="52" stroke="rgba(255,255,255,0.7)" stroke-width="2"/>
										<!-- Balance beam -->
										<line x1="40" y1="24" x2="40" y2="14" stroke="rgba(255,255,255,0.5)" stroke-width="1.5" stroke-dasharray="2,2"/>
										<line x1="30" y1="14" x2="50" y2="14" stroke="rgba(255,255,255,0.8)" stroke-width="2" stroke-linecap="round"/>
									</svg>
								</div>
								<div class="area-image-text">
									<div class="area-image-label">Research Area 03</div>
									<div class="area-image-title">Responsible AI</div>
									<div class="area-image-stat">
										<span class="stat-pill">CARA-FMs</span>
										<span class="stat-pill">African AI Ethics</span>
										<span class="stat-pill">Fairness</span>
									</div>
								</div>
							</div>
						</div>
						<div class="area-header">
							<div class="area-icon">⚖️</div>
							<h2>Responsible AI Innovation & Ethical Frameworks</h2>
						</div>
						<p class="area-description">
							Developing ethical AI frameworks specifically designed for African contexts, 
							ensuring responsible and contextually-aware AI development.
						</p>
						<div class="area-topics">
							<div class="topic-tag">Ethical AI for Africa</div>
							<div class="topic-tag">Context-Aware Frameworks</div>
							<div class="topic-tag">CARA-FMs Development</div>
							<div class="topic-tag">Responsible Innovation</div>
						</div>
						<div class="area-projects">
							<h4>Current Projects</h4>
							<ul>
								<li><a href="/projects#cara-fm">CARA-FMs Framework Development</a></li>
								<li><a href="/projects#prime-directives">Prime Directives for Responsible AI</a></li>
								<li><a href="/projects#ethical-frameworks">Ethical AI Frameworks for Africa</a></li>
							</ul>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Key Publications Section -->
		<section class="key-pubs-section">
			<div class="container">
				<h2 class="section-title">Selected Publications</h2>
				<p class="section-subtitle">Peer-reviewed work from SAAIL Lab since June 2025</p>
				<div class="pubs-grid">
					<div class="pub-card pub-card--agri">
						<div class="pub-venue">CV4A @ CVPR 2026</div>
						<h3>CLOVES-4603: Benchmarking Classical Texture Features and Fine-Tuned Deep Models for Clove Quality Grading</h3>
						<p class="pub-authors">I. Nyalala, P. Vincent</p>
						<div class="pub-tags">
							<span class="ptag">Agriculture</span>
							<span class="ptag">Computer Vision</span>
						</div>
					</div>
					<div class="pub-card pub-card--ethics">
						<div class="pub-venue">DLI 2026, Lagos · Best Poster Award</div>
						<h3>DGS-Bench: A Benchmark for Deep Grounding and Segmentation in Agricultural Scenes</h3>
						<p class="pub-authors">I. Nyalala</p>
						<div class="pub-tags">
							<span class="ptag">Benchmark</span>
							<span class="ptag">Segmentation</span>
						</div>
					</div>
					<div class="pub-card pub-card--ethics">
						<div class="pub-venue">ICLR 2026 Workshop</div>
						<h3>Unifying Perspectives on Learning Biases: A Data-Centric Intervention for Holistic Fairness, Robustness, and Generalization</h3>
						<p class="pub-authors">P. Vincent, I. Nyalala</p>
						<div class="pub-tags">
							<span class="ptag">Responsible AI</span>
							<span class="ptag">Fairness</span>
						</div>
					</div>
					<div class="pub-card pub-card--agri">
						<div class="pub-venue">DLI 2025, Kigali · Best Poster Award</div>
						<h3>CARA-FMs: Context-Aware and Responsible AI Framework for Foundation Models in East Africa</h3>
						<p class="pub-authors">I. Nyalala</p>
						<div class="pub-tags">
							<span class="ptag">Responsible AI</span>
							<span class="ptag">Foundation Models</span>
						</div>
					</div>
				</div>
				<div class="pubs-cta">
					<a href="/publications" class="btn btn-primary">View All Publications</a>
				</div>
			</div>
		</section>

	</main>

	<ModernFooter />
</Layout>

<style>
	.research-page {
		padding-top: 90px;
	}

	.research-hero {
		background: linear-gradient(135deg, var(--bg-secondary) 0%, var(--bg-tertiary) 100%);
		padding: 4rem 0;
		text-align: center;
	}

	.hero-badge {
		display: inline-block;
		background: var(--accent-blue);
		color: white;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		padding: 0.35rem 1rem;
		border-radius: 100px;
		margin-bottom: 1.25rem;
	}

	.hero-content h1 {
		font-size: 3rem;
		font-weight: 700;
		color: var(--accent-blue);
		margin-bottom: 1.5rem;
	}

	.hero-stats {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 2rem;
		margin-top: 2.5rem;
		flex-wrap: wrap;
	}

	.hstat {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.2rem;
	}

	.hstat-num {
		font-size: 2rem;
		font-weight: 800;
		color: var(--accent-blue);
		line-height: 1;
	}

	.hstat-lbl {
		font-size: 0.8rem;
		font-weight: 500;
		color: var(--text-secondary);
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}

	.hstat-divider {
		width: 1px;
		height: 2.5rem;
		background: var(--text-secondary);
		opacity: 0.2;
	}

	.hero-description {
		font-size: 1.25rem;
		color: var(--text-secondary);
		max-width: 800px;
		margin: 0 auto;
		line-height: 1.7;
	}

	.research-areas {
		padding: 5rem 0;
		background: var(--bg-primary);
	}

	.areas-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 3rem;
	}

	.research-area {
		background: var(--bg-secondary);
		border-radius: 1.5rem;
		padding: 3rem;
		border-left: 6px solid;
		transition: all 0.3s ease;
	}

	.research-area.primary {
		border-left-color: var(--accent-green);
	}

	.research-area.secondary {
		border-left-color: #dc2626;
	}

	.research-area.tertiary {
		border-left-color: #7c3aed;
	}

	.area-image {
		width: 100%;
		height: 200px;
		margin-bottom: 1.5rem;
		border-radius: 1rem;
		overflow: hidden;
		position: relative;
	}

	.area-image--agri {
		background: linear-gradient(135deg, #065f46 0%, #059669 40%, #10b981 100%);
	}

	.area-image--health {
		background: linear-gradient(135deg, #7f1d1d 0%, #dc2626 40%, #f87171 100%);
	}

	.area-image--ethics {
		background: linear-gradient(135deg, #4c1d95 0%, #7c3aed 40%, #a78bfa 100%);
	}

	.area-image::before {
		content: '';
		position: absolute;
		inset: 0;
		background:
			radial-gradient(circle at 80% 20%, rgba(255,255,255,0.12) 0%, transparent 50%),
			radial-gradient(circle at 20% 80%, rgba(255,255,255,0.08) 0%, transparent 40%);
	}

	.area-image-overlay {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		gap: 2rem;
		padding: 1.5rem 2rem;
		transition: transform 0.3s ease;
	}

	.research-area:hover .area-image-overlay {
		transform: scale(1.02);
	}

	.area-image-icon {
		flex-shrink: 0;
		width: 80px;
		height: 80px;
		opacity: 0.95;
	}

	.area-image-icon svg {
		width: 80px;
		height: 80px;
	}

	.area-image-text {
		flex: 1;
		color: white;
	}

	.area-image-label {
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		opacity: 0.7;
		margin-bottom: 0.25rem;
	}

	.area-image-title {
		font-size: 1.6rem;
		font-weight: 800;
		line-height: 1.1;
		margin-bottom: 0.75rem;
		text-shadow: 0 1px 8px rgba(0,0,0,0.25);
	}

	.area-image-stat {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.stat-pill {
		background: rgba(255,255,255,0.2);
		border: 1px solid rgba(255,255,255,0.3);
		color: white;
		font-size: 0.72rem;
		font-weight: 600;
		padding: 0.2rem 0.6rem;
		border-radius: 100px;
		backdrop-filter: blur(4px);
	}

	.research-area:hover {
		transform: translateY(-4px);
		box-shadow: 0 12px 32px var(--shadow-medium);
	}

	.area-header {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 1.5rem;
	}

	.area-icon {
		font-size: 3rem;
	}

	.area-header h2 {
		font-size: 1.75rem;
		font-weight: 700;
		color: var(--text-primary);
	}

	.area-description {
		font-size: 1.125rem;
		color: var(--text-secondary);
		line-height: 1.7;
		margin-bottom: 2rem;
	}

	.area-topics {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-bottom: 2rem;
	}

	.topic-tag {
		background: var(--accent-blue);
		color: white;
		padding: 0.5rem 1rem;
		border-radius: 0.75rem;
		font-size: 0.875rem;
		font-weight: 500;
	}

	.area-projects h4 {
		font-size: 1.25rem;
		font-weight: 600;
		color: var(--text-primary);
		margin-bottom: 1rem;
	}

	.area-projects ul {
		list-style: none;
		padding: 0;
	}

	.area-projects li {
		margin-bottom: 0.75rem;
	}

	.area-projects a {
		color: var(--accent-blue);
		text-decoration: none;
		font-weight: 500;
		transition: color 0.3s ease;
	}

	.area-projects a:hover {
		color: var(--accent-green);
		text-decoration: underline;
	}

	.collaborations {
		padding: 5rem 0;
		background: var(--bg-secondary);
	}

	.section-title {
		text-align: center;
		font-size: 2.5rem;
		font-weight: 700;
		color: var(--accent-blue);
		margin-bottom: 1rem;
	}

	.section-description {
		text-align: center;
		font-size: 1.125rem;
		color: var(--text-secondary);
		max-width: 800px;
		margin: 0 auto 3rem;
		line-height: 1.7;
	}

	.collaborations-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
		gap: 2rem;
	}

	.collaboration-card {
		background: var(--bg-primary);
		border-radius: 1.5rem;
		padding: 2rem;
		text-align: center;
		box-shadow: 0 4px 12px var(--shadow-light);
		border: 1px solid var(--border-color);
		transition: all 0.3s ease;
	}

	.collaboration-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 8px 20px var(--shadow-medium);
	}

	.collab-flag {
		font-size: 3rem;
		margin-bottom: 1rem;
	}

	.collaboration-card h3 {
		font-size: 1.25rem;
		font-weight: 600;
		color: var(--text-primary);
		margin-bottom: 0.5rem;
	}

	.collab-location {
		color: var(--text-muted);
		font-weight: 500;
		margin-bottom: 1rem;
	}

	.collab-project {
		color: var(--text-secondary);
		line-height: 1.6;
		margin-bottom: 1.5rem;
		font-size: 0.875rem;
	}

	.collab-details {
		display: flex;
		justify-content: center;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.collab-status,
	.collab-type {
		padding: 0.25rem 0.75rem;
		border-radius: 0.5rem;
		font-size: 0.75rem;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.collab-status.active {
		background: #dcfce7;
		color: #166534;
	}

	.collab-status.initiating {
		background: #fef3c7;
		color: #d97706;
	}

	.collab-status.ongoing {
		background: #e0f2fe;
		color: #0369a1;
	}

	.collab-type {
		background: var(--bg-tertiary);
		color: var(--text-secondary);
	}

	@media (max-width: 768px) {
		.research-page {
			padding-top: 80px;
		}

		.research-hero {
			padding: 3rem 0;
		}

		.hero-content h1 {
			font-size: 2.5rem;
		}

		.hero-description {
			font-size: 1rem;
		}

		.research-areas {
			padding: 3rem 0;
		}

		.research-area {
			padding: 2rem 1.5rem;
		}

		.area-header {
			flex-direction: column;
			text-align: center;
			gap: 0.75rem;
		}

		.area-header h2 {
			font-size: 1.5rem;
		}

		.area-description {
			font-size: 1rem;
		}

		.area-topics {
			justify-content: center;
		}

		.area-image {
			height: 160px;
		}

		.area-image-overlay {
			gap: 1rem;
			padding: 1rem 1.25rem;
		}

		.area-image-icon {
			width: 56px;
			height: 56px;
		}

		.area-image-icon svg {
			width: 56px;
			height: 56px;
		}

		.area-image-title {
			font-size: 1.2rem;
		}

		.pubs-grid {
			grid-template-columns: 1fr;
		}

		.collaborations-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 480px) {
		.research-page {
			padding-top: 70px;
		}

		.research-hero {
			padding: 2rem 0;
		}

		.hero-content h1 {
			font-size: 2rem;
		}

		.hero-description {
