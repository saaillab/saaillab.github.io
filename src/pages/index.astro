---
import Layout from '../layouts/Layout.astro';
import ModernHeader from '../components/ModernHeader.astro';
import ModernFooter from '../components/ModernFooter.astro';
import metrics from '../data/scholar-metrics.json';
import { PUBLICATIONS } from '../data/publications';

const featuredSlugs = [
	'clove-xai-etri2026',
	'dgs-bench',
	'cloves-4603',
	'cropguardnet',
	'cara-fm',
	'cassava-weakened-signals-2025',
	'bafnet-polyp-2025'
];
const saailPubCount = PUBLICATIONS.filter((p) => p.isSaailLab !== false).length;
const featuredPubs = featuredSlugs
	.map((slug) => PUBLICATIONS.find((p) => p.slug === slug))
	.filter((p): p is NonNullable<typeof p> => Boolean(p));
---

<Layout
	title="SAAIL Lab | Sustainable AI for Agriculture & Intelligent Livelihoods"
	description="SAAIL Lab at IIT Madras Zanzibar and WSDSAI IIT Madras. Research in precision agriculture, Swahili NLP and AI safety (CultureSEEDS), responsible computer vision, and healthcare AI."
>
	<ModernHeader currentPage="home" />

	<main>
		<!-- Swiss Architectural Hero -->
		<section class="hero">
			<div class="container">
				<div class="hero-grid">
					<div class="hero-copy">
						<div class="hero-pill">
							<img src="/images/logo/saail-crest.png" alt="SAAIL Crest" width="22" height="22" />
							<span>IIT Madras Zanzibar &amp; WSDSAI IIT Madras</span>
						</div>

						<h1 class="hero-title">
							Ground-Truth AI for East Africa's Crops, Languages, and Health
						</h1>

						<p class="hero-lead">
							The Sustainable AI for Agriculture &amp; Intelligent Livelihoods (SAAIL) Lab designs compact, explainable computer vision systems, culturally grounded Swahili language benchmarks, and reliable clinical models engineered for real-world deployment across Africa and the Global South.
						</p>

						<div class="hero-actions">
							<a href="/research" class="btn btn-primary">Explore Research Pillars &rarr;</a>
							<a href="/publications" class="btn btn-secondary">All {saailPubCount} SAAIL Lab Papers</a>
							<a href="/projects" class="hero-text-link">Active Grants &amp; Projects &rarr;</a>
						</div>

						<!-- Auto-Synced Scholar & Lab Impact Bar -->
						<div class="impact-bar" aria-label="Verified Research Impact">
							<a
								href="https://scholar.google.com/citations?user=jYVzIZUAAAAJ&hl=en"
								target="_blank"
								rel="noopener"
								class="impact-stat impact-stat-link"
								title={`Auto-synced from Google Scholar (${metrics.updatedAt})`}
							>
								<span class="impact-num">{metrics.citations.toLocaleString()}</span>
								<span class="impact-lbl">Scholar Citations</span>
								<span class="impact-sub">h-index {metrics.hIndex} · i10 {metrics.i10Index}</span>
							</a>
							<div class="impact-stat">
								<span class="impact-num">{metrics.saailPublishedCount} + {metrics.saailUnderReviewCount}</span>
								<span class="impact-lbl">SAAIL Lab Papers</span>
								<span class="impact-sub">Published · Under Review</span>
							</div>
							<div class="impact-stat">
								<span class="impact-num">US$120K+</span>
								<span class="impact-lbl">Funded Grants</span>
								<span class="impact-sub">Google · ICSR · IITMZ</span>
							</div>
							<div class="impact-stat">
								<span class="impact-num">2x Best</span>
								<span class="impact-lbl">DL Indaba Posters</span>
								<span class="impact-sub">Kigali 2025 · Lagos 2026</span>
							</div>
						</div>
					</div>

					<!-- Visual Evidence Column: True Submitted Architecture + Flagship Highlights -->
					<div class="hero-visual">
						<a href="/papers/cropguardnet/" class="architecture-frame" aria-label="View CropGuardNet project page">
							<div class="frame-header">
								<span class="frame-tag">Flagship System · Under Peer Review</span>
								<span class="frame-spec">481.6K Params · 5.00 ms ONNX</span>
							</div>
							<img
								src="/images/papers/cropguardnet/architecture.png"
								alt="CropGuardNet Unified Lightweight CNN-Transformer Architecture"
								class="architecture-img"
								loading="eager"
							/>
							<div class="frame-footer">
								<span>CropGuardNet: Leak-free cross-crop diagnostics across 35,420 unique leaf images</span>
								<span class="frame-link">Project Page &rarr;</span>
							</div>
						</a>

						<div class="mini-highlights">
							<a href="/papers/clove-xai-etri2026/" class="mini-card">
								<span class="mini-kicker">ETRI Journal 2026 · Q2 SCI</span>
								<strong>Explainable Clove Grading (EER 100%)</strong>
								<span>DOI: 10.4218/etrij.2026-0225</span>
							</a>
							<a href="/projects#cultureseeds" class="mini-card mini-card-gold">
								<span class="mini-kicker">Google Award · US$100,000</span>
								<strong>CultureSEEDS East Africa &amp; Swahili</strong>
								<span>Safety &amp; Cultural Evaluation across 10 Languages</span>
							</a>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Four Core Research Pillars -->
		<section class="section pillars-band">
			<div class="container">
				<div class="section-head">
					<span class="page-eyebrow">Scientific Agenda</span>
					<h2 class="section-title-left">Four Integrated Research Pillars</h2>
					<p class="section-lead">
						Our work bridges agricultural sensing, Swahili language technology, verifiable AI alignment, and maternal healthcare under severe compute and data constraints.
					</p>
				</div>

				<div class="pillars-grid">
					<article class="pillar-card">
						<div class="pillar-top">
							<span class="pillar-num">01</span>
							<span class="pillar-tag">Flagship Domain</span>
						</div>
						<h3>AI for Precision Agriculture &amp; Blue Economy</h3>
						<p>
							Phenology-aware orchard monitoring (CashewAI), Zanzibar spice inspection (CLOVES-4603, ZSTC-Clove-V1), coastal seaweed Ice-Ice and ocean heatwave modeling, and unified cross-crop leaf pathology (CropGuardNet) plus aquaculture and coral health monitoring.
						</p>
						<div class="pillar-meta">
							<span>Cashew</span><span>Cloves</span><span>Seaweed</span><span>Cassava &amp; Maize</span>
						</div>
						<a href="/research#agriculture" class="pillar-link">Explore Agriculture &amp; Blue Economy &rarr;</a>
					</article>

					<article class="pillar-card">
						<div class="pillar-top">
							<span class="pillar-num">02</span>
							<span class="pillar-tag pillar-tag-gold">Google Award · US$100K</span>
						</div>
						<h3>Swahili NLP, Language Data &amp; Cultural AI Safety</h3>
						<p>
							Co-leading East African safety evaluation with Google DeepMind and Google.org CultureSEEDS across 10 African languages anchored in Swahili. Building the Zanzibar Swahili Corpus, spoken domain QA, and the Dira native-vs-translated Swahili provenance benchmark.
						</p>
						<div class="pillar-meta">
							<span>CultureSEEDS</span><span>Swahili Corpus</span><span>Dira Benchmark</span><span>Spoken QA</span>
						</div>
						<a href="/research#language" class="pillar-link">Explore Language &amp; Safety &rarr;</a>
					</article>

					<article class="pillar-card">
						<div class="pillar-top">
							<span class="pillar-num">03</span>
							<span class="pillar-tag">2x DLI Best Poster</span>
						</div>
						<h3>Responsible AI, Explainability &amp; Sovereign Policy</h3>
						<p>
							Formalizing the deployment gap evaluation mirage (DGS-Bench), procedural compositional XAI (ETRI 2026), few-shot and generative data boundaries (DSA 2026), CARA-FM edge compression principles (PMLR 302), and East African AI policy harmonization (Oxford TAIS 2026).
						</p>
						<div class="pillar-meta">
							<span>DGS-Bench</span><span>EER Audit</span><span>CARA-FM</span><span>EAC Sovereignty</span>
						</div>
						<a href="/research#responsible" class="pillar-link">Explore Responsible AI &rarr;</a>
					</article>

					<article class="pillar-card">
						<div class="pillar-top">
							<span class="pillar-num">04</span>
							<span class="pillar-tag">Clinical &amp; Assistive</span>
						</div>
						<h3>Healthcare AI &amp; Assistive Technologies</h3>
						<p>
							Multi-institutional clinical machine learning with Penn State University (PlacentaVision imaging), Pemba Center for Public Health Kinetics (preterm birth biomarkers), colorectal polyp boundary segmentation (BAFNet, ESWA 2025), and E-Vision on-device spatial assistance.
						</p>
						<div class="pillar-meta">
							<span>PlacentaVision</span><span>BAFNet (IF 7.5)</span><span>Preterm ML</span><span>E-Vision App</span>
						</div>
						<a href="/research#healthcare" class="pillar-link">Explore Healthcare &amp; Assistive AI &rarr;</a>
					</article>
				</div>
			</div>
		</section>

		<!-- Selected Publications Ledger -->
		<section class="section">
			<div class="container">
				<div class="ledger-header">
					<div>
						<span class="page-eyebrow">Peer-Reviewed Outputs</span>
						<h2 class="section-title-left">Selected Recent Publications</h2>
					</div>
					<a href="/publications" class="btn btn-secondary">Explore All {saailPubCount} Lab &amp; {PUBLICATIONS.length - saailPubCount} Prior Papers &rarr;</a>
				</div>

				<div class="pub-ledger">
					{featuredPubs.map((pub) => {
						const cleanDoi = pub.doi ? pub.doi.replace(/^https?:\/\/(dx\.)?doi\.org\//i, '').trim() : '';
						return (
							<article class="ledger-row">
								<div class="ledger-meta">
									<span class="ledger-year">{pub.year}</span>
									<span class="ledger-venue">{pub.venueShort}</span>
									{pub.award && <span class="ledger-award">{pub.award}</span>}
								</div>
								<div class="ledger-main">
									<h3>
										<a href={`/papers/${pub.slug}/`}>{pub.title}</a>
									</h3>
									<p class="ledger-authors">{pub.authors.map((a) => a.name).join(', ')}</p>
									<p class="ledger-tldr">{pub.tldr}</p>
								</div>
								<div class="ledger-links">
									<a href={`/papers/${pub.slug}/`} class="pill-btn pill-primary">Project Page</a>
									{cleanDoi && (
										<a href={`https://doi.org/${cleanDoi}`} target="_blank" rel="noopener" class="pill-btn">DOI</a>
									)}
									{pub.codeUrl && (
										<a href={pub.codeUrl} target="_blank" rel="noopener" class="pill-btn">Code</a>
									)}
								</div>
							</article>
						);
					})}
				</div>
			</div>
		</section>

		<!-- Institutional Lockup & Collaborations Band -->
		<section class="section closing-band">
			<div class="container">
				<div class="closing-grid">
					<div class="closing-left">
						<span class="page-eyebrow">Campus &amp; Partnerships</span>
						<h2>Anchored in Zanzibar, Collaborating Globally</h2>
						<p>
							SAAIL Lab operates jointly across IIT Madras Zanzibar and WSDSAI IIT Madras Chennai, uniting MTech and BTech researchers with partners at Google DeepMind, Penn State University, University of Cambridge, Deakin University, and the Zanzibar State Trading Corporation (ZSTC).
						</p>
						<div class="logo-lockup">
							<img src="/images/logo/iitmz-logo.png" alt="IIT Madras Zanzibar" />
							<img src="/images/logo/wsai-logo.png" alt="Wadhwani School of Data Science and AI IIT Madras" />
						</div>
					</div>
					<div class="closing-right">
						<div class="closing-stats">
							<div><strong>5</strong><span>PhD Candidates</span></div>
							<div><strong>3</strong><span>Current MTech</span></div>
							<div><strong>8</strong><span>BS / BTech Researchers</span></div>
							<div><strong>4</strong><span>Graduated Alumni</span></div>
						</div>
						<div class="closing-btns">
							<a href="/people" class="btn btn-primary">Meet Our People</a>
							<a href="/tools" class="btn btn-secondary">Mobile Apps &amp; Software</a>
							<a href="/hiring" class="btn btn-secondary">Open Positions</a>
						</div>
					</div>
				</div>
			</div>
		</section>
	</main>

	<ModernFooter />
</Layout>

<style>
	.hero {
		padding: 3.75rem 0 4rem;
		background: linear-gradient(180deg, var(--bg-secondary) 0%, var(--bg-primary) 100%);
		border-bottom: 1px solid var(--border-color);
	}

	.hero-grid {
		display: grid;
		grid-template-columns: 1.05fr 0.95fr;
		gap: 3rem;
		align-items: start;
	}

	.hero-pill {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.35rem 0.9rem 0.35rem 0.5rem;
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		border-radius: 999px;
		font-size: 0.82rem;
		font-weight: 700;
		color: var(--accent-primary);
		margin-bottom: 1.25rem;
	}

	.hero-pill img {
		border-radius: 50%;
	}

	.hero-title {
		font-size: clamp(2.1rem, 4vw, 3.1rem);
		font-weight: 800;
		line-height: 1.12;
		color: var(--text-primary);
		margin-bottom: 1.25rem;
	}

	.hero-lead {
		font-size: 1.08rem;
		line-height: 1.7;
		color: var(--text-secondary);
		margin-bottom: 1.75rem;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.85rem;
		margin-bottom: 2.25rem;
	}

	.hero-text-link {
		font-size: 0.94rem;
		font-weight: 600;
		color: var(--accent-primary);
		text-decoration: none;
		padding: 0.4rem 0.5rem;
	}

	.hero-text-link:hover {
		text-decoration: underline;
	}

	.impact-bar {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.75rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--border-color);
	}

	.impact-stat {
		display: flex;
		flex-direction: column;
		text-decoration: none;
		padding: 0.65rem 0.75rem;
		border-radius: 0.75rem;
		background: var(--bg-card);
		border: 1px solid var(--border-color);
	}

	.impact-stat-link:hover {
		border-color: var(--accent-primary);
	}

	.impact-num {
		font-family: 'Plus Jakarta Sans', sans-serif;
		font-size: 1.35rem;
		font-weight: 800;
		color: var(--accent-primary);
		font-variant-numeric: tabular-nums;
	}

	.impact-lbl {
		font-size: 0.78rem;
		font-weight: 700;
		color: var(--text-primary);
		margin-top: 0.1rem;
	}

	.impact-sub {
		font-size: 0.7rem;
		color: var(--text-muted);
	}

	/* Visual Showcase */
	.hero-visual {
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
	}

	.architecture-frame {
		display: block;
		background: #ffffff;
		border: 1px solid var(--border-color);
		border-radius: 1rem;
		overflow: hidden;
		text-decoration: none;
		box-shadow: 0 12px 30px var(--shadow-light);
		transition: transform 0.22s ease, box-shadow 0.22s ease;
	}

	.architecture-frame:hover {
		transform: translateY(-3px);
		box-shadow: 0 18px 36px var(--shadow-medium);
	}

	.frame-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.5rem;
		padding: 0.65rem 1rem;
		background: #f7f7f2;
		border-bottom: 1px solid #e5e8e1;
		font-size: 0.75rem;
		font-weight: 700;
		color: #0c1a12;
	}

	.frame-spec {
		color: #14532d;
		font-family: 'JetBrains Mono', monospace;
	}

	.architecture-img {
		width: 100%;
		height: auto;
		max-height: 290px;
		object-fit: contain;
		padding: 0.65rem;
		background: #ffffff;
	}

	.frame-footer {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.75rem;
		padding: 0.65rem 1rem;
		border-top: 1px solid #e5e8e1;
		font-size: 0.78rem;
		color: #2b3a32;
	}

	.frame-link {
		font-weight: 700;
		color: #14532d;
		white-space: nowrap;
	}

	.mini-highlights {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.85rem;
	}

	.mini-card {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		padding: 0.9rem 1rem;
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		border-left: 3px solid var(--accent-primary);
		border-radius: 0.75rem;
		text-decoration: none;
		color: var(--text-primary);
		transition: transform 0.18s ease, border-color 0.18s ease;
	}

	.mini-card:hover {
		transform: translateY(-2px);
		border-color: var(--accent-primary);
	}

	.mini-card-gold {
		border-left-color: var(--accent-gold);
	}

	.mini-kicker {
		font-size: 0.7rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--accent-primary);
	}

	.mini-card-gold .mini-kicker {
		color: var(--accent-gold);
	}

	.mini-card strong {
		font-size: 0.88rem;
		line-height: 1.3;
	}

	.mini-card span:last-child {
		font-size: 0.75rem;
		color: var(--text-muted);
	}

	/* Section Helpers */
	.section-head {
		max-width: 720px;
		margin-bottom: 2.5rem;
	}

	.section-title-left {
		font-size: clamp(1.75rem, 3vw, 2.3rem);
		font-weight: 800;
		color: var(--text-primary);
		margin-bottom: 0.65rem;
	}

	.section-lead {
		font-size: 1.05rem;
		color: var(--text-secondary);
		line-height: 1.65;
	}

	/* Pillars */
	.pillars-band {
		background: var(--bg-secondary);
		border-bottom: 1px solid var(--border-color);
	}

	.pillars-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.5rem;
	}

	.pillar-card {
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		border-radius: 1rem;
		padding: 1.75rem;
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.pillar-card:hover {
		transform: translateY(-3px);
		box-shadow: 0 12px 26px var(--shadow-light);
	}

	.pillar-top {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.pillar-num {
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.82rem;
		font-weight: 700;
		color: var(--accent-primary);
	}

	.pillar-tag {
		font-size: 0.72rem;
		font-weight: 700;
		padding: 0.2rem 0.6rem;
		border-radius: 999px;
		background: rgba(20, 83, 45, 0.1);
		color: var(--accent-primary);
	}

	.pillar-tag-gold {
		background: rgba(180, 83, 9, 0.12);
		color: var(--accent-gold);
	}

	.pillar-card h3 {
		font-size: 1.25rem;
		color: var(--text-primary);
	}

	.pillar-card p {
		font-size: 0.95rem;
		color: var(--text-secondary);
		line-height: 1.65;
		flex: 1;
	}

	.pillar-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.pillar-meta span {
		font-size: 0.74rem;
		font-weight: 600;
		padding: 0.2rem 0.55rem;
		border-radius: 6px;
		background: var(--bg-secondary);
		border: 1px solid var(--border-color);
		color: var(--text-secondary);
	}

	.pillar-link {
		font-size: 0.88rem;
		font-weight: 700;
		color: var(--accent-primary);
		text-decoration: none;
		padding-top: 0.35rem;
	}

	.pillar-link:hover {
		text-decoration: underline;
	}

	/* Publication Ledger */
	.ledger-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		flex-wrap: wrap;
		gap: 1rem;
		margin-bottom: 2rem;
	}

	.pub-ledger {
		border: 1px solid var(--border-color);
		border-radius: 1rem;
		background: var(--bg-card);
		overflow: hidden;
	}

	.ledger-row {
		display: grid;
		grid-template-columns: 200px 1fr auto;
		gap: 1.5rem;
		align-items: start;
		padding: 1.4rem 1.6rem;
		border-bottom: 1px solid var(--border-color);
	}

	.ledger-row:last-child {
		border-bottom: none;
	}

	.ledger-meta {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.ledger-year {
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.82rem;
		font-weight: 700;
		color: var(--accent-primary);
	}

	.ledger-venue {
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--text-primary);
	}

	.ledger-award {
		display: inline-block;
		width: fit-content;
		font-size: 0.7rem;
		font-weight: 700;
		padding: 0.15rem 0.5rem;
		border-radius: 6px;
		background: rgba(180, 83, 9, 0.12);
		color: var(--accent-gold);
	}

	.ledger-main h3 {
		font-size: 1.05rem;
		margin-bottom: 0.3rem;
		line-height: 1.38;
	}

	.ledger-main h3 a {
		color: var(--text-primary);
		text-decoration: none;
	}

	.ledger-main h3 a:hover {
		color: var(--accent-primary);
		text-decoration: underline;
	}

	.ledger-authors {
		font-size: 0.84rem;
