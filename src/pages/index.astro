---
import Layout from '../layouts/Layout.astro';
import ModernHeader from '../components/ModernHeader.astro';
import ModernFooter from '../components/ModernFooter.astro';
import metrics from '../data/scholar-metrics.json';
import { PUBLICATIONS } from '../data/publications';

const featuredSlugs = [
	'cropguardnet',
	'clove-xai-etri2026',
	'dgs-bench',
	'cloves-4603',
	'cara-fm',
	'cassava-weakened-signals-2025',
	'bafnet-polyp-2025'
];
const saailPubCount = PUBLICATIONS.filter((p) => p.isSaailLab !== false).length;
const featuredPubs = featuredSlugs
	.map((slug) => PUBLICATIONS.find((p) => p.slug === slug))
	.filter((p): p is NonNullable<typeof p> => Boolean(p));
---

<Layout
	title="SAAIL Lab | AI Research Lab in Zanzibar · IIT Madras Zanzibar"
	description="SAAIL Lab (Sustainable AI for Agriculture & Intelligent Livelihoods) at IIT Madras Zanzibar, directed by Innocent Nyalala. Flagship AI, deep learning, machine learning, computer vision, Swahili NLP, agricultural AI, and healthcare AI research group in Zanzibar, Tanzania, and East Africa."
	canonical="https://saaillab.github.io/"
>
	<ModernHeader currentPage="home" />

	<main id="main-content">
		<!-- Balanced Architectural Hero -->
		<section class="hero">
			<div class="container">
				<div class="hero-grid">
					<div class="hero-copy">
						<div class="hero-pill">
							<img src="/images/logo/saail-crest.png" alt="SAAIL Lab IIT Madras Zanzibar AI Research Emblem" width="22" height="22" />
							<span>AI Research Lab · IIT Madras Zanzibar, Tanzania</span>
						</div>

						<h1 class="hero-title">
							AI and Deep Learning for East Africa's Crops, Languages, and Health
						</h1>

						<p class="hero-lead">
							Directed by <a href="/people/" class="inline-link">Innocent Nyalala</a> at IIT Madras Zanzibar, the Sustainable AI for Agriculture &amp; Intelligent Livelihoods (SAAIL) Lab engineers lightweight deep learning, machine learning, and computer vision models, Swahili NLP benchmarks, and clinical AI systems for real-world deployment across Zanzibar, Tanzania, and East Africa.
						</p>

						<div class="hero-actions">
							<a href="/research/" class="btn btn-primary">Explore Research Pillars &rarr;</a>
							<a href="/publications/" class="btn btn-secondary">All {saailPubCount} SAAIL Lab Papers</a>
							<a href="/projects/" class="hero-text-link">Active Grants &amp; Projects &rarr;</a>
						</div>
					</div>

					<!-- Prominent Full-Visibility Hero Visual (NOT squished by sub-cards) -->
					<div class="hero-visual">
						<a href="/papers/cropguardnet/" class="architecture-frame" aria-label="View CropGuardNet project page">
							<div class="frame-header">
								<span class="frame-tag">Flagship System · Manuscript Under Review</span>
								<span class="frame-spec">481.6K Params · 63.8M FLOPs · 5.00 ms ONNX</span>
							</div>
							<div class="frame-img-wrap">
								<img
									src="/images/papers/cropguardnet/architecture.png"
									alt="CropGuardNet Unified Lightweight CNN-Transformer Architecture"
									class="architecture-img"
									loading="eager"
								/>
							</div>
							<div class="frame-footer">
								<span>CropGuardNet: Leak-free cross-crop diagnostics across 35,420 unique leaf images</span>
								<span class="frame-link">Open Paper Page &rarr;</span>
							</div>
						</a>
					</div>
				</div>

				<!-- Full-Width Verified Impact Bar (Zero cramping, zero dead left whitespace) -->
				<div class="impact-bar" aria-label="Verified Research Impact">
					<a
						href="https://scholar.google.com/citations?user=jYVzIZUAAAAJ&hl=en"
						target="_blank"
						rel="noopener"
						class="impact-stat impact-stat-link"
						title={`Google Scholar Live Profile (${metrics.updatedAt})`}
					>
						<span class="impact-num">{metrics.citations.toLocaleString()}</span>
						<span class="impact-lbl">PI Career Citations ↗</span>
						<span class="impact-sub">h-index {metrics.hIndex} · i10 {metrics.i10Index}</span>
					</a>
					<a href="/publications/" class="impact-stat impact-stat-link">
						<span class="impact-num">{metrics.saailPublishedCount} + {metrics.saailUnderReviewCount}</span>
						<span class="impact-lbl">SAAIL Lab Papers</span>
						<span class="impact-sub">Published · Under Review</span>
					</a>
					<a href="/projects/" class="impact-stat impact-stat-link">
						<span class="impact-num">7 Programs</span>
						<span class="impact-lbl">Active Initiatives</span>
						<span class="impact-sub">ICSR · AI4EAC · Consortia</span>
					</a>
					<a href="/gallery/" class="impact-stat impact-stat-link">
						<span class="impact-num">2x Best</span>
						<span class="impact-lbl">DL Indaba Posters</span>
						<span class="impact-sub">Kigali 2025 · Lagos 2026</span>
					</a>
				</div>

				<!-- Full-Width Featured Milestones Strip (moved cleanly below Hero as requested) -->
				<div class="milestones-strip">
					<a href="/papers/clove-xai-etri2026/" class="milestone-card">
						<div class="ms-meta">
							<span class="ms-kicker">ETRI Journal 2026 · Q2 SCI</span>
							<span class="ms-arrow">&rarr;</span>
						</div>
						<strong>Explainable Clove Quality Grading (EER 100%)</strong>
						<p>Segmentation-first compositional vision eliminates background shortcuts across Zanzibar cloves.</p>
						<span class="ms-foot">DOI ↗ · Paper Summary</span>
					</a>

					<a href="/projects/swahili-dira/" class="milestone-card milestone-card-gold">
						<div class="ms-meta">
							<span class="ms-kicker">Flagship NLP Benchmark</span>
							<span class="ms-arrow">&rarr;</span>
						</div>
						<strong>Zanzibar Swahili Corpus &amp; Dira Benchmark</strong>
						<p>Curating coastal Kiunguja prose, spoken agricultural QA, and translationese provenance detectors.</p>
						<span class="ms-foot">Dedicated Project Website</span>
					</a>

					<a href="/papers/dgs-bench/" class="milestone-card">
						<div class="ms-meta">
							<span class="ms-kicker">Deep Learning Indaba 2026 · Best Poster</span>
							<span class="ms-arrow">&rarr;</span>
						</div>
						<strong>DGS-Bench: Balanced Deployment Gap Metrics</strong>
						<p>Selected 18 of 114 submissions; exposes -6.00 pp accuracy mirages on smallholder cassava fields.</p>
						<span class="ms-foot">Poster &amp; Code</span>
					</a>
				</div>
			</div>
		</section>

		<!-- Four Core Research Pillars (Preserved 2x2 Editorial Grid) -->
		<section class="section pillars-band">
			<div class="container">
				<div class="section-head">
					<span class="page-eyebrow">Scientific Agenda</span>
					<h2 class="section-title-left">Four Integrated Research Pillars</h2>
					<p class="section-lead">
						Our work bridges agricultural sensing, Swahili language technology, verifiable AI alignment, and maternal clinical modeling under real-world resource constraints.
					</p>
				</div>

				<div class="pillars-grid">
					<article class="pillar-card">
						<div class="pillar-top">
							<span class="pillar-num">01</span>
							<span class="pillar-tag">Flagship Domain</span>
						</div>
						<h3>AI for Precision Agriculture &amp; Blue Economy</h3>
						<p>
							Deep learning and computer vision systems for Tanzanian cashew orchard monitoring (CashewAI), Zanzibar clove grading (CLOVES-4603, ZSTC-Clove-V1), coastal seaweed Ice-Ice disease and marine heatwave modeling, and unified cross-crop leaf pathology (CropGuardNet).
						</p>
						<div class="pillar-meta">
							<span>Cashew</span><span>Cloves</span><span>Seaweed</span><span>Cassava &amp; Maize</span>
						</div>
						<a href="/projects/cropguard-pathology/" class="pillar-link">Explore Agriculture &amp; Pathology Projects &rarr;</a>
					</article>

					<article class="pillar-card">
						<div class="pillar-top">
							<span class="pillar-num">02</span>
							<span class="pillar-tag pillar-tag-gold">Flagship NLP Benchmark</span>
						</div>
						<h3>Swahili NLP, Language Data &amp; Cultural Alignment</h3>
						<p>
							Building the Zanzibar Swahili Corpus across coastal Kiunguja prose and spoken agricultural QA, pairing the Dira native-vs-translated Swahili provenance benchmark with resource-aware East African foundation model frameworks (CARA-FM, PMLR 302).
						</p>
						<div class="pillar-meta">
							<span>Swahili Corpus</span><span>Dira Benchmark</span><span>Spoken QA</span><span>CARA-FM</span>
						</div>
						<a href="/projects/swahili-dira/" class="pillar-link">Explore Swahili Corpus &amp; Dira &rarr;</a>
					</article>

					<article class="pillar-card">
						<div class="pillar-top">
							<span class="pillar-num">03</span>
							<span class="pillar-tag">2x DLI Best Poster</span>
						</div>
						<h3>Responsible AI, Explainability &amp; Sovereign Policy</h3>
						<p>
							Formalizing the deployment gap evaluation mirage (DGS-Bench), procedural compositional XAI (ETRI 2026), few-shot and generative data boundaries (DSA 2026), CARA-FM edge compression principles (PMLR 302), and East African AI policy harmonization (Oxford TAIS 2026).
						</p>
						<div class="pillar-meta">
							<span>DGS-Bench</span><span>EER Audit</span><span>CARA-FM</span><span>EAC Sovereignty</span>
						</div>
						<a href="/papers/dgs-bench/" class="pillar-link">Explore DGS-Bench &amp; Audits &rarr;</a>
					</article>

					<article class="pillar-card">
						<div class="pillar-top">
							<span class="pillar-num">04</span>
							<span class="pillar-tag">Clinical &amp; Public Health</span>
						</div>
						<h3>Healthcare &amp; Clinical AI</h3>
						<p>
							Multi-institutional clinical machine learning with Penn State University (PlacentaVision imaging), Pemba Center for Public Health Kinetics (preterm birth serum biomarkers), colorectal polyp boundary segmentation (BAFNet, ESWA 2025), and privacy-preserving federated training.
						</p>
						<div class="pillar-meta">
							<span>PlacentaVision</span><span>BAFNet (IF 7.5)</span><span>Preterm ML</span><span>Clinical Privacy</span>
						</div>
						<a href="/projects/placentavision/" class="pillar-link">Explore Clinical AI Consortium &rarr;</a>
					</article>
				</div>
			</div>
		</section>

		<!-- Selected Publications Ledger -->
		<section class="section">
			<div class="container">
				<div class="ledger-header">
					<div>
						<span class="page-eyebrow">Peer-Reviewed Outputs</span>
						<h2 class="section-title-left">Selected Recent Publications</h2>
					</div>
					<a href="/publications/" class="btn btn-secondary">Explore All {saailPubCount} Lab &amp; {PUBLICATIONS.length - saailPubCount} Prior Papers &rarr;</a>
				</div>

				<div class="pub-ledger">
					{featuredPubs.map((pub) => {
						const cleanDoi = pub.doi ? pub.doi.replace(/^https?:\/\/(dx\.)?doi\.org\//i, '').trim() : '';
						return (
							<article class="ledger-row">
								<div class="ledger-meta">
									<span class="ledger-year">{pub.year}</span>
									<span class="ledger-venue">{pub.venueShort}</span>
									{pub.award && <span class="ledger-award">{pub.award}</span>}
								</div>
								<div class="ledger-main">
									<h3>
										<a href={`/papers/${pub.slug}/`}>{pub.title}</a>
									</h3>
									<p class="ledger-authors">
										{pub.authors.map((a, i) => (
											<>
												{a.name === 'Innocent Nyalala' ? (
													<strong class="pi-name">{a.name}</strong>
												) : (
													<span>{a.name}</span>
												)}
												{i < pub.authors.length - 1 ? ', ' : ''}
											</>
										))}
									</p>
									<p class="ledger-tldr">{pub.tldr}</p>
								</div>
								<div class="ledger-links">
									<a href={`/papers/${pub.slug}/`} class="pill-btn pill-primary">Project Page</a>
									{cleanDoi && (
										<a href={`https://doi.org/${cleanDoi}`} target="_blank" rel="noopener" class="pill-btn">DOI ↗</a>
									)}
									{pub.codeUrl && (
										<a href={pub.codeUrl} target="_blank" rel="noopener" class="pill-btn">Code ↗</a>
									)}
								</div>
							</article>
						);
					})}
				</div>
			</div>
		</section>

		<!-- FAQ Section + Structured FAQPage Schema for Search & AI Discovery -->
		<section class="section faq-band" aria-labelledby="faq-heading">
			<div class="container">
				<div class="section-head">
					<span class="page-eyebrow">Laboratory Overview</span>
					<h2 id="faq-heading" class="section-title-left">AI Research at IIT Madras Zanzibar: Common Questions</h2>
					<p class="section-lead">Key facts about SAAIL Lab, research focus areas in Zanzibar and Tanzania, open benchmarks, and academic supervision.</p>
				</div>

				<div class="faq-grid">
					<article class="faq-item">
						<h3>What is SAAIL Lab at IIT Madras Zanzibar?</h3>
						<p>
							SAAIL Lab (Sustainable AI for Agriculture and Intelligent Livelihoods) is an artificial intelligence research laboratory within the School of Engineering and Science at the Indian Institute of Technology Madras Zanzibar, Tanzania. Founded in October 2024, the group builds deployable deep learning, computer vision, and machine learning systems tailored to East African agricultural, coastal, linguistic, and clinical settings.
						</p>
					</article>

					<article class="faq-item">
						<h3>Who leads SAAIL Lab in Zanzibar?</h3>
						<p>
							Innocent Nyalala, Assistant Professor at IIT Madras Zanzibar and Associate Research Fellow at the Wadhwani School of Data Science and AI (IIT Madras), founded and directs SAAIL Lab. His group brings together co-supervised PhD candidates, MTech Data Science and AI researchers, and BS undergraduate fellows, supported by {metrics.citations.toLocaleString()} Google Scholar citations and an h-index of {metrics.hIndex}.
						</p>
					</article>

					<article class="faq-item">
						<h3>Which AI, machine learning, and NLP areas does the lab study?</h3>
						<p>
							Research spans four integrated domains: computer vision for East African agriculture and the Zanzibar blue economy (cloves, cashew, coastal seaweed, and multi-crop leaf pathology), Swahili NLP and native provenance detection (Zanzibar Swahili Corpus and Dira), explainable and responsible AI auditing (DGS-Bench and CARA-FM), and healthcare AI (PlacentaVision and preterm biomarker modeling).
						</p>
					</article>

					<article class="faq-item">
						<h3>Where can researchers access SAAIL Lab datasets and publications?</h3>
						<p>
							All peer-reviewed manuscripts, curated vision benchmarks such as CLOVES-4603, ZSTC-Clove-V1, and CropGuardNet's 35,420-image pathology dataset, Swahili language corpora, and reproducible PyTorch/ONNX codebases are indexed at <a href="/publications/" class="inline-link">saaillab.github.io/publications</a> and <a href="https://github.com/saaillab" target="_blank" rel="noopener" class="inline-link">github.com/saaillab</a>.
						</p>
					</article>

					<article class="faq-item">
						<h3>How can students and partners collaborate with SAAIL Lab?</h3>
						<p>
							MTech and BS students at IIT Madras Zanzibar, visiting researchers, and institutional collaborators across Tanzania, Kenya, and international universities can review active openings on our <a href="/hiring/" class="inline-link">Hiring page</a> or contact the laboratory directly at <a href="mailto:saail_lab@iitmz.ac.in" class="inline-link">saail_lab@iitmz.ac.in</a>.
						</p>
					</article>
				</div>
			</div>
		</section>

		<script type="application/ld+json">
		{
		  "@context": "https://schema.org",
		  "@type": "FAQPage",
		  "mainEntity": [
		    {
		      "@type": "Question",
		      "name": "What is SAAIL Lab at IIT Madras Zanzibar?",
		      "acceptedAnswer": {
		        "@type": "Answer",
		        "text": "SAAIL Lab (Sustainable AI for Agriculture and Intelligent Livelihoods) is an artificial intelligence research laboratory within the School of Engineering and Science at the Indian Institute of Technology Madras Zanzibar, Tanzania. Founded in October 2024, the group builds deployable deep learning, computer vision, and machine learning systems tailored to East African agricultural, coastal, linguistic, and clinical settings."
		      }
		    },
		    {
		      "@type": "Question",
		      "name": "Who leads SAAIL Lab in Zanzibar?",
		      "acceptedAnswer": {
		        "@type": "Answer",
		        "text": "Innocent Nyalala, Assistant Professor at IIT Madras Zanzibar and Associate Research Fellow at the Wadhwani School of Data Science and AI (IIT Madras), founded and directs SAAIL Lab, supervising PhD candidates, MTech Data Science and AI researchers, and BS undergraduate fellows."
		      }
		    },
		    {
		      "@type": "Question",
		      "name": "Which AI, machine learning, and NLP areas does SAAIL Lab study?",
		      "acceptedAnswer": {
		        "@type": "Answer",
		        "text": "Research spans four integrated domains: computer vision for East African agriculture and the Zanzibar blue economy (cloves, cashew, coastal seaweed, and multi-crop leaf pathology), Swahili NLP and native provenance detection (Zanzibar Swahili Corpus and Dira), explainable and responsible AI auditing (DGS-Bench and CARA-FM), and healthcare AI (PlacentaVision and preterm biomarker modeling)."
		      }
		    },
		    {
		      "@type": "Question",
		      "name": "Where can researchers access SAAIL Lab datasets and publications?",
		      "acceptedAnswer": {
		        "@type": "Answer",
		        "text": "All peer-reviewed manuscripts, curated vision benchmarks such as CLOVES-4603, ZSTC-Clove-V1, and CropGuardNet's 35,420-image pathology dataset, Swahili language corpora, and reproducible PyTorch and ONNX codebases are indexed at https://saaillab.github.io/publications/ and https://github.com/saaillab."
		      }
		    },
		    {
		      "@type": "Question",
		      "name": "How can students and partners collaborate with SAAIL Lab in Tanzania and East Africa?",
		      "acceptedAnswer": {
		        "@type": "Answer",
		        "text": "MTech and BS students at IIT Madras Zanzibar, visiting researchers, and institutional collaborators across Tanzania, Kenya, and international universities can contact the laboratory at saail_lab@iitmz.ac.in or through https://saaillab.github.io/hiring/."
		      }
		    }
		  ]
		}
		</script>

		<!-- IITMZ Institutional Band with Verified PI Portrait -->
		<section class="section closing-band">
			<div class="container closing-grid">
				<div class="closing-left">
					<span class="page-eyebrow">Research Group &amp; Training</span>
					<h2>Built in Zanzibar for East African Impact</h2>
					<p>
						Founded in October 2024 by <a href="https://www.iitmz.ac.in/schools/engineering-and-science/faculty/prof-innocent-nyalala" target="_blank" rel="author noopener" class="inline-link">Innocent Nyalala</a> at the School of Engineering and Science, Indian Institute of Technology Madras Zanzibar, SAAIL Lab brings together doctoral candidates, MTech researchers, BS undergraduate fellows, and global academic collaborators.
					</p>
					<div class="pi-spot-card">
						<img
							src="/images/people/innocent-nyalala-saail-lab-zanzibar.jpg"
							alt="Innocent Nyalala, Assistant Professor and Principal Investigator of SAAIL Lab at IIT Madras Zanzibar"
							class="pi-spot-img"
							width="160"
							height="160"
							loading="lazy"
						/>
						<div class="pi-spot-meta">
							<span class="pi-spot-kicker">Principal Investigator · SAAIL Lab</span>
							<strong><a href="https://www.iitmz.ac.in/schools/engineering-and-science/faculty/prof-innocent-nyalala" target="_blank" rel="noopener" class="inline-link">Innocent Nyalala</a></strong>
							<span>Assistant Professor, School of Engineering &amp; Science, IIT Madras Zanzibar · Artificial Intelligence, Deep Learning, Computer Vision &amp; Swahili NLP</span>
						</div>
					</div>
				</div>
				<div class="closing-right">
					<div class="closing-stats">
						<div><strong>5</strong><span>Co-Supervised PhD</span></div>
						<div><strong>3</strong><span>Current MTech DSAI</span></div>
						<div><strong>3</strong><span>BS DSAI Researchers</span></div>
						<div><strong>4</strong><span>Graduated MTech Alumni</span></div>
					</div>
					<div class="closing-btns">
						<a href="/people/" class="btn btn-primary">Meet Team &amp; Alumni</a>
						<a href="/gallery/" class="btn btn-secondary">Conference Gallery</a>
						<a href="/hiring/" class="btn btn-secondary">Join SAAIL Lab</a>
					</div>
				</div>
			</div>
		</section>
	</main>

	<ModernFooter />
</Layout>

<style>
	.hero {
		padding: 2.75rem 0 3.75rem;
		background: radial-gradient(circle at 82% 16%, rgba(20, 83, 45, 0.06), transparent 48%), var(--bg-primary);
		border-bottom: 1px solid var(--border-color);
	}

	.hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
		gap: 2.75rem;
		align-items: center;
		margin-bottom: 2.25rem;
	}

	.hero-pill {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.35rem 0.95rem 0.35rem 0.55rem;
		border-radius: 999px;
		background: var(--bg-secondary);
		border: 1px solid var(--border-color);
		font-size: 0.82rem;
		font-weight: 600;
		color: var(--accent-primary);
		margin-bottom: 1.25rem;
	}

	.hero-pill img { border-radius: 50%; }

	.hero-title {
		font-size: clamp(2.05rem, 3.6vw, 3.15rem);
		font-weight: 800;
		line-height: 1.12;
		color: var(--text-primary);
		margin-bottom: 1.15rem;
	}

	.hero-lead {
		font-size: 1.06rem;
		line-height: 1.68;
		color: var(--text-secondary);
		margin-bottom: 1.6rem;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
	}

	.hero-text-link {
		font-size: 0.92rem;
		font-weight: 600;
		color: var(--accent-primary);
		text-decoration: none;
		padding: 0.5rem 0.4rem;
	}

	.hero-text-link:hover { text-decoration: underline; }

	/* Prominent Right-Column Architecture Visual */
	.architecture-frame {
		display: block;
		background: #ffffff;
		border: 1px solid var(--border-color);
		border-radius: 1.1rem;
		overflow: hidden;
		text-decoration: none;
		box-shadow: 0 14px 36px var(--shadow-light);
		transition: transform 0.22s ease, box-shadow 0.22s ease;
	}

	.architecture-frame:hover {
		transform: translateY(-3px);
		box-shadow: 0 20px 44px var(--shadow-medium);
	}

	.frame-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.5rem;
		padding: 0.72rem 1.15rem;
		background: #f7f7f2;
		border-bottom: 1px solid #e5e8e1;
		font-size: 0.78rem;
		font-weight: 700;
		color: #0c1a12;
	}

	.frame-spec {
		color: #14532d;
		font-family: 'JetBrains Mono', monospace;
	}

	.frame-img-wrap {
		background: #ffffff;
		padding: 1rem 1.1rem;
	}

	.architecture-img {
		width: 100%;
		height: auto;
		max-height: 460px;
		object-fit: contain;
		display: block;
		margin: 0 auto;
	}

