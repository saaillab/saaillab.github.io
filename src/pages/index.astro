---
import Layout from '../layouts/Layout.astro';
import ModernHeader from '../components/ModernHeader.astro';
import ModernFooter from '../components/ModernFooter.astro';
import { CROPGUARD_SERIES, PUBLICATIONS } from '../data/publications';

const featuredSlugs = [
  'cropguardnet',
  'dgs-bench',
  'cloves-4603',
  'cara-fm',
  'trustworthy-ai-iclr2026',
  'zstc-clove-v1'
];

const featuredPubs = featuredSlugs
  .map((s) => PUBLICATIONS.find((p) => p.slug === s))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));

const totalCataloged = PUBLICATIONS.length;
---

<Layout
  title="SAAIL Lab | Sustainable AI for Agriculture & Intelligent Livelihoods | IIT Madras Zanzibar"
  description="Sustainable AI for Agriculture & Intelligent Livelihoods (SAAIL) Lab led by Dr. Innocent Nyalala at IIT Madras Zanzibar and WSDSAI IIT Madras. Home of CropGuardNet, DGS-Bench, CLOVES-4603, and PlacentaVision."
  canonical="https://saaillab.github.io/"
>
  <ModernHeader currentPage="home" />

  <main class="home-main">
    <!-- Hero Section -->
    <section class="hero-band">
      <div class="container">
        <div class="hero-grid">
          <div class="hero-copy">
            <div class="hero-kicker">
              <span class="kicker-dot"></span>
              <span>IIT MADRAS ZANZIBAR · WSDSAI CHENNAI</span>
            </div>
            <h1 class="hero-title">
              Sustainable AI for Agriculture &amp; Intelligent Livelihoods
            </h1>
            <p class="hero-desc">
              Founded and led by <a href="https://inyalala.github.io" target="_blank" rel="noopener">Dr. Innocent Nyalala</a>, SAAIL Lab designs resource-efficient Computer Vision, Explainable AI, and Trustworthy Foundation Models for precision agriculture, maternal healthcare imaging, and climate-resilient East African communities.
            </p>

            <div class="hero-actions">
              <a href="/cropguard/" class="btn btn-primary">Explore CropGuard Series (1-6) &rarr;</a>
              <a href="/publications" class="btn btn-secondary">All 45+ Project Pages</a>
              <a href="/hiring" class="btn btn-ghost">Join the Lab</a>
            </div>
          </div>

          <div class="hero-visual">
            <a href="/papers/cropguardnet/" class="hero-showcase-card">
              <div class="showcase-badge">FLAGSHIP RELEASE · PAPER 1</div>
              <img
                src="/images/papers/cropguardnet/architecture.png"
                alt="CropGuardNet Unified Lightweight CNN-Transformer Architecture"
                loading="eager"
              />
              <div class="showcase-meta">
                <h3>CropGuardNet</h3>
                <p>481.6K params · 99.17% Acc across 35,420 deduplicated leaf images · 5.00 ms ONNX CPU</p>
                <span class="showcase-link">Open Project Page &rarr;</span>
              </div>
            </a>
          </div>
        </div>

        <!-- Lab Impact KPI Strip -->
        <div class="hero-stats">
          <div class="stat-card">
            <span class="stat-number" data-target={totalCataloged}>{totalCataloged}</span><span class="stat-plus">+</span>
            <span class="stat-label">Peer-Reviewed &amp; Indexed Works</span>
          </div>
          <div class="stat-card">
            <span class="stat-number" data-target="1185">1185</span><span class="stat-plus">+</span>
            <span class="stat-label">Google Scholar Citations (h-index 15)</span>
          </div>
          <div class="stat-card">
            <span class="stat-number" data-target="2">2</span><span class="stat-plus">&times;</span>
            <span class="stat-label">Deep Learning Indaba Best Poster Awards</span>
          </div>
          <div class="stat-card">
            <span class="stat-number" data-target="12">12</span><span class="stat-plus">+</span>
            <span class="stat-label">PhD &amp; MTech Lab Researchers</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Latest Highlights Ticker -->
    <section class="news-strip">
      <div class="container">
        <div class="news-strip-inner">
          <span class="news-strip-badge">LATEST HIGHLIGHTS</span>
          <div class="news-strip-items">
            <a href="/papers/dgs-bench/">DLI 2026 Best Poster Award: DGS-Bench (Cassava Deployment Gap Benchmark)</a>
            <span>·</span>
            <a href="/papers/cropguardnet/">Paper 1 Project Page &amp; Code Live: CropGuardNet (AIIA)</a>
            <span>·</span>
            <a href="/papers/cloves-4603/">CVPR 2026 V4A Workshop: CLOVES-4603 Benchmark (99.67% Acc)</a>
            <span>·</span>
            <a href="/papers/trustworthy-ai-iclr2026/">ICLR 2026 Workshop: Trustworthy AI in Africa</a>
          </div>
        </div>
      </div>
    </section>

    <!-- CropGuard Research Ecosystem Spotlight -->
    <section class="section ecosystem-section">
      <div class="container">
        <div class="section-header-row">
          <div>
            <span class="section-eyebrow">NEW RESEARCH PROGRAM</span>
            <h2 class="section-heading-left">The CropGuard Research Ecosystem (Papers 1-6)</h2>
            <p class="section-lead-left">
              A systematic six-paper suite resolving data leakage, edge model size, explainability faithfulness, domain shift, continual adaptation, and severity grading for real-world crop pathology.
            </p>
          </div>
          <a href="/cropguard/" class="btn btn-secondary">Open Umbrella Hub &rarr;</a>
        </div>

        <div class="cg-home-grid">
          {CROPGUARD_SERIES.map((item) => (
            <div class="cg-home-card">
              <div class="cg-home-top">
                <span class="cg-home-num">Paper {item.number}</span>
                <span class="cg-home-status">{item.status}</span>
              </div>
              <h3>{item.codeName}</h3>
              <p class="cg-home-venue">{item.targetVenue}</p>
              <p class="cg-home-summary">{item.summary}</p>
              <div class="cg-home-actions">
                {item.slug ? (
                  <a href={`/papers/${item.slug}/`} class="mini-link mini-link-primary">Project Page &rarr;</a>
                ) : (
                  <a href="/cropguard/" class="mini-link">Series Roadmap</a>
                )}
                {item.repoUrl && (
                  <a href={item.repoUrl} target="_blank" rel="noopener" class="mini-link">GitHub</a>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Research Pillars -->
    <section id="areas" class="section pillars-section">
      <div class="container">
        <div class="section-center-head">
          <span class="section-eyebrow">CORE MISSIONS</span>
          <h2>Research Pillars</h2>
          <p>Advancing methodological rigor in machine learning anchored in East African agricultural, environmental, and clinical challenges.</p>
        </div>

        <div class="pillars-grid">
          <article class="pillar-card">
            <div class="pillar-tag">01 · PRECISION AGRICULTURE</div>
            <h3>Crop Pathology &amp; Edge Vision</h3>
            <p>
              Leak-free cross-crop vision architectures (CropGuardNet, CropKD-Net), smallholder smartphone spice grading (ZSTC Clove, CLOVES-4603), UAV-assisted orchard phenotyping, and trustworthy explainable diagnostics.
            </p>
            <a href="/research#agriculture" class="pillar-link">Explore Agriculture AI &rarr;</a>
          </article>

          <article class="pillar-card">
            <div class="pillar-tag">02 · HEALTHCARE &amp; IMAGING</div>
            <h3>Maternal &amp; Clinical AI</h3>
            <p>
              Non-invasive optical and ultrasound placental perfusion assessment (PlacentaVision), diabetic retinopathy CAD systems, brain tumor classification, and accessible assistive interfaces for clinical resource-constrained settings.
            </p>
            <a href="/research#healthcare" class="pillar-link">Explore Healthcare AI &rarr;</a>
          </article>

          <article class="pillar-card">
            <div class="pillar-tag">03 · RESPONSIBLE &amp; INCLUSIVE AI</div>
            <h3>Deployment Benchmarks &amp; African AI Governance</h3>
            <p>
              Balanced field-shift evaluation protocols (DGS-Bench Best Poster DLI 2026), culturally aware foundation model frameworks (CARA-FM Best Poster DLI 2025), and policy governance for equitable AI deployment across Africa.
            </p>
            <a href="/research#responsible-ai" class="pillar-link">Explore Responsible AI &rarr;</a>
          </article>
        </div>
      </div>
    </section>

    <!-- Featured Publications & Project Pages -->
    <section class="section featured-pubs-section">
      <div class="container">
        <div class="section-header-row">
          <div>
            <span class="section-eyebrow">RECENT PUBLICATIONS &amp; AWARDS</span>
            <h2 class="section-heading-left">Selected Academic Project Pages</h2>
            <p class="section-lead-left">
              Interactive project pages following open scholarly publishing standards with full abstracts, visual figures, Highwire Press SEO tags, and BibTeX.
            </p>
          </div>
          <a href="/publications" class="btn btn-primary">View All {totalCataloged} Project Pages &rarr;</a>
        </div>

        <div class="featured-grid">
          {featuredPubs.map((pub) => (
            <article class="feat-card">
              <div class="feat-badges">
                <span class="feat-venue">{pub.venueShort}</span>
                {pub.award && <span class="feat-award">{pub.award}</span>}
              </div>
              <h3 class="feat-title">
                <a href={`/papers/${pub.slug}/`}>{pub.shortTitle || pub.title}</a>
              </h3>
              <p class="feat-tldr">{pub.tldr}</p>
              <div class="feat-links">
                <a href={`/papers/${pub.slug}/`} class="mini-link mini-link-primary">Project Page &rarr;</a>
                {(pub.paperUrl || pub.doi) && (
                  <a href={pub.paperUrl || pub.doi} target="_blank" rel="noopener" class="mini-link">Paper</a>
                )}
                {pub.codeUrl && (
                  <a href={pub.codeUrl} target="_blank" rel="noopener" class="mini-link">Code</a>
                )}
                {pub.datasetUrl && (
                  <a href={pub.datasetUrl} target="_blank" rel="noopener" class="mini-link">Dataset</a>
                )}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Quick Collaborations & Opportunities Banner -->
    <section class="section cta-band">
      <div class="container">
        <div class="cta-card">
          <div>
            <h2>Collaborate, Access Datasets, or Join SAAIL Lab</h2>
            <p>
              We welcome PhD, MTech, and visiting researchers at IIT Madras Zanzibar and WSDSAI Chennai, as well as international collaborations across academia and agri-health institutions.
            </p>
          </div>
          <div class="cta-actions">
            <a href="/github" class="btn btn-secondary">GitHub Repositories</a>
            <a href="/datasets" class="btn btn-secondary">Open Datasets</a>
            <a href="/people" class="btn btn-secondary">Meet the Team</a>
            <a href="/contact" class="btn btn-primary">Contact SAAIL Lab</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <ModernFooter />
</Layout>

<style>
  .home-main {
    background: var(--bg-primary, #ffffff);
    color: var(--text-primary, #0f172a);
  }
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Hero */
  .hero-band {
    padding: 3.5rem 0 2.5rem;
    background: radial-gradient(circle at 80% 20%, rgba(37, 99, 235, 0.08), transparent 55%),
                radial-gradient(circle at 10% 80%, rgba(16, 185, 129, 0.06), transparent 50%);
    border-bottom: 1px solid var(--border-color, #e2e8f0);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 2.5rem;
    align-items: center;
    margin-bottom: 2.75rem;
  }
  .hero-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    background: #eff6ff;
    color: #1d4ed8;
    border: 1px solid #bfdbfe;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }
  .kicker-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
  }
  .hero-title {
    font-size: clamp(2.1rem, 4vw, 3.25rem);
    font-weight: 800;
    line-height: 1.14;
    letter-spacing: -0.025em;
    margin: 0 0 1.15rem;
    color: var(--text-primary);
  }
  .hero-desc {
    font-size: 1.08rem;
    line-height: 1.68;
    color: var(--text-secondary);
    margin: 0 0 1.75rem;
  }
  .hero-desc a {
    color: var(--accent-blue, #2563eb);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.35rem;
    border-radius: 10px;
    font-size: 0.94rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .btn-primary {
    background: #0f172a;
    color: #ffffff;
    border: 1px solid #0f172a;
  }
  .btn-primary:hover {
    background: #2563eb;
    border-color: #2563eb;
    transform: translateY(-2px);
  }
  .btn-secondary {
    background: var(--bg-card, #ffffff);
    color: var(--text-primary);
    border: 1px solid var(--border-color, #cbd5e1);
  }
  .btn-secondary:hover {
    border-color: #2563eb;
    color: #2563eb;
  }
  .btn-ghost {
    background: transparent;
    color: var(--text-secondary);
    border: 1px solid transparent;
  }
  .btn-ghost:hover {
    color: #2563eb;
    background: #eff6ff;
  }

  .hero-showcase-card {
    display: block;
    background: #ffffff;
    border: 1px solid var(--border-color, #e2e8f0);
    border-radius: 16px;
    padding: 1rem;
    text-decoration: none;
    box-shadow: 0 14px 36px rgba(15, 23, 42, 0.08);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .hero-showcase-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 44px rgba(37, 99, 235, 0.14);
  }
  .showcase-badge {
    display: inline-block;
    padding: 0.2rem 0.65rem;
    border-radius: 6px;
    background: #eff6ff;
    color: #1d4ed8;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    margin-bottom: 0.65rem;
  }
  .hero-showcase-card img {
    width: 100%;
    max-height: 220px;
    object-fit: contain;
    border-radius: 8px;
    margin-bottom: 0.85rem;
  }
  .showcase-meta h3 {
    margin: 0 0 0.25rem;
    font-size: 1.1rem;
    font-weight: 800;
    color: #0f172a;
  }
  .showcase-meta p {
    margin: 0 0 0.5rem;
    font-size: 0.84rem;
    color: #475569;
  }
  .showcase-link {
    font-size: 0.84rem;
    font-weight: 700;
    color: #2563eb;
  }

  /* Hero Stats */
  .hero-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }
  .stat-card {
    background: var(--bg-card, #ffffff);
    border: 1px solid var(--border-color, #e2e8f0);
    border-radius: 14px;
    padding: 1.15rem 1rem;
    text-align: center;
    box-shadow: 0 2px 10px rgba(15, 23, 42, 0.03);
  }
  .stat-number, .stat-plus {
    font-size: 1.85rem;
    font-weight: 800;
    color: #2563eb;
  }
  .stat-label {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  /* News Strip */
  .news-strip {
    background: #0f172a;
    color: #f8fafc;
    padding: 0.85rem 0;
    font-size: 0.85rem;
  }
  .news-strip-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem 1rem;
  }
  .news-strip-badge {
    background: #2563eb;
    color: #ffffff;
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.05em;
  }
  .news-strip-items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.8rem;
  }
  .news-strip-items a {
    color: #e2e8f0;
    text-decoration: none;
    font-weight: 500;
  }
  .news-strip-items a:hover {
    color: #ffffff;
    text-decoration: underline;
  }

  /* Sections */
  .section { padding: 4rem 0; }
  .ecosystem-section { background: var(--bg-secondary, #f8fafc); border-bottom: 1px solid var(--border-color, #e2e8f0); }
  .featured-pubs-section { background: var(--bg-secondary, #f8fafc); border-top: 1px solid var(--border-color, #e2e8f0); }

  .section-eyebrow {
    display: inline-block;
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: #2563eb;
    margin-bottom: 0.45rem;
  }
  .section-header-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 2.25rem;
  }
  .section-heading-left {
    margin: 0 0 0.5rem;
    font-size: 1.95rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .section-lead-left {
    margin: 0;
    max-width: 680px;
    color: var(--text-secondary);
    font-size: 1.02rem;
  }
  .section-center-head {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 2.5rem;
  }
  .section-center-head h2 {
    margin: 0 0 0.6rem;
    font-size: 2rem;
    font-weight: 800;
  }
  .section-center-head p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 1.04rem;
  }

  /* CropGuard Home Grid */
  .cg-home-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.25rem;
  }
  .cg-home-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-card, #ffffff);
    border: 1px solid var(--border-color, #e2e8f0);
    border-radius: 14px;
    padding: 1.35rem;
  }
  .cg-home-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.65rem;
  }
  .cg-home-num {
    font-size: 0.78rem;
    font-weight: 800;
    color: #2563eb;
    text-transform: uppercase;
  }
  .cg-home-status {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.16rem 0.55rem;
    border-radius: 999px;
    background: #eff6ff;
    color: #1d4ed8;
  }
  .cg-home-card h3 {
    margin: 0 0 0.25rem;
    font-size: 1.2rem;
    font-weight: 800;
  }
  .cg-home-venue {
    margin: 0 0 0.65rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-muted);
  }
  .cg-home-summary {
    margin: 0 0 1rem;
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.55;
    flex: 1;
  }
  .cg-home-actions, .feat-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .mini-link {
    display: inline-flex;
    padding: 0.38rem 0.78rem;
    border-radius: 8px;
    border: 1px solid var(--border-color, #cbd5e1);
    background: var(--bg-secondary, #f8fafc);
    color: var(--text-primary);
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
  }
  .mini-link:hover {
    border-color: #2563eb;
    color: #2563eb;
  }
  .mini-link-primary {
    background: #0f172a;
    border-color: #0f172a;
    color: #ffffff;
  }
  .mini-link-primary:hover {
    background: #2563eb;
    border-color: #2563eb;
    color: #ffffff;
  }

  /* Pillars */
  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: 1.5rem;
  }
  .pillar-card {
    background: var(--bg-card, #ffffff);
    border: 1px solid var(--border-color, #e2e8f0);
    border-radius: 16px;
    padding: 1.65rem;
    display: flex;
    flex-direction: column;
  }
  .pillar-tag {
    font-size: 0.74rem;
    font-weight: 800;
    color: #059669;
    letter-spacing: 0.05em;
    margin-bottom: 0.65rem;
  }
  .pillar-card h3 {
    margin: 0 0 0.75rem;
    font-size: 1.25rem;
    font-weight: 800;
  }
  .pillar-card p {
    margin: 0 0 1.25rem;
    color: var(--text-secondary);
    line-height: 1.65;
    font-size: 0.94rem;
    flex: 1;
  }
  .pillar-link {
    font-size: 0.88rem;
    font-weight: 700;
    color: #2563eb;
    text-decoration: none;
  }

  /* Featured Pubs */
  .featured-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(330px, 1fr));
    gap: 1.25rem;
  }
  .feat-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-card, #ffffff);
    border: 1px solid var(--border-color, #e2e8f0);
    border-radius: 14px;
    padding: 1.45rem;
  }
  .feat-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.65rem;
  }
  .feat-venue, .feat-award {
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
    font-size: 0.74rem;
    font-weight: 700;
  }
  .feat-venue { background: #eff6ff; color: #1d4ed8; }
  .feat-award { background: #fef3c7; color: #92400e; }
  .feat-title {
    margin: 0 0 0.55rem;
    font-size: 1.12rem;
    font-weight: 700;
    line-height: 1.38;
  }
  .feat-title a {
    color: var(--text-primary);
    text-decoration: none;
  }
  .feat-title a:hover { color: #2563eb; text-decoration: underline; }
  .feat-tldr {
    margin: 0 0 1.1rem;
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.55;
    flex: 1;
  }

  /* CTA Band */
  .cta-card {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 2rem;
    border-radius: 18px;
    background: linear-gradient(135deg, #0f172a, #1e293b);
    color: #ffffff;
  }
