<script>
	document.querySelectorAll('.copy-cmd-btn').forEach((btn) => {
		btn.addEventListener('click', async () => {
			const cmd = btn.getAttribute('data-copy') || '';
			if (!cmd) return;
			let ok = false;
			try {
				await navigator.clipboard.writeText(cmd);
				ok = true;
			} catch (_e) {
				const area = document.createElement('textarea');
				area.value = cmd;
				area.style.position = 'fixed';
				area.style.opacity = '0';
				document.body.appendChild(area);
				area.select();
				try { ok = document.execCommand('copy'); } catch (_e2) {}
				document.body.removeChild(area);
			}
			if (ok) {
				btn.textContent = 'Copied!';
				const liveEl = document.getElementById('saailLiveStatus');
				if (liveEl) {
					liveEl.textContent = '';
					requestAnimationFrame(() => { liveEl.textContent = 'Command copied to clipboard.'; });
				}
				setTimeout(() => { btn.textContent = 'Copy'; }, 1600);
			}
		});
	});

	const expTabs = Array.from(document.querySelectorAll('.exp-tab')) as HTMLButtonElement[];
	expTabs.forEach((tab, idx) => {
		tab.addEventListener('click', () => {
			expTabs.forEach((t) => {
				const active = t === tab;
				t.classList.toggle('is-active', active);
				t.setAttribute('aria-selected', String(active));
				t.setAttribute('tabindex', active ? '0' : '-1');
				const pid = t.getAttribute('data-exp-target');
				const panel = pid ? document.getElementById(pid) : null;
				if (panel) panel.hidden = !active;
			});
		});
		tab.addEventListener('keydown', (e: KeyboardEvent) => {
			let next: number | null = null;
			if (e.key === 'ArrowRight') next = (idx + 1) % expTabs.length;
			else if (e.key === 'ArrowLeft') next = (idx - 1 + expTabs.length) % expTabs.length;
			else if (e.key === 'Home') next = 0;
			else if (e.key === 'End') next = expTabs.length - 1;
			if (next === null) return;
			e.preventDefault();
			expTabs[next].focus();
			expTabs[next].click();
		});
	});
</script>

