---
import Layout from '../layouts/Layout.astro';
import ModernHeader from '../components/ModernHeader.astro';
import ModernFooter from '../components/ModernFooter.astro';
import clovesMeta from '../../public/models/cloves_mobilenetv3s_meta.json';
import cassavaMeta from '../../public/models/cassava_mobilenetv3s_meta.json';

const zstcGrades = [
	{ label: 'Grade I (Premium)', count: 1455, pct: 27.5 },
	{ label: 'Grade II (Standard)', count: 1320, pct: 24.9 },
	{ label: 'Grade III (Commercial)', count: 1398, pct: 26.4 },
	{ label: 'Grade IV (Mpeta)', count: 1125, pct: 21.2 }
];

const cassavaSplit = cassavaMeta.classes.map((name, idx) => ({
	name,
	f1: cassavaMeta.perClassF1Pct[idx],
	sample: cassavaMeta.demoSamples[idx]
}));
---

<Layout
	title="East Africa AI Datasets & Swahili Benchmarks | SAAIL Lab Zanzibar"
	description="Open agricultural computer vision benchmarks, Zanzibar clove grading datasets (CLOVES-4603, ZSTC-Clove-V1), leak-free crop pathology splits, DGS-Bench, and the Zanzibar Swahili Corpus & Dira NLP benchmark from IIT Madras Zanzibar."
	canonical="https://saaillab.github.io/datasets/"
>
	<ModernHeader currentPage="resources" />

	<main id="main-content">
		<section class="page-hero">
			<div class="container">
				<span class="page-eyebrow" data-i18n="datasets.eyebrow">Data Infrastructure · East Africa &amp; Zanzibar</span>
				<h1 class="page-title" data-i18n="datasets.title">Open AI Datasets &amp; Evaluation Benchmarks</h1>
				<p class="page-lead">
					<span data-i18n="datasets.lead_pre">Curated regional computer vision datasets and leak-free evaluation benchmarks from SAAIL Lab at IIT Madras Zanzibar across Zanzibar specialty commodities, African crop pathology, and Swahili language technologies. Released under</span> <a href="https://creativecommons.org/licenses/by-nc/4.0/" target="_blank" rel="license noopener">CC BY-NC 4.0</a>.
				</p>
			</div>
		</section>

		<section class="section">
			<div class="container ds-stack">
				<!-- Interactive Dataset Explorer & Sample Browser -->
				<div id="explorer" class="explorer-section">
					<div class="explorer-head">
						<div>
							<span class="explorer-kicker">Interactive Benchmark Inspector</span>
							<h2 class="group-title" data-i18n="datasets.explorer_title">Dataset Explorer &amp; Sample Browser</h2>
						</div>
						<p class="explorer-sub">Inspect verified split proportions, deduplication audits, and representative held-out test imagery before downloading.</p>
					</div>

					<div class="exp-tabs" role="tablist" aria-label="Explore SAAIL Lab datasets and splits">
						<button id="expTabZstc" type="button" role="tab" aria-selected="true" aria-controls="expPanelZstc" tabindex="0" class="exp-tab is-active" data-exp-target="expPanelZstc">ZSTC-Clove-V1 (5,298)</button>
						<button id="expTabCloves" type="button" role="tab" aria-selected="false" aria-controls="expPanelCloves" tabindex="-1" class="exp-tab" data-exp-target="expPanelCloves">CLOVES-4603 (4,603)</button>
						<button id="expTabCassava" type="button" role="tab" aria-selected="false" aria-controls="expPanelCassava" tabindex="-1" class="exp-tab" data-exp-target="expPanelCassava">DGS-Bench &amp; Cassava (19,397+)</button>
						<button id="expTabCropguard" type="button" role="tab" aria-selected="false" aria-controls="expPanelCropguard" tabindex="-1" class="exp-tab" data-exp-target="expPanelCropguard">CropGuard Deduplicated (35,420)</button>
					</div>

					<div id="expPanelZstc" class="exp-panel" role="tabpanel" aria-labelledby="expTabZstc">
						<div class="exp-grid">
							<div class="exp-metrics">
								<h3>ZSTC Commercial Grade Distribution (Saateni Warehouse)</h3>
								<p>Dual-expert verified grading (&kappa; = 0.87) across all four regulatory Zanzibar clove grades.</p>
								<div class="exp-bars">
									{zstcGrades.map((g) => (
										<div class="exp-bar-row">
											<span>{g.label}</span>
											<strong>{g.count.toLocaleString()} ({g.pct}%)</strong>
											<div class="exp-track"><div class="exp-fill" style={`width:${Math.round(g.pct * 2.5)}%`}></div></div>
										</div>
									))}
								</div>
								<div class="exp-links">
									<a href="/tools/#live-demo" class="btn btn-primary">Test Cloves ONNX Live &rarr;</a>
									<a href="/papers/zstc-clove-v1/" class="btn btn-secondary">ZSTC-Clove-V1 Paper</a>
								</div>
							</div>
							<div class="exp-samples">
								<h3>Held-Out Clove Grade Samples ({clovesMeta.testSamples} test set)</h3>
								<div class="thumb-grid-4">
									{clovesMeta.demoSamples.map((s) => (
										<figure class="exp-thumb-card">
											<img src={s.file} alt={`Verified held-out ZSTC ${s.gradeLabel} clove specimen`} loading="lazy" />
											<figcaption><strong>{s.shortLabel}</strong><span>ONNX {s.verifiedConfPct}%</span></figcaption>
										</figure>
									))}
								</div>
							</div>
						</div>
					</div>

					<div id="expPanelCloves" class="exp-panel" role="tabpanel" aria-labelledby="expTabCloves" hidden>
						<div class="exp-grid">
							<div class="exp-metrics">
								<h3>Lot-Aware 5-Seed Stratified Split &amp; Session Integrity</h3>
								<p>Standardized 224x224 RGB benchmark evaluated under strict 70/10/20 lot-aware splits (<em>n</em> = 921 held-out test buds) plus foreground mask EER auditing.</p>
								<div class="exp-bars">
									<div class="exp-bar-row"><span>Training Partition (Seed Lot-Grouped)</span><strong>70% (~3,222)</strong><div class="exp-track"><div class="exp-fill" style="width:70%"></div></div></div>
									<div class="exp-bar-row"><span>Validation Partition</span><strong>10% (~460)</strong><div class="exp-track"><div class="exp-fill" style="width:10%"></div></div></div>
									<div class="exp-bar-row"><span>Held-Out Test Set (5-Seed)</span><strong>20% (n = 921)</strong><div class="exp-track"><div class="exp-fill" style="width:20%"></div></div></div>
								</div>
								<div class="exp-links">
									<a href="/papers/cloves-4603/" class="btn btn-primary">CLOVES-4603 Summary</a>
									<a href="/papers/capture-session-confounding-cloves/" class="btn btn-secondary">Session Confounding Audit</a>
								</div>
							</div>
							<div class="exp-figures-pair">
								<figure class="exp-fig-card">
									<img src="/images/papers/cloves/Fig1_Class_Distribution.png" alt="CLOVES-4603 commercial grade class distribution" loading="lazy" />
									<figcaption>Commercial clove grade counts across CLOVES-4603.</figcaption>
								</figure>
								<figure class="exp-fig-card">
									<img src="/images/papers/cloves/fig6_confound.png" alt="Capture-session confounding diagnostic across clove tray lighting" loading="lazy" />
									<figcaption>Background shortcut audit motivating segmentation-first grading.</figcaption>
								</figure>
							</div>
						</div>
					</div>

					<div id="expPanelCassava" class="exp-panel" role="tabpanel" aria-labelledby="expTabCassava" hidden>
						<div class="exp-grid">
							<div class="exp-metrics">
								<h3>Ugandan Field Class Skew (65.8% CMD) &amp; MobileNetV3-Small F1</h3>
								<p>DGS-Bench exposes accuracy mirages under natural class imbalance across {cassavaMeta.testSamples.toLocaleString()} stratified field test images (80/10/10).</p>
								<div class="exp-bars">
									{cassavaSplit.map((c) => (
										<div class="exp-bar-row">
											<span>{c.name}</span>
											<strong>F1 {c.f1}%</strong>
											<div class="exp-track"><div class="exp-fill" style={`width:${Math.round(c.f1)}%`}></div></div>
										</div>
									))}
								</div>
								<div class="exp-links">
									<a href="/tools/#live-demo" class="btn btn-primary">Test Cassava ONNX Live &rarr;</a>
									<a href="/papers/dgs-bench/" class="btn btn-secondary">DGS-Bench Paper (Best Poster)</a>
								</div>
							</div>
							<div class="exp-samples">
								<h3>Representative 5-Class Cassava Field Images</h3>
								<div class="thumb-grid-5">
									{cassavaSplit.map((c) => (
										<figure class="exp-thumb-card">
											<img src={c.sample.file} alt={`Held-out Ugandan cassava leaf specimen for ${c.name}`} loading="lazy" />
											<figcaption><strong>{c.sample.shortLabel}</strong><span>F1 {c.f1}%</span></figcaption>
										</figure>
									))}
								</div>
							</div>
						</div>
					</div>

					<div id="expPanelCropguard" class="exp-panel" role="tabpanel" aria-labelledby="expTabCropguard" hidden>
						<div class="exp-grid">
							<div class="exp-metrics">
								<h3>Specimen UUID + 64-Bit pHash Deduplication Funnel</h3>
								<p>Purges 80,238 leaked offline augmentations before 8-fold leave-one-crop-out evaluation across 38 disease classes.</p>
								<div class="exp-bars">
									<div class="exp-bar-row"><span>Raw Augmented Archive (Contaminated)</span><strong>115,658 (100%)</strong><div class="exp-track"><div class="exp-fill" style="width:100%"></div></div></div>
									<div class="exp-bar-row"><span>Purged Duplicates (UUID + 64-bit pHash)</span><strong>80,238 (69.4%)</strong><div class="exp-track"><div class="exp-fill fill-warn" style="width:69%"></div></div></div>
									<div class="exp-bar-row"><span>Verified Unique Specimens Retained</span><strong>35,420 (30.6%)</strong><div class="exp-track"><div class="exp-fill" style="width:31%"></div></div></div>
								</div>
								<div class="exp-links">
									<a href="/papers/cropguardnet/" class="btn btn-primary">CropGuardNet Paper</a>
									<a href="/tools/#live-demo" class="btn btn-secondary">Browser Inference Demo</a>
								</div>
							</div>
							<div class="exp-figures-pair">
								<figure class="exp-fig-card">
									<img src="/images/papers/cropguardnet/fig01_dataset_distribution.png" alt="Deduplicated multi-crop specimen distribution across 8 species" loading="lazy" />
									<figcaption>Deduplicated 8-crop, 38-class distribution.</figcaption>
								</figure>
								<figure class="exp-fig-card">
									<img src="/images/papers/cropguardnet/fig_degradation_samples.png" alt="Field perturbation robustness test image samples" loading="lazy" />
									<figcaption>Stress-test corruption profiles evaluated by CropGuardNet.</figcaption>
								</figure>
							</div>
						</div>
					</div>
				</div>

				<div id="agriculture" class="group-section">
					<h2 class="group-title" data-i18n="datasets.ag_group">Agricultural &amp; Computer Vision Benchmarks</h2>
					<div class="ds-grid">
						<article class="ds-card">
							<div class="ds-meta">
								<span class="ds-badge">4,603 Images</span>
								<span class="ds-venue">CVPR 2026 V4A · ETRI Journal 2026</span>
							</div>
							<h3>CLOVES-4603</h3>
							<p>
								Standardized 224x224 RGB clove quality benchmark spanning four official Zanzibar State Trading Corporation (ZSTC) commercial grades (Grades 1 to 4) collected at ZSTC facilities, evaluated under lot-aware 70/10/20 stratified 5-seed splits.
							</p>
							<div class="spec-pills">
								<span>4 classes</span><span>Lot-aware 5-seed</span><span>CC BY-NC 4.0</span>
							</div>
							<div class="code-copy-bar">
								<code>git clone https://github.com/saaillab/CLOVES-4603.git</code>
								<button type="button" class="copy-cmd-btn" data-copy="git clone https://github.com/saaillab/CLOVES-4603.git">Copy</button>
							</div>
							<details class="datasheet-drawer">
								<summary data-i18n="datasets.datasheet_summary">Datasheet &amp; Governance Card</summary>
								<dl class="datasheet-dl">
									<div><dt>Classes &amp; Labels</dt><dd>4 official ZSTC commercial grades (Grade 1, Grade 2, Grade 3, Grade 4; 4,603 images)</dd></div>
									<div><dt>Modality &amp; Resolution</dt><dd>Standardized 224x224 RGB clove quality imagery</dd></div>
									<div><dt>Split Protocol</dt><dd>Lot-aware 70/10/20 stratified 5-seed splits (n = 921 held-out test images)</dd></div>
									<div><dt>Collection Context</dt><dd>Zanzibar State Trading Corporation (ZSTC) inspection facilities, Tanzania</dd></div>
									<div><dt>License &amp; Ethics</dt><dd>CC BY-NC 4.0 · Non-human agricultural commodity imagery</dd></div>
									<div><dt>Access &amp; Citation</dt><dd>GitHub manifests &amp; benchmark scripts (<a href="/papers/cloves-4603/">CVPR 2026 V4A</a>)</dd></div>
								</dl>
							</details>
							<div class="ds-links">
								<a href="/papers/cloves-4603/" class="btn btn-primary">Project Page</a>
								<a href="https://github.com/saaillab/CLOVES-4603" target="_blank" rel="noopener" class="btn btn-secondary">GitHub ↗</a>
							</div>
						</article>

						<article class="ds-card">
							<div class="ds-meta">
								<span class="ds-badge">5,298 Images</span>
								<span class="ds-venue">AI4EAC / EAC STI 2026</span>
							</div>
							<h3>ZSTC-Clove-V1</h3>
							<p>
								Expert-annotated single-clove dataset collected at the Saateni warehouse (Unguja, Zanzibar) across Grade I (1,455), Grade II (1,320), Grade III (1,398), and Grade IV <em>mpeta</em> (1,125) with inter-annotator &kappa; = 0.87.
							</p>
							<div class="spec-pills">
								<span>4 classes</span><span>Dual-expert &kappa;=0.87</span><span>CC BY-NC 4.0</span>
							</div>
							<div class="code-copy-bar">
								<code>git clone https://github.com/saaillab/zstc-clove-v1.git</code>
								<button type="button" class="copy-cmd-btn" data-copy="git clone https://github.com/saaillab/zstc-clove-v1.git">Copy</button>
							</div>
							<details class="datasheet-drawer">
								<summary data-i18n="datasets.datasheet_summary">Datasheet &amp; Governance Card</summary>
								<dl class="datasheet-dl">
									<div><dt>Classes &amp; Labels</dt><dd>4 regulatory grades: Grade I (1,455), Grade II (1,320), Grade III (1,398), Grade IV mpeta (1,125)</dd></div>
									<div><dt>Modality &amp; Resolution</dt><dd>Single-clove and lot RGB photographs standardized for edge inspection</dd></div>
									<div><dt>Split Protocol</dt><dd>Dual-expert verified labels (&kappa; = 0.87); leak-free inspection splits</dd></div>
									<div><dt>Collection Context</dt><dd>Saateni ZSTC warehouse, Unguja, Zanzibar, co-designed with regulatory graders</dd></div>
									<div><dt>License &amp; Ethics</dt><dd>CC BY-NC 4.0 · Participatory co-design protocols (<a href="/papers/clove-codesign-africhi2025/">AfriCHI 2025</a>)</dd></div>
									<div><dt>Access &amp; Citation</dt><dd>Benchmark repository &amp; rules (<a href="/papers/zstc-clove-v1/">AI4EAC 2026</a> · <a href="/papers/clove-xai-etri2026/">ETRI 2026</a>)</dd></div>
								</dl>
							</details>
							<div class="ds-links">
								<a href="/papers/zstc-clove-v1/" class="btn btn-primary">Project Page</a>
								<a href="https://github.com/saaillab/zstc-clove-v1" target="_blank" rel="noopener" class="btn btn-secondary">GitHub ↗</a>
							</div>
						</article>

						<article class="ds-card">
							<div class="ds-meta">
								<span class="ds-badge">35,420 Unique Images</span>
								<span class="ds-venue">Under Peer Review</span>
							</div>
							<h3>CropGuard Deduplicated Multi-Crop Benchmark</h3>
							<p>
								Leak-free cross-crop foliar pathology suite across 8 crops and 38 disease classes constructed by purging 80,238 offline-augmented duplicate PlantVillage copies via specimen UUID grouping and 64-bit DCT perceptual hashing.
							</p>
							<div class="spec-pills">
								<span>8 crops · 38 classes</span><span>UUID + 64-bit pHash</span><span>CC BY-NC 4.0</span>
							</div>
							<div class="code-copy-bar">
								<code>git clone https://github.com/saaillab/CropGuardNet.git</code>
								<button type="button" class="copy-cmd-btn" data-copy="git clone https://github.com/saaillab/CropGuardNet.git">Copy</button>
							</div>
							<details class="datasheet-drawer">
								<summary data-i18n="datasets.datasheet_summary">Datasheet &amp; Governance Card</summary>
								<dl class="datasheet-dl">
									<div><dt>Classes &amp; Labels</dt><dd>8 crops across 38 disease/healthy classes; 35,420 deduplicated leaf images</dd></div>
									<div><dt>Modality &amp; Resolution</dt><dd>224x224 RGB foliar disease images with clean and field-transfer subsets</dd></div>
									<div><dt>Split Protocol</dt><dd>80,238 duplicates purged via specimen UUID grouping + 64-bit DCT pHash; 8-fold leave-one-crop-out</dd></div>
									<div><dt>Collection Context</dt><dd>Curated public multi-crop pathology cohorts plus PlantDoc uncurated smartphone test images</dd></div>
									<div><dt>License &amp; Ethics</dt><dd>CC BY-NC 4.0 · Manifest-only redistribution preserving upstream crop dataset terms</dd></div>
									<div><dt>Access &amp; Citation</dt><dd>Deduplication manifests &amp; scripts (<a href="/papers/cropguardnet/">CropGuardNet Paper</a>)</dd></div>
								</dl>
							</details>
							<div class="ds-links">
								<a href="/papers/cropguardnet/" class="btn btn-primary">Project Page</a>
								<a href="https://github.com/saaillab/CropGuardNet" target="_blank" rel="noopener" class="btn btn-secondary">GitHub Manifests ↗</a>
							</div>
						</article>

						<article class="ds-card">
							<div class="ds-meta">
								<span class="ds-badge">19,397 Field + Cross-Crop</span>
								<span class="ds-venue">DLI 2026 Best Poster</span>
							</div>
							<h3>DGS-Bench Field Deployment Protocol</h3>
							<p>
								Standardized Deployment Gap Score benchmark pairing balanced lab subsets against natural class-skewed Ugandan smallholder cassava field images (65.8% CMD prevalence), extended to Tomato (10 classes) and Rice (4 classes).
							</p>
							<div class="spec-pills">
								<span>10-seed fixed splits</span><span>Balanced vs. Field</span><span>CC BY-NC 4.0</span>
							</div>
							<div class="code-copy-bar">
								<code>pip install git+https://github.com/saaillab/dgs-bench.git</code>
								<button type="button" class="copy-cmd-btn" data-copy="pip install git+https://github.com/saaillab/dgs-bench.git">Copy</button>
							</div>
							<details class="datasheet-drawer">
								<summary data-i18n="datasets.datasheet_summary">Datasheet &amp; Governance Card</summary>
								<dl class="datasheet-dl">
									<div><dt>Classes &amp; Labels</dt><dd>Cassava (5 classes, 19,397 field images), Tomato (10 classes), and Rice (4 classes)</dd></div>
									<div><dt>Modality &amp; Resolution</dt><dd>Field smallholder smartphone &amp; lab RGB foliage imagery under natural class skew (65.8% CMD)</dd></div>
									<div><dt>Split Protocol</dt><dd>Deterministic 10-seed evaluation protocol comparing balanced lab vs. skewed field splits (40 runs)</dd></div>
									<div><dt>Collection Context</dt><dd>Makerere AI Lab Ugandan smallholder cassava field surveys plus cross-crop benchmarks</dd></div>
									<div><dt>License &amp; Ethics</dt><dd>CC BY-NC 4.0 · Evaluation protocol &amp; deterministic seed manifests only</dd></div>
									<div><dt>Access &amp; Citation</dt><dd>Runnable CLI &amp; p* verifier (<a href="/papers/dgs-bench/">DGS-Bench · DLI 2026</a>)</dd></div>
								</dl>
							</details>
							<div class="ds-links">
								<a href="/papers/dgs-bench/" class="btn btn-primary">Project Page</a>
								<a href="https://github.com/saaillab/dgs-bench" target="_blank" rel="noopener" class="btn btn-secondary">GitHub ↗</a>
							</div>
						</article>
					</div>
				</div>

				<div id="language" class="group-section">
					<h2 class="group-title" data-i18n="datasets.lang_group">Swahili NLP, Provenance &amp; Cultural AI Safety</h2>
					<div class="ds-grid">
						<article class="ds-card">
							<div class="ds-meta">
								<span class="ds-badge badge-gold">TAIS 2026 &amp; AAAI 2026</span>
								<span class="ds-venue">Responsible AI &amp; Policy Evaluation</span>
							</div>
							<h3>East African AI Policy &amp; Global South Sovereignty Corpus</h3>
							<p>
								Comparative policy and governance evaluation criteria anchoring national AI strategies in Ubuntu, Harambee, and Ujamaa alongside seven-dimensional sovereignty metrics across the Global South.
							</p>
							<details class="datasheet-drawer">
								<summary data-i18n="datasets.datasheet_summary">Datasheet &amp; Governance Card</summary>
								<dl class="datasheet-dl">
									<div><dt>Classes &amp; Labels</dt><dd>7 sovereignty dimensions &amp; national AI strategy audit criteria (Ethiopia, Kenya, Rwanda)</dd></div>
									<div><dt>Modality &amp; Resolution</dt><dd>Structured policy documents, infrastructure indicators (water/power/compute), and rubrics</dd></div>
									<div><dt>Split Protocol</dt><dd>Cross-national comparative policy matrix rather than supervised train/test splits</dd></div>
									<div><dt>Collection Context</dt><dd>Public East African Community policy frameworks &amp; regional governance literature</dd></div>
									<div><dt>License &amp; Ethics</dt><dd>CC BY-NC 4.0 · Grounded in Ubuntu, Harambee, and Ujamaa participatory principles</dd></div>
									<div><dt>Access &amp; Citation</dt><dd><a href="/papers/ai-policy-harmonization-tais2026/">TAIS 2026 (Oxford)</a> · <a href="/papers/ai-sovereignty-global-south-aaai2026/">AAAI 2026</a></dd></div>
								</dl>
							</details>
							<div class="ds-links">
								<a href="/projects/responsible-ai-global-south/" class="btn btn-primary">Responsible AI Project</a>
								<a href="/papers/ai-policy-harmonization-tais2026/" class="btn btn-secondary">TAIS 2026 Policy Paper</a>
							</div>
						</article>

						<article class="ds-card">
							<div class="ds-meta">
								<span class="ds-badge badge-gold">In Active Curation</span>
								<span class="ds-venue">SAAIL Lab Swahili NLP</span>
							</div>
							<h3>Zanzibar Swahili Corpus, Spoken QA &amp; Dira Provenance Dataset</h3>
							<p>
								Authentic Kiunguja/coastal Swahili text and spoken domain QA paired with the <em>Dira</em> provenance dataset built to benchmark and detect synthetic translationese versus natural native Swahili writing.
							</p>
							<details class="datasheet-drawer">
								<summary data-i18n="datasets.datasheet_summary">Datasheet &amp; Governance Card</summary>
								<dl class="datasheet-dl">
									<div><dt>Classes &amp; Labels</dt><dd>Native Kiunguja/coastal Swahili prose vs. machine-translated Swahili provenance pairs</dd></div>
									<div><dt>Modality &amp; Resolution</dt><dd>Editorial Swahili text, lexical/discourse annotations, and spoken agricultural QA audio-text pairs</dd></div>
									<div><dt>Split Protocol</dt><dd>Source-grouped provenance splits preventing same-document leakage across detectors</dd></div>
									<div><dt>Collection Context</dt><dd>Zanzibar &amp; coastal Tanzania editorial sources and local agricultural dialogues</dd></div>
									<div><dt>License &amp; Ethics</dt><dd>Active curation under community-consented language governance protocols</dd></div>
