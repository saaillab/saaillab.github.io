---
import Layout from '../layouts/Layout.astro';
import ModernHeader from '../components/ModernHeader.astro';
import ModernFooter from '../components/ModernFooter.astro';

const datasets = [
  {
    name: 'CropGuard-35420 Deduplicated Multi-Crop Manifest',
    domain: 'Agricultural Vision',
    status: 'Open Reproducibility Manifest',
    scale: '35,420 unique images · 80,238 duplicates purged · 8 crops · 38 classes',
    description:
      'Leakage-free train/validation/test split manifest constructed via two-stage SHA/UUID deduplication and perceptual-hash (pHash) clustering, plus external field validation splits on PlantDoc and leave-one-crop-out protocols.',
    projectUrl: '/papers/cropguardnet/',
    repoUrl: 'https://github.com/saaillab/CropGuardNet'
  },
  {
    name: 'CLOVES-4603 Fine-Grained Clove Dataset',
    domain: 'Specialty Crop Inspection',
    status: 'CVPR 2026 V4A Benchmark',
    scale: '4,603 standardized 224x224 RGB images across 4 ZSTC grades',
    description:
      'First public export clove grading benchmark recorded at the Zanzibar State Trading Corporation (ZSTC), comparing texture-fusion SVM (92.94%) and deep vision backbones (up to 99.67%).',
    projectUrl: '/papers/cloves-4603/',
    repoUrl: 'https://github.com/saaillab/CLOVES-4603'
  },
  {
    name: 'DGS-Bench: Deployment Gap & Sensitivity Benchmark',
    domain: 'Agricultural Robustness',
    status: 'Best Poster · DLI 2026',
    scale: 'Multi-condition cassava pathology & balanced metric protocol',
    description:
      'Standardized evaluation suite measuring controlled-to-smallholder field generalization drops, macro-averaged recall on rare crop pathologies, and calibration error.',
    projectUrl: '/papers/dgs-bench/',
    repoUrl: 'https://github.com/saaillab/dgs-bench'
  },
  {
    name: 'RuTAG Specialty Crop Data Ecosystem',
    domain: 'Agricultural Sensing & IoT',
    status: 'Multi-Institution Collaboration',
    scale: 'Cloves · Black Pepper · Cardamom · Millets · Walnuts',
    description:
      'Structured imaging and environmental telemetry schemas developed jointly with the Rural Technology Action Group (RuTAG) at IIT Madras Chennai.',
    projectUrl: '/projects',
    repoUrl: 'https://github.com/saaillab'
  },
  {
    name: 'PlacentaVision Ultrasound & Optical Cohort',
    domain: 'Maternal Healthcare AI',
    status: 'Ethics-Approved Research Access',
    scale: 'Placental weight, volume & vascularization annotations',
    description:
      'Clinical imaging protocols and multi-institutional annotations supporting automated placental pathology screening under IRB data-use agreements.',
    projectUrl: '/projects',
    repoUrl: 'https://github.com/saaillab'
  },
  {
    name: 'E-Vision Assistive Spatial Navigation Subset',
    domain: 'Assistive Technology',
    status: 'Academic Release',
    scale: 'Indoor & outdoor obstacle detection frames',
    description:
      'Curated obstacle detection sequences tailored for smartphone-based spatial audio guidance in East African urban and campus pathways.',
    projectUrl: '/projects',
    repoUrl: 'https://github.com/saaillab'
  }
];
---

<Layout
  title="Datasets & Benchmarks | SAAIL Lab"
  description="Curated agricultural, speech, medical imaging, and assistive AI benchmarks from SAAIL Lab: CropGuard-35420, CLOVES-4603, DGS-Bench, RuTAG Specialty Crops, and PlacentaVision."
  canonical="https://saaillab.github.io/datasets/"
>
  <ModernHeader currentPage="resources" />

  <main class="ds-main">
    <section class="ds-hero">
      <div class="ds-container">
        <span class="ds-eyebrow">LEAK-FREE BENCHMARKS &amp; FIELD CORPORA</span>
        <h1>Datasets &amp; Evaluation Manifests</h1>
        <p class="ds-lead">
          High-integrity agricultural vision, dialectal African speech, and clinical benchmarks designed with strict duplicate removal, transparent metadata, and open citation standards.
        </p>
      </div>
    </section>

    <section class="ds-band">
      <div class="ds-container">
        <div class="ds-grid">
          {datasets.map((ds) => (
            <article class="ds-card">
              <div class="ds-card-top">
                <span class="ds-domain">{ds.domain}</span>
                <span class="ds-status">{ds.status}</span>
              </div>
              <h2>{ds.name}</h2>
              <p class="ds-scale">{ds.scale}</p>
              <p class="ds-desc">{ds.description}</p>
              <div class="ds-actions">
                <a href={ds.projectUrl} class="d-btn d-btn-primary">Project Page &rarr;</a>
                <a href={ds.repoUrl} target="_blank" rel="noopener" class="d-btn">GitHub Repository</a>
              </div>
            </article>
          ))}
        </div>

        <div class="ds-guidelines">
          <h2>Data Redistribution &amp; Attribution Policy</h2>
          <p>
            For composite agricultural datasets assembled from third-party public benchmarks (such as PlantVillage or PlantDoc), SAAIL Lab distributes deterministic SHA/pHash deduplication manifests and official fetch scripts rather than redistributing raw image archives, ensuring full compliance with original dataset licenses. Clinical datasets follow institutional IRB agreements and are accessible via approved research collaborations through our <a href="/contact">Contact</a> page.
          </p>
        </div>
      </div>
    </section>
  </main>

  <ModernFooter />
</Layout>

<style>
  .ds-main { background: var(--bg-primary, #ffffff); color: var(--text-primary); }
  .ds-container { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
  .ds-hero {
    padding: 4.5rem 0 2.5rem;
    text-align: center;
    background: radial-gradient(circle at top center, rgba(16, 185, 129, 0.08), transparent 60%);
    border-bottom: 1px solid var(--border-color, #e2e8f0);
  }
  .ds-eyebrow { font-size: 0.78rem; font-weight: 700; color: #059669; letter-spacing: 0.05em; }
  .ds-hero h1 { font-size: clamp(2rem, 4vw, 2.85rem); font-weight: 800; margin: 0.5rem 0 0.85rem; }
  .ds-lead { max-width: 740px; margin: 0 auto; color: var(--text-secondary); font-size: 1.05rem; }

  .ds-band { padding: 3rem 0 4.5rem; }
  .ds-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 1.35rem;
    margin-bottom: 3rem;
  }
  .ds-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-card, #ffffff);
    border: 1px solid var(--border-color, #e2e8f0);
    border-radius: 16px;
    padding: 1.45rem;
  }
  .ds-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.65rem;
  }
  .ds-domain { font-size: 0.74rem; font-weight: 800; text-transform: uppercase; color: #059669; }
  .ds-status {
    padding: 0.18rem 0.6rem;
    border-radius: 999px;
    background: #eff6ff;
    color: #1d4ed8;
    font-size: 0.72rem;
    font-weight: 700;
  }
  .ds-card h2 { margin: 0 0 0.35rem; font-size: 1.16rem; font-weight: 800; }
  .ds-scale { margin: 0 0 0.65rem; font-size: 0.82rem; font-weight: 700; color: #2563eb; }
  .ds-desc { margin: 0 0 1.2rem; font-size: 0.9rem; color: var(--text-secondary); line-height: 1.6; flex: 1; }
  .ds-actions { display: flex; flex-wrap: wrap; gap: 0.45rem; }
  .d-btn {
    padding: 0.42rem 0.85rem;
    border-radius: 8px;
    border: 1px solid var(--border-color, #cbd5e1);
    background: var(--bg-secondary, #f8fafc);
    color: var(--text-primary);
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
  }
  .d-btn:hover { border-color: #2563eb; color: #2563eb; }
  .d-btn-primary { background: #0f172a; border-color: #0f172a; color: #ffffff; }
  .d-btn-primary:hover { background: #2563eb; border-color: #2563eb; color: #ffffff; }

  .ds-guidelines {
    background: var(--bg-secondary, #f8fafc);
    border: 1px solid var(--border-color, #e2e8f0);
    border-left: 4px solid #059669;
    border-radius: 14px;
    padding: 1.65rem;
  }
  .ds-guidelines h2 { margin: 0 0 0.5rem; font-size: 1.25rem; }
  .ds-guidelines p { margin: 0; font-size: 0.94rem; color: var(--text-secondary); line-height: 1.65; }
</style>
