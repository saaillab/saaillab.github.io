    color: var(--text-secondary);
    margin: 0;
  }
  .hub-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-top: 0.25rem;
  }
  .hub-links a {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent-primary);
    text-decoration: none;
    padding: 0.28rem 0.65rem;
    border-radius: 6px;
    border: 1px solid var(--border-color);
    background: var(--bg-secondary);
  }
  .hub-links a:hover { border-color: var(--accent-primary); }
  .hub-chip-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-color);
  }
  .hub-chip {
    font-family: inherit;
    font-size: 0.74rem;
    font-weight: 600;
    padding: 0.24rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--border-color);
    background: var(--bg-secondary);
    color: var(--text-secondary);
    cursor: pointer;
  }
  .hub-chip:hover { border-color: var(--accent-primary); color: var(--accent-primary); }
  .hub-chip.is-selected {
    background: var(--accent-primary);
    border-color: var(--accent-primary);
    color: #ffffff;
  }
  :global([data-theme="dark"]) .hub-chip.is-selected { color: #062111; }
  .hub-chip.is-dimmed { opacity: 0.38; }

  @media (max-width: 960px) {
    .map-layout { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 640px) {
    .collab-grid.grid-2col {
      grid-template-columns: minmax(0, 1fr);
    }

    .collab-hero {
      padding: 3.25rem 0 2.5rem;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const HUBS: Record<string, {
      regionTag: string;
      regionKey: string;
      title: string;
      partners: string;
      desc: string;
      links: { label: string; href: string }[];
    }> = {
      'zstc': {
        regionTag: 'Saateni, Zanzibar',
        regionKey: 'east-africa',
        title: 'Zanzibar State Trading Corporation (ZSTC)',
        partners: 'Certified ZSTC Clove Inspection Team',
        desc: 'Participatory co-design and regulatory validation of CLOVES-4603 and ZSTC-Clove-V1, plus compositional U-Net + ResNet-18 auditing attaining 99.45% macro-F1 and 100% EER.',
        links: [
          { label: 'Ubora-AI Project', href: '/projects/ubora-ai/' },
          { label: 'ETRI 2026 XAI Paper', href: '/papers/clove-xai-etri2026/' },
          { label: 'Live Cloves Demo', href: '/tools/#live-demo' }
        ]
      },
      'cphk': {
        regionTag: 'Pemba, Tanzania & India',
        regionKey: 'east-africa',
        title: 'Center for Public Health Kinetics (CPHK Pemba) & SVSU',
        partners: 'Prof. Sunil Sazawal (PhDs: Saide Mbarak, Ali Salim Ali, Ibrahim Kabole, Bihila Bakari)',
        desc: 'Longitudinal pediatric, maternal, and preterm birth serum biomarker analytics in Pemba Island hospitals and North India under joint PhD supervision.',
        links: [
          { label: 'People & PhDs', href: '/people/' },
          { label: 'Active Projects', href: '/projects/' }
        ]
      },
      'iitm-wsai': {
        regionTag: 'Chennai, India',
        regionKey: 'asia-oceania',
        title: 'Wadhwani School of Data Science and AI, IIT Madras',
        partners: 'Prof. Nirav Bhatt',
        desc: 'Joint research spanning resource-aware agricultural foundation models (CARA-FM, PMLR Vol. 302) alongside Global South AI sovereignty governance.',
        links: [
          { label: 'CARA-FM (PMLR 302)', href: '/papers/cara-fm/' },
          { label: 'AAAI 2026 Sovereignty', href: '/papers/ai-sovereignty-global-south-aaai2026/' }
        ]
      },
      'rutag': {
        regionTag: 'Chennai, India',
        regionKey: 'asia-oceania',
        title: 'Rural Technology Action Group (RuTAG), IIT Madras',
        partners: 'Dr. Jayababu',
        desc: 'Shared postharvest grading workflows and smallholder datasets across spices, cardamom, millets, walnuts, and cashew orchards in Tanzania and India.',
        links: [
          { label: 'Ubora-AI Grading', href: '/projects/ubora-ai/' },
          { label: 'CashewAI Project', href: '/projects/cashew-ai/' }
        ]
      },
      'penn-state': {
        regionTag: 'Pennsylvania, USA',
        regionKey: 'europe-na',
        title: 'Pennsylvania State University',
        partners: 'Prof. Alison Gernand, Prof. Wang & PlacentaVision Group',
        desc: 'Post-delivery placental morphometry and maternal-neonatal clinical imaging built for low-resource obstetric wards using calibrated smartphone imaging protocols.',
        links: [
          { label: 'PlacentaVision Project', href: '/projects/placentavision/' },
          { label: 'Publications', href: '/publications/' }
        ]
      },
      'columbia': {
        regionTag: 'New York, USA',
        regionKey: 'europe-na',
        title: 'Columbia University',
        partners: 'Dr. Sathish R. S.',
        desc: 'Environmental monitoring, AI air quality index sensing, and scalable IoT systems for public health exposure assessment.',
        links: [
          { label: 'Responsible AI Program', href: '/projects/responsible-ai-global-south/' },
          { label: 'Contact SAAIL Lab', href: '/contact/' }
        ]
      },
      'oxford': {
        regionTag: 'Oxford, UK & East Africa',
        regionKey: 'europe-na',
        title: 'Oxford Technical AI Safety & East African Cultural AI',
        partners: 'Hope K. McCoy',
        desc: 'Comparative audit of Ethiopian, Kenyan, and Rwandan national AI strategies proposing East African harmonization anchored in Ujamaa, Harambee, and Ubuntu ethics (TAIS 2026).',
        links: [
          { label: 'TAIS 2026 Oxford Paper', href: '/papers/ai-policy-harmonization-tais2026/' },
          { label: 'Governance Project', href: '/projects/responsible-ai-global-south/' }
        ]
      },
      'cambridge': {
        regionTag: 'Cambridge & Salford, UK',
        regionKey: 'europe-na',
        title: 'University of Cambridge & University of Salford',
        partners: 'Soumya Banerjee (Cambridge) & Vikranth H. Nagaraja (Salford)',
        desc: 'Seven-dimensional AI sovereignty diagnostics (PAIG @ EurIPS 2025) and multipolar South-South compute coalitions (AAAI 2026 EGSAI).',
        links: [
          { label: 'Digital Sovereignty (EurIPS)', href: '/papers/digital-sovereignty-serfdom-2025/' },
          { label: 'Global South AI (AAAI)', href: '/papers/ai-sovereignty-global-south-aaai2026/' }
        ]
      },
      'deakin': {
        regionTag: 'Victoria, Australia',
        regionKey: 'asia-oceania',
        title: 'Deakin University & Agriculture Victoria Research',
        partners: 'A/Prof. Sunil Aryal, Dr. Kallol K. Karmakar & Dr. Arbind Kumar (PhD: B. C. Bhattarai)',
        desc: 'Joint cotutelle PhD program between IIT Madras Zanzibar and Deakin University advancing agentic AI, orchard telemetry, and federated IoT security.',
        links: [
          { label: 'View PhD Cohort', href: '/people/' },
          { label: 'Research Pillars', href: '/research/' }
        ]
      },
      'nau': {
        regionTag: 'Nanjing & Xuzhou, China',
        regionKey: 'asia-oceania',
        title: 'Nanjing Agricultural University & Xuzhou Univ. of Technology',
        partners: 'Prof. Kunjie Chen, Prof. Baohua Zhang, Jiayu Zhang & Junfeng Gao',
        desc: 'Joint computer vision architectures for boundary-gated colorectal polyp segmentation (BAFNet, ESWA 2025, 0.914 Dice) and signal-rectified cassava pathology (COMPAG 2025).',
        links: [
          { label: 'BAFNet (ESWA 2025)', href: '/papers/bafnet-polyp-2025/' },
          { label: 'Cassava COMPAG 2025', href: '/papers/cassava-weakened-signals-2025/' }
        ]
      }
    };

    const nodes = Array.from(document.querySelectorAll('.hub-node')) as HTMLElement[];
    const chips = Array.from(document.querySelectorAll('.hub-chip')) as HTMLElement[];
    const arcs = Array.from(document.querySelectorAll('.map-arcs path')) as SVGElement[];
    const tabs = Array.from(document.querySelectorAll('.map-tab')) as HTMLElement[];

    const badgeEl = document.getElementById('hubRegionBadge');
    const titleEl = document.getElementById('hubTitle');
    const partnersEl = document.getElementById('hubPartners');
    const descEl = document.getElementById('hubDesc');
    const linksEl = document.getElementById('hubLinks');

    function selectHub(id: string) {
      const h = HUBS[id];
      if (!h) return;
      nodes.forEach((n) => {
        const active = n.getAttribute('data-hub') === id;
        n.classList.toggle('is-selected', active);
        n.setAttribute('aria-pressed', String(active));
      });
      chips.forEach((c) => {
        const active = c.getAttribute('data-hub') === id;
        c.classList.toggle('is-selected', active);
        c.setAttribute('aria-pressed', String(active));
      });
      arcs.forEach((a) => a.classList.toggle('is-active-arc', a.getAttribute('data-hub') === id));

      if (badgeEl) badgeEl.textContent = h.regionTag;
      if (titleEl) titleEl.textContent = h.title;
      if (partnersEl) partnersEl.innerHTML = `<strong>Collaborators:</strong> ${h.partners}`;
      if (descEl) descEl.textContent = h.desc;
      if (linksEl) {
        linksEl.innerHTML = h.links.map((lk) => `<a href="${lk.href}">${lk.label}</a>`).join('');
      }
    }

    function applyRegionFilter(region: string) {
      let firstMatch = '';
      nodes.forEach((n) => {
        const match = region === 'all' || n.getAttribute('data-region') === region;
        n.classList.toggle('is-dimmed', !match);
        n.setAttribute('aria-disabled', String(!match));
        n.setAttribute('tabindex', match ? '0' : '-1');
        if (match && !firstMatch) firstMatch = n.getAttribute('data-hub') || '';
      });
      chips.forEach((c) => {
        const match = region === 'all' || c.getAttribute('data-region') === region;
        c.classList.toggle('is-dimmed', !match);
        (c as HTMLButtonElement).disabled = !match;
      });
      arcs.forEach((a) => {
        const hid = a.getAttribute('data-hub') || '';
        const match = region === 'all' || HUBS[hid]?.regionKey === region;
        a.classList.toggle('is-dimmed', !match);
      });
      if (firstMatch && region !== 'all') {
        selectHub(firstMatch);
      }
    }

    nodes.forEach((n) => {
      n.addEventListener('click', () => selectHub(n.getAttribute('data-hub') || ''));
      n.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          selectHub(n.getAttribute('data-hub') || '');
        }
      });
    });

    chips.forEach((c) => {
      c.addEventListener('click', () => selectHub(c.getAttribute('data-hub') || ''));
    });

    tabs.forEach((tab, idx) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => {
          t.classList.remove('is-active');
          t.setAttribute('aria-selected', 'false');
          t.setAttribute('tabindex', '-1');
        });
        tab.classList.add('is-active');
        tab.setAttribute('aria-selected', 'true');
        tab.setAttribute('tabindex', '0');
        applyRegionFilter(tab.getAttribute('data-region') || 'all');
      });
      tab.addEventListener('keydown', (e: KeyboardEvent) => {
        let next: number | null = null;
        if (e.key === 'ArrowRight') next = (idx + 1) % tabs.length;
        else if (e.key === 'ArrowLeft') next = (idx - 1 + tabs.length) % tabs.length;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = tabs.length - 1;
        if (next === null) return;
        e.preventDefault();
        tabs[next].focus();
        tabs[next].click();
      });
    });
  });
</script>
