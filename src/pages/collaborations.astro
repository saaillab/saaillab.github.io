  }
  .map-tab:hover { border-color: var(--accent-primary); color: var(--accent-primary); }
  .map-tab.is-active {
    background: var(--accent-primary);
    border-color: var(--accent-primary);
    color: #ffffff;
  }
  :global([data-theme="dark"]) .map-tab.is-active { color: #062111; }

  .map-layout {
    display: grid;
