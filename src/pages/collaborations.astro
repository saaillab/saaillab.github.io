  .hub-node circle {
    fill: var(--accent-primary);
    stroke: var(--bg-card);
    stroke-width: 2;
    transition: r 0.16s ease, opacity 0.16s ease;
  }
  .hub-node:hover circle,
  .hub-node.is-selected circle {
    fill: var(--accent-gold);
    r: 8.5;
  }
  .hub-node.is-dimmed { opacity: 0.25; }

  .map-inspector {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 14px;
    padding: 1.45rem;
    display: flex;
