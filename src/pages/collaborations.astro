---
import Layout from '../layouts/Layout.astro';
import ModernHeader from '../components/ModernHeader.astro';
import ModernFooter from '../components/ModernFooter.astro';
---

<Layout
  title="Research Collaborations | SAAIL Lab at IIT Madras Zanzibar"
  description="Global and regional research collaborations led by SAAIL Lab (IIT Madras Zanzibar) across IIT Madras, ZSTC Zanzibar, RuTAG, CPHK Pemba, Penn State, Columbia University, Deakin University, Cambridge, Salford, Oxford Technical AI Safety, and Nanjing Agricultural University."
  canonical="https://saaillab.github.io/collaborations/"
>
  <ModernHeader currentPage="research" />

  <main id="main-content" class="collab-page">
    <section class="collab-hero">
      <div class="collab-container">
        <span class="collab-eyebrow" data-i18n="collab.eyebrow">Global &amp; East African Research Consortia</span>
        <h1 data-i18n="collab.title">Research Collaborations</h1>
        <p class="hero-lead">
          <span data-i18n="collab.lead_pre">Led by</span> <a href="https://www.iitmz.ac.in/schools/engineering-and-science/faculty/prof-innocent-nyalala" target="_blank" rel="noopener noreferrer">Innocent Nyalala</a> <span data-i18n="collab.lead_post">at IIT Madras Zanzibar, SAAIL Lab coordinates ten verified institutional partnerships across Tanzania, India, the United States, the United Kingdom, Australia, and China.</span>
        </p>

        <div class="metrics-strip" aria-label="Collaboration summary statistics">
          <div class="metric-item">
            <span class="metric-value">10</span>
            <span class="metric-label">Partner Consortia</span>
          </div>
          <div class="metric-item">
            <span class="metric-value">6</span>
            <span class="metric-label">Partner Countries</span>
          </div>
          <div class="metric-item">
            <span class="metric-value">5</span>
            <span class="metric-label">Co-Supervised PhDs</span>
          </div>
          <div class="metric-item">
            <span class="metric-value">CC BY-NC 4.0</span>
            <span class="metric-label">Research Attribution Standard</span>
          </div>
        </div>
      </div>
    </section>

    <section class="collab-section map-section" id="network-map">
      <div class="collab-container">
        <div class="section-header-left">
          <span class="section-tag">Interactive Partner Network</span>
          <h2 data-i18n="collab.map_title">East Africa &amp; Global Collaboration Map</h2>
          <p class="section-desc">
            Inspect SAAIL Lab's research links connecting IIT Madras Zanzibar across Tanzania, India, the United States, the United Kingdom, Australia, and China. Select a region or click any hub marker.
          </p>
        </div>

        <div class="map-controls" role="tablist" aria-label="Filter collaboration hubs by region">
          <button type="button" role="tab" aria-selected="true" aria-controls="collabMapInspector" tabindex="0" class="map-tab is-active" data-region="all">All Hubs (10)</button>
          <button type="button" role="tab" aria-selected="false" aria-controls="collabMapInspector" tabindex="-1" class="map-tab" data-region="east-africa">East Africa (2)</button>
          <button type="button" role="tab" aria-selected="false" aria-controls="collabMapInspector" tabindex="-1" class="map-tab" data-region="asia-oceania">Asia &amp; Oceania (4)</button>
          <button type="button" role="tab" aria-selected="false" aria-controls="collabMapInspector" tabindex="-1" class="map-tab" data-region="europe-na">Europe &amp; North America (4)</button>
        </div>

        <div class="map-layout">
          <div class="map-canvas-wrap">
            <svg viewBox="0 0 1000 460" class="collab-map-svg" role="img" aria-label="World network map showing collaborations radiating from SAAIL Lab in Zanzibar">
              <rect x="0" y="0" width="1000" height="460" class="map-ocean" rx="14" />
              <g class="map-grid-lines" aria-hidden="true">
                <line x1="0" y1="115" x2="1000" y2="115" />
                <line x1="0" y1="230" x2="1000" y2="230" />
                <line x1="0" y1="345" x2="1000" y2="345" />
                <line x1="250" y1="0" x2="250" y2="460" />
                <line x1="500" y1="0" x2="500" y2="460" />
                <line x1="750" y1="0" x2="750" y2="460" />
              </g>
              <g class="map-continents" aria-hidden="true">
                <!-- North America -->
                <path d="M125 68 L285 64 L322 108 L295 148 L254 178 L234 218 L206 202 L180 156 L142 132 Z" />
                <!-- South America -->
                <path d="M262 230 L328 244 L362 292 L340 368 L300 416 L278 380 L270 302 Z" />
                <!-- Europe -->
                <path d="M466 64 L548 60 L568 106 L536 132 L472 130 L460 102 Z" />
                <!-- Africa -->
                <path d="M458 148 L556 146 L596 184 L624 224 L608 286 L562 356 L532 354 L512 280 L458 228 Z" />
                <!-- Madagascar -->
                <path d="M622 290 L638 286 L632 328 L616 322 Z" />
                <!-- Asia -->
                <path d="M558 62 L855 56 L892 108 L852 178 L788 194 L735 228 L698 205 L650 186 L588 158 L558 118 Z" />
                <!-- Maritime SE Asia -->
                <path d="M775 232 L845 234 L848 256 L776 254 Z" />
                <!-- Australia -->
                <path d="M810 294 L908 292 L928 344 L886 382 L818 368 L802 326 Z" />
              </g>

              <!-- Curved arcs radiating from Zanzibar (609, 250) -->
              <g class="map-arcs">
                <path data-hub="penn-state" d="M609,250 Q445,95 284,131" />
                <path data-hub="columbia" d="M609,250 Q455,98 295,131" />
                <path data-hub="oxford" d="M609,250 Q525,138 495,104" />
                <path data-hub="cambridge" d="M609,250 Q536,132 503,99" />
                <path data-hub="iitm-wsai" d="M609,250 Q672,188 723,205" />
                <path data-hub="rutag" d="M609,250 Q676,196 728,214" />
                <path data-hub="nau" d="M609,250 Q736,142 830,155" />
                <path data-hub="deakin" d="M609,250 Q775,268 901,342" />
                <path data-hub="zstc" d="M609,250 Q602,240 603,244" />
                <path data-hub="cphk" d="M609,250 Q615,236 616,240" />
              </g>

              <!-- Home Hub: SAAIL Lab, IIT Madras Zanzibar -->
              <g class="map-origin">
                <circle cx="609" cy="250" r="13" class="origin-halo" />
                <circle cx="609" cy="250" r="6" class="origin-dot" />
                <text x="609" y="274" text-anchor="middle" class="origin-label">SAAIL Lab · Zanzibar</text>
              </g>

              <!-- Partner Nodes -->
              <g id="mapNodesLayer" class="map-nodes">
                <g class="hub-node" data-hub="zstc" data-region="east-africa" tabindex="0" role="button" aria-pressed="false" aria-label="Select ZSTC Saateni Zanzibar">
                  <circle cx="603" cy="242" r="5.5" />
                  <title>ZSTC (Saateni, Zanzibar)</title>
                </g>
                <g class="hub-node" data-hub="cphk" data-region="east-africa" tabindex="0" role="button" aria-pressed="false" aria-label="Select CPHK Pemba and SVSU">
                  <circle cx="617" cy="238" r="5.5" />
                  <title>CPHK Pemba &amp; SVSU (Pemba, Tanzania &amp; India)</title>
                </g>
                <g class="hub-node is-selected" data-hub="iitm-wsai" data-region="asia-oceania" tabindex="0" role="button" aria-pressed="true" aria-label="Select Wadhwani School of Data Science and AI, IIT Madras">
                  <circle cx="723" cy="205" r="6" />
                  <title>WSAI, IIT Madras (Chennai, India)</title>
                </g>
                <g class="hub-node" data-hub="rutag" data-region="asia-oceania" tabindex="0" role="button" aria-pressed="false" aria-label="Select RuTAG IIT Madras">
                  <circle cx="729" cy="215" r="5.5" />
                  <title>RuTAG, IIT Madras (Chennai, India)</title>
                </g>
                <g class="hub-node" data-hub="penn-state" data-region="europe-na" tabindex="0" role="button" aria-pressed="false" aria-label="Select Pennsylvania State University">
                  <circle cx="284" cy="131" r="6" />
                  <title>Pennsylvania State University (USA)</title>
                </g>
                <g class="hub-node" data-hub="columbia" data-region="europe-na" tabindex="0" role="button" aria-pressed="false" aria-label="Select Columbia University">
                  <circle cx="296" cy="131" r="5.5" />
                  <title>Columbia University (New York, USA)</title>
                </g>
                <g class="hub-node" data-hub="oxford" data-region="europe-na" tabindex="0" role="button" aria-pressed="false" aria-label="Select Oxford Technical AI Safety">
                  <circle cx="495" cy="105" r="5.5" />
                  <title>Oxford Technical AI Safety (Oxford, UK)</title>
                </g>
                <g class="hub-node" data-hub="cambridge" data-region="europe-na" tabindex="0" role="button" aria-pressed="false" aria-label="Select University of Cambridge and University of Salford">
                  <circle cx="504" cy="98" r="6" />
                  <title>University of Cambridge &amp; Salford (UK)</title>
                </g>
                <g class="hub-node" data-hub="deakin" data-region="asia-oceania" tabindex="0" role="button" aria-pressed="false" aria-label="Select Deakin University and Agriculture Victoria">
                  <circle cx="901" cy="342" r="6" />
                  <title>Deakin University &amp; AgVic (Australia)</title>
                </g>
                <g class="hub-node" data-hub="nau" data-region="asia-oceania" tabindex="0" role="button" aria-pressed="false" aria-label="Select Nanjing Agricultural University and XZUT">
                  <circle cx="830" cy="155" r="6" />
                  <title>Nanjing Agricultural University &amp; XZUT (China)</title>
                </g>
              </g>
            </svg>
          </div>

          <aside id="collabMapInspector" class="map-inspector" aria-live="polite">
            <span id="hubRegionBadge" class="region-badge">Chennai, India</span>
            <h3 id="hubTitle">Wadhwani School of Data Science and AI, IIT Madras</h3>
            <p id="hubPartners" class="lead-line"><strong>Collaborators:</strong> Prof. Nirav Bhatt</p>
            <p id="hubDesc" class="hub-desc">
              Joint theoretical and empirical research spanning culturally attuned and resource-aware agricultural foundation models (CARA-FM, PMLR Vol. 302) alongside Global South AI sovereignty governance.
            </p>
            <div id="hubLinks" class="hub-links">
              <a href="/papers/cara-fm/">CARA-FM (PMLR 302)</a>
              <a href="/papers/ai-sovereignty-global-south-aaai2026/">AAAI 2026 Sovereignty</a>
            </div>
            <div class="hub-chip-list" aria-label="All collaboration hubs">
              <button type="button" class="hub-chip" data-hub="zstc" data-region="east-africa" aria-pressed="false">ZSTC Zanzibar</button>
              <button type="button" class="hub-chip" data-hub="cphk" data-region="east-africa" aria-pressed="false">CPHK Pemba</button>
              <button type="button" class="hub-chip is-selected" data-hub="iitm-wsai" data-region="asia-oceania" aria-pressed="true">IITM WSAI</button>
              <button type="button" class="hub-chip" data-hub="rutag" data-region="asia-oceania" aria-pressed="false">IITM RuTAG</button>
              <button type="button" class="hub-chip" data-hub="penn-state" data-region="europe-na" aria-pressed="false">Penn State</button>
              <button type="button" class="hub-chip" data-hub="columbia" data-region="europe-na" aria-pressed="false">Columbia</button>
              <button type="button" class="hub-chip" data-hub="oxford" data-region="europe-na" aria-pressed="false">Oxford TAIS</button>
              <button type="button" class="hub-chip" data-hub="cambridge" data-region="europe-na" aria-pressed="false">Cambridge &amp; Salford</button>
              <button type="button" class="hub-chip" data-hub="deakin" data-region="asia-oceania" aria-pressed="false">Deakin &amp; AgVic</button>
              <button type="button" class="hub-chip" data-hub="nau" data-region="asia-oceania" aria-pressed="false">NAU &amp; XZUT</button>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <section class="collab-section section-alt">
      <div class="collab-container">
        <div class="section-header-left">
          <span class="section-tag">01 · Anchor Campus &amp; Regulatory Partners</span>
          <h2>IIT Madras Network &amp; Zanzibar Commodity Authorities</h2>
          <p class="section-desc">
            Core foundational collaborations linking foundational ML theory at IIT Madras Chennai with commercial agricultural inspection and smallholder field translation across Zanzibar and rural India.
          </p>
        </div>

        <div class="collab-grid">
          <article class="collab-card">
            <div class="card-meta">
              <span class="region-badge">Chennai, India</span>
              <span class="role-badge">Foundational Theory &amp; Policy</span>
            </div>
            <h3>Wadhwani School of Data Science and AI, IIT Madras</h3>
            <p class="lead-line"><strong>Principal Collaborator:</strong> Prof. Nirav Bhatt</p>
            <p class="card-body">
              Joint theoretical and empirical research spanning culturally attuned and resource-aware agricultural foundation models (CARA-FM in PMLR Vol. 302) alongside Global South AI sovereignty and multipolar compute governance (AAAI 2026 EGSAI and PAIG at EurIPS 2025).
            </p>
            <div class="card-links">
              <a href="/papers/cara-fm/">CARA-FM (PMLR 302)</a>
              <a href="/papers/ai-sovereignty-global-south-aaai2026/">AAAI 2026 Sovereignty</a>
            </div>
          </article>

          <article class="collab-card">
            <div class="card-meta">
              <span class="region-badge">Saateni, Zanzibar</span>
              <span class="role-badge">Commodity Regulation</span>
            </div>
            <h3>Zanzibar State Trading Corporation (ZSTC)</h3>
            <p class="lead-line"><strong>Principal Partners:</strong> Certified ZSTC Clove Inspection Team</p>
            <p class="card-body">
              Participatory human-centered co-design and commercial validation of standardized clove datasets (CLOVES-4603 and ZSTC-Clove-V1), compositional U-Net + ResNet-18 auditing attaining 99.45% macro-F1 with 100% Explanation Evidence Ratio, and capture-session confounding protocols.
            </p>
            <div class="card-links">
              <a href="/projects/ubora-ai/">Ubora-AI Project</a>
              <a href="/papers/clove-xai-etri2026/">ETRI 2026 XAI Paper</a>
              <a href="/papers/cloves-4603/">CLOVES-4603 (CVPR)</a>
            </div>
          </article>

          <article class="collab-card">
            <div class="card-meta">
              <span class="region-badge">Chennai, India</span>
              <span class="role-badge">Rural Ag &amp; Datasets</span>
            </div>
            <h3>Rural Technology Action Group (RuTAG), IIT Madras</h3>
            <p class="lead-line"><strong>Principal Collaborator:</strong> Dr. Jayababu</p>
            <p class="card-body">
              Joint research advancing AI for rural agriculture and smallholder agricultural dataset development (covering cardamom, millets, and walnuts) alongside edge postharvest grading workflows and low-power enclosure engineering across Tanzania and India.
            </p>
            <div class="card-links">
              <a href="/projects/ubora-ai/">Ubora-AI Grading</a>
              <a href="/projects/cashew-ai/">CashewAI Project</a>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="collab-section">
      <div class="collab-container">
        <div class="section-header-left">
          <span class="section-tag">02 · Global Health &amp; Maternal Informatics</span>
          <h2>Pediatric, Neonatal &amp; Clinical AI Consortia</h2>
          <p class="section-desc">
            Biomedical machine learning and clinical field studies conducted across Pemba Island hospitals, Indian clinical institutes, and North American university medical research groups.
          </p>
        </div>

        <div class="collab-grid">
          <article class="collab-card">
            <div class="card-meta">
              <span class="region-badge">Pemba, Tanzania &amp; India</span>
              <span class="role-badge">Joint PhD Supervision (4)</span>
            </div>
            <h3>Center for Public Health Kinetics (CPHK Pemba) &amp; Swami Vivekanand Subharti University</h3>
            <p class="lead-line"><strong>Principal Collaborator:</strong> Prof. Sunil Sazawal (PhD Researchers: Saide A. Mbarak, Ali Salim Ali, Ibrahim B. Kabole, Bihila A. Bakari)</p>
            <p class="card-body">
              Longitudinal pediatric, maternal, and infectious-disease cohort analytics in Pemba and North India, pairing population health surveillance with accountable clinical machine learning under joint PhD supervision.
            </p>
            <div class="card-links">
              <a href="/people/">Lab Members &amp; PhDs</a>
              <a href="/projects/">Active Clinical Projects</a>
            </div>
          </article>

          <article class="collab-card">
            <div class="card-meta">
              <span class="region-badge">Pennsylvania, USA</span>
              <span class="role-badge">Placental Computer Vision</span>
            </div>
            <h3>Pennsylvania State University</h3>
            <p class="lead-line"><strong>Principal Collaborators:</strong> Prof. Alison Gernand, Prof. Wang &amp; PlacentaVision Group</p>
            <p class="card-body">
              Automated post-delivery placental segmentation and maternal-neonatal triage research engineered for low-resource obstetric wards using calibrated smartphone imaging and domain-generalizable vision pipelines.
            </p>
            <div class="card-links">
              <a href="/projects/placentavision/">PlacentaVision Project</a>
              <a href="/publications/">Published Literature</a>
            </div>
          </article>

          <article class="collab-card">
            <div class="card-meta">
              <span class="region-badge">New York, USA</span>
              <span class="role-badge">Environmental Sensing &amp; IoT</span>
            </div>
            <h3>Columbia University</h3>
            <p class="lead-line"><strong>Principal Collaborator:</strong> Dr. Sathish R. S.</p>
            <p class="card-body">
              Joint research on environmental monitoring, AI-driven air quality index sensing, and scalable IoT systems for public health analytics and community exposure assessment.
            </p>
            <div class="card-links">
              <a href="/projects/responsible-ai-global-south/">Responsible AI Program</a>
              <a href="/contact/">Collaborate with SAAIL</a>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="collab-section section-alt">
      <div class="collab-container">
        <div class="section-header-left">
          <span class="section-tag">03 · International Technical &amp; Governance Alliances</span>
          <h2>Sovereign AI Governance, Security &amp; Multimodal Vision</h2>
          <p class="section-desc">
            Cross-continental collaborations across Australia, the United Kingdom, and China advancing AI safety policy, edge IoT resilience, medical image segmentation, and foliar disease modeling.
          </p>
        </div>

        <div class="collab-grid grid-2col">
          <article class="collab-card">
            <div class="card-meta">
              <span class="region-badge">Victoria, Australia</span>
              <span class="role-badge">Cotutelle / Joint PhD Program</span>
            </div>
            <h3>Deakin University &amp; Agriculture Victoria Research</h3>
            <p class="lead-line"><strong>Principal Collaborators:</strong> A/Prof. Sunil Aryal, Dr. Kallol Krishna Karmakar &amp; Dr. Arbind Kumar (PhD Candidate: Bidhan Chandra Bhattarai)</p>
            <p class="card-body">
              Joint/cotutelle PhD program between IIT Madras Zanzibar and Deakin University developing an agentic AI framework for agricultural technologies, resilient IoT telemetry, and federated security.
            </p>
            <div class="card-links">
              <a href="/people/">View PhD Cohorts</a>
              <a href="/research/">Research Architecture</a>
            </div>
          </article>

          <article class="collab-card">
            <div class="card-meta">
              <span class="region-badge">Cambridge &amp; Salford, UK</span>
              <span class="role-badge">AI Sovereignty Policy</span>
            </div>
            <h3>University of Cambridge &amp; University of Salford</h3>
            <p class="lead-line"><strong>Principal Collaborators:</strong> Soumya Banerjee (Cambridge) &amp; Vikranth H. Nagaraja (Salford)</p>
            <p class="card-body">
              Comparative seven-dimensional AI sovereignty diagnostics evaluating Singapore, Vietnam, Kenya, and Syria (PAIG at EurIPS 2025) alongside multipolar South-South compute and open-weight coalitions (AAAI 2026 EGSAI).
            </p>
            <div class="card-links">
              <a href="/papers/digital-sovereignty-serfdom-2025/">Digital Sovereignty (EurIPS)</a>
              <a href="/papers/ai-sovereignty-global-south-aaai2026/">Global South AI (AAAI)</a>
            </div>
          </article>

          <article class="collab-card">
            <div class="card-meta">
              <span class="region-badge">Oxford, UK &amp; East Africa</span>
              <span class="role-badge">Cultural AI Safety</span>
            </div>
            <h3>Oxford Technical AI Safety &amp; East African Cultural AI</h3>
            <p class="lead-line"><strong>Principal Collaborator:</strong> Hope K. McCoy</p>
            <p class="card-body">
              Cross-national audit comparing formal AI policies in Ethiopia (2022), Kenya (2025), and Rwanda (2023), proposing East African Community harmonization anchored in Ujamaa, Harambee, and Ubuntu ethics for TAIS 2026 at the University of Oxford.
            </p>
            <div class="card-links">
              <a href="/papers/ai-policy-harmonization-tais2026/">TAIS 2026 Oxford Paper</a>
              <a href="/projects/responsible-ai-global-south/">Governance Project</a>
            </div>
          </article>

          <article class="collab-card">
            <div class="card-meta">
              <span class="region-badge">Nanjing &amp; Xuzhou, China</span>
              <span class="role-badge">Medical &amp; Foliar Vision</span>
            </div>
            <h3>Nanjing Agricultural University &amp; Xuzhou University of Technology</h3>
            <p class="lead-line"><strong>Principal Collaborators:</strong> Prof. Kunjie Chen, Prof. Baohua Zhang, Jiayu Zhang &amp; Junfeng Gao</p>
            <p class="card-body">
              Joint architectural research producing boundary-gated colorectal polyp segmentation (BAFNet in Expert Systems with Applications, 0.914 EndoScene Dice) and signal-rectified cassava leaf pathology detection (MAIANet and COMPAG 2025).
            </p>
            <div class="card-links">
              <a href="/papers/bafnet-polyp-2025/">BAFNet (ESWA 2025)</a>
              <a href="/papers/cassava-weakened-signals-2025/">Weakened Signals (COMPAG)</a>
              <a href="https://inyalala.github.io/papers/maianet-cassava-2024/" target="_blank" rel="noopener">MAIANet (COMPAG 2024) &#8599;</a>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="collab-cta-section">
      <div class="collab-container">
        <div class="cta-banner">
          <div class="cta-text">
            <h2>Initiate a Joint Research Collaboration</h2>
            <p>
              Academic institutions, agricultural cooperatives, public health ministries, and non-profit engineering teams can propose joint studies with SAAIL Lab at IIT Madras Zanzibar. Open codebases, datasets, and benchmarks are licensed under <a href="https://creativecommons.org/licenses/by-nc/4.0/" target="_blank" rel="license noopener">CC BY-NC 4.0</a> (<a href="mailto:innocent@iitmz.ac.in">innocent@iitmz.ac.in</a>).
            </p>
          </div>
          <div class="cta-actions">
            <a href="/contact/" class="btn-primary">Contact SAAIL Lab</a>
            <a href="https://www.iitmz.ac.in/schools/engineering-and-science/faculty/prof-innocent-nyalala" target="_blank" rel="noopener noreferrer" class="btn-secondary">IITMZ Faculty Profile</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <ModernFooter />
</Layout>

<style>
  .collab-page {
    padding-top: var(--header-height, 74px);
    background-color: var(--bg-primary);
    color: var(--text-primary);
  }

  .collab-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .collab-hero {
    padding: 4.5rem 0 3.25rem;
    border-bottom: 1px solid var(--border-color);
    text-align: left;
  }

  .collab-eyebrow {
    display: inline-block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-primary);
    margin-bottom: 0.85rem;
  }

  .collab-hero h1 {
    font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
    font-size: clamp(2.1rem, 4vw, 3rem);
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }

  .hero-lead {
    font-size: 1.08rem;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 78ch;
