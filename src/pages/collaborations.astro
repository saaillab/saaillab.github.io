---
import Layout from '../layouts/Layout.astro';
import ModernHeader from '../components/ModernHeader.astro';
import ModernFooter from '../components/ModernFooter.astro';
---

<Layout 
	title="Collaborations | SAAIL Lab | IIT Madras Zanzibar"
	description="International research collaborations and academic partnerships at SAAIL Lab, School of Engineering and Science, IIT Madras Zanzibar."
	canonical="https://saaillab.github.io/collaborations/"
>
	<ModernHeader currentPage="research" />
	
	<main id="main-content" class="collaborations-page">
		<!-- Hero Section -->
		<section class="page-hero">
			<div class="container">
				<span class="page-eyebrow">Global Network</span>
				<h1 class="page-title">International Collaborations</h1>
				<p class="page-lead">
					SAAIL Lab at IIT Madras Zanzibar maintains active research partnerships with universities and clinical institutes across Australia, the United States, the United Kingdom, China, and East Africa.
				</p>
			</div>
		</section>

		<!-- Collaborations Grid -->
		<section class="collaborations-content">
			<div class="container">
				<div class="collaborations-grid">
					<div class="collaboration-card">
						<div class="collab-flag">AU</div>
						<h2>Deakin University</h2>
						<p class="collab-location">Australia</p>
						<p class="collab-project">
							Cotutelle PhD collaboration on agentic AI frameworks for agricultural technologies with A/Prof. Sunil Aryal and Dr. Kallol Krishna Karmakar.
						</p>
						<div class="collab-details">
							<span class="collab-status active">Active</span>
							<span class="collab-type">Joint PhD Supervision</span>
						</div>
					</div>

					<div class="collaboration-card">
						<div class="collab-flag">US</div>
						<h2>Penn State University</h2>
						<p class="collab-location">United States</p>
						<p class="collab-project">
							PlacentaVision clinical imaging consortium with Prof. Alison Gernand focusing on placental weight, perfusion, and maternal neonatal health risk prediction.
						</p>
						<div class="collab-details">
							<span class="collab-status active">Active</span>
							<span class="collab-type">Clinical Imaging</span>
						</div>
					</div>

					<div class="collaboration-card">
						<div class="collab-flag">US</div>
						<h2>Columbia University</h2>
						<p class="collab-location">United States</p>
						<p class="collab-project">
							AI-driven air quality index monitoring research with Dr. Sathish R. S., focusing on environmental sensing and public health analytics.
						</p>
						<div class="collab-details">
							<span class="collab-status active">Active</span>
							<span class="collab-type">Environmental AI</span>
						</div>
					</div>

					<div class="collaboration-card">
						<div class="collab-flag">UK</div>
						<h2>University of Cambridge</h2>
						<p class="collab-location">United Kingdom</p>
						<p class="collab-project">
							Responsible AI sovereignty and ethical governance frameworks with Dr. Soumya Banerjee (AAAI 2026 EGSAI and NeurIPS 2025 PAIG).
						</p>
						<div class="collab-details">
							<span class="collab-status active">Active</span>
							<span class="collab-type">Responsible AI</span>
						</div>
					</div>

					<div class="collaboration-card">
						<div class="collab-flag">CN</div>
						<h2>Nanjing Agricultural University</h2>
						<p class="collab-location">China</p>
						<p class="collab-project">
							Long-standing precision agriculture and plant pathology vision research partnership extending from Dr. Nyalala's doctoral studies.
						</p>
						<div class="collab-details">
							<span class="collab-status ongoing">Ongoing</span>
							<span class="collab-type">Agricultural Vision</span>
						</div>
					</div>

					<div class="collaboration-card">
						<div class="collab-flag">UK</div>
						<h2>University of Salford</h2>
						<p class="collab-location">United Kingdom</p>
						<p class="collab-project">
							Co-authored research on Global South AI sovereignty and trustworthy technological futures with Dr. Vikranth H. Nagaraja.
						</p>
						<div class="collab-details">
							<span class="collab-status active">Active</span>
							<span class="collab-type">AI Policy &amp; Ethics</span>
						</div>
					</div>
				</div>
			</div>
		</section>
	</main>

	<ModernFooter />
</Layout>

<style>
	.collaborations-content {
		padding: 4.5rem 0;
		background: var(--bg-primary);
	}

	.collaborations-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
		gap: 1.75rem;
	}

	.collaboration-card {
		background: var(--bg-card);
		border-radius: 1.25rem;
		padding: 2rem;
		text-align: center;
		box-shadow: 0 4px 12px var(--shadow-light);
		border: 1px solid var(--border-color);
		transition: all 0.3s ease;
	}

	.collaboration-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 8px 20px var(--shadow-medium);
	}

	.collab-flag {
		display: inline-grid;
		place-items: center;
		width: 48px;
		height: 48px;
		border-radius: 12px;
		background: rgba(20, 83, 45, 0.1);
		color: var(--accent-primary);
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.92rem;
		font-weight: 800;
		letter-spacing: 0.05em;
		margin: 0 auto 1rem;
	}

	.collaboration-card h2 {
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--text-primary);
		margin-bottom: 0.45rem;
	}

	.collab-location {
		color: var(--text-muted);
		font-weight: 500;
		margin-bottom: 1rem;
	}

	.collab-project {
		color: var(--text-secondary);
		line-height: 1.6;
		margin-bottom: 1.5rem;
		font-size: 0.875rem;
	}

	.collab-details {
		display: flex;
		justify-content: center;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.collab-status,
	.collab-type {
		padding: 0.25rem 0.75rem;
		border-radius: 0.5rem;
		font-size: 0.75rem;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.collab-status.active {
		background: #dcfce7;
		color: #166534;
	}

	.collab-status.ongoing {
		background: #e0f2fe;
		color: #0369a1;
	}

	.collab-type {
		background: var(--bg-tertiary);
		color: var(--text-secondary);
	}

	@media (max-width: 768px) {
		.collaborations-grid {
			grid-template-columns: 1fr;
		}
	}
</style>