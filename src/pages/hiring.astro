---
import Layout from '../layouts/Layout.astro';
import ModernHeader from '../components/ModernHeader.astro';
import ModernFooter from '../components/ModernFooter.astro';
---

<Layout
	title="Join SAAIL Lab | Research Opportunities at IIT Madras Zanzibar"
	description="Research opportunities at SAAIL Lab, IIT Madras Zanzibar: MTech Data Science & AI thesis positions, BS in Data Science & AI fellowships, visiting researchers, and filled PhD cohort details."
	canonical="https://saaillab.github.io/hiring/"
>
	<ModernHeader currentPage="hiring" />

	<main id="main-content">
		<section class="page-hero">
			<div class="container">
				<span class="page-eyebrow">Careers &amp; Academic Training</span>
				<h1 class="page-title">Join SAAIL Lab</h1>
				<p class="page-lead">
					We train MTech and BS researchers at the School of Engineering and Science, IIT Madras Zanzibar, building reliable agricultural vision, Swahili language safety, and clinical ML systems.
				</p>
			</div>
		</section>

		<section class="section">
			<div class="container">
				<div class="section-head">
					<span class="page-eyebrow">Positions &amp; Fellowship Status</span>
					<h2 class="section-title-left">Research Opportunities</h2>
					<p class="section-lead">Review open student positions, visiting researcher fellowships, and current cohort status.</p>
				</div>

				<div class="opp-grid">
					<article class="opp-card">
						<div class="opp-top">
							<span class="opp-num">01</span>
							<span class="opp-badge badge-open">Open · IITMZ Cohort</span>
						</div>
						<h3>MTech in Data Science &amp; AI Thesis Research</h3>
						<p>
							Two-year Master's thesis positions supervised by Dr. Innocent Nyalala spanning lightweight computer vision for East African crops, explainable commodity grading, deployment gap auditing, Swahili NLP/safety, and maternal clinical imaging.
						</p>
						<dl class="opp-meta">
							<div><dt>Eligibility</dt><dd>Admitted IIT Madras Zanzibar MTech DSAI candidates</dd></div>
							<div><dt>Location</dt><dd>Bweleo Campus, Zanzibar, Tanzania</dd></div>
						</dl>
						<a href="/contact/" class="opp-link">Inquire About MTech Projects &rarr;</a>
					</article>

					<article class="opp-card">
						<div class="opp-top">
							<span class="opp-num">02</span>
							<span class="opp-badge badge-open">Rolling · IITMZ BS</span>
						</div>
						<h3>BS in Data Science &amp; AI Undergraduate Research</h3>
						<p>
							Hands-on undergraduate research fellowships contributing to the CultureSEEDS East Africa benchmark, Zanzibar Swahili Corpus, Dira translationese detection, and coastal blue economy seaweed telemetry.
						</p>
						<dl class="opp-meta">
							<div><dt>Eligibility</dt><dd>IIT Madras Zanzibar BS in Data Science &amp; AI students</dd></div>
							<div><dt>Commitment</dt><dd>Semester or summer research fellowship (3 to 12 months)</dd></div>
						</dl>
						<a href="/contact/" class="opp-link">Apply for BS Fellowship &rarr;</a>
					</article>

					<article class="opp-card">
						<div class="opp-top">
							<span class="opp-num">03</span>
							<span class="opp-badge badge-open">Open · Collaboration</span>
						</div>
						<h3>Visiting Researchers &amp; Postdocs</h3>
						<p>
							Short- and medium-term academic exchanges for doctoral students, faculty collaborators, and AI engineers partnering on East African food systems, Swahili safety evaluations, or low-resource clinical ML.
						</p>
						<dl class="opp-meta">
							<div><dt>Duration</dt><dd>1 to 12 months (in-person Zanzibar or hybrid consortium)</dd></div>
							<div><dt>Focus</dt><dd>Joint publications, open benchmarks, and shared field trials</dd></div>
						</dl>
						<a href="/contact/" class="opp-link">Propose a Visiting Exchange &rarr;</a>
					</article>

					<article class="opp-card opp-closed">
						<div class="opp-top">
							<span class="opp-num">04</span>
							<span class="opp-badge badge-closed">Filled · Position Closed</span>
						</div>
						<h3>Cotutelle PhD in Agentic AI for Agricultural Technologies</h3>
						<p>
							Joint doctoral fellowship between IIT Madras Zanzibar and Deakin University, Australia on autonomous orchard sensing and agricultural decision support.
						</p>
						<dl class="opp-meta">
							<div><dt>Status</dt><dd>This funded position has been filled (B. C. Bhattarai, current PhD cohort).</dd></div>
							<div><dt>Future Openings</dt><dd>Monitor IITMZ and Deakin portals or contact us regarding self-funded doctoral fellowships.</dd></div>
						</dl>
						<a href="/people/" class="opp-link">Meet Current PhD Cohort &rarr;</a>
					</article>
				</div>
			</div>
		</section>

		<section class="section alt-band">
			<div class="container">
				<div class="section-head">
					<span class="page-eyebrow">Application Protocol</span>
					<h2 class="section-title-left">How to Express Interest</h2>
				</div>
				<div class="steps-grid">
					<div class="step-card">
						<span class="step-num">01</span>
						<h3>Review Our Recent Work</h3>
						<p>Read two recent papers or active projects closely aligned with your technical background in vision, NLP, or clinical modeling.</p>
					</div>
					<div class="step-card">
						<span class="step-num">02</span>
						<h3>Prepare a Concise Note</h3>
						<p>Include a current CV, unofficial transcripts or GitHub portfolio, and a 150-word paragraph naming the specific research stream of interest.</p>
					</div>
					<div class="step-card">
						<span class="step-num">03</span>
						<h3>Reach the Lab</h3>
						<p>Submit your inquiry via <a href="/contact/">our contact form</a> or write directly to <a href="mailto:saail_lab@iitmz.ac.in">saail_lab@iitmz.ac.in</a>.</p>
					</div>
				</div>
			</div>
		</section>
	</main>

	<ModernFooter />
</Layout>

<style>
	.alt-band {
		background: var(--bg-secondary);
		border-top: 1px solid var(--border-color);
	}
	.section-head { margin-bottom: 2rem; max-width: 720px; }
	.section-title-left { font-size: clamp(1.7rem, 2.8vw, 2.2rem); font-weight: 800; color: var(--text-primary); margin-bottom: 0.5rem; }
	.section-lead { font-size: 1.02rem; color: var(--text-secondary); }

	.opp-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.5rem;
	}

	.opp-card {
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		border-radius: 1rem;
		padding: 1.75rem;
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		box-shadow: 0 4px 14px var(--shadow-light);
	}

	.opp-closed {
		background: var(--bg-secondary);
		opacity: 0.92;
	}

	.opp-top {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.opp-num {
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.82rem;
		font-weight: 700;
		color: var(--accent-primary);
	}

	.opp-badge {
		font-size: 0.72rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		padding: 0.24rem 0.7rem;
		border-radius: 999px;
	}

	.badge-open { background: #ecfdf5; color: #14532d; }
	.badge-closed { background: #e5e7eb; color: #374151; }

	.opp-card h3 { font-size: 1.22rem; color: var(--text-primary); line-height: 1.32; }
	.opp-card p { font-size: 0.94rem; color: var(--text-secondary); line-height: 1.65; flex: 1; }

	.opp-meta {
		background: var(--bg-secondary);
		border: 1px solid var(--border-color);
		border-radius: 0.75rem;
		padding: 0.85rem 1rem;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}
	.opp-closed .opp-meta { background: var(--bg-card); }
	.opp-meta dt { font-size: 0.72rem; font-weight: 800; text-transform: uppercase; color: var(--text-muted); }
	.opp-meta dd { font-size: 0.86rem; color: var(--text-primary); margin: 0.1rem 0 0; }

	.opp-link {
		font-size: 0.88rem;
		font-weight: 700;
		color: var(--accent-primary);
		text-decoration: none;
		padding-top: 0.25rem;
	}
	.opp-link:hover { text-decoration: underline; }

	.steps-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.35rem;
	}

	.step-card {
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		border-radius: 1rem;
		padding: 1.5rem;
	}

	.step-num {
		display: inline-block;
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.82rem;
		font-weight: 800;
		color: var(--accent-primary);
		margin-bottom: 0.6rem;
	}

	.step-card h3 { font-size: 1.12rem; color: var(--text-primary); margin-bottom: 0.45rem; }
	.step-card p { font-size: 0.92rem; color: var(--text-secondary); line-height: 1.6; }
	.step-card a { color: var(--accent-primary); font-weight: 700; }

	@media (max-width: 860px) {
		.opp-grid, .steps-grid { grid-template-columns: 1fr; }
	}
</style>
