---
import Layout from '../layouts/Layout.astro';
import ModernHeader from '../components/ModernHeader.astro';
import ModernFooter from '../components/ModernFooter.astro';
---

<Layout
	title="Join SAAIL Lab | AI Research Positions at IIT Madras Zanzibar"
	description="Apply for MTech Data Science & AI thesis positions, BS undergraduate fellowships, and visiting AI researcher opportunities in deep learning, computer vision, and Swahili NLP at SAAIL Lab, IIT Madras Zanzibar."
	canonical="https://saaillab.github.io/hiring/"
>
	<ModernHeader currentPage="hiring" />

	<main id="main-content">
		<section class="page-hero">
			<div class="container">
				<span class="page-eyebrow" data-i18n="hiring.eyebrow">Careers &amp; Academic Training</span>
				<h1 class="page-title" data-i18n="hiring.title">Join SAAIL Lab</h1>
				<p class="page-lead" data-i18n="hiring.lead">
					We train MTech and BS researchers at the School of Engineering and Science, IIT Madras Zanzibar, building reliable agricultural vision, Swahili language safety, and clinical ML systems.
				</p>
			</div>
		</section>

		<section class="section">
			<div class="container">
				<div class="section-head">
					<span class="page-eyebrow" data-i18n="hiring.tracks_eyebrow">Positions &amp; Fellowship Status</span>
					<h2 class="section-title-left" data-i18n="hiring.tracks_title">Research Opportunities</h2>
					<p class="section-lead">Review open student positions, visiting researcher fellowships, and current cohort status.</p>
				</div>

				<div class="opp-grid">
					<article class="opp-card">
						<div class="opp-top">
							<span class="opp-num">01</span>
							<span class="opp-badge badge-open">Open · IITMZ Cohort</span>
						</div>
						<h3>MTech in Data Science &amp; AI Thesis Research</h3>
						<p>
							Two-year Master's thesis positions supervised by Innocent Nyalala spanning lightweight computer vision for East African crops, explainable commodity grading, deployment gap auditing, Swahili NLP/safety, and maternal clinical imaging.
						</p>
						<dl class="opp-meta">
							<div><dt>Eligibility</dt><dd>Admitted IIT Madras Zanzibar MTech DSAI candidates</dd></div>
							<div><dt>Location</dt><dd>Bweleo Campus, Zanzibar, Tanzania</dd></div>
						</dl>
						<a href="/contact/" class="opp-link">Inquire About MTech Projects &rarr;</a>
					</article>

					<article class="opp-card">
						<div class="opp-top">
							<span class="opp-num">02</span>
							<span class="opp-badge badge-open">Rolling · IITMZ BS</span>
						</div>
						<h3>BS in Data Science &amp; AI Undergraduate Research</h3>
						<p>
							Hands-on undergraduate research fellowships contributing to the Zanzibar Swahili Corpus, Dira translationese detection, and coastal blue economy seaweed telemetry.
						</p>
						<dl class="opp-meta">
							<div><dt>Eligibility</dt><dd>IIT Madras Zanzibar BS in Data Science &amp; AI students</dd></div>
							<div><dt>Commitment</dt><dd>Semester or summer research fellowship (3 to 12 months)</dd></div>
						</dl>
						<a href="/contact/" class="opp-link">Apply for BS Fellowship &rarr;</a>
					</article>

					<article class="opp-card">
						<div class="opp-top">
							<span class="opp-num">03</span>
							<span class="opp-badge badge-open">Open · Collaboration</span>
						</div>
						<h3>Visiting Researchers &amp; Postdocs</h3>
						<p>
							Short- and medium-term academic exchanges for doctoral students, faculty collaborators, and AI engineers partnering on East African food systems, Swahili safety evaluations, or low-resource clinical ML.
						</p>
						<dl class="opp-meta">
							<div><dt>Duration</dt><dd>1 to 12 months (in-person Zanzibar or hybrid consortium)</dd></div>
							<div><dt>Focus</dt><dd>Joint publications, open benchmarks, and shared field trials</dd></div>
						</dl>
						<a href="/contact/" class="opp-link">Propose a Visiting Exchange &rarr;</a>
					</article>

					<article class="opp-card opp-closed">
						<div class="opp-top">
							<span class="opp-num">04</span>
							<span class="opp-badge badge-closed">Filled · Position Closed</span>
						</div>
						<h3>Cotutelle PhD in Agentic AI for Agricultural Technologies</h3>
						<p>
							Joint doctoral fellowship between IIT Madras Zanzibar and Deakin University, Australia on autonomous orchard sensing and agricultural decision support.
						</p>
						<dl class="opp-meta">
							<div><dt>Status</dt><dd>This funded position has been filled (B. C. Bhattarai, current PhD cohort).</dd></div>
							<div><dt>Future Openings</dt><dd>Monitor IITMZ and Deakin portals or contact us regarding self-funded doctoral fellowships.</dd></div>
						</dl>
						<a href="/people/" class="opp-link">Meet Current PhD Cohort &rarr;</a>
					</article>
				</div>
			</div>
		</section>

		<section class="section alt-band">
			<div class="container">
				<div class="section-head">
					<span class="page-eyebrow">Application Protocol</span>
					<h2 class="section-title-left">How to Express Interest</h2>
				</div>
				<div class="steps-grid">
					<div class="step-card">
						<span class="step-num">01</span>
						<h3>Review Our Recent Work</h3>
						<p>Read two recent papers or active projects closely matched to your technical background in vision, NLP, or clinical modeling.</p>
					</div>
					<div class="step-card">
						<span class="step-num">02</span>
						<h3>Prepare a Concise Note</h3>
						<p>Include a current CV, unofficial transcripts or GitHub portfolio, and a 150-word paragraph naming the specific research stream of interest.</p>
					</div>
					<div class="step-card">
						<span class="step-num">03</span>
						<h3>Reach the Lab</h3>
						<p>Submit your inquiry via <a href="/contact/">our contact form</a> or write directly to <a href="mailto:saail_lab@iitmz.ac.in">saail_lab@iitmz.ac.in</a>.</p>
					</div>
				</div>

				<div class="checklist-card">
					<div class="checklist-head">
						<div>
							<span class="page-eyebrow" data-i18n="hiring.apply_eyebrow">Packet Checklist</span>
							<h3 data-i18n="hiring.apply_title">Application Email Format &amp; Required Items</h3>
						</div>
						<div class="checklist-btns">
							<button type="button" id="toggleApplyTpl" class="btn btn-secondary" aria-expanded="false" aria-controls="applyTemplateText">Preview Template</button>
							<button type="button" id="copyApplyTpl" class="btn btn-secondary">Copy Email Template</button>
						</div>
					</div>
					<div class="checklist-cols">
						<div>
							<p class="cl-sub">Subject line format (pick one):</p>
							<ul class="cl-list">
								<li><code>[MTech Thesis] Full Name - Research Topic</code></li>
								<li><code>[BS Fellowship] Full Name - Stream Name</code></li>
								<li><code>[Visiting] Full Name - Home Institution</code></li>
							</ul>
						</div>
						<div>
							<p class="cl-sub">Attach or link all four items:</p>
							<ul class="cl-list">
								<li>Current CV (PDF, max 2 pages)</li>
								<li>GitHub profile, code sample, or unofficial transcript</li>
								<li>150-word paragraph referencing two SAAIL Lab papers</li>
								<li>Intended start term and expected weekly hours</li>
							</ul>
						</div>
					</div>
					<pre id="applyTemplateText" class="apply-tpl" hidden>To: saail_lab@iitmz.ac.in
Subject: [MTech Thesis] Your Name - Target Research Topic

Dear Innocent Nyalala and SAAIL Lab Team,

I am a [MTech / BS / PhD / Visiting] candidate at [Institution] writing to express interest in joining SAAIL Lab starting [Month/Year].

After reading [Paper 1] and [Paper 2], I would like to contribute to [Crop Pathology / Swahili NLP / Responsible AI / Clinical ML]. My relevant experience includes [brief project or skill summary].

Attached / Linked:
- CV (PDF)
- GitHub / Portfolio: [URL]
- Availability: [Dates and hours/week]

Sincerely,
[Your Name]</pre>
				</div>
			</div>
		</section>
	</main>

	<ModernFooter />
</Layout>

<script>
	const toggleTplBtn = document.getElementById('toggleApplyTpl');
	const copyTplBtn = document.getElementById('copyApplyTpl');
	const tplEl = document.getElementById('applyTemplateText');
	toggleTplBtn?.addEventListener('click', () => {
		if (!tplEl) return;
		tplEl.hidden = !tplEl.hidden;
		toggleTplBtn.setAttribute('aria-expanded', String(!tplEl.hidden));
		toggleTplBtn.textContent = tplEl.hidden ? 'Preview Template' : 'Hide Template';
	});
	copyTplBtn?.addEventListener('click', async () => {
		const txt = tplEl?.textContent?.trim() || '';
		if (!txt) return;
		let ok = false;
		try {
			await navigator.clipboard.writeText(txt);
			ok = true;
		} catch (_e) {
			const area = document.createElement('textarea');
			area.value = txt;
			area.style.position = 'fixed';
			area.style.opacity = '0';
			document.body.appendChild(area);
			area.select();
			try { ok = document.execCommand('copy'); } catch (_e2) {}
			document.body.removeChild(area);
		}
		if (ok) {
			copyTplBtn.textContent = 'Template Copied!';
			const liveEl = document.getElementById('saailLiveStatus');
			if (liveEl) {
				liveEl.textContent = '';
				requestAnimationFrame(() => { liveEl.textContent = 'Application email template copied to clipboard.'; });
			}
			setTimeout(() => { copyTplBtn.textContent = 'Copy Email Template'; }, 1800);
		}
	});
</script>

<style>
	.alt-band {
		background: var(--bg-secondary);
		border-top: 1px solid var(--border-color);
	}
	.section-head { margin-bottom: 2rem; max-width: 720px; }
	.section-title-left { font-size: clamp(1.7rem, 2.8vw, 2.2rem); font-weight: 800; color: var(--text-primary); margin-bottom: 0.5rem; }
	.section-lead { font-size: 1.02rem; color: var(--text-secondary); }

	.opp-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.5rem;
	}

	.opp-card {
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		border-radius: 1rem;
		padding: 1.75rem;
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		box-shadow: 0 4px 14px var(--shadow-light);
	}

	.opp-closed {
		background: var(--bg-secondary);
		opacity: 0.92;
	}

	.opp-top {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.opp-num {
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.82rem;
		font-weight: 700;
		color: var(--accent-primary);
	}

	.opp-badge {
		font-size: 0.72rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		padding: 0.24rem 0.7rem;
		border-radius: 999px;
	}

	.badge-open { background: #ecfdf5; color: #14532d; }
	.badge-closed { background: #e5e7eb; color: #374151; }
	:global([data-theme="dark"]) .badge-open { background: rgba(52, 211, 153, 0.16); color: #34d399; }
	:global([data-theme="dark"]) .badge-closed { background: rgba(148, 163, 184, 0.18); color: #cbd5e1; }

	.opp-card h3 { font-size: 1.22rem; color: var(--text-primary); line-height: 1.32; }
	.opp-card p { font-size: 0.94rem; color: var(--text-secondary); line-height: 1.65; flex: 1; }

	.opp-meta {
		background: var(--bg-secondary);
		border: 1px solid var(--border-color);
		border-radius: 0.75rem;
		padding: 0.85rem 1rem;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}
	.opp-closed .opp-meta { background: var(--bg-card); }
	.opp-meta dt { font-size: 0.72rem; font-weight: 800; text-transform: uppercase; color: var(--text-muted); }
	.opp-meta dd { font-size: 0.86rem; color: var(--text-primary); margin: 0.1rem 0 0; }

	.opp-link {
		font-size: 0.88rem;
		font-weight: 700;
		color: var(--accent-primary);
		text-decoration: none;
		padding-top: 0.25rem;
	}
	.opp-link:hover { text-decoration: underline; }

	.steps-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.35rem;
	}

	.step-card {
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		border-radius: 1rem;
		padding: 1.5rem;
	}

	.step-num {
		display: inline-block;
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.82rem;
		font-weight: 800;
		color: var(--accent-primary);
		margin-bottom: 0.6rem;
	}

	.step-card h3 { font-size: 1.12rem; color: var(--text-primary); margin-bottom: 0.45rem; }
	.step-card p { font-size: 0.92rem; color: var(--text-secondary); line-height: 1.6; }
	.step-card a { color: var(--accent-primary); font-weight: 700; }

	.checklist-card {
		margin-top: 1.5rem;
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		border-radius: 1rem;
		padding: 1.65rem;
	}
	.checklist-head {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		flex-wrap: wrap;
		margin-bottom: 1rem;
	}
	.checklist-head h3 { font-size: 1.2rem; color: var(--text-primary); }
	.checklist-btns { display: flex; flex-wrap: wrap; gap: 0.5rem; }
	.apply-tpl {
		margin-top: 1.1rem;
		padding: 1rem 1.15rem;
		border-radius: 0.75rem;
		background: var(--bg-secondary);
		border: 1px solid var(--border-color);
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.8rem;
		line-height: 1.58;
		color: var(--text-primary);
		overflow-x: auto;
		white-space: pre-wrap;
	}
	.apply-tpl[hidden] { display: none; }
	.checklist-cols {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.35rem;
	}
	.cl-sub { font-size: 0.85rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.45rem; }
	.cl-list {
		margin: 0;
		padding-left: 1.2rem;
		font-size: 0.88rem;
		color: var(--text-secondary);
		line-height: 1.65;
	}
	.cl-list code {
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.8rem;
		color: var(--text-primary);
		background: var(--bg-secondary);
		padding: 0.08rem 0.35rem;
		border-radius: 4px;
	}

	@media (max-width: 860px) {
		.opp-grid, .steps-grid, .checklist-cols { grid-template-columns: minmax(0, 1fr); }
	}
</style>
