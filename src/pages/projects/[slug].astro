---
import Layout from '../../layouts/Layout.astro';
import ModernHeader from '../../components/ModernHeader.astro';
import ModernFooter from '../../components/ModernFooter.astro';
import { PROJECTS, type LabProject } from '../../data/projects';

export function getStaticPaths() {
  return PROJECTS.map((project) => ({
    params: { slug: project.slug },
    props: { project }
  }));
}

interface Props {
  project: LabProject;
}

const { project } = Astro.props;
---

<Layout
  title={`${project.shortTitle} | SAAIL Lab Projects`}
  description={project.summary}
  canonical={`https://saaillab.github.io/projects/${project.slug}/`}
  ogImage={`https://saaillab.github.io${project.heroImage}`}
>
  <ModernHeader currentPage="research" />

  <main id="main-content">
    <section class="proj-hero">
      <div class="container">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <ol class="breadcrumb-list">
            <li><a href="/projects/">&larr; All Projects &amp; Grants</a></li>
            <li aria-hidden="true">/</li>
            <li><span>{project.pillar}</span></li>
          </ol>
        </nav>

        <div class="proj-hero-grid">
          <div class="proj-copy">
            <div class="badge-row">
              <span class="pillar-pill">{project.pillar}</span>
              <span class="award-pill">{project.badge}</span>
              <span class="status-pill">{project.status}</span>
            </div>
            <h1>{project.title}</h1>
            <p class="proj-summary">{project.summary}</p>
            <div class="proj-actions">
              {project.githubUrl && (
                <a href={project.githubUrl} target="_blank" rel="noopener" class="btn btn-primary">GitHub Repository ↗</a>
              )}
              <a href="/publications/" class="btn btn-secondary">All Lab Publications</a>
              <a href="/contact/" class="btn btn-secondary">Collaborate With Us</a>
            </div>
          </div>

          <div class="proj-visual-card">
            <img src={project.heroImage} alt={project.heroAlt} class="proj-hero-img" />
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container proj-body-grid">
        <div class="proj-narrative">
          <h2>Scientific Context &amp; Approach</h2>
          {project.description.map((para) => (
            <p>{para}</p>
          ))}

          <h3>Core Technical Objectives</h3>
          <ul class="clean-list">
            {project.objectives.map((obj) => (
              <li>{obj}</li>
            ))}
          </ul>

          <h3>Verified Deliverables &amp; Outputs</h3>
          <ul class="clean-list deliverables">
            {project.deliverables.map((del) => (
              <li>{del}</li>
            ))}
          </ul>

          {project.slug === 'swahili-dira' && (
            <section class="swahili-protocol" id="swahili-protocol" aria-labelledby="swProtocolHeading">
              <div class="sw-head">
                <span class="sw-kicker">Interactive Benchmark Preview</span>
                <h3 id="swProtocolHeading">Zanzibar Swahili Corpus &amp; Dira Audit Protocol</h3>
                <p>Inspect how Dira separates coastal Kiunguja Swahili writing from English-translated text and organizes spoken agricultural QA curation.</p>
              </div>

              <div class="sw-tabs" role="tablist" aria-label="Swahili corpus and Dira protocol views">
                <button id="swTabAudit" type="button" role="tab" aria-selected="true" aria-controls="swPanelAudit" tabindex="0" class="sw-tab is-active" data-sw-target="swPanelAudit">Kiunguja vs. Translationese</button>
                <button id="swTabSplit" type="button" role="tab" aria-selected="false" aria-controls="swPanelSplit" tabindex="-1" class="sw-tab" data-sw-target="swPanelSplit">Source-Grouped Splits</button>
                <button id="swTabQa" type="button" role="tab" aria-selected="false" aria-controls="swPanelQa" tabindex="-1" class="sw-tab" data-sw-target="swPanelQa">Spoken Agricultural QA</button>
              </div>

              <div id="swPanelAudit" class="sw-panel" role="tabpanel" aria-labelledby="swTabAudit">
                <div class="sw-audit-grid">
                  <div class="sw-audit-item">
                    <strong>1. Syntactic Calquing</strong>
                    <p>Audits clause ordering and passive nominalizations introduced when English agricultural manuals are machine-translated into standard Swahili.</p>
                  </div>
                  <div class="sw-audit-item">
                    <strong>2. Coastal Kiunguja Register</strong>
                    <p>Compares verified Unguja and coastal Tanzania editorial prose against synthetic textbook phrasing produced by general multilingual models.</p>
                  </div>
                  <div class="sw-audit-item">
                    <strong>3. Agrarian Domain Lexicon</strong>
                    <p>Evaluates accurate grounding across local crop and commodity terminology such as <em>karafuu</em> (clove), <em>mpeta</em> (Grade IV defective buds), and <em>muhogo</em> (cassava).</p>
                  </div>
                </div>
              </div>

              <div id="swPanelSplit" class="sw-panel" role="tabpanel" aria-labelledby="swTabSplit" hidden>
                <div class="sw-split-box">
                  <p>
                    Dira enforces strict document-level source grouping across native Kiunguja prose and parallel machine-translated pairs so detectors cannot memorize stylistic quirks from overlapping passages in both training and held-out test sets.
                  </p>
                  <ul class="clean-list">
                    <li><strong>Team Leads:</strong> Saleh Saleh (corpus and dialect annotation) &amp; Sri Advaita (provenance detection modeling)</li>
                    <li><strong>Dataset Governance:</strong> Sourced strictly under community-consented Zanzibar editorial agreements</li>
                  </ul>
                </div>
              </div>

              <div id="swPanelQa" class="sw-panel" role="tabpanel" aria-labelledby="swTabQa" hidden>
                <div class="sw-split-box">
                  <p>
                    SAAIL Lab BS researchers pair Zanzibar editorial prose with spoken smallholder livelihood and crop diagnostic dialogues in Kiunguja. Community consent review is active; verified audio-text clips will be published directly in this panel upon completion of ethical clearance.
                  </p>
                  <div class="sw-inline-links">
                    <a href="/datasets/#language" class="btn btn-secondary">Dataset Datasheet</a>
                    <a href="/people/" class="btn btn-secondary">Swahili NLP Team</a>
                  </div>
                </div>
              </div>
            </section>
          )}
        </div>

        <aside class="proj-sidebar">
          <div class="side-card">
            <h2>Project Metadata</h2>
            <dl class="meta-dl">
              <dt>Principal Lead</dt>
              <dd>{project.lead}</dd>

              {project.funding && (
                <>
                  <dt>Funding &amp; Support</dt>
                  <dd>{project.funding}</dd>
                </>
              )}

              {project.team.length > 0 && (
                <>
                  <dt>SAAIL Lab Team</dt>
                  <dd>
                    <div class="chip-wrap">
                      {project.team.map((member) => (
                        <span class="chip">{member}</span>
                      ))}
                    </div>
                  </dd>
                </>
              )}

              <dt>Institutional Partners</dt>
              <dd>
                <ul class="partner-list">
                  {project.partners.map((partner) => (
                    <li>{partner}</li>
                  ))}
                </ul>
              </dd>
            </dl>
          </div>

          {project.relatedPapers.length > 0 && (
            <div class="side-card">
              <h2>Companion Publications</h2>
              <div class="paper-links">
                {project.relatedPapers.map((rp) => (
                  <a href={`/papers/${rp.slug}/`} class="paper-mini-link">
                    <span class="rp-venue">{rp.venue}</span>
                    <span class="rp-title">{rp.title} &rarr;</span>
                  </a>
                ))}
              </div>
            </div>
          )}
        </aside>
      </div>
    </section>
  </main>

  <ModernFooter />
</Layout>

<style>
  .proj-hero {
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border-color);
    padding: 2.5rem 0 3.5rem;
  }

  .breadcrumb {
    margin-bottom: 1.5rem;
  }

  .breadcrumb-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .breadcrumb a {
    color: var(--accent-primary);
    text-decoration: none;
  }

  .breadcrumb a:hover { text-decoration: underline; }

  .proj-hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 2.5rem;
    align-items: center;
  }

  .badge-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 0.9rem;
  }

  .pillar-pill, .award-pill, .status-pill {
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
  }

  .pillar-pill { background: #ecfdf5; color: #14532d; }
  .award-pill { background: #fef3c7; color: #92400e; }
  .status-pill { background: var(--bg-card); color: var(--text-secondary); border: 1px solid var(--border-color); }

  .proj-copy h1 {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    line-height: 1.18;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  .proj-summary {
    font-size: 1.06rem;
    line-height: 1.68;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  .proj-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .proj-visual-card {
    background: #ffffff;
    border: 1px solid var(--border-color);
    border-radius: 1rem;
    padding: 0.75rem;
    box-shadow: 0 10px 28px var(--shadow-light);
  }

  .proj-hero-img {
    width: 100%;
    max-height: 360px;
    object-fit: contain;
    border-radius: 0.65rem;
    display: block;
    background: #ffffff;
  }

  .proj-body-grid {
    display: grid;
    grid-template-columns: 1.4fr 0.9fr;
    gap: 2.75rem;
    align-items: start;
  }

  .proj-narrative h2 {
    font-size: 1.6rem;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  .proj-narrative h3 {
    font-size: 1.2rem;
    color: var(--accent-primary);
    margin: 2rem 0 0.75rem;
  }

  .proj-narrative p {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  .clean-list {
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    color: var(--text-secondary);
    line-height: 1.62;
  }

  .proj-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .side-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 1rem;
    padding: 1.5rem;
    box-shadow: 0 4px 12px var(--shadow-light);
  }

  .side-card h2 {
    font-size: 1.08rem;
    color: var(--text-primary);
    margin-bottom: 1rem;
    padding-bottom: 0.55rem;
    border-bottom: 1px solid var(--border-color);
  }

  .meta-dl dt {
    font-size: 0.74rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    margin-top: 0.9rem;
  }
  .meta-dl dt:first-child { margin-top: 0; }

  .meta-dl dd {
    font-size: 0.92rem;
    color: var(--text-primary);
    margin: 0.25rem 0 0;
    line-height: 1.5;
  }

  .chip-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.25rem;
  }

  .chip {
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.2rem 0.55rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 6px;
  }

  .partner-list {
    margin: 0;
    padding-left: 1.1rem;
    font-size: 0.88rem;
    color: var(--text-secondary);
  }

  .paper-links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .paper-mini-link {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.7rem 0.85rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 0.65rem;
    text-decoration: none;
    transition: border-color 0.16s ease, transform 0.16s ease;
  }

  .paper-mini-link:hover {
    border-color: var(--accent-primary);
    transform: translateY(-1px);
  }

  .rp-venue {
    font-size: 0.74rem;
    font-weight: 700;
    color: var(--accent-primary);
  }

  .rp-title {
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.38;
  }

  .swahili-protocol {
    margin-top: 2.25rem;
    padding: 1.5rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 1rem;
  }
  .sw-kicker {
    display: inline-block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-primary);
    margin-bottom: 0.25rem;
  }
  .sw-head h3 {
    margin: 0 0 0.45rem !important;
    color: var(--text-primary) !important;
    font-size: 1.25rem;
  }
  .sw-head p {
    margin: 0 0 1rem !important;
    font-size: 0.92rem;
  }
  .sw-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .sw-tab {
    padding: 0.48rem 0.95rem;
    border-radius: 999px;
    border: 1px solid var(--border-color);
    background: var(--bg-card);
    color: var(--text-secondary);
    font-family: inherit;
    font-size: 0.84rem;
    font-weight: 700;
    cursor: pointer;
  }
  .sw-tab.is-active {
    background: var(--accent-primary);
    border-color: var(--accent-primary);
    color: #ffffff;
  }
  :global([data-theme="dark"]) .sw-tab.is-active { color: #062111; }
  .sw-panel[hidden] { display: none; }
  .sw-audit-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.85rem;
  }
  .sw-audit-item,
  .sw-split-box {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 0.75rem;
    padding: 1rem;
  }
  .sw-audit-item strong {
    display: block;
    font-size: 0.9rem;
    color: var(--text-primary);
    margin-bottom: 0.35rem;
  }
  .sw-audit-item p,
  .sw-split-box p {
    margin: 0 !important;
    font-size: 0.85rem !important;
    line-height: 1.55 !important;
    color: var(--text-secondary);
  }
  .sw-split-box .clean-list {
    margin-top: 0.75rem;
    font-size: 0.86rem;
  }
  .sw-inline-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 0.85rem;
  }
  @media (max-width: 960px) {
    .proj-hero-grid, .proj-body-grid { grid-template-columns: minmax(0, 1fr); }
    .sw-audit-grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = Array.from(document.querySelectorAll('.sw-tab')) as HTMLButtonElement[];
    if (!tabs.length) return;
    tabs.forEach((tab, idx) => {
      tab.addEventListener('click', () => {
        const targetId = tab.getAttribute('data-sw-target');
        tabs.forEach((t) => {
          const active = t === tab;
          t.classList.toggle('is-active', active);
          t.setAttribute('aria-selected', String(active));
          t.setAttribute('tabindex', active ? '0' : '-1');
          const pid = t.getAttribute('data-sw-target');
          const panel = pid ? document.getElementById(pid) : null;
          if (panel) panel.hidden = !active;
        });
        if (targetId) {
          const activePanel = document.getElementById(targetId);
          if (activePanel) activePanel.hidden = false;
        }
      });
      tab.addEventListener('keydown', (e: KeyboardEvent) => {
        let next: number | null = null;
        if (e.key === 'ArrowRight') next = (idx + 1) % tabs.length;
        else if (e.key === 'ArrowLeft') next = (idx - 1 + tabs.length) % tabs.length;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = tabs.length - 1;
        if (next === null) return;
        e.preventDefault();
        tabs[next].focus();
        tabs[next].click();
      });
    });
  });
</script>
