---

<Layout
	title="Gallery & Conference Posters | SAAIL Lab | IIT Madras Zanzibar"
	description="Conference posters, field presentations, award announcements, and workshop photos from SAAIL Lab at Deep Learning Indaba, Oxford TAIS, CVPR, Data Science Africa, and IIT Madras Zanzibar."
	canonical="https://saaillab.github.io/gallery"
>
	<ModernHeader currentPage="gallery" />

	<main>
		<section class="page-hero">
			<div class="container">
				<span class="page-eyebrow">Visual Archive</span>
				<h1 class="page-title">Conference Posters, Awards &amp; Field Moments</h1>
				<p class="page-lead">
					High-resolution conference posters, award certificates, invited talks, and symposium photos across Lagos, Kigali, Kampala, Oxford, and Zanzibar.
				</p>

				<div class="gallery-filters" role="tablist" aria-label="Filter gallery items">
					<button type="button" class="g-pill is-active" data-filter="all">All Items ({ITEMS.length})</button>
					<button type="button" class="g-pill" data-filter="posters">Conference Posters ({ITEMS.filter((i) => i.category === 'posters').length})</button>
					<button type="button" class="g-pill" data-filter="conferences">Conference Photos ({ITEMS.filter((i) => i.category === 'conferences').length})</button>
					<button type="button" class="g-pill" data-filter="awards">Awards &amp; Talks ({ITEMS.filter((i) => i.category === 'awards').length})</button>
				</div>
			</div>
		</section>

		<section class="section">
			<div class="container">
				<div class="gallery-grid" id="galleryGrid">
					{ITEMS.map((item) => (
						<article class="g-card" data-cat={item.category}>
							<div class="g-media">
								<img src={item.src} alt={item.title} loading="lazy" class="g-img" />
							</div>
							<div class="g-body">
								<div class="g-meta">
									<span class="g-cat">{item.category.toUpperCase()}</span>
									<span class="g-date">{item.date}</span>
								</div>
								<h3>{item.title}</h3>
								<p class="g-venue">{item.venue}</p>
								<p class="g-caption">{item.caption}</p>
								{item.link && (
									<a href={item.link} class="g-link">View Project Page &rarr;</a>
								)}
							</div>
						</article>
					))}
				</div>
			</div>
		</section>
	</main>

	<!-- Lightbox for Full Resolution Poster Reading -->
	<div id="gLightbox" class="g-lightbox" hidden role="dialog" aria-modal="true" aria-label="Enlarged poster viewer">
		<button id="gClose" type="button" class="g-close" aria-label="Close viewer">&times;</button>
		<img id="gLightboxImg" src="" alt="" />
		<p id="gLightboxCap"></p>
	</div>

	<ModernFooter />
</Layout>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const pills = document.querySelectorAll('.g-pill');
		const cards = document.querySelectorAll('.g-card');

		pills.forEach((p) => {
			p.addEventListener('click', () => {
				pills.forEach((x) => x.classList.remove('is-active'));
				p.classList.add('is-active');
				const f = p.getAttribute('data-filter') || 'all';
				cards.forEach((c) => {
					const el = c as HTMLElement;
					el.style.display = f === 'all' || el.getAttribute('data-cat') === f ? 'flex' : 'none';
				});
			});
		});

		const lb = document.getElementById('gLightbox');
		const lbImg = document.getElementById('gLightboxImg') as HTMLImageElement | null;
		const lbCap = document.getElementById('gLightboxCap');
		const lbClose = document.getElementById('gClose');

		document.querySelectorAll('.g-img').forEach((img) => {
			img.addEventListener('click', () => {
				const el = img as HTMLImageElement;
				if (!lb || !lbImg || !lbCap) return;
				lbImg.src = el.src;
				lbImg.alt = el.alt;
				lbCap.textContent = el.alt;
				lb.hidden = false;
			});
		});

		lbClose?.addEventListener('click', () => { if (lb) lb.hidden = true; });
		lb?.addEventListener('click', (e) => { if (e.target === lb) lb.hidden = true; });
		document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && lb && !lb.hidden) lb.hidden = true; });
	});
</script>

<style>
	.gallery-filters {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.55rem;
		margin-top: 1.75rem;
	}

	.g-pill {
		padding: 0.48rem 1rem;
		border-radius: 999px;
		border: 1.5px solid var(--border-color);
		background: var(--bg-card);
		color: var(--text-primary);
		font-family: inherit;
		font-size: 0.85rem;
		font-weight: 600;
		cursor: pointer;
	}

	.g-pill:hover {
		border-color: var(--accent-primary);
		color: var(--accent-primary);
	}

	.g-pill.is-active {
		background: var(--accent-primary);
		border-color: var(--accent-primary);
		color: #ffffff;
	}

	:global([data-theme="dark"]) .g-pill.is-active { color: #062111; }

	.gallery-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.65rem;
	}

	.g-card {
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		border-radius: 1rem;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		box-shadow: 0 4px 14px var(--shadow-light);
	}

	.g-media {
		background: var(--bg-secondary);
		border-bottom: 1px solid var(--border-color);
		height: 240px;
		overflow: hidden;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0.65rem;
	}

	.g-img {
		width: 100%;
		height: 100%;
		object-fit: contain;
		cursor: zoom-in;
		border-radius: 0.5rem;
		transition: transform 0.25s ease;
	}

	.g-card:hover .g-img {
		transform: scale(1.02);
	}

	.g-body {
		padding: 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		flex: 1;
	}

	.g-meta {
		display: flex;
		justify-content: space-between;
		align-items: center;
		font-size: 0.72rem;
		font-weight: 700;
	}

	.g-cat {
		color: var(--accent-primary);
		letter-spacing: 0.05em;
	}

	.g-date {
		color: var(--text-muted);
	}

	.g-body h3 {
		font-size: 1.06rem;
		color: var(--text-primary);
		line-height: 1.35;
	}

	.g-venue {
		font-size: 0.82rem;
		font-weight: 600;
		color: var(--accent-gold);
	}

	.g-caption {
		font-size: 0.86rem;
		color: var(--text-secondary);
		line-height: 1.55;
		flex: 1;
	}

	.g-link {
		margin-top: 0.4rem;
		font-size: 0.84rem;
		font-weight: 700;
		color: var(--accent-primary);
		text-decoration: none;
	}

	.g-link:hover { text-decoration: underline; }

	.g-lightbox {
		position: fixed;
		inset: 0;
		z-index: 1200;
		background: rgba(8, 18, 12, 0.92);
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 2rem;
	}
	.g-lightbox[hidden] { display: none; }
	.g-lightbox img {
		max-width: 92vw;
		max-height: 82vh;
		object-fit: contain;
		border-radius: 8px;
		background: #ffffff;
		padding: 0.35rem;
	}
	.g-lightbox p {
		color: #ffffff;
		margin-top: 0.85rem;
		font-weight: 600;
		font-size: 0.95rem;
		text-align: center;
	}
	.g-close {
		position: fixed;
		top: 1.25rem;
		right: 1.5rem;
		width: 40px;
		height: 40px;
		border-radius: 999px;
		border: none;
		background: #ffffff;
		color: #0c1a12;
		font-size: 1.5rem;
		cursor: pointer;
	}

	@media (max-width: 1024px) {
		.gallery-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	}
	@media (max-width: 640px) {
		.gallery-grid { grid-template-columns: 1fr; }
	}
</style>
