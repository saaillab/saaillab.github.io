---

<Layout
	title="Event Gallery & Posters | SAAIL Lab | IIT Madras Zanzibar"
	description="Interactive conference albums, slideshows, posters, and award recognitions from SAAIL Lab across Deep Learning Indaba, Data Science Africa, CVPR, ICLR, Oxford TAIS, and ACM AfriCHI."
	canonical="https://saaillab.github.io/gallery/"
>
	<ModernHeader currentPage="gallery" />

	<main id="main-content">
		<section class="page-hero">
			<div class="container">
				<span class="page-eyebrow">Conferences, Fieldwork &amp; Awards</span>
				<h1 class="page-title">Event Gallery &amp; Poster Slideshows</h1>
				<p class="page-lead">
					Click any conference event below to read the session summary, inspect high-resolution posters, and step through the photo slideshow.
				</p>
			</div>
		</section>

		<section class="section">
			<div class="container">
				<div class="gallery-filters" role="tablist" aria-label="Filter albums">
					<button type="button" role="tab" aria-selected="true" aria-controls="albumsGrid" tabindex="0" class="g-tab active" data-filter="all">All Events ({ALBUMS.length})</button>
					<button type="button" role="tab" aria-selected="false" aria-controls="albumsGrid" tabindex="-1" class="g-tab" data-filter="conferences">Workshops &amp; Talks</button>
					<button type="button" role="tab" aria-selected="false" aria-controls="albumsGrid" tabindex="-1" class="g-tab" data-filter="awards">Best Poster Awards</button>
					<button type="button" role="tab" aria-selected="false" aria-controls="albumsGrid" tabindex="-1" class="g-tab" data-filter="posters">Technical Posters</button>
				</div>

				<div class="albums-grid" id="albumsGrid">
					{ALBUMS.map((album, idx) => (
						<article class="album-card" data-category={album.category}>
							<button type="button" class="album-cover-btn" data-album-idx={idx} aria-label={`Open ${album.title} slideshow (${album.slides.length} items)`}>
								<img src={album.cover} alt={album.title} class="album-cover" loading="lazy" />
								<span class="slide-count-badge">{album.slides.length} slides</span>
							</button>
							<div class="album-body">
								<div class="album-top">
									<span class="album-tag">{album.tag}</span>
									<span class="album-date">{album.date}</span>
								</div>
								<h2>{album.title}</h2>
								<p class="album-venue">{album.venue}</p>
								<p class="album-summary">{album.summary}</p>
								<button type="button" class="open-album-cta" data-album-idx={idx} aria-label={`Open event slideshow and summary for ${album.title}`}>
									Open Event Slideshow &amp; Summary &rarr;
								</button>
							</div>
						</article>
					))}
				</div>
			</div>
		</section>
	</main>

	<!-- Interactive Event Slideshow Modal -->
	<div id="albumModal" class="album-modal" hidden role="dialog" aria-modal="true" aria-labelledby="modalAlbumTitle">
		<div class="modal-backdrop"></div>
		<div class="modal-panel">
			<div class="modal-head">
				<div>
					<span id="modalAlbumMeta" class="modal-kicker"></span>
					<h2 id="modalAlbumTitle">Event Slideshow</h2>
				</div>
				<button id="closeAlbumBtn" type="button" class="modal-close" aria-label="Close slideshow">&times;</button>
			</div>

			<div class="modal-layout">
				<div class="modal-stage">
					<button id="prevSlideBtn" type="button" class="nav-arrow nav-prev" aria-label="Previous slide">&#10094;</button>
					<div class="stage-frame">
						<img id="stageImg" alt="" />
					</div>
					<button id="nextSlideBtn" type="button" class="nav-arrow nav-next" aria-label="Next slide">&#10095;</button>
					<div class="stage-caption-bar">
						<div>
							<strong id="stageTitle"></strong>
							<p id="stageCaption"></p>
							<a id="stagePaperLink" class="stage-paper-link" hidden>Read Linked Paper &rarr;</a>
						</div>
						<span id="stageCounter" class="stage-counter"></span>
					</div>
					<div id="stageThumbs" class="stage-thumbs"></div>
				</div>

				<aside class="modal-info">
					<h3>Event Summary</h3>
					<p id="modalSummary" class="modal-summary-text"></p>
					<div id="modalLinksWrap" class="modal-links"></div>
				</aside>
			</div>
		</div>
	</div>

	<ModernFooter />
</Layout>

<script define:vars={{ ALBUMS }}>
	document.addEventListener('DOMContentLoaded', function () {
		const tabs = document.querySelectorAll('.g-tab');
		const cards = document.querySelectorAll('.album-card');

		tabs.forEach((tab, idx) => {
			tab.addEventListener('click', () => {
				tabs.forEach((t) => {
					t.classList.remove('active');
					t.setAttribute('aria-selected', 'false');
					t.setAttribute('tabindex', '-1');
				});
				tab.classList.add('active');
				tab.setAttribute('aria-selected', 'true');
				tab.setAttribute('tabindex', '0');
				const filter = tab.getAttribute('data-filter');
				cards.forEach((card) => {
					const cat = card.getAttribute('data-category');
					card.style.display = filter === 'all' || cat === filter ? 'flex' : 'none';
				});
			});
			tab.addEventListener('keydown', (e) => {
				let nextIdx = null;
				if (e.key === 'ArrowRight') nextIdx = (idx + 1) % tabs.length;
				else if (e.key === 'ArrowLeft') nextIdx = (idx - 1 + tabs.length) % tabs.length;
				else if (e.key === 'Home') nextIdx = 0;
				else if (e.key === 'End') nextIdx = tabs.length - 1;
				if (nextIdx === null) return;
				e.preventDefault();
				const nextTab = tabs[nextIdx];
				nextTab.focus();
				nextTab.click();
			});
		});

		const modal = document.getElementById('albumModal');
		const closeBtn = document.getElementById('closeAlbumBtn');
		const backdrop = modal?.querySelector('.modal-backdrop');
		const prevBtn = document.getElementById('prevSlideBtn');
		const nextBtn = document.getElementById('nextSlideBtn');
		const stageImg = document.getElementById('stageImg');
		const stageTitle = document.getElementById('stageTitle');
		const stageCaption = document.getElementById('stageCaption');
		const stagePaperLink = document.getElementById('stagePaperLink');
		const stageCounter = document.getElementById('stageCounter');
		const stageThumbs = document.getElementById('stageThumbs');
		const modalMeta = document.getElementById('modalAlbumMeta');
		const modalTitle = document.getElementById('modalAlbumTitle');
		const modalSummary = document.getElementById('modalSummary');
		const modalLinksWrap = document.getElementById('modalLinksWrap');

		let activeAlbum = null;
		let slideIndex = 0;
		let lastTriggerEl = null;

		function renderSlide() {
			if (!activeAlbum || !stageImg || !stageTitle || !stageCaption || !stageCounter || !stageThumbs) return;
			const slides = activeAlbum.slides;
			if (slideIndex < 0) slideIndex = slides.length - 1;
			if (slideIndex >= slides.length) slideIndex = 0;
			const current = slides[slideIndex];

			stageImg.src = current.src;
			stageImg.alt = current.title;
			stageTitle.textContent = current.title;
			stageCaption.textContent = current.caption;
			stageCounter.textContent = `${slideIndex + 1} / ${slides.length}`;

			if (stagePaperLink instanceof HTMLAnchorElement) {
				if (current.paperLink) {
					stagePaperLink.href = current.paperLink;
					stagePaperLink.hidden = false;
				} else {
					stagePaperLink.hidden = true;
				}
			}

			Array.from(stageThumbs.children).forEach((thumb, i) => {
				thumb.classList.toggle('active', i === slideIndex);
				thumb.setAttribute('aria-pressed', String(i === slideIndex));
			});
		}

		function openAlbum(idx, triggerEl) {
			activeAlbum = ALBUMS[idx];
			if (!activeAlbum || !modal) return;
			lastTriggerEl = triggerEl || document.activeElement;
			slideIndex = 0;

			if (modalMeta) modalMeta.textContent = `${activeAlbum.venue} · ${activeAlbum.date}`;
			if (modalTitle) modalTitle.textContent = activeAlbum.title;
			if (modalSummary) modalSummary.textContent = activeAlbum.summary;

			if (modalLinksWrap) {
				modalLinksWrap.innerHTML = '';
				(activeAlbum.links || []).forEach((lnk) => {
					const a = document.createElement('a');
					a.href = lnk.href;
					a.textContent = lnk.label + ' →';
					a.className = 'modal-link-btn';
					if (lnk.href.startsWith('http')) {
						a.target = '_blank';
						a.rel = 'noopener';
					}
					modalLinksWrap.appendChild(a);
				});
			}

			if (stageThumbs) {
				stageThumbs.innerHTML = '';
				activeAlbum.slides.forEach((s, i) => {
					const btn = document.createElement('button');
					btn.type = 'button';
					btn.className = 'thumb-btn';
					btn.setAttribute('aria-label', `Slide ${i + 1}: ${s.title}`);
					btn.setAttribute('aria-pressed', String(i === 0));
					const img = document.createElement('img');
					img.src = s.src;
					img.alt = s.title;
					btn.appendChild(img);
					btn.addEventListener('click', () => {
						slideIndex = i;
						renderSlide();
					});
					stageThumbs.appendChild(btn);
				});
			}

			renderSlide();
			modal.hidden = false;
			document.body.style.overflow = 'hidden';
			closeBtn?.focus();
		}

		function closeModal() {
			if (!modal) return;
			modal.hidden = true;
			document.body.style.overflow = '';
			if (lastTriggerEl && typeof lastTriggerEl.focus === 'function') {
				lastTriggerEl.focus();
			}
		}

		document.querySelectorAll('[data-album-idx]').forEach((trigger) => {
			trigger.addEventListener('click', () => {
				const idx = Number(trigger.getAttribute('data-album-idx'));
				if (!Number.isNaN(idx)) openAlbum(idx, trigger);
			});
		});

		prevBtn?.addEventListener('click', () => { slideIndex--; renderSlide(); });
		nextBtn?.addEventListener('click', () => { slideIndex++; renderSlide(); });
		closeBtn?.addEventListener('click', closeModal);
		backdrop?.addEventListener('click', closeModal);

		document.addEventListener('keydown', (e) => {
			if (!modal || modal.hidden) return;
			if (e.key === 'Escape') { closeModal(); return; }
			if (e.key === 'ArrowLeft') { e.preventDefault(); slideIndex--; renderSlide(); return; }
			if (e.key === 'ArrowRight') { e.preventDefault(); slideIndex++; renderSlide(); return; }
			if (e.key === 'Tab') {
				const focusables = Array.from(modal.querySelectorAll('a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])')).filter((el) => !el.hidden && el.offsetParent !== null);
				if (focusables.length === 0) return;
				const first = focusables[0];
				const last = focusables[focusables.length - 1];
				if (!modal.contains(document.activeElement)) {
					e.preventDefault();
					first.focus();
					return;
				}
				if (e.shiftKey && document.activeElement === first) {
					e.preventDefault();
					last.focus();
				} else if (!e.shiftKey && document.activeElement === last) {
					e.preventDefault();
					first.focus();
				}
			}
		});
	});
</script>

