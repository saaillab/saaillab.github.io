---
import Layout from '../layouts/Layout.astro';
import ModernHeader from '../components/ModernHeader.astro';
import ModernFooter from '../components/ModernFooter.astro';
import { PUBLICATIONS } from '../data/publications';

const saailCount = PUBLICATIONS.filter((p) => p.isSaailLab !== false).length;

const repositories = [
  {
    name: 'CropGuardNet',
    badge: 'CropGuard Series · Under Peer Review',
    language: 'PyTorch / ONNX',
    description:
      'Unified lightweight CNN-Transformer framework (481,574 params, 1.84 MB, 63.8M FLOPs) with Multi-Scale Feature Pyramid, Crop-Aware Conditioning, and four-family XAI evaluation on 35,420 UUID- and pHash-deduplicated leaf images.',
    repoUrl: 'https://github.com/saaillab/CropGuardNet',
    pagesUrl: 'https://saaillab.github.io/CropGuardNet/',
    projectUrl: '/papers/cropguardnet/'
  },
  {
    name: 'dgs-bench',
    badge: 'Best Poster · DLI 2026',
    language: 'Python / Agricultural AI',
    description:
      'Deployment Gap and Sensitivity Benchmark (DGS-Bench) for African agricultural AI, quantifying controlled-to-field performance drops and minority-disease sensitivity on cassava pathology.',
    repoUrl: 'https://github.com/saaillab/dgs-bench',
    pagesUrl: 'https://saaillab.github.io/dgs-bench/',
    projectUrl: '/papers/dgs-bench/'
  },
  {
    name: 'CLOVES-4603',
    badge: 'CVPR 2026 V4A',
    language: 'Python / Computer Vision',
    description:
      'First public 4,603-image Zanzibar clove grading benchmark across four ZSTC commercial grades comparing classical texture-fusion pipelines (92.94%) and fine-tuned CNNs/DINOv2 (up to 99.67%).',
    repoUrl: 'https://github.com/saaillab/CLOVES-4603',
    pagesUrl: 'https://saaillab.github.io/CLOVES-4603/',
    projectUrl: '/papers/cloves-4603/'
  },
  {
    name: 'zstc-clove-v1',
    badge: 'AI4EAC 2026 Travel Award',
    language: 'Python / PyTorch',
    description:
      'ZSTC-Clove-V1 (5,298 single-clove images) feasibility study and mobile inspection baselines evaluating architectural sensitivity across ResNet-18 (94.46%) and VGG-16.',
    repoUrl: 'https://github.com/saaillab/zstc-clove-v1',
    pagesUrl: 'https://saaillab.github.io/zstc-clove-v1/',
    projectUrl: '/papers/zstc-clove-v1/'
  },
  {
    name: 'cara-fm',
    badge: 'Best Poster · DLI 2025 (PMLR 302)',
    language: 'Python / Evaluation',
    description:
      'Culturally Attuned and Resource-Aware Foundation Models (CARA-FM) framework and alignment checklists published in PMLR Vol. 302 (Best Poster Award, DLI 2025).',
    repoUrl: 'https://github.com/saaillab/cara-fm',
    pagesUrl: 'https://saaillab.github.io/cara-fm/',
    projectUrl: '/papers/cara-fm/'
  },
  {
    name: 'trustworthy-ai-iclr2026',
    badge: 'ICLR 2026 Workshop',
    language: 'Markdown / Governance',
    description:
      'Governance audit templates and community-participatory validation protocols accompanying our ICLR 2026 Workshop paper on Trustworthy AI in Africa.',
    repoUrl: 'https://github.com/saaillab/trustworthy-ai-iclr2026',
    pagesUrl: 'https://saaillab.github.io/trustworthy-ai-iclr2026/',
    projectUrl: '/papers/trustworthy-ai-iclr2026/'
  },
  {
    name: 'saaillab.github.io',
    badge: 'Lab Web Platform',
    language: 'Astro / TypeScript',
    description:
      `Source repository for the SAAIL Lab website featuring ${saailCount} SAAIL Lab manuscripts and ${PUBLICATIONS.length} total academic project pages built with Astro 5.`,
    repoUrl: 'https://github.com/saaillab/saaillab.github.io',
    pagesUrl: 'https://saaillab.github.io/',
    projectUrl: '/'
  }
];
---

<Layout
  title="Open-Source GitHub Repositories | SAAIL Lab"
  description="Official GitHub repositories of SAAIL Lab (github.com/saaillab): CropGuardNet, dgs-bench, CLOVES-4603, zstc-clove-v1, cara-fm, and trustworthy-ai-iclr2026."
  canonical="https://saaillab.github.io/github/"
>
  <ModernHeader currentPage="resources" />

  <main class="gh-main">
    <section class="gh-hero">
      <div class="gh-container">
        <span class="gh-eyebrow">OPEN-SOURCE CODE &amp; REPRODUCIBILITY · GITHUB.COM/SAAILLAB</span>
        <h1>Open-Source GitHub Repositories</h1>
        <p class="gh-lead">
          Published SAAIL Lab systems release modular PyTorch/ONNX code, CITATION.cff metadata, deduplication manifests, and standalone project documentation under open licenses.
        </p>
        <a href="https://github.com/saaillab" target="_blank" rel="noopener" class="gh-org-btn">
          Visit github.com/saaillab &rarr;
        </a>
      </div>
    </section>

    <section class="gh-list-band">
      <div class="gh-container">
        <div class="gh-grid">
          {repositories.map((repo) => (
            <article class="gh-card">
              <div class="gh-card-top">
                <span class="gh-lang">{repo.language}</span>
                <span class="gh-badge">{repo.badge}</span>
              </div>
              <h2>
                <a href={repo.repoUrl} target="_blank" rel="noopener">saaillab/{repo.name}</a>
              </h2>
              <p class="gh-desc">{repo.description}</p>
              <div class="gh-actions">
                <a href={repo.repoUrl} target="_blank" rel="noopener" class="g-btn g-btn-primary">GitHub Repo</a>
                <a href={repo.pagesUrl} target="_blank" rel="noopener" class="g-btn">Repo Pages</a>
                <a href={repo.projectUrl} class="g-btn">Lab Project Page &rarr;</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>

  <ModernFooter />
</Layout>

<style>
  .gh-main { background: var(--bg-primary); color: var(--text-primary); }
  .gh-container { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
  .gh-hero {
    padding: 4rem 0 2.75rem;
    text-align: center;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border-color);
  }
  .gh-eyebrow { font-size: 0.78rem; font-weight: 800; color: var(--accent-primary); letter-spacing: 0.06em; }
  .gh-hero h1 { font-size: clamp(2rem, 4vw, 2.85rem); font-weight: 800; margin: 0.5rem 0 0.85rem; }
  .gh-lead { max-width: 720px; margin: 0 auto 1.5rem; color: var(--text-secondary); font-size: 1.05rem; }
  .gh-org-btn {
    display: inline-flex;
    padding: 0.72rem 1.4rem;
    border-radius: 10px;
    background: var(--accent-primary);
    color: #ffffff;
    font-weight: 600;
    text-decoration: none;
  }
  .gh-org-btn:hover { background: var(--accent-secondary); }

  .gh-list-band { padding: 3rem 0 4.5rem; }
  .gh-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 1.35rem;
  }
  .gh-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 1.45rem;
  }
  .gh-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.65rem;
  }
  .gh-lang { font-size: 0.76rem; font-weight: 700; color: var(--accent-primary); }
  .gh-badge {
    padding: 0.18rem 0.6rem;
    border-radius: 999px;
    background: rgba(20, 83, 45, 0.1);
    color: var(--accent-primary);
    font-size: 0.72rem;
    font-weight: 700;
  }
  .gh-card h2 { margin: 0 0 0.6rem; font-size: 1.2rem; font-weight: 800; }
  .gh-card h2 a { color: var(--text-primary); text-decoration: none; }
  .gh-card h2 a:hover { color: var(--accent-primary); text-decoration: underline; }
  .gh-desc { margin: 0 0 1.2rem; font-size: 0.9rem; color: var(--text-secondary); line-height: 1.6; flex: 1; }
  .gh-actions { display: flex; flex-wrap: wrap; gap: 0.45rem; }
  .g-btn {
    padding: 0.42rem 0.85rem;
    border-radius: 8px;
    border: 1px solid var(--border-color);
    background: var(--bg-secondary);
    color: var(--text-primary);
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
  }
  .g-btn:hover { border-color: var(--accent-primary); color: var(--accent-primary); }
  .g-btn-primary { background: var(--accent-primary); border-color: var(--accent-primary); color: #ffffff; }
  .g-btn-primary:hover { background: var(--accent-secondary); border-color: var(--accent-secondary); color: #ffffff; }
</style>
