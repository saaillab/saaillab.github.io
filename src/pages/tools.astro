---
import Layout from '../layouts/Layout.astro';
import ModernHeader from '../components/ModernHeader.astro';
import ModernFooter from '../components/ModernFooter.astro';
import clovesMeta from '../../public/models/cloves_mobilenetv3s_meta.json';
import cassavaMeta from '../../public/models/cassava_mobilenetv3s_meta.json';
import { DEMO_CLASS_SW } from '../utils/i18n';
---

<Layout
	title="On-Device AI Apps & Software | SAAIL Lab · IIT Madras Zanzibar"
	description="Offline Android and Flutter deep learning field applications (Ubora-AI Zanzibar Clove Grading, Maize Disease Segmentation, E-Vision) and reproducible PyTorch/ONNX codebases built at SAAIL Lab, IIT Madras Zanzibar."
	canonical="https://saaillab.github.io/tools/"
>
	<ModernHeader currentPage="resources" />

	<main id="main-content">
		<section class="page-hero">
			<div class="container">
				<span class="page-eyebrow" data-i18n="tools.eyebrow">Engineering &amp; Field Prototypes</span>
				<h1 class="page-title" data-i18n="tools.title">Mobile Applications &amp; Research Software</h1>
				<p class="page-lead" data-i18n="tools.lead">
					Translating SAAIL Lab models into offline mobile prototypes for East African field conditions alongside reproducible PyTorch, ONNX, and XAI evaluation codebases.
				</p>
			</div>
		</section>

		<!-- Mobile Apps Built by SAAIL Lab Students -->
		<section class="section">
			<div class="container">
				<div class="group-head">
					<span class="page-eyebrow">Android &amp; Flutter Prototypes</span>
					<h2>On-Device Field Mobile Applications</h2>
					<p>Student-developed mobile prototypes running quantized TensorFlow Lite (TFLite INT8) and lightweight vision models locally without internet connectivity.</p>
				</div>

				<div class="apps-grid apps-grid-2">
					<article class="tool-card app-card">
						<div class="tool-top">
							<span class="tool-badge badge-mobile">Flutter · TFLite INT8</span>
							<span class="tool-status">Research Prototype</span>
						</div>
						<h3>Ubora-AI: ZSTC Clove Quality Grading App</h3>
						<p class="tool-author">Developer: Patrick Vincent Ndowo (MTech Alum) &amp; SAAIL Lab</p>
						<p class="tool-desc">
							Offline mobile inspection application matched to Zanzibar State Trading Corporation (ZSTC) commercial clove grades (Grades I to IV). Designed through participatory co-design with Saateni inspectors to perform on-device foreground isolation and defect (<em>mpeta</em>) screening on budget Android smartphones.
						</p>
						<ul class="spec-list">
							<li><strong>Architecture:</strong> Compositional segmentation-first + lightweight CNN inference</li>
							<li><strong>Runtime:</strong> On-device TensorFlow Lite INT8 mobile deployment</li>
							<li><strong>Companion Benchmarks:</strong> ZSTC-Clove-V1, CLOVES-4603, ETRI Journal 2026</li>
						</ul>
						<div class="tool-links">
							<a href="/projects/ubora-ai/" class="btn btn-primary">Ubora-AI Project Page</a>
							<a href="/papers/clove-codesign-africhi2025/" class="btn btn-secondary">AfriCHI Co-Design Paper</a>
							<a href="https://github.com/saaillab/zstc-clove-v1" target="_blank" rel="noopener" class="btn btn-secondary">Companion Repo ↗</a>
						</div>
					</article>

					<article class="tool-card app-card">
						<div class="tool-top">
							<span class="tool-badge badge-mobile">Android · TFLite INT8</span>
							<span class="tool-status">Research Prototype</span>
						</div>
						<h3>Maize Foliar Disease Segmentation &amp; Classification App</h3>
						<p class="tool-author">Developer: Duen Michael Chombo (MTech Alum) &amp; SAAIL Lab</p>
						<p class="tool-desc">
							Two-stage mobile Android diagnostic application pairing DeepLabV3+ foliar lesion segmentation with MobileViT classification for offline field diagnosis of Maize Lethal Necrosis, Gray Leaf Spot, Northern Corn Leaf Blight, and healthy leaves.
						</p>
						<ul class="spec-list">
							<li><strong>Segmentation &amp; Classifier:</strong> DeepLabV3+ + MobileViT hybrid pipeline</li>
							<li><strong>Deployment:</strong> Offline quantized TFLite INT8 mobile package</li>
							<li><strong>Target Users:</strong> East African extension officers &amp; smallholder scouts</li>
						</ul>
						<div class="tool-links">
							<a href="/projects/cropguard-pathology/" class="btn btn-primary">Crop Pathology Project</a>
							<a href="/papers/cropguardnet/" class="btn btn-secondary">CropGuardNet Paper</a>
						</div>
					</article>
				</div>
			</div>
		</section>

		<!-- Open-Source Codebases & Benchmarking Frameworks -->
		<section class="section alt-band">
			<div class="container">
				<div class="group-head">
					<span class="page-eyebrow">Open-Source Code</span>
					<h2>Reproducible Benchmarks &amp; Toolkits</h2>
					<p>Released at <a href="https://github.com/saaillab" target="_blank" rel="noopener">github.com/saaillab</a> (<code>CC BY-NC 4.0</code>; CARA-FM follows PMLR Vol. 302 under <code>CC BY 4.0</code>).</p>
				</div>

				<div class="apps-grid apps-grid-2">
					<article class="tool-card">
						<div class="tool-top">
							<span class="tool-badge badge-code">PyTorch · ONNX</span>
							<span class="tool-status">5.00 ms CPU Inference</span>
						</div>
						<h3>CropGuardNet Framework</h3>
						<p class="tool-desc">
							Training, UUID + 64-bit pHash deduplication auditor (80,238 duplicates purged), 20-regime corruption suite, 8-fold leave-one-crop-out evaluation, and four-method XAI faithfulness suite.
						</p>
						<div class="code-copy-bar">
							<code>git clone https://github.com/saaillab/CropGuardNet.git && cd CropGuardNet</code>
							<button type="button" class="copy-cmd-btn" data-copy="git clone https://github.com/saaillab/CropGuardNet.git && cd CropGuardNet">Copy</button>
						</div>
						<div class="tool-links">
							<a href="https://github.com/saaillab/CropGuardNet" target="_blank" rel="noopener" class="btn btn-primary">GitHub Repo ↗</a>
							<a href="/papers/cropguardnet/" class="btn btn-secondary">Paper Summary</a>
						</div>
					</article>

					<article class="tool-card">
						<div class="tool-top">
							<span class="tool-badge badge-code">Python Package · Pytest</span>
							<span class="tool-status">DLI 2026 Best Poster</span>
						</div>
						<h3>DGS-Bench Evaluation Suite</h3>
						<p class="tool-desc">
							Runnable <code>dgs_bench</code> package verifying Algorithm 1 balanced gap metrics, closed-form mirage thresholds <code>p*</code>, Temperature Scaling, Saerens EM prior shift, and fixed 10-seed Cassava splits.
						</p>
						<div class="code-copy-bar">
							<code>pip install -e . && python -m dgs_bench.cli --demo-verify</code>
							<button type="button" class="copy-cmd-btn" data-copy="pip install -e . && python -m dgs_bench.cli --demo-verify">Copy</button>
						</div>
						<div class="tool-links">
							<a href="https://github.com/saaillab/dgs-bench" target="_blank" rel="noopener" class="btn btn-primary">GitHub Repo ↗</a>
							<a href="/papers/dgs-bench/" class="btn btn-secondary">Paper Summary</a>
						</div>
					</article>

					<article class="tool-card">
						<div class="tool-top">
							<span class="tool-badge badge-mobile">CC BY 4.0 · PMLR Vol. 302</span>
							<span class="tool-status">9 Formal Indices</span>
						</div>
						<h3>CARA-FM Readiness Package</h3>
						<p class="tool-desc">
							Operationalizes all nine CARA-FM indices (<code>CEI</code>, <code>DFS</code>, <code>MPP</code>, <code>YIP</code>, <code>IOE</code>, <code>IAE</code>, <code>CAI</code>, <code>CAS</code>, <code>KPV</code>) with Draft 2020-12 JSON Schema validation across edge and cloud models.
						</p>
						<div class="code-copy-bar">
							<code>pip install -e . && python -m cara_fm.cli --demo</code>
							<button type="button" class="copy-cmd-btn" data-copy="pip install -e . && python -m cara_fm.cli --demo">Copy</button>
						</div>
						<div class="tool-links">
							<a href="https://github.com/saaillab/cara-fm" target="_blank" rel="noopener" class="btn btn-primary">CARA-FM Repo ↗</a>
							<a href="/papers/cara-fm/" class="btn btn-secondary">Paper Summary</a>
						</div>
					</article>

					<article class="tool-card">
						<div class="tool-top">
							<span class="tool-badge badge-code">Texture + CNN + ViT</span>
							<span class="tool-status">CVPR 2026 V4A</span>
						</div>
						<h3>CLOVES-4603 Benchmark Code</h3>
						<p class="tool-desc">
							Reproducible benchmarking code comparing classical texture descriptors (GLCM, GLRLM, LBP, HOG), frozen self-supervised DINOv2 linear probes, and fine-tuned CNN backbones under lot-aware 5-seed stratification.
						</p>
						<div class="code-copy-bar">
							<code>git clone https://github.com/saaillab/CLOVES-4603.git && cd CLOVES-4603</code>
							<button type="button" class="copy-cmd-btn" data-copy="git clone https://github.com/saaillab/CLOVES-4603.git && cd CLOVES-4603">Copy</button>
						</div>
						<div class="tool-links">
							<a href="https://github.com/saaillab/CLOVES-4603" target="_blank" rel="noopener" class="btn btn-primary">CLOVES-4603 Repo ↗</a>
							<a href="/papers/cloves-4603/" class="btn btn-secondary">Paper Summary</a>
						</div>
					</article>
				</div>
			</div>
		</section>

		<!-- In-Browser WebAssembly ONNX Live Inference Demo (Dual Model + Live CAM Saliency) -->
		<section class="section" id="live-demo">
			<div class="container">
				<div class="group-head">
					<span class="page-eyebrow" data-i18n="demo.eyebrow">Client-Side WebAssembly AI</span>
					<h2 data-i18n="demo.title">In-Browser Live ONNX Inference &amp; Visual Saliency (CAM)</h2>
					<p data-i18n="demo.lead">
						Switch between verified PyTorch MobileNetV3-Small + CAM ONNX models for Zanzibar Cloves ({clovesMeta.modelSizeMB} MB, {clovesMeta.testAccuracyPct}% acc, {clovesMeta.testMacroF1Pct}% Macro-F1, n = {clovesMeta.testSamples}) and Ugandan Cassava Pathology ({cassavaMeta.modelSizeMB} MB, {cassavaMeta.testAccuracyPct}% acc, {cassavaMeta.testMacroF1Pct}% Macro-F1, n = {cassavaMeta.testSamples}), executing with real-time Class Activation Maps inside WebAssembly with zero server uploads.
					</p>
				</div>

				<div class="demo-model-tabs" role="tablist" aria-label="Select ONNX WebAssembly inference model">
					<button
						type="button"
						role="tab"
						aria-selected="true"
						aria-controls="demoPanelShell"
						tabindex="0"
						class="demo-tab is-active"
						data-model-key="cloves"
						data-url={clovesMeta.onnxFile}
						data-format={clovesMeta.format}
						data-size={clovesMeta.modelSizeMB}
						data-spec={`${clovesMeta.modelSizeMB} MB · Acc ${clovesMeta.testAccuracyPct}% · F1 ${clovesMeta.testMacroF1Pct}% (n = ${clovesMeta.testSamples})`}
						data-classes={JSON.stringify(clovesMeta.classes)}
						data-i18n="demo.tab_cloves"
					>Zanzibar Cloves (ZSTC Grades I&ndash;IV)</button>
					<button
						type="button"
						role="tab"
						aria-selected="false"
						aria-controls="demoPanelShell"
						tabindex="-1"
						class="demo-tab"
						data-model-key="cassava"
						data-url={cassavaMeta.onnxFile}
						data-format={cassavaMeta.format}
						data-size={cassavaMeta.modelSizeMB}
						data-spec={`${cassavaMeta.modelSizeMB} MB · Acc ${cassavaMeta.testAccuracyPct}% · F1 ${cassavaMeta.testMacroF1Pct}% (n = ${cassavaMeta.testSamples})`}
						data-classes={JSON.stringify(cassavaMeta.classes)}
						data-i18n="demo.tab_cassava"
					>Ugandan Cassava Pathology (5 Classes)</button>
				</div>

				<div class="demo-panel" id="demoPanelShell">
					<div class="demo-left">
						<div class="demo-specs-row">
							<span class="tool-badge badge-mobile" id="demoFormatBadge">{clovesMeta.format}</span>
							<span class="tool-status" id="demoMetricBadge">{clovesMeta.modelSizeMB} MB · Acc {clovesMeta.testAccuracyPct}% · F1 {clovesMeta.testMacroF1Pct}% (n = {clovesMeta.testSamples})</span>
						</div>

						<p class="demo-instructions" id="demoInstructions">
							Select a held-out test photograph or upload your own image to run client-side classification and pixel-level CAM saliency:
						</p>

						<div id="demoGridCloves" class="demo-samples-grid" role="group" aria-label="Held-out Zanzibar clove test samples">
							{clovesMeta.demoSamples.map((s) => (
								<button
									type="button"
									class="demo-sample-btn"
									data-sample-src={s.file}
									data-sample-label={s.gradeLabel}
								>
									<img src={s.file} alt={`Held-out Zanzibar clove test image: ${s.gradeLabel}`} width="84" height="84" loading="lazy" />
									<span>{s.shortLabel}</span>
								</button>
							))}
						</div>

						<div id="demoGridCassava" class="demo-samples-grid demo-grid-5" role="group" aria-label="Held-out Ugandan cassava field test samples" hidden>
							{cassavaMeta.demoSamples.map((s) => (
								<button
									type="button"
									class="demo-sample-btn"
									data-sample-src={s.file}
									data-sample-label={s.gradeLabel}
								>
									<img src={s.file} alt={`Held-out Ugandan cassava test image: ${s.gradeLabel}`} width="84" height="84" loading="lazy" />
									<span>{s.shortLabel}</span>
								</button>
							))}
						</div>

						<div class="demo-upload-row">
							<input id="demoFileInput" type="file" accept="image/*" class="sr-only" />
							<input id="demoCameraInput" type="file" accept="image/*" capture="environment" class="sr-only" />
							<button type="button" id="demoCameraBtn" class="btn btn-primary" data-i18n="demo.camera_btn">Take Field Photo</button>
							<button type="button" id="demoUploadBtn" class="btn btn-secondary" data-i18n="demo.upload_btn">Upload Custom Image</button>
							<button type="button" id="demoOfflineBtn" class="btn btn-secondary demo-offline-btn" data-i18n="demo.save_offline">Save Models Offline</button>
							<span id="demoInputLabel" class="demo-input-note">No image executed yet</span>
						</div>
						<p id="demoOfflineNote" class="demo-offline-note">PWA Offline Cache: ready for field precaching (7.14 MB total ONNX weights).</p>
					</div>

					<div class="demo-right">
						<div class="demo-preview-wrap">
							<div class="demo-canvas-col">
								<canvas id="demoPreviewCanvas" width="224" height="224" aria-label="Center-cropped 224x224 ONNX input preview with optional CAM saliency heatmap"></canvas>
								<div class="cam-controls">
									<label class="cam-toggle-lbl">
										<input id="demoCamToggle" type="checkbox" checked />
										<span data-i18n="demo.cam_toggle">Visual Saliency (CAM)</span>
									</label>
									<label class="cam-opacity-lbl">
										<span><span data-i18n="demo.cam_opacity">CAM Opacity</span>: <strong id="demoCamOpacityVal">55%</strong></span>
										<input id="demoCamOpacity" type="range" min="0" max="85" step="5" value="55" aria-valuetext="55%" />
									</label>
									<div class="cam-legend" aria-hidden="true">
										<span>Low</span>
										<span class="cam-ramp"></span>
										<span>High</span>
									</div>
								</div>
							</div>

							<div class="demo-meta-readout">
								<div>
									<small data-i18n="demo.pred_label">Model Prediction</small>
									<strong id="demoPredClass" data-i18n="demo.idle_pred">Select a sample image</strong>
								</div>
								<div>
									<small data-i18n="demo.lat_label">Browser Inference</small>
									<strong id="demoLatency">0.0 ms</strong>
								</div>
								<div>
									<small data-i18n="demo.backend_label">Runtime Backend</small>
									<strong id="demoBackend">WASM CPU (Lazy)</strong>
								</div>
							</div>
						</div>

						<div class="demo-bars" aria-label="Predicted class probabilities">
							{[0, 1, 2, 3, 4].map((idx) => (
								<div class="prob-row" id={`demoProbRow${idx}`} hidden={idx >= clovesMeta.classes.length}>
									<div class="prob-head">
										<span id={`demoProbName${idx}`}>{clovesMeta.classes[idx] || ''}</span>
										<strong class="prob-pct" id={`demoProbPct${idx}`}>0.0%</strong>
									</div>
									<div class="prob-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-labelledby={`demoProbName${idx}`}>
										<div class="prob-fill" id={`demoProbBar${idx}`} style="width: 0%"></div>
									</div>
								</div>
							))}
						</div>

						<div id="demoStatusBox" class="calc-alert alert-ok" role="status" aria-live="polite" data-i18n="demo.ready_hint">
							Ready: ONNX WebAssembly weights load lazily on first click so initial page load stays fast.
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Interactive Browser Calculators -->
		<section class="section alt-band" id="calculators">
			<div class="container">
				<div class="group-head">
					<span class="page-eyebrow" data-i18n="calc.eyebrow">Interactive Diagnostics</span>
					<h2 data-i18n="calc.title">Interactive Evaluation Calculators</h2>
					<p data-i18n="calc.lead">Compute exact closed-form DGS-Bench mirage onset thresholds and CARA-FM edge readiness scores directly in your browser using verified equations from both repositories.</p>
				</div>

				<div class="apps-grid apps-grid-2">
					<!-- DGS-Bench Mirage Threshold Calculator -->
					<article class="tool-card calc-card">
						<div class="tool-top">
							<span class="tool-badge badge-code">DGS-Bench Eq. (p*)</span>
							<span class="tool-status">Client-Side Solver</span>
						</div>
						<h3>Mirage Threshold &amp; Prior-Shift Calculator</h3>
						<p class="tool-desc">Estimates the exact majority prevalence <code>p* = (Acc_L - r_bar) / (r_1 - r_bar)</code> where raw field accuracy appears better than balanced laboratory accuracy (<code>DGS_Acc &lt; 0</code>).</p>

						<div class="preset-row" aria-label="DGS-Bench presets">
							<button type="button" class="preset-btn dgs-preset" data-lab="55.85" data-r1="65.0" data-rminor="53.4" data-prev="65.8">ResNet-50</button>
							<button type="button" class="preset-btn dgs-preset" data-lab="54.05" data-r1="62.5" data-rminor="51.8" data-prev="65.8">EfficientNet-B3</button>
							<button type="button" class="preset-btn dgs-preset" data-lab="56.85" data-r1="64.0" data-rminor="54.6" data-prev="65.8">ViT-S/16</button>
							<button type="button" class="preset-btn dgs-preset" data-lab="91.0" data-r1="92.0" data-rminor="74.0" data-prev="65.4">Tomato (&gt;90%)</button>
						</div>

						<div class="calc-controls">
							<label class="calc-field">
								<span>Balanced Lab Accuracy (<code>Acc_L</code>): <strong id="dgsLabVal">55.85%</strong></span>
								<input id="dgsLab" type="range" min="30" max="99" step="0.05" value="55.85" aria-valuetext="55.85%" />
							</label>
							<label class="calc-field">
								<span>Majority-Class Recall (<code>r_1</code>): <strong id="dgsR1Val">65.0%</strong></span>
								<input id="dgsR1" type="range" min="20" max="99.5" step="0.1" value="65.0" aria-valuetext="65.0%" />
							</label>
							<label class="calc-field">
								<span>Mean Minority Recall (<code>r_bar</code>): <strong id="dgsRMinorVal">53.4%</strong></span>
								<input id="dgsRMinor" type="range" min="15" max="99" step="0.1" value="53.4" aria-valuetext="53.4%" />
							</label>
							<label class="calc-field">
								<span>Field Majority Prevalence (<code>p</code>): <strong id="dgsPrevVal">65.8%</strong></span>
								<input id="dgsPrev" type="range" min="20" max="95" step="0.1" value="65.8" aria-valuetext="65.8%" />
							</label>
						</div>

						<div class="calc-readout">
							<div><small>Threshold <code>p*</code></small><strong id="dgsPStarOut">21.1%</strong></div>
							<div><small>Projected Field Acc</small><strong id="dgsFldAccOut">61.0%</strong></div>
							<div><small>Projected <code>DGS_Acc</code></small><strong id="dgsDeltaOut">-5.2 pp</strong></div>
						</div>
						<div id="dgsAlertBox" class="calc-alert alert-warn" role="status" aria-live="polite">Evaluation Mirage Active: report DGS_F1 as primary metric.</div>
					</article>

					<!-- CARA-FM Edge Readiness Calculator -->
					<article class="tool-card calc-card">
						<div class="tool-top">
							<span class="tool-badge badge-mobile">CARA-FM Technical Indices</span>
							<span class="tool-status">Matches cara_fm/indices.py</span>
						</div>
						<h3>Edge Readiness (<code>CEI</code> &amp; <code>DFS</code>) Calculator</h3>
						<p class="tool-desc">Computes exact Computational Efficiency Index (<code>CEI</code>) and Deployment Feasibility Score (<code>DFS</code>) against East African 1&ndash;4 GB RAM, <code>&lt; 500 MB</code> disk, and <code>&lt; 250 ms</code> CPU gates.</p>

						<div class="preset-row" aria-label="CARA-FM model presets">
							<button type="button" class="preset-btn cara-preset" data-bacc="78.16" data-size="5.95" data-ram="0.19" data-devram="2.0" data-lat="20.69" data-off="1" data-cpu="1">MobileNetV3-S</button>
							<button type="button" class="preset-btn cara-preset" data-bacc="81.64" data-size="42.72" data-ram="0.24" data-devram="2.0" data-lat="69.73" data-off="1" data-cpu="1">ResNet-18</button>
							<button type="button" class="preset-btn cara-preset" data-bacc="83.27" data-size="90.04" data-ram="0.31" data-devram="2.0" data-lat="174.60" data-off="1" data-cpu="1">ResNet-50</button>
							<button type="button" class="preset-btn cara-preset" data-bacc="86.0" data-size="4200" data-ram="8.0" data-devram="2.0" data-lat="1850" data-off="0" data-cpu="0">Cloud 7B VLM</button>
						</div>

						<div class="calc-controls">
							<label class="calc-field">
								<span>Cross-Crop Balanced Acc: <strong id="caraBaccVal">78.16%</strong></span>
								<input id="caraBacc" type="range" min="30" max="99.5" step="0.05" value="78.16" aria-valuetext="78.16%" />
							</label>
							<label class="calc-field">
								<span>Model Size (MB): <strong id="caraSizeVal">5.95 MB</strong></span>
								<input id="caraSize" type="range" min="1" max="1500" step="0.5" value="5.95" aria-valuetext="5.95 MB" />
