<script>
	import { DEMO_CLASS_SW } from '../utils/i18n';

	document.querySelectorAll('.copy-cmd-btn').forEach((btn) => {
		btn.addEventListener('click', async () => {
			const cmd = btn.getAttribute('data-copy') || '';
			if (!cmd) return;
			let ok = false;
			try {
				await navigator.clipboard.writeText(cmd);
				ok = true;
			} catch (_e) {
				const area = document.createElement('textarea');
				area.value = cmd;
				area.style.position = 'fixed';
				area.style.opacity = '0';
				document.body.appendChild(area);
				area.select();
				try { ok = document.execCommand('copy'); } catch (_e2) {}
				document.body.removeChild(area);
			}
			if (ok) {
				btn.textContent = 'Copied!';
				const liveEl = document.getElementById('saailLiveStatus');
				if (liveEl) {
					liveEl.textContent = '';
					requestAnimationFrame(() => { liveEl.textContent = 'Command copied to clipboard.'; });
				}
				setTimeout(() => { btn.textContent = 'Copy'; }, 1600);
			}
		});
	});

	(function initDgsCalc() {
		const labIn = document.getElementById('dgsLab') as HTMLInputElement | null;
		const r1In = document.getElementById('dgsR1') as HTMLInputElement | null;
		const rmIn = document.getElementById('dgsRMinor') as HTMLInputElement | null;
		const pvIn = document.getElementById('dgsPrev') as HTMLInputElement | null;
		if (!labIn || !r1In || !rmIn || !pvIn) return;

		function updateDgs() {
			const accL = parseFloat(labIn!.value);
			const r1 = parseFloat(r1In!.value);
			const rm = parseFloat(rmIn!.value);
			const p = parseFloat(pvIn!.value);
			document.getElementById('dgsLabVal')!.textContent = `${accL.toFixed(2)}%`;
			document.getElementById('dgsR1Val')!.textContent = `${r1.toFixed(1)}%`;
			document.getElementById('dgsRMinorVal')!.textContent = `${rm.toFixed(1)}%`;
			document.getElementById('dgsPrevVal')!.textContent = `${p.toFixed(1)}%`;
			labIn!.setAttribute('aria-valuetext', `${accL.toFixed(2)}%`);
			r1In!.setAttribute('aria-valuetext', `${r1.toFixed(1)}%`);
			rmIn!.setAttribute('aria-valuetext', `${rm.toFixed(1)}%`);
			pvIn!.setAttribute('aria-valuetext', `${p.toFixed(1)}%`);

			const pFrac = p / 100;
			const accF = pFrac * r1 + (1 - pFrac) * rm;
			const dgsAcc = accL - accF;
			const denom = r1 - rm;
			const pStarEl = document.getElementById('dgsPStarOut')!;
			if (Math.abs(denom) < 0.05) {
				pStarEl.textContent = 'Undefined';
			} else {
				const pStarPct = ((accL - rm) / denom) * 100;
				pStarEl.textContent = `${pStarPct.toFixed(1)}%`;
			}
			document.getElementById('dgsFldAccOut')!.textContent = `${accF.toFixed(1)}%`;
			document.getElementById('dgsDeltaOut')!.textContent = `${dgsAcc >= 0 ? '+' : ''}${dgsAcc.toFixed(1)} pp`;

			const alertBox = document.getElementById('dgsAlertBox')!;
			if (dgsAcc < 0 && p > 30) {
				alertBox.className = 'calc-alert alert-warn';
				alertBox.textContent = 'Evaluation Mirage Active (DGS_Acc < 0 under >30% skew): report DGS_F1 as primary metric.';
			} else if (p > 30) {
				alertBox.className = 'calc-alert alert-ok';
				alertBox.textContent = 'Majority >30% without accuracy sign reversal; still inspect per-class recall and DGS_F1.';
			} else {
				alertBox.className = 'calc-alert alert-ok';
				alertBox.textContent = 'Low prior skew (<=30% majority): raw accuracy does not reverse sign.';
			}
		}

		[labIn, r1In, rmIn, pvIn].forEach((el) => el.addEventListener('input', updateDgs));
		document.querySelectorAll('.dgs-preset').forEach((btn) => {
			btn.addEventListener('click', () => {
				labIn.value = btn.getAttribute('data-lab') || '55.85';
				r1In.value = btn.getAttribute('data-r1') || '65.0';
				rmIn.value = btn.getAttribute('data-rminor') || '53.4';
				pvIn.value = btn.getAttribute('data-prev') || '65.8';
				updateDgs();
			});
		});
		updateDgs();
	})();

	(function initCaraCalc() {
		const baccIn = document.getElementById('caraBacc') as HTMLInputElement | null;
		const sizeIn = document.getElementById('caraSize') as HTMLInputElement | null;
		const ramIn = document.getElementById('caraRam') as HTMLInputElement | null;
		const devRamIn = document.getElementById('caraDevRam') as HTMLInputElement | null;
		const latIn = document.getElementById('caraLat') as HTMLInputElement | null;
		const offIn = document.getElementById('caraOffline') as HTMLInputElement | null;
		const cpuIn = document.getElementById('caraCpuOnly') as HTMLInputElement | null;
		if (!baccIn || !sizeIn || !ramIn || !devRamIn || !latIn || !offIn || !cpuIn) return;

		const clip01 = (v: number) => Math.max(0, Math.min(1, v));

		function updateCara() {
			const bacc = parseFloat(baccIn!.value);
			const sizeMb = parseFloat(sizeIn!.value);
			const ramGb = parseFloat(ramIn!.value);
			const deviceRam = parseFloat(devRamIn!.value);
			const latMs = parseFloat(latIn!.value);
			const offline = offIn!.checked;
			const cpuOnly = cpuIn!.checked;

			const sizeLabel = `${sizeMb >= 100 ? sizeMb.toFixed(0) : sizeMb.toFixed(2)} MB`;
			document.getElementById('caraBaccVal')!.textContent = `${bacc.toFixed(2)}%`;
			document.getElementById('caraSizeVal')!.textContent = sizeLabel;
			document.getElementById('caraRamVal')!.textContent = `${ramGb.toFixed(2)} GB`;
			document.getElementById('caraDevRamVal')!.textContent = `${deviceRam.toFixed(1)} GB`;
			document.getElementById('caraLatVal')!.textContent = `${latMs.toFixed(1)} ms`;
			baccIn!.setAttribute('aria-valuetext', `${bacc.toFixed(2)}%`);
			sizeIn!.setAttribute('aria-valuetext', sizeLabel);
			ramIn!.setAttribute('aria-valuetext', `${ramGb.toFixed(2)} GB`);
			devRamIn!.setAttribute('aria-valuetext', `${deviceRam.toFixed(1)} GB`);
			latIn!.setAttribute('aria-valuetext', `${latMs.toFixed(1)} ms`);

			const acc = clip01(bacc / 100);
			const sizeScore = clip01(1 / (1 + Math.max(sizeMb, 0.01) / 125));
			const latScore = clip01(100 / (100 + Math.max(latMs, 0.1)));
			const cei = clip01(0.55 * acc + 0.45 * (0.5 * sizeScore + 0.5 * latScore));

			const dfs = (
				(offline ? 1 : 0) +
				(cpuOnly ? 1 : 0) +
				(sizeMb <= 500 ? 1 : clip01(500 / Math.max(sizeMb, 0.001))) +
				(ramGb <= 0.65 * deviceRam ? 1 : clip01(deviceRam / Math.max(ramGb, 0.001))) +
				(latMs <= 250 ? 1 : clip01(250 / Math.max(latMs, 0.001)))
			) / 5;
			const meanTech = 0.5 * (cei + dfs);

			document.getElementById('caraCeiOut')!.textContent = cei.toFixed(3);
			document.getElementById('caraDfsOut')!.textContent = dfs.toFixed(3);
			document.getElementById('caraMeanOut')!.textContent = meanTech.toFixed(3);

			const alertBox = document.getElementById('caraAlertBox')!;
			if (dfs >= 0.999) {
				alertBox.className = 'calc-alert alert-ok';
				alertBox.textContent = `Edge-Ready (DFS = 1.000): clears 500 MB storage, ${(0.65 * deviceRam).toFixed(2)} GB RAM headroom, offline CPU, and 250 ms gates.`;
			} else {
				alertBox.className = 'calc-alert alert-warn';
				alertBox.textContent = `Constrained/Cloud Bound (DFS = ${dfs.toFixed(3)}): requires pruning, quantization, or connectivity.`;
			}
		}

		[baccIn, sizeIn, ramIn, devRamIn, latIn, offIn, cpuIn].forEach((el) => el.addEventListener('input', updateCara));
		document.querySelectorAll('.cara-preset').forEach((btn) => {
			btn.addEventListener('click', () => {
				const size = parseFloat(btn.getAttribute('data-size') || '5.95');
				const lat = parseFloat(btn.getAttribute('data-lat') || '20.69');
				baccIn.value = btn.getAttribute('data-bacc') || '78.16';
				sizeIn.max = String(Math.max(1500, size));
				sizeIn.value = String(size);
				ramIn.value = btn.getAttribute('data-ram') || '0.19';
				devRamIn.value = btn.getAttribute('data-devram') || '2.0';
				latIn.max = String(Math.max(1000, lat));
				latIn.value = String(lat);
				offIn.checked = btn.getAttribute('data-off') === '1';
				cpuIn.checked = btn.getAttribute('data-cpu') === '1';
				updateCara();
			});
		});
		updateCara();
	})();

	(function initOnnxLiveDemo() {
		const modelTabs = Array.from(document.querySelectorAll('.demo-tab')) as HTMLButtonElement[];
		const gridCloves = document.getElementById('demoGridCloves');
		const gridCassava = document.getElementById('demoGridCassava');
		const formatBadge = document.getElementById('demoFormatBadge');
		const metricBadge = document.getElementById('demoMetricBadge');
		const sampleBtns = Array.from(document.querySelectorAll('.demo-sample-btn')) as HTMLButtonElement[];
		const uploadBtn = document.getElementById('demoUploadBtn') as HTMLButtonElement | null;
		const cameraBtn = document.getElementById('demoCameraBtn') as HTMLButtonElement | null;
		const offlineBtn = document.getElementById('demoOfflineBtn') as HTMLButtonElement | null;
		const offlineNote = document.getElementById('demoOfflineNote');
		const fileInput = document.getElementById('demoFileInput') as HTMLInputElement | null;
		const cameraInput = document.getElementById('demoCameraInput') as HTMLInputElement | null;
		const canvas = document.getElementById('demoPreviewCanvas') as HTMLCanvasElement | null;
		const camToggle = document.getElementById('demoCamToggle') as HTMLInputElement | null;
		const camOpacityIn = document.getElementById('demoCamOpacity') as HTMLInputElement | null;
		const camOpacityVal = document.getElementById('demoCamOpacityVal');
		const inputNoteEl = document.getElementById('demoInputLabel');
		const predEl = document.getElementById('demoPredClass');
		const latEl = document.getElementById('demoLatency');
		const backendEl = document.getElementById('demoBackend');
		const statusBox = document.getElementById('demoStatusBox');
		if (!canvas || !predEl || !latEl || !statusBox) return;

		const ctx = canvas.getContext('2d', { willReadFrequently: true });
		if (!ctx) return;

		const MODELS: Record<'cloves' | 'cassava', {
			url: string;
			format: string;
			specText: string;
			sizeMb: number;
			classes: string[];
		}> = {
			cloves: {
				url: '/models/cloves_mobilenetv3s.onnx',
				format: 'FP32 Single-File CAM ONNX (Opset 13)',
				specText: '3.57 MB · Acc 94.2% · F1 94.19% (n = 793)',
				sizeMb: 3.57,
				classes: ['Grade I (Premium)', 'Grade II (Standard)', 'Grade III (Commercial)', 'Grade IV (Mpeta)']
			},
			cassava: {
				url: '/models/cassava_mobilenetv3s.onnx',
				format: 'FP32 Single-File CAM ONNX (Opset 13)',
				specText: '3.57 MB · Acc 82.48% · F1 69.29% (n = 2141)',
				sizeMb: 3.57,
				classes: ['Cassava Bacterial Blight (CBB)', 'Cassava Brown Streak Disease (CBSD)', 'Cassava Green Mite (CGM)', 'Cassava Mosaic Disease (CMD)', 'Healthy Cassava Leaf']
			}
		};
		modelTabs.forEach((tab) => {
			const k = tab.getAttribute('data-model-key') as 'cloves' | 'cassava' | null;
			if (!k || !MODELS[k]) return;
			MODELS[k].url = tab.getAttribute('data-url') || MODELS[k].url;
			MODELS[k].format = tab.getAttribute('data-format') || MODELS[k].format;
			MODELS[k].specText = tab.getAttribute('data-spec') || MODELS[k].specText;
			MODELS[k].sizeMb = parseFloat(tab.getAttribute('data-size') || String(MODELS[k].sizeMb));
			try {
				const parsed = JSON.parse(tab.getAttribute('data-classes') || '[]');
				if (Array.isArray(parsed) && parsed.length) MODELS[k].classes = parsed;
			} catch (_e) {}
		});

		let activeModel: 'cloves' | 'cassava' = 'cloves';
		let lastBaseImageData: ImageData | null = null;
		let lastCamSlice: Float32Array | null = null;
		let lastBestClassEn: string | null = null;
		let lastBestProbPct = 0;
		let lastLatencyMs = 0;

		function trClass(clsEn: string): string {
			const lang = document.documentElement.lang === 'sw' ? 'sw' : 'en';
			if (lang === 'sw' && DEMO_CLASS_SW[clsEn]) return DEMO_CLASS_SW[clsEn];
			return clsEn;
		}

		function drawPlaceholder() {
			lastBaseImageData = null;
			lastCamSlice = null;
			lastBestClassEn = null;
			ctx!.fillStyle = '#0f172a';
			ctx!.fillRect(0, 0, 224, 224);
			ctx!.fillStyle = '#cbd5e1';
			ctx!.font = '600 13px Inter, sans-serif';
			ctx!.textAlign = 'center';
			ctx!.fillText('224x224 Input + CAM', 112, 114);
		}
		drawPlaceholder();

		const ORT_VERSION = '1.20.1';
		let ortScriptPromise: Promise<any> | null = null;
		const sessionPromises: Record<string, Promise<any> | null> = {};
		let activeReqId = 0;

		function loadOrtScript(): Promise<any> {
			if ((window as any).ort) return Promise.resolve((window as any).ort);
			if (ortScriptPromise) return ortScriptPromise;
			ortScriptPromise = new Promise((resolve, reject) => {
				const script = document.createElement('script');
				script.src = '/vendor/ort/ort.wasm.min.js';
				script.async = true;
				script.onload = () => {
					const ort = (window as any).ort;
					if (!ort) {
						reject(new Error('onnxruntime-web script loaded but window.ort is missing'));
						return;
					}
					ort.env.wasm.wasmPaths = '/vendor/ort/';
					ort.env.wasm.numThreads = 1;
					resolve(ort);
				};
				script.onerror = () => reject(new Error('Failed to load self-hosted WebAssembly runtime (/vendor/ort/).'));
				document.head.appendChild(script);
			});
			return ortScriptPromise;
		}

		async function getSession(modelKey: 'cloves' | 'cassava') {
			const cfg = MODELS[modelKey];
			const existing = sessionPromises[modelKey];
			if (existing) return existing;
			sessionPromises[modelKey] = (async () => {
				statusBox!.className = 'calc-alert alert-ok';
				statusBox!.textContent = `Loading WebAssembly runtime and ${cfg.sizeMb} MB MobileNetV3-Small ONNX weights...`;
				const ort = await loadOrtScript();
				const session = await ort.InferenceSession.create(cfg.url, {
					executionProviders: ['wasm']
				});
				if (backendEl) backendEl.textContent = 'WebAssembly CPU';
				return { ort, session };
			})();
			return sessionPromises[modelKey]!;
		}

		function softmax(logits: Float32Array): number[] {
			let maxVal = -Infinity;
			for (let i = 0; i < logits.length; i++) {
				if (logits[i] > maxVal) maxVal = logits[i];
			}
			const exps = Array.from(logits, (v) => Math.exp(v - maxVal));
			const sum = exps.reduce((a, b) => a + b, 0) || 1;
			return exps.map((e) => e / sum);
		}

		function camColor(t: number): [number, number, number] {
			const c = Math.max(0, Math.min(1, t));
			if (c < 0.25) {
				const f = c / 0.25;
				return [0, Math.round(60 * f), Math.round(160 + 95 * f)];
			} else if (c < 0.5) {
				const f = (c - 0.25) / 0.25;
				return [0, Math.round(60 + 195 * f), Math.round(255 - 120 * f)];
			} else if (c < 0.75) {
				const f = (c - 0.5) / 0.25;
				return [Math.round(255 * f), 255, Math.round(135 * (1 - f))];
			}
			const f = (c - 0.75) / 0.25;
			return [255, Math.round(255 * (1 - f)), 0];
		}

		function compositeCanvas() {
			if (!lastBaseImageData) return;
			const out = new ImageData(new Uint8ClampedArray(lastBaseImageData.data), 224, 224);
			const showCam = Boolean(camToggle?.checked);
			const alphaMax = Number(camOpacityIn?.value ?? '55') / 100;
			const pctText = `${Math.round(alphaMax * 100)}%`;
			if (camOpacityVal) camOpacityVal.textContent = pctText;
			camOpacityIn?.setAttribute('aria-valuetext', pctText);

			if (showCam && lastCamSlice && alphaMax > 0) {
				let minV = Infinity;
				let maxV = -Infinity;
				for (let i = 0; i < 49; i++) {
					const v = lastCamSlice[i];
					if (v < minV) minV = v;
					if (v > maxV) maxV = v;
				}
				const span = Math.max(1e-6, maxV - minV);
				const norm7 = new Float32Array(49);
				for (let i = 0; i < 49; i++) {
					norm7[i] = (lastCamSlice[i] - minV) / span;
				}
				const d = out.data;
				for (let py = 0; py < 224; py++) {
					const gy = (py / 223) * 6;
					const y0 = Math.floor(gy);
					const y1 = Math.min(6, y0 + 1);
					const fy = gy - y0;
					for (let px = 0; px < 224; px++) {
						const gx = (px / 223) * 6;
						const x0 = Math.floor(gx);
						const x1 = Math.min(6, x0 + 1);
						const fx = gx - x0;
						const v00 = norm7[y0 * 7 + x0];
						const v10 = norm7[y0 * 7 + x1];
						const v01 = norm7[y1 * 7 + x0];
						const v11 = norm7[y1 * 7 + x1];
						const val = (v00 * (1 - fx) + v10 * fx) * (1 - fy) + (v01 * (1 - fx) + v11 * fx) * fy;
						const [hr, hg, hb] = camColor(val);
						const a = alphaMax * (0.25 + 0.75 * val);
						const off = (py * 224 + px) * 4;
						d[off] = Math.round(d[off] * (1 - a) + hr * a);
						d[off + 1] = Math.round(d[off + 1] * (1 - a) + hg * a);
						d[off + 2] = Math.round(d[off + 2] * (1 - a) + hb * a);
					}
				}
			}
			ctx!.putImageData(out, 0, 0);
		}

		function syncModelUI(modelKey: 'cloves' | 'cassava') {
			activeModel = modelKey;
			activeReqId++;
			sampleBtns.forEach((b) => b.classList.remove('is-selected'));
			if (gridCloves) gridCloves.hidden = modelKey !== 'cloves';
			if (gridCassava) gridCassava.hidden = modelKey !== 'cassava';
			const cfg = MODELS[modelKey];
			if (formatBadge) formatBadge.textContent = cfg.format;
			if (metricBadge) metricBadge.textContent = cfg.specText;
			drawPlaceholder();
			predEl!.textContent = document.documentElement.lang === 'sw' ? 'Chagua picha ya mfano' : 'Select a sample image';
			latEl!.textContent = '0.0 ms';
			if (inputNoteEl) inputNoteEl.textContent = document.documentElement.lang === 'sw' ? 'Hakuna picha iliyojaribiwa bado' : 'No image executed yet';
			for (let i = 0; i < 5; i++) {
				const row = document.getElementById(`demoProbRow${i}`);
				const nm = document.getElementById(`demoProbName${i}`);
				const pctEl = document.getElementById(`demoProbPct${i}`);
				const barEl = document.getElementById(`demoProbBar${i}`);
				if (row) row.hidden = i >= cfg.classes.length;
				if (nm) nm.textContent = cfg.classes[i] ? trClass(cfg.classes[i]) : '';
				if (pctEl) pctEl.textContent = '0.0%';
				if (barEl) {
					barEl.style.width = '0%';
					barEl.parentElement?.setAttribute('aria-valuenow', '0');
				}
			}
			statusBox!.className = 'calc-alert alert-ok';
			statusBox!.textContent = document.documentElement.lang === 'sw'
				? 'Tayari: uzito wa ONNX hupakiwa tu unapobofya picha.'
				: `Ready: ${cfg.sizeMb} MB ONNX model + 7x7 CAM saliency loads on first click.`;
		}

		function preprocessCanvasToTensor(ort: any) {
			const base = lastBaseImageData!;
			const imgData = base.data;
			const size = 224 * 224;
			const floatData = new Float32Array(3 * size);
			const mean = [0.485, 0.456, 0.406];
			const std = [0.229, 0.224, 0.225];
			for (let i = 0; i < size; i++) {
				const r = imgData[i * 4] / 255.0;
				const g = imgData[i * 4 + 1] / 255.0;
				const b = imgData[i * 4 + 2] / 255.0;
				floatData[i] = (r - mean[0]) / std[0];
				floatData[size + i] = (g - mean[1]) / std[1];
				floatData[2 * size + i] = (b - mean[2]) / std[2];
			}
			return new ort.Tensor('float32', floatData, [1, 3, 224, 224]);
		}

		async function runInferenceOnImage(img: HTMLImageElement, labelText: string, reqId: number, modelKey: 'cloves' | 'cassava') {
			try {
				if (reqId !== activeReqId) return;
				if (inputNoteEl) inputNoteEl.textContent = labelText;
				const side = Math.min(img.naturalWidth || img.width, img.naturalHeight || img.height);
				const sx = Math.max(0, Math.floor(((img.naturalWidth || img.width) - side) / 2));
				const sy = Math.max(0, Math.floor(((img.naturalHeight || img.height) - side) / 2));
				ctx!.clearRect(0, 0, 224, 224);
				ctx!.drawImage(img, sx, sy, side, side, 0, 0, 224, 224);
				lastBaseImageData = ctx!.getImageData(0, 0, 224, 224);

				const { ort, session } = await getSession(modelKey);
				if (reqId !== activeReqId) return;
				const inputTensor = preprocessCanvasToTensor(ort);
				const t0 = performance.now();
				const outputs = await session.run({ [session.inputNames[0]]: inputTensor });
				if (reqId !== activeReqId) return;
				const dtMs = performance.now() - t0;

				const logitsTensor = outputs['logits'] || outputs[session.outputNames[0]];
				const camTensor = outputs['cam_maps'] || outputs[session.outputNames[1]];
				const rawOut = logitsTensor.data as Float32Array;
				const probs = softmax(rawOut);
				let bestIdx = 0;
				for (let i = 1; i < probs.length; i++) {
					if (probs[i] > probs[bestIdx]) bestIdx = i;
				}

				if (camTensor && camTensor.data) {
					const offset = bestIdx * 49;
					lastCamSlice = (camTensor.data as Float32Array).slice(offset, offset + 49);
				} else {
					lastCamSlice = null;
				}
				compositeCanvas();

				const cfg = MODELS[modelKey];
				lastBestClassEn = cfg.classes[bestIdx];
				lastBestProbPct = probs[bestIdx] * 100;
				lastLatencyMs = dtMs;

				predEl!.textContent = trClass(lastBestClassEn);
				latEl!.textContent = `${dtMs.toFixed(1)} ms`;
				probs.forEach((p, idx) => {
					const pct = p * 100;
					const nmEl = document.getElementById(`demoProbName${idx}`);
					const pctEl = document.getElementById(`demoProbPct${idx}`);
					const barEl = document.getElementById(`demoProbBar${idx}`);
					if (nmEl && cfg.classes[idx]) nmEl.textContent = trClass(cfg.classes[idx]);
					if (pctEl) pctEl.textContent = `${pct.toFixed(1)}%`;
					if (barEl) {
						barEl.style.width = `${pct.toFixed(1)}%`;
						barEl.parentElement?.setAttribute('aria-valuenow', pct.toFixed(0));
					}
				});

				const dispName = trClass(lastBestClassEn);
				const isSwNow = document.documentElement.lang === 'sw';
				statusBox!.className = 'calc-alert alert-ok';
				statusBox!.textContent = isSwNow
					? `Utabiri: ${dispName} (uhakika wa ${lastBestProbPct.toFixed(1)}%) ndani ya ${dtMs.toFixed(1)} ms kwenye kifaa chako.`
					: `Predicted ${dispName} (${lastBestProbPct.toFixed(1)}% confidence) in ${dtMs.toFixed(1)} ms locally on your device.`;

				const liveEl = document.getElementById('saailLiveStatus');
				if (liveEl) {
					liveEl.textContent = '';
					requestAnimationFrame(() => {
						liveEl.textContent = isSwNow
							? `Utabiri: ${dispName} ndani ya milisekunde ${dtMs.toFixed(1)}.`
							: `Prediction: ${dispName} in ${dtMs.toFixed(1)} milliseconds.`;
					});
				}
			} catch (err) {
				if (reqId !== activeReqId) return;
				sessionPromises[modelKey] = null;
				statusBox!.className = 'calc-alert alert-warn';
				statusBox!.textContent = `Browser inference error: ${err instanceof Error ? err.message : 'Unable to initialize WebAssembly session.'}`;
			}
		}

		modelTabs.forEach((tab, idx) => {
			tab.addEventListener('click', () => {
				const key = (tab.getAttribute('data-model-key') === 'cassava' ? 'cassava' : 'cloves') as 'cloves' | 'cassava';
				modelTabs.forEach((t) => {
					t.classList.remove('is-active');
					t.setAttribute('aria-selected', 'false');
					t.setAttribute('tabindex', '-1');
				});
				tab.classList.add('is-active');
				tab.setAttribute('aria-selected', 'true');
				tab.setAttribute('tabindex', '0');
				syncModelUI(key);
			});
			tab.addEventListener('keydown', (e: KeyboardEvent) => {
				let next: number | null = null;
				if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') next = (idx + 1) % modelTabs.length;
				else if (e.key === 'Home') next = 0;
				else if (e.key === 'End') next = modelTabs.length - 1;
				if (next === null) return;
				e.preventDefault();
				modelTabs[next].focus();
				modelTabs[next].click();
			});
		});

		camToggle?.addEventListener('change', compositeCanvas);
		camOpacityIn?.addEventListener('input', compositeCanvas);

		sampleBtns.forEach((btn) => {
			btn.addEventListener('click', () => {
				sampleBtns.forEach((b) => b.classList.remove('is-selected'));
				btn.classList.add('is-selected');
				const src = btn.getAttribute('data-sample-src') || '';
				const lbl = btn.getAttribute('data-sample-label') || 'Sample';
				if (!src) return;
				const reqId = ++activeReqId;
				const mKey = activeModel;
				const img = new Image();
				img.onload = () => runInferenceOnImage(img, `Held-out test sample: ${trClass(lbl)}`, reqId, mKey);
				img.onerror = () => {
					if (reqId !== activeReqId) return;
					statusBox!.className = 'calc-alert alert-warn';
					statusBox!.textContent = `Failed to load sample image ${src}.`;
				};
				img.src = src;
			});
		});

		function handleLocalImageFile(file: File, prefix: string) {
			const reqId = ++activeReqId;
			const mKey = activeModel;
			const fname = file.name || 'camera_snap.jpg';
			sampleBtns.forEach((b) => b.classList.remove('is-selected'));
			const reader = new FileReader();
			reader.onload = () => {
				const img = new Image();
				img.onload = () => runInferenceOnImage(img, `${prefix}: ${fname}`, reqId, mKey);
				img.onerror = () => {
					if (reqId !== activeReqId) return;
					const isSwNow = document.documentElement.lang === 'sw';
					statusBox!.className = 'calc-alert alert-warn';
					statusBox!.textContent = isSwNow
						? `Picha isiyosomeka (${fname}). Tafadhali pakia JPEG, PNG, au WebP.`
						: `Unsupported or unreadable image format (${fname}). Please upload a JPEG, PNG, or WebP photograph.`;
					const liveEl = document.getElementById('saailLiveStatus');
					if (liveEl) {
						liveEl.textContent = '';
						requestAnimationFrame(() => {
							liveEl.textContent = isSwNow
								? `Picha isiyosomeka (${fname}).`
								: `Unsupported or unreadable image format (${fname}).`;
						});
					}
				};
				img.src = String(reader.result || '');
			};
			reader.onerror = () => {
				if (reqId !== activeReqId) return;
				statusBox!.className = 'calc-alert alert-warn';
				statusBox!.textContent = `Could not read local file ${fname}.`;
			};
			reader.readAsDataURL(file);
		}

		uploadBtn?.addEventListener('click', () => fileInput?.click());
		cameraBtn?.addEventListener('click', () => cameraInput?.click());
		fileInput?.addEventListener('change', () => {
			const file = fileInput.files?.[0];
			if (!file) return;
			fileInput.value = '';
			handleLocalImageFile(file, 'Local file');
		});
		cameraInput?.addEventListener('change', () => {
			const file = cameraInput.files?.[0];
			if (!file) return;
			cameraInput.value = '';
			handleLocalImageFile(file, 'Field camera');
		});

		let offlineState: 'idle' | 'cached' | 'unsupported' | 'error' = 'idle';

		offlineBtn?.addEventListener('click', async () => {
			if (!('caches' in window)) {
				offlineState = 'unsupported';
				if (offlineNote) {
					offlineNote.textContent = document.documentElement.lang === 'sw'
						? 'Hifadhi ya kivinjari (Cache API) haipatikani katika mazingira haya.'
						: 'Offline Cache API is unavailable in this browser context.';
				}
				return;
			}
			offlineBtn.disabled = true;
			if (offlineNote) {
				offlineNote.textContent = document.documentElement.lang === 'sw'
					? 'Inahifadhi mifumo ya ONNX na picha za mfano kwa matumizi bila mtandao...'
					: 'Caching ONNX weights and demo images for offline field use...';
			}
			try {
				const cache = await caches.open('saail-lab-v3');
				const assets = [
					'/vendor/ort/ort.wasm.min.js',
					'/vendor/ort/ort-wasm-simd-threaded.mjs',
					'/vendor/ort/ort-wasm-simd-threaded.wasm',
					'/models/cloves_mobilenetv3s.onnx',
					'/models/cloves_mobilenetv3s_meta.json',
					'/models/cassava_mobilenetv3s.onnx',
					'/models/cassava_mobilenetv3s_meta.json',
					'/images/demo/clove_grade1.jpg',
					'/images/demo/clove_grade2.jpg',
					'/images/demo/clove_grade3.jpg',
					'/images/demo/clove_grade4.jpg',
					'/images/demo/cassava_0_cbb.jpg',
					'/images/demo/cassava_1_cbsd.jpg',
					'/images/demo/cassava_2_cgm.jpg',
					'/images/demo/cassava_3_cmd.jpg',
					'/images/demo/cassava_4_healthy.jpg'
				];
				await cache.addAll(assets);
				offlineState = 'cached';
				const isSwNow = document.documentElement.lang === 'sw';
				if (offlineNote) {
					offlineNote.textContent = isSwNow
						? 'Mifumo yote miwili, injini ya WASM, na picha za mfano zimehifadhiwa kwa matumizi bila mtandao.'
						: 'Offline ready: WASM runtime, both ONNX models (7.14 MB), and all 9 demo images are cached on this device.';
				}
				const liveEl = document.getElementById('saailLiveStatus');
				if (liveEl) {
					liveEl.textContent = '';
					requestAnimationFrame(() => {
						liveEl.textContent = isSwNow
							? 'Injini ya WebAssembly na mifumo yote miwili imehifadhiwa kwa matumizi bila mtandao.'
							: 'WebAssembly runtime and both ONNX models cached for offline use.';
					});
				}
			} catch (_err) {
				offlineState = 'error';
				if (offlineNote) {
					offlineNote.textContent = document.documentElement.lang === 'sw'
						? 'Uhifadhi wa nje ya mtandao haukukamilika; kagua ruhusa za hifadhi.'
						: 'Offline caching could not complete; check storage permissions.';
				}
			} finally {
				offlineBtn.disabled = false;
			}
		});

		window.addEventListener('saail:langchange', () => {
			const cfg = MODELS[activeModel];
			const isSw = document.documentElement.lang === 'sw';
			for (let i = 0; i < cfg.classes.length; i++) {
				const nm = document.getElementById(`demoProbName${i}`);
				if (nm) nm.textContent = trClass(cfg.classes[i]);
			}
			if (lastBestClassEn) {
				const disp = trClass(lastBestClassEn);
				predEl!.textContent = disp;
				statusBox!.textContent = isSw
					? `Utabiri: ${disp} (uhakika wa ${lastBestProbPct.toFixed(1)}%) ndani ya ${lastLatencyMs.toFixed(1)} ms kwenye kifaa chako.`
					: `Predicted ${disp} (${lastBestProbPct.toFixed(1)}% confidence) in ${lastLatencyMs.toFixed(1)} ms locally on your device.`;
			} else {
				predEl!.textContent = isSw ? 'Chagua picha ya mfano' : 'Select a sample image';
				if (inputNoteEl) inputNoteEl.textContent = isSw ? 'Hakuna picha iliyojaribiwa bado' : 'No image executed yet';
				statusBox!.textContent = isSw
					? 'Tayari: uzito wa ONNX hupakiwa tu unapobofya picha.'
					: `Ready: ${cfg.sizeMb} MB ONNX model + 7x7 CAM saliency loads on first click.`;
			}
			if (offlineNote) {
				if (offlineState === 'idle') {
					offlineNote.textContent = isSw
						? 'Hifadhi ya Nje ya Mtandao: tayari kuhifadhi mifumo ya ONNX (7.14 MB).'
						: 'PWA Offline Cache: ready for field precaching (7.14 MB total ONNX weights).';
				} else if (offlineState === 'cached') {
					offlineNote.textContent = isSw
						? 'Mifumo yote miwili, injini ya WASM, na picha za mfano zimehifadhiwa kwa matumizi bila mtandao.'
						: 'Offline ready: WASM runtime, both ONNX models (7.14 MB), and all 9 demo images are cached on this device.';
				} else if (offlineState === 'unsupported') {
					offlineNote.textContent = isSw
						? 'Hifadhi ya kivinjari (Cache API) haipatikani katika mazingira haya.'
						: 'Offline Cache API is unavailable in this browser context.';
				} else if (offlineState === 'error') {
					offlineNote.textContent = isSw
						? 'Uhifadhi wa nje ya mtandao haukukamilika; kagua ruhusa za hifadhi.'
						: 'Offline caching could not complete; check storage permissions.';
				}
			}
		});
	})();

	(function initAgriAiBiasCard() {
		const nameIn = document.getElementById('biasDatasetName') as HTMLInputElement | null;
		const geoSel = document.getElementById('biasGeo') as HTMLSelectElement | null;
		const senSel = document.getElementById('biasSensor') as HTMLSelectElement | null;
		const balSel = document.getElementById('biasBalance') as HTMLSelectElement | null;
		const dedSel = document.getElementById('biasDedup') as HTMLSelectElement | null;
		const shfSel = document.getElementById('biasShift') as HTMLSelectElement | null;
		const banner = document.getElementById('biasStatusBanner');
		const copyMdBtn = document.getElementById('copyBiasMdBtn') as HTMLButtonElement | null;
		const dlJsonBtn = document.getElementById('downloadBiasJsonBtn') as HTMLButtonElement | null;
		if (!nameIn || !geoSel || !senSel || !balSel || !dedSel || !shfSel || !banner) return;

		function getAuditData() {
			const dims = [
				{ dimension: 'Geography & Regional Provenance', score: Number(geoSel!.value), note: geoSel!.options[geoSel!.selectedIndex].text },
				{ dimension: 'Imaging Environment & Canopy Clutter', score: Number(senSel!.value), note: senSel!.options[senSel!.selectedIndex].text },
				{ dimension: 'Class Balance (Gini <= 0.10)', score: Number(balSel!.value), note: balSel!.options[balSel!.selectedIndex].text },
				{ dimension: 'Image Quality & Resolution Fidelity', score: Number(dedSel!.value), note: dedSel!.options[dedSel!.selectedIndex].text },
				{ dimension: 'Morphological Diversity & Symptom Coverage', score: Number(shfSel!.value), note: shfSel!.options[shfSel!.selectedIndex].text }
			];
			const total = dims.reduce((acc, d) => acc + d.score, 0);
			const tier = total >= 8
				? 'Tier A: Field-Validated Representativeness'
				: total >= 5
					? 'Tier B: Partial Audit (Document Gaps)'
					: 'Tier C: Lab-Bound / High Deployment Risk';
			return {
				dataset: nameIn!.value.trim() || 'Unnamed Agricultural Dataset',
				scoreOutOf10: total,
				tier,
				dimensions: dims,
				standard: 'SAAIL Lab AgriAI Bias Card (DSA 2026)'
			};
		}

		function updateBiasBanner() {
			const data = getAuditData();
			banner!.className = data.scoreOutOf10 >= 8 ? 'calc-alert alert-ok' : 'calc-alert alert-warn';
			banner!.textContent = `AgriAI Audit Score: ${data.scoreOutOf10} / 10 (${data.tier})`;
		}

		[nameIn, geoSel, senSel, balSel, dedSel, shfSel].forEach((el) => {
			el.addEventListener('input', updateBiasBanner);
			el.addEventListener('change', updateBiasBanner);
		});
		updateBiasBanner();

		copyMdBtn?.addEventListener('click', async () => {
			const data = getAuditData();
			const md = [
				`# AgriAI Bias Card: ${data.dataset}`,
				`- **Audit Score:** ${data.scoreOutOf10} / 10 (${data.tier})`,
				`- **Framework:** ${data.standard}`,
				'',
				'| Dimension | Score (0-2) | Evidence Summary |',
				'| :--- | :--- | :--- |',
				...data.dimensions.map((d) => `| ${d.dimension} | ${d.score} / 2 | ${d.note} |`)
			].join('\n');
			let ok = false;
			try {
				await navigator.clipboard.writeText(md);
				ok = true;
			} catch (_e) {
				const area = document.createElement('textarea');
				area.value = md;
				area.style.position = 'fixed';
				area.style.opacity = '0';
				document.body.appendChild(area);
				area.select();
				try { ok = document.execCommand('copy'); } catch (_e2) {}
				document.body.removeChild(area);
			}
			if (ok) {
				copyMdBtn.textContent = 'Markdown Copied!';
				const liveEl = document.getElementById('saailLiveStatus');
				if (liveEl) {
					liveEl.textContent = '';
					requestAnimationFrame(() => { liveEl.textContent = 'AgriAI Bias Card Markdown copied to clipboard.'; });
				}
				setTimeout(() => { copyMdBtn.textContent = 'Copy Markdown Card'; }, 1600);
			}
		});

		dlJsonBtn?.addEventListener('click', () => {
			const data = getAuditData();
			const blob = new Blob([JSON.stringify(data, null, 2) + '\n'], { type: 'application/json;charset=utf-8' });
			const url = URL.createObjectURL(blob);
			const a = document.createElement('a');
			a.href = url;
			a.download = `${data.dataset.toLowerCase().replace(/[^a-z0-9]+/g, '-')}-agriai-bias-card.json`;
			document.body.appendChild(a);
			a.click();
			document.body.removeChild(a);
			URL.revokeObjectURL(url);
			const liveEl = document.getElementById('saailLiveStatus');
			if (liveEl) {
				liveEl.textContent = '';
				requestAnimationFrame(() => { liveEl.textContent = 'Downloaded AgriAI Bias Card JSON report.'; });
			}
		});
	})();
</script>

