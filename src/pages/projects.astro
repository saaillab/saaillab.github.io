---
import Layout from '../layouts/Layout.astro';
import ModernHeader from '../components/ModernHeader.astro';
import ModernFooter from '../components/ModernFooter.astro';

const projects = [
  {
    id: 'cropguard-ecosystem',
    category: 'agriculture',
    status: 'Flagship Series',
    title: 'CropGuard Research Ecosystem (Papers 1-6): Leak-Free Cross-Crop Leaf Diagnostics & Edge Distillation',
    summary:
      'Six-paper research program establishing UUID- and perceptual-hash deduplicated agricultural benchmarks (35,420 unique images across 8 crops and 38 classes, 80,238 duplicates purged), compact CNN-Transformer diagnostics (CropGuardNet: 481.6K params, 99.17% accuracy, 5.00 ms ONNX CPU), and INT8 distillation (CropKD-Net).',
    lead: 'Dr. Innocent Nyalala · IITMZ & WSDSAI',
    collaboration: 'IIT Madras Zanzibar & WSDSAI Chennai',
    tags: ['Computer Vision', 'Explainable AI', 'Edge Deployment', 'CropGuard Series'],
    projectPage: '/cropguard/',
    paperPage: '/papers/cropguardnet/',
    codeUrl: 'https://github.com/saaillab/CropGuardNet'
  },
  {
    id: 'dgs-bench',
    category: 'agriculture',
    status: 'Award Winner · DLI 2026',
    title: 'DGS-Bench: Measuring the Deployment Gap in African Agricultural AI Requires Balanced Metrics',
    summary:
      'Deployment Gap and Sensitivity Benchmark grounded in a multi-condition African cassava pathology case study, demonstrating why balanced per-class recall, F1, and calibration checks outperform aggregate accuracy under smallholder field shift. Awarded Best Poster at Deep Learning Indaba 2026 (18 accepted of 114 submissions).',
    lead: 'Dr. Innocent Nyalala · Surabhi Gudla · Patrick N. Vincent',
    collaboration: 'IIT Madras Zanzibar · Pan-Atlantic University Lagos',
    tags: ['Best Poster DLI 2026', 'Cassava Pathology', 'Balanced Metrics', 'Deployment Gap'],
    projectPage: '/papers/dgs-bench/',
    codeUrl: 'https://github.com/saaillab/dgs-bench'
  },
  {
    id: 'cloves-4603',
    category: 'agriculture',
    status: 'Published · CVPR 2026 V4A',
    title: 'ZSTC Cloves Grading & CLOVES-4603 Fine-Grained Spice Inspection',
    summary:
      'First public 4,603-image benchmark for Zanzibar clove quality grading across four commercial ZSTC grades (ResNet-50 99.67% Acc; classical texture-fusion SVM 92.94%) plus ZSTC-Clove-V1 (5,298 single-clove images, AI4EAC 2026).',
    lead: 'Patrick N. Vincent (MTech) · Dr. Innocent Nyalala',
    collaboration: 'Zanzibar State Trading Corporation (ZSTC) & IITMZ',
    tags: ['CVPR 2026 V4A', 'CLOVES-4603', 'ZSTC-Clove-V1', 'Smallholder Vision'],
    projectPage: '/papers/cloves-4603/',
    codeUrl: 'https://github.com/saaillab/CLOVES-4603'
  },
  {
    id: 'placentavision',
    category: 'healthcare',
    status: 'Active · International',
    title: 'PlacentaVision: Non-Invasive Placental Weight, Volume & Perfusion Estimation',
    summary:
      'AI-driven ultrasound and optical image analysis for early placental dysfunction detection and neonatal outcome estimation in maternal healthcare, developed in partnership with the PlacentaVision consortium.',
    lead: 'Twamaa Makame (MTech) · Dr. Innocent Nyalala',
    collaboration: 'Penn State University · Mnazi Mmoja Hospital Partners',
    tags: ['Maternal Healthcare', 'Medical Ultrasound', 'PlacentaVision'],
    projectPage: '/publications'
  },
  {
    id: 'cara-fm',
    category: 'responsible-ai',
    status: 'Best Poster · DLI 2025',
    title: 'CARA-FM & Trustworthy AI Governance Frameworks for Africa',
    summary:
      'Culturally grounded ethical principles (CARA-FM Framework, Best Poster Award at DLI 2025, PMLR Vol. 302) and socio-technical oversight protocols for trustworthy foundation models across agricultural advisory and healthcare triage (ICLR 2026 Workshop).',
    lead: 'Dr. Innocent Nyalala · Global Ethics Consortium',
    collaboration: 'IITMZ · WSDSAI · Multi-Institution Working Group',
    tags: ['ICLR 2026 Workshop', 'Best Poster DLI 2025', 'CARA-FM', 'Trustworthy AI'],
    projectPage: '/papers/trustworthy-ai-iclr2026/',
    codeUrl: 'https://github.com/saaillab/cara-fm'
  },
  {
    id: 'rutag-ecosystems',
    category: 'agriculture',
    status: 'Active Collaboration',
    title: 'Agricultural Data Ecosystems for High-Value Specialty Crops',
    summary:
      'Standardized field imaging and IoT telemetry pipelines for cloves, black pepper, cardamom, millets, and walnuts built with Rural Technology Action Group (RuTAG) IIT Madras to support smallholders across India and East Africa.',
    lead: 'SAAIL Lab Agri-Data Group',
    collaboration: 'RuTAG IIT Madras Chennai',
    tags: ['Agricultural Data', 'RuTAG', 'IoT Sensors', 'Smallholder Support'],
    projectPage: '/datasets'
  },
  {
    id: 'evision-assistive',
    category: 'healthcare',
    status: 'Completed MTech Thesis',
    title: 'E-Vision: Intelligent Assistive Spatial Navigation for the Visually Impaired',
    summary:
      'On-device depth and object-detection smartphone pipeline offering bilingual voice feedback for real-time obstacle avoidance and independence.',
    lead: 'Shivam Vyas (MTech) · Dr. Innocent Nyalala',
    collaboration: 'IIT Madras Zanzibar',
    tags: ['Assistive Tech', 'Edge Computer Vision', 'Accessibility'],
    projectPage: '/publications'
  },
  {
    id: 'preterm-birth-xai',
    category: 'healthcare',
    status: 'Completed MTech Thesis',
    title: 'Explainable Machine Learning for Preterm Birth Prediction from Metabolomics',
    summary:
      'Interpretable SHAP- and attention-guided tabular classification pipeline identifying maternal serum biomarkers associated with preterm delivery risk.',
    lead: 'Makame (MTech) · Dr. Innocent Nyalala',
    collaboration: 'IIT Madras Zanzibar',
    tags: ['Clinical XAI', 'Metabolomics', 'Maternal Health'],
    projectPage: '/publications'
  }
];
---

<Layout
  title="Research Projects | SAAIL Lab"
  description="Active and completed research initiatives at SAAIL Lab: CropGuardNet (Papers 1-6), DGS-Bench, CLOVES-4603, PlacentaVision, CARA-FM, RuTAG Agricultural Data Ecosystems, and E-Vision."
  canonical="https://saaillab.github.io/projects/"
>
  <ModernHeader currentPage="projects" />

  <main class="proj-main">
    <section class="proj-hero">
      <div class="proj-container">
        <span class="proj-eyebrow">APPLIED &amp; FOUNDATIONAL INITIATIVES</span>
        <h1>Lab Research Projects</h1>
        <p class="proj-lead">
          Each initiative connects empirical machine learning theory with real-world East African and South Asian field benchmarks across agriculture, clinical maternal care, and low-resource language technology.
        </p>
        <div class="proj-filters">
          <button type="button" class="filter-chip active" data-cat="all">All Projects ({projects.length})</button>
          <button type="button" class="filter-chip" data-cat="agriculture">AI for Agriculture</button>
          <button type="button" class="filter-chip" data-cat="healthcare">Healthcare &amp; Assistive</button>
          <button type="button" class="filter-chip" data-cat="responsible-ai">Responsible &amp; African AI</button>
        </div>
      </div>
    </section>

    <section class="proj-grid-band">
      <div class="proj-container">
        <div class="proj-grid" id="projectsGrid">
          {projects.map((p) => (
            <article class="proj-card" data-category={p.category}>
              <div class="proj-card-head">
                <span class="proj-cat">{p.category.replace('-', ' ')}</span>
                <span class="proj-status">{p.status}</span>
              </div>
              <h2>{p.title}</h2>
              <p class="proj-summary">{p.summary}</p>
              <div class="proj-meta">
                <div><strong>Lead:</strong> {p.lead}</div>
                <div><strong>Partners:</strong> {p.collaboration}</div>
              </div>
              <div class="proj-tags">
                {p.tags.map((t) => <span class="tag">{t}</span>)}
              </div>
              <div class="proj-actions">
                <a href={p.projectPage} class="p-btn p-btn-primary">Project Page &rarr;</a>
                {p.paperPage && <a href={p.paperPage} class="p-btn">Paper 1 Page</a>}
                {p.codeUrl && <a href={p.codeUrl} target="_blank" rel="noopener" class="p-btn">GitHub Code</a>}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>

  <script is:inline>
    (function () {
      const chips = Array.from(document.querySelectorAll('.filter-chip'));
      const cards = Array.from(document.querySelectorAll('.proj-card'));
      chips.forEach(function (chip) {
        chip.addEventListener('click', function () {
          chips.forEach(function (c) { c.classList.remove('active'); });
          chip.classList.add('active');
          const cat = chip.getAttribute('data-cat');
          cards.forEach(function (card) {
            card.style.display = (cat === 'all' || card.getAttribute('data-category') === cat) ? '' : 'none';
          });
        });
      });
    })();
  </script>

  <ModernFooter />
</Layout>

<style>
  .proj-main { background: var(--bg-primary, #ffffff); color: var(--text-primary); }
  .proj-container { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
  .proj-hero {
    padding: 4.5rem 0 2.5rem;
    text-align: center;
    background: radial-gradient(circle at top center, rgba(37, 99, 235, 0.08), transparent 60%);
    border-bottom: 1px solid var(--border-color, #e2e8f0);
  }
  .proj-eyebrow {
    font-size: 0.78rem;
    font-weight: 700;
    color: #2563eb;
    letter-spacing: 0.05em;
  }
  .proj-hero h1 { font-size: clamp(2rem, 4vw, 2.85rem); font-weight: 800; margin: 0.5rem 0 0.85rem; }
  .proj-lead { max-width: 740px; margin: 0 auto 1.75rem; color: var(--text-secondary); font-size: 1.05rem; }
  .proj-filters { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.55rem; }
  .filter-chip {
    padding: 0.48rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--border-color, #cbd5e1);
    background: var(--bg-card, #ffffff);
    color: var(--text-secondary);
    font-family: inherit;
    font-size: 0.86rem;
    font-weight: 600;
    cursor: pointer;
  }
  .filter-chip.active { background: #2563eb; border-color: #2563eb; color: #ffffff; }

  .proj-grid-band { padding: 3rem 0 4.5rem; }
  .proj-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 1.5rem;
  }
  .proj-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-card, #ffffff);
    border: 1px solid var(--border-color, #e2e8f0);
    border-radius: 16px;
    padding: 1.5rem;
  }
  .proj-card-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  .proj-cat {
    font-size: 0.74rem;
    font-weight: 800;
    text-transform: uppercase;
    color: #059669;
  }
  .proj-status {
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: #eff6ff;
    color: #1d4ed8;
    font-size: 0.72rem;
    font-weight: 700;
  }
  .proj-card h2 { margin: 0 0 0.7rem; font-size: 1.18rem; font-weight: 800; line-height: 1.38; }
  .proj-summary { margin: 0 0 1rem; font-size: 0.9rem; color: var(--text-secondary); line-height: 1.6; flex: 1; }
  .proj-meta {
    font-size: 0.82rem;
    color: var(--text-secondary);
    padding: 0.75rem;
    border-radius: 10px;
    background: var(--bg-secondary, #f8fafc);
    margin-bottom: 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .proj-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 1.1rem; }
  .tag {
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    background: var(--bg-secondary, #f8fafc);
    border: 1px solid var(--border-color, #e2e8f0);
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--text-muted);
  }
  .proj-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .p-btn {
    padding: 0.45rem 0.9rem;
    border-radius: 8px;
    border: 1px solid var(--border-color, #cbd5e1);
    background: var(--bg-secondary, #f8fafc);
    color: var(--text-primary);
    font-size: 0.84rem;
    font-weight: 600;
    text-decoration: none;
  }
  .p-btn:hover { border-color: #2563eb; color: #2563eb; }
  .p-btn-primary { background: #0f172a; border-color: #0f172a; color: #ffffff; }
  .p-btn-primary:hover { background: #2563eb; border-color: #2563eb; color: #ffffff; }
</style>
