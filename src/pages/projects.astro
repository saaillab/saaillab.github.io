---
import Layout from '../layouts/Layout.astro';
import ModernHeader from '../components/ModernHeader.astro';
import ModernFooter from '../components/ModernFooter.astro';
import { PROJECTS } from '../data/projects';
---

<Layout
	title="AI Projects & Grants in Zanzibar | SAAIL Lab · IIT Madras Zanzibar"
	description="Active AI, deep learning, agricultural computer vision, Swahili NLP, and healthcare ML research programs led by Innocent Nyalala at SAAIL Lab, IIT Madras Zanzibar, Tanzania and East Africa."
	canonical="https://saaillab.github.io/projects/"
>
	<ModernHeader currentPage="research" />

	<main id="main-content">
		<section class="page-hero">
			<div class="container">
				<span class="page-eyebrow">Funded Initiatives &amp; Dedicated Project Sites · Zanzibar, Tanzania</span>
				<h1 class="page-title">Active AI Projects &amp; Grants</h1>
				<p class="page-lead">
					Every major SAAIL Lab research program at IIT Madras Zanzibar maintains a dedicated project site documenting partner institutions, open East African datasets, deep learning pipelines, and peer-reviewed outputs.
				</p>
			</div>
		</section>

		<section class="section">
			<div class="container">
				<div class="projects-grid">
					{PROJECTS.map((proj) => (
						<article class="project-card">
							<a href={`/projects/${proj.slug}/`} class="card-thumb-link" tabindex="-1" aria-hidden="true">
								<img src={proj.heroImage} alt={proj.heroAlt} class="card-thumb" loading="lazy" />
							</a>
							<div class="card-body">
								<div class="card-top">
									<span class="pillar-badge">{proj.pillar}</span>
									<span class="badge-note">{proj.badge}</span>
								</div>
								<h2>
									<a href={`/projects/${proj.slug}/`}>{proj.title}</a>
								</h2>
								<p class="card-summary">{proj.summary}</p>
								<div class="card-meta">
									<div><strong>Lead:</strong> {proj.lead}</div>
									{proj.team.length > 0 && (
										<div><strong>Team:</strong> {proj.team.slice(0, 5).join(', ')}{proj.team.length > 5 ? ` (+${proj.team.length - 5})` : ''}</div>
									)}
								</div>
								<div class="card-actions">
									<a href={`/projects/${proj.slug}/`} class="btn btn-primary">Open Project Website &rarr;</a>
									{proj.githubUrl && (
										<a href={proj.githubUrl} target="_blank" rel="noopener" class="btn btn-secondary">GitHub ↗</a>
									)}
								</div>
							</div>
						</article>
					))}
				</div>
			</div>
		</section>
	</main>

	<ModernFooter />
</Layout>

<style>
	.projects-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 2rem;
	}

	.project-card {
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		border-radius: 1.15rem;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		box-shadow: 0 6px 20px var(--shadow-light);
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.project-card:hover {
		transform: translateY(-3px);
		box-shadow: 0 12px 28px var(--shadow-medium);
	}

	.card-thumb-link {
		display: block;
		background: #ffffff;
		border-bottom: 1px solid var(--border-color);
		height: 240px;
		padding: 0.5rem;
		overflow: hidden;
	}

	.card-thumb-link:focus-visible {
		outline: 2px solid #14532d;
		outline-offset: -3px;
	}

	.card-thumb {
		width: 100%;
		height: 100%;
		object-fit: contain;
		object-position: center;
		display: block;
	}

	.card-body {
		padding: 1.65rem;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		flex: 1;
	}

	.card-top {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.pillar-badge {
		font-size: 0.72rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		padding: 0.22rem 0.65rem;
		border-radius: 999px;
		background: #ecfdf5;
		color: #14532d;
	}

	.badge-note {
		font-size: 0.76rem;
		font-weight: 700;
		color: var(--accent-gold);
	}

	.project-card h2 {
		font-size: 1.25rem;
		line-height: 1.32;
	}

	.project-card h2 a {
		color: var(--text-primary);
		text-decoration: none;
	}

	.project-card h2 a:hover { color: var(--accent-primary); }

	.card-summary {
		font-size: 0.94rem;
		color: var(--text-secondary);
		line-height: 1.65;
		flex: 1;
	}

	.card-meta {
		background: var(--bg-secondary);
		border: 1px solid var(--border-color);
		border-radius: 0.75rem;
		padding: 0.85rem 1rem;
		font-size: 0.84rem;
		color: var(--text-secondary);
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.card-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		padding-top: 0.35rem;
	}

	@media (max-width: 900px) {
		.projects-grid { grid-template-columns: 1fr; }
	}
</style>
