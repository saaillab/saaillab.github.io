---
import Layout from '../layouts/Layout.astro';
import ModernHeader from '../components/ModernHeader.astro';
import ModernFooter from '../components/ModernFooter.astro';
import metrics from '../data/scholar-metrics.json';
import { PUBLICATIONS } from '../data/publications';
import { publicationToRis } from '../utils/citations';

const saailPubs = PUBLICATIONS.filter((p) => p.isSaailLab !== false).sort((a, b) => {
	if (a.slug === 'cropguardnet') return -1;
	if (b.slug === 'cropguardnet') return 1;
	if (b.year !== a.year) return b.year - a.year;
	return b.dateISO.localeCompare(a.dateISO);
});

const publishedCount = saailPubs.filter((p) => p.category !== 'preprint').length;
const underReviewCount = saailPubs.filter((p) => p.category === 'preprint').length;
const totalWorks = saailPubs.length || 1;
const count2026 = saailPubs.filter((p) => p.year === 2026).length;
const count2025 = saailPubs.filter((p) => p.year === 2025).length;
const countJournals = saailPubs.filter((p) => p.category === 'journal').length;
const countConfWksp = saailPubs.filter((p) => p.category === 'conference' || p.category === 'workshop').length;
const countClinical = saailPubs.filter((p) =>
	p.topics.some((t) => /medical|health|polyp/i.test(t))
).length;
const countAgri = saailPubs.filter(
	(p) =>
		!p.topics.some((t) => /medical|health|polyp/i.test(t)) &&
		p.topics.some((t) => /agriculture|clove|cassava/i.test(t))
).length;
const countPolicy = Math.max(0, saailPubs.length - countClinical - countAgri);

const allBibBundle = saailPubs.map((p) => p.bibtex.trim()).join('\n\n');
const allRisBundle = saailPubs.map((p) => publicationToRis(p)).join('\r\n\r\n');
---

<Layout
	title="AI Publications from Zanzibar | SAAIL Lab · IIT Madras Zanzibar"
	description="Peer-reviewed AI, deep learning, computer vision, agricultural AI, Swahili NLP, and healthcare ML publications authored at SAAIL Lab (IIT Madras Zanzibar, 2024–present)."
	canonical="https://saaillab.github.io/publications/"
>
	<ModernHeader currentPage="publications" />

	<main id="main-content">
		<section class="page-hero">
			<div class="container">
				<span class="page-eyebrow" data-i18n="pubs.eyebrow">Scholarly Record · Zanzibar &amp; East Africa AI</span>
				<h1 class="page-title" data-i18n="pubs.title">SAAIL Lab Publications</h1>
				<p class="page-lead" data-i18n="pubs.lead">
					Peer-reviewed journal articles, conference papers, and manuscripts authored at SAAIL Lab (IIT Madras Zanzibar, 2025 to Present), covering deep learning for agriculture, computer vision, Responsible AI, Swahili NLP, AI Policy, and clinical machine learning.
				</p>

				<div class="metrics-strip">
					<div class="m-chip"><strong>{publishedCount}</strong><span>SAAIL Published / Conf.</span></div>
					<div class="m-chip"><strong>{underReviewCount}</strong><span>Under Peer Review</span></div>
					<div class="m-chip">
						<strong>{metrics.citations.toLocaleString()}</strong>
						<span>PI Career Citations (h-index {metrics.hIndex})</span>
					</div>
				</div>
			</div>
		</section>

		<!-- Primary Section: SAAIL Lab Publications -->
		<section class="section">
			<div class="container">
				<h2 class="sr-only" data-i18n="pubs.analytics_heading">Publication Analytics</h2>
				<div class="pub-analytics" aria-label="SAAIL Lab Publications Distribution">
					<div class="ana-card">
						<h3>By Publication Year</h3>
						<div class="ana-row">
							<span>2026 Outputs</span><strong>{count2026}</strong>
							<div class="ana-track"><div class="ana-fill" style={`width:${Math.round((count2026 / totalWorks) * 100)}%`}></div></div>
						</div>
						<div class="ana-row">
							<span>2025 Outputs</span><strong>{count2025}</strong>
							<div class="ana-track"><div class="ana-fill" style={`width:${Math.round((count2025 / totalWorks) * 100)}%`}></div></div>
						</div>
					</div>
					<div class="ana-card">
						<h3>By Venue Tier</h3>
						<div class="ana-row">
							<span>Peer-Reviewed Journals</span><strong>{countJournals}</strong>
							<div class="ana-track"><div class="ana-fill" style={`width:${Math.round((countJournals / totalWorks) * 100)}%`}></div></div>
						</div>
						<div class="ana-row">
							<span>Conferences &amp; Workshops</span><strong>{countConfWksp}</strong>
							<div class="ana-track"><div class="ana-fill" style={`width:${Math.round((countConfWksp / totalWorks) * 100)}%`}></div></div>
						</div>
						<div class="ana-row">
							<span>Under Peer Review</span><strong>{underReviewCount}</strong>
							<div class="ana-track"><div class="ana-fill" style={`width:${Math.round((underReviewCount / totalWorks) * 100)}%`}></div></div>
						</div>
					</div>
					<div class="ana-card">
						<h3>By Primary Research Track</h3>
						<div class="ana-row">
							<span>Agriculture &amp; Food Systems AI</span><strong>{countAgri}</strong>
							<div class="ana-track"><div class="ana-fill" style={`width:${Math.round((countAgri / totalWorks) * 100)}%`}></div></div>
						</div>
						<div class="ana-row">
							<span>AI Policy, Safety &amp; Sovereignty</span><strong>{countPolicy}</strong>
							<div class="ana-track"><div class="ana-fill" style={`width:${Math.round((countPolicy / totalWorks) * 100)}%`}></div></div>
						</div>
						<div class="ana-row">
							<span>Clinical &amp; Biomedical AI</span><strong>{countClinical}</strong>
							<div class="ana-track"><div class="ana-fill" style={`width:${Math.round((countClinical / totalWorks) * 100)}%`}></div></div>
						</div>
					</div>
				</div>

				<div class="controls-bar">
					<div class="filter-tabs" role="tablist" aria-label="Filter SAAIL Lab publications">
						<button type="button" role="tab" aria-selected="true" aria-controls="saailList" tabindex="0" class="tab-btn is-active" data-filter="all">All SAAIL Lab ({saailPubs.length})</button>
						<button type="button" role="tab" aria-selected="false" aria-controls="saailList" tabindex="-1" class="tab-btn" data-filter="published">Published ({publishedCount})</button>
						<button type="button" role="tab" aria-selected="false" aria-controls="saailList" tabindex="-1" class="tab-btn" data-filter="preprint">Under Review ({underReviewCount})</button>
						<button type="button" role="tab" aria-selected="false" aria-controls="saailList" tabindex="-1" class="tab-btn" data-filter="policy">Responsible AI, Policy &amp; GovTech</button>
						<button type="button" role="tab" aria-selected="false" aria-controls="saailList" tabindex="-1" class="tab-btn" data-filter="agri">Agriculture &amp; Vision</button>
					</div>

					<div class="pub-bulk-controls">
						<input
							id="pubSearch"
							type="search"
							placeholder="Search title, year, author, DOI, keyword..."
							aria-label="Search SAAIL Lab publications"
							class="search-input"
						/>
						<select id="pubSort" aria-label="Sort SAAIL Lab publications" class="sort-select">
							<option value="default">Sort: Flagship &amp; Newest</option>
							<option value="year">Sort: Newest Year First</option>
							<option value="journal">Sort: Peer-Reviewed Journals First</option>
						</select>
						<button type="button" id="copyPubFilterUrlBtn" class="act-btn bulk-btn">Copy Filter Link</button>
						<button type="button" id="downloadAllBibBtn" class="act-btn bulk-btn">Download All 20 (.bib)</button>
						<button type="button" id="downloadAllRisBtn" class="act-btn bulk-btn">Download All 20 (.ris)</button>
					</div>
				</div>
				<pre id="allBibBundle" hidden>{allBibBundle}</pre>
				<pre id="allRisBundle" hidden>{allRisBundle}</pre>

				<div class="result-count" id="resultCount" aria-live="polite">Showing {saailPubs.length} of {saailPubs.length} SAAIL Lab works</div>

				<div class="pubs-list" id="saailList">
					{saailPubs.map((pub, pubIdx) => {
						const isUnderReview = pub.category === 'preprint';
						const cleanDoi = pub.doi ? pub.doi.replace(/^https?:\/\/(dx\.)?doi\.org\//i, '').trim() : '';
						const doiHref = cleanDoi ? `https://doi.org/${cleanDoi}` : '';
						const isPolicy = pub.topics.some((t) =>
							t.toLowerCase().includes('policy') || t.toLowerCase().includes('responsible') || t.toLowerCase().includes('govtech')
						);
						const isAgri = pub.topics.some((t) =>
							t.toLowerCase().includes('agriculture') || t.toLowerCase().includes('clove') || t.toLowerCase().includes('cassava')
						);
						const searchText = [
							String(pub.year),
							pub.venueShort,
							pub.award || '',
							pub.title,
							isUnderReview ? 'under review manuscript' : pub.venue,
							pub.authors.map((a) => a.name).join(' '),
							pub.keywords.join(' '),
							pub.topics.join(' '),
							cleanDoi,
							pub.tldr
						].join(' ').toLowerCase();

						return (
							<article
								class="pub-item"
								data-status={isUnderReview ? 'preprint' : 'published'}
								data-category={pub.category}
								data-year={pub.year}
								data-date={pub.dateISO}
								data-orig-idx={pubIdx}
								data-policy={isPolicy ? 'yes' : 'no'}
								data-agri={isAgri ? 'yes' : 'no'}
								data-search={searchText}
							>
								<div class="saail-row-grid">
									<div class="saail-meta-col">
										<span class="badge-year">{pub.year}</span>
										<span class={isUnderReview ? 'badge-review' : 'badge-venue'}>
											{isUnderReview ? 'Under Peer Review' : pub.venueShort}
										</span>
										{pub.award && <span class="badge-award">{pub.award}</span>}
									</div>

									<div class="saail-main-col">
										<h2 class="pub-title">
											<a href={`/papers/${pub.slug}/`}>{pub.title}</a>
										</h2>

										<p class="pub-authors">
											{pub.authors.map((a, i) => (
												<>
													{a.name === 'Innocent Nyalala' ? (
														<strong class="pi-name">{a.name}</strong>
													) : (
														<span>{a.name}</span>
													)}
													{i < pub.authors.length - 1 ? ', ' : ''}
												</>
											))}
										</p>
										<p class="pub-venue-line">
											{isUnderReview ? `Manuscript Under Peer Review (${pub.year})` : `${pub.venue} (${pub.month} ${pub.year})`}
											{!isUnderReview && pub.impactFactor ? ` · ${pub.impactFactor}` : ''}
											{typeof pub.citations === 'number' && pub.citations > 0 ? ` · ${pub.citations} ${pub.citations === 1 ? 'Citation' : 'Citations'}` : ''}
										</p>
										<p class="pub-tldr">{pub.tldr}</p>
									</div>

									<div class="pub-actions">
										<a href={`/papers/${pub.slug}/`} class="act-btn act-primary">Summary &amp; Results &rarr;</a>
										{!isUnderReview && doiHref && (
											<a href={doiHref} target="_blank" rel="noopener" class="act-btn">
												DOI ↗
											</a>
										)}
										{!isUnderReview && pub.paperUrl && pub.paperUrl !== doiHref && (
											<a href={pub.paperUrl} target="_blank" rel="noopener" class="act-btn">Paper ↗</a>
										)}
										{pub.codeUrl && (
											<a href={pub.codeUrl} target="_blank" rel="noopener" class="act-btn">Code ↗</a>
										)}
										{pub.posterUrl && (
											<a href={pub.posterUrl} target="_blank" rel="noopener" class="act-btn">Poster ↗</a>
										)}
										<button type="button" class="act-btn copy-bib-inline" data-orig-label="Copy BibTeX" data-bib-code={`code-${pub.slug}`}>Copy BibTeX</button>
										<button type="button" class="act-btn copy-ris-inline" data-orig-label="Copy RIS" data-ris-code={`ris-${pub.slug}`}>Copy RIS</button>
										<button type="button" class="act-btn download-bib-btn" data-slug={pub.slug} data-bib-code={`code-${pub.slug}`}>Download .bib</button>
										<button type="button" class="act-btn bib-toggle-btn" aria-expanded="false" aria-controls={`bib-${pub.slug}`} data-bib-target={`bib-${pub.slug}`}>Preview</button>
									</div>
								</div>

								<div id={`bib-${pub.slug}`} class="bib-drawer" hidden>
									<div class="bib-drawer-top">
										<span>BibTeX &amp; Reference Export</span>
										<div class="bib-drawer-actions">
											<button type="button" class="copy-bib-inline" data-orig-label="Copy" data-bib-code={`code-${pub.slug}`}>Copy</button>
											<button type="button" class="copy-ris-inline" data-orig-label="Copy RIS" data-ris-code={`ris-${pub.slug}`}>Copy RIS</button>
											<button type="button" class="download-bib-btn drawer-action-btn" data-slug={pub.slug} data-bib-code={`code-${pub.slug}`}>Download .bib</button>
										</div>
									</div>
									<pre><code id={`code-${pub.slug}`}>{pub.bibtex}</code></pre>
									<pre id={`ris-${pub.slug}`} hidden>{publicationToRis(pub)}</pre>
								</div>
							</article>
						);
					})}
					<div id="noPubResults" class="no-pub-results" hidden>
						No SAAIL Lab works match the selected filter and search terms.
					</div>
				</div>
			</div>
		</section>

		<!-- Clean Personal Archive Pointer for Pre-IITMZ Publications & Theses -->
		<section class="section prior-band" id="prior-works">
			<div class="container">
				<div class="prior-callout">
					<div>
						<span class="page-eyebrow">PI Personal Archive &middot; Pre-SAAIL Lab (2015&ndash;2024)</span>
						<h2>Earlier Publications &amp; Academic Theses</h2>
						<p>
							Journal papers and Nanjing Agricultural University theses published by Innocent Nyalala prior to founding SAAIL Lab at IIT Madras Zanzibar in October 2024 are maintained on his personal site at <a href="https://inyalala.github.io/publications/" target="_blank" rel="noopener">inyalala.github.io/publications</a>.
						</p>
					</div>
					<a href="https://inyalala.github.io/publications/" target="_blank" rel="noopener" class="btn btn-secondary prior-cta">View Personal Archive &#8599;</a>
				</div>
			</div>
		</section>
	</main>

	<ModernFooter />
</Layout>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const tabs = document.querySelectorAll('.tab-btn');
		const searchInput = document.getElementById('pubSearch') as HTMLInputElement | null;
		const items = Array.from(document.querySelectorAll('#saailList .pub-item')) as HTMLElement[];
		const countEl = document.getElementById('resultCount');
		const emptyEl = document.getElementById('noPubResults');
		const listEl = document.getElementById('saailList');
		const sortSelect = document.getElementById('pubSort') as HTMLSelectElement | null;
		const copyFilterUrlBtn = document.getElementById('copyPubFilterUrlBtn') as HTMLButtonElement | null;
		const urlParams = new URLSearchParams(window.location.search);

		let activeFilter = urlParams.get('filter') || 'all';
		const validFilters = new Set(['all', 'published', 'preprint', 'policy', 'agri']);
		if (!validFilters.has(activeFilter)) activeFilter = 'all';

		if (searchInput && urlParams.get('q')) {
			searchInput.value = urlParams.get('q') || '';
		}
		if (sortSelect && urlParams.get('sort')) {
			const s = urlParams.get('sort') || 'default';
			if (['default', 'year', 'journal'].includes(s)) sortSelect.value = s;
		}

		tabs.forEach((t) => {
			const match = (t.getAttribute('data-filter') || 'all') === activeFilter;
			t.classList.toggle('is-active', match);
			t.setAttribute('aria-selected', String(match));
			t.setAttribute('tabindex', match ? '0' : '-1');
		});

		function syncUrlState() {
			const params = new URLSearchParams();
			if (activeFilter !== 'all') params.set('filter', activeFilter);
			const qVal = searchInput?.value.trim() || '';
			if (qVal) params.set('q', qVal);
			const sortVal = sortSelect?.value || 'default';
			if (sortVal !== 'default') params.set('sort', sortVal);
			const qs = params.toString();
			const target = qs ? `${window.location.pathname}?${qs}${window.location.hash}` : `${window.location.pathname}${window.location.hash}`;
			window.history.replaceState(null, '', target);
		}

		function applySort() {
			if (!listEl) return;
			const mode = sortSelect?.value || 'default';
			const sorted = Array.from(items).sort((a, b) => {
				if (mode === 'year') {
					const dy = Number(b.getAttribute('data-year') || 0) - Number(a.getAttribute('data-year') || 0);
					if (dy !== 0) return dy;
					return String(b.getAttribute('data-date') || '').localeCompare(String(a.getAttribute('data-date') || ''));
				}
				if (mode === 'journal') {
					const ja = a.getAttribute('data-category') === 'journal' ? 0 : 1;
					const jb = b.getAttribute('data-category') === 'journal' ? 0 : 1;
					if (ja !== jb) return ja - jb;
				}
				return Number(a.getAttribute('data-orig-idx') || 0) - Number(b.getAttribute('data-orig-idx') || 0);
			});
			sorted.forEach((node) => listEl.appendChild(node));
		}

		function applyFilter() {
			applySort();
			const q = (searchInput?.value || '').trim().toLowerCase();
			let lastVisible: HTMLElement | null = null;
			let shown = 0;

			Array.from(listEl?.querySelectorAll('.pub-item') || items).forEach((item) => {
				item.classList.remove('is-last-visible');
				const st = item.getAttribute('data-status') || '';
				const pol = item.getAttribute('data-policy') === 'yes';
				const agr = item.getAttribute('data-agri') === 'yes';
				const hay = item.getAttribute('data-search') || '';

				let fOk = true;
				if (activeFilter === 'published') fOk = st === 'published';
				else if (activeFilter === 'preprint') fOk = st === 'preprint';
				else if (activeFilter === 'policy') fOk = pol;
				else if (activeFilter === 'agri') fOk = agr;

				const qOk = !q || hay.includes(q);
				const vis = fOk && qOk;
				(item as HTMLElement).style.display = vis ? 'block' : 'none';
				if (vis) {
					shown++;
					lastVisible = item as HTMLElement;
				}
			});

			if (lastVisible) {
				(lastVisible as HTMLElement).classList.add('is-last-visible');
			}
			if (emptyEl) {
				emptyEl.hidden = shown > 0;
			}

			if (countEl) {
				const nextText = `Showing ${shown} of ${items.length} SAAIL Lab works`;
				if (countEl.textContent !== nextText) {
					countEl.textContent = nextText;
				}
			}
			syncUrlState();
		}

		tabs.forEach((tab, idx) => {
			tab.addEventListener('click', () => {
				tabs.forEach((t) => {
					t.classList.remove('is-active');
					t.setAttribute('aria-selected', 'false');
					t.setAttribute('tabindex', '-1');
				});
				tab.classList.add('is-active');
				tab.setAttribute('aria-selected', 'true');
				tab.setAttribute('tabindex', '0');
				activeFilter = tab.getAttribute('data-filter') || 'all';
				applyFilter();
			});
			tab.addEventListener('keydown', (e: Event) => {
				const ke = e as KeyboardEvent;
				let nextIdx: number | null = null;
				if (ke.key === 'ArrowRight') nextIdx = (idx + 1) % tabs.length;
				else if (ke.key === 'ArrowLeft') nextIdx = (idx - 1 + tabs.length) % tabs.length;
				else if (ke.key === 'Home') nextIdx = 0;
				else if (ke.key === 'End') nextIdx = tabs.length - 1;
				if (nextIdx === null) return;
				ke.preventDefault();
				const nextTab = tabs[nextIdx] as HTMLElement;
				nextTab.focus();
				nextTab.click();
			});
		});

		applyFilter();

		searchInput?.addEventListener('input', applyFilter);
		sortSelect?.addEventListener('change', applyFilter);
		copyFilterUrlBtn?.addEventListener('click', async () => {
			syncUrlState();
			const url = window.location.href;
			let copied = false;
			try {
				await navigator.clipboard.writeText(url);
				copied = true;
			} catch (_e) {
				const area = document.createElement('textarea');
				area.value = url;
				area.style.position = 'fixed';
				area.style.opacity = '0';
				document.body.appendChild(area);
				area.select();
				try { copied = document.execCommand('copy'); } catch (_e2) {}
				document.body.removeChild(area);
			}
			if (copied) {
				const orig = 'Copy Filter Link';
				copyFilterUrlBtn.textContent = 'Link Copied!';
				const liveEl = document.getElementById('saailLiveStatus');
				if (liveEl) {
					liveEl.textContent = '';
					requestAnimationFrame(() => { liveEl.textContent = 'Shareable publications filter URL copied to clipboard.'; });
				}
				setTimeout(() => { copyFilterUrlBtn.textContent = orig; }, 1600);
			}
		});

		document.querySelectorAll('.bib-toggle-btn').forEach((btn) => {
			btn.addEventListener('click', () => {
				const id = btn.getAttribute('data-bib-target') || '';
				const drawer = document.getElementById(id);
				if (drawer) {
					drawer.hidden = !drawer.hidden;
					btn.setAttribute('aria-expanded', String(!drawer.hidden));
				}
			});
		});

		document.querySelectorAll('.copy-bib-inline').forEach((btn) => {
			btn.addEventListener('click', async () => {
				const id = btn.getAttribute('data-bib-code') || '';
				const codeEl = document.getElementById(id);
				const txt = codeEl?.textContent?.trim() || '';
				if (!txt) return;
				let copied = false;
				try {
					await navigator.clipboard.writeText(txt);
					copied = true;
				} catch (_err) {
					const area = document.createElement('textarea');
					area.value = txt;
					area.style.position = 'fixed';
					area.style.opacity = '0';
					document.body.appendChild(area);
					area.select();
					try { copied = document.execCommand('copy'); } catch (_e2) {}
					document.body.removeChild(area);
				}
				if (copied) {
					const orig = btn.getAttribute('data-orig-label') || 'Copy';
					btn.textContent = 'Copied!';
					const liveEl = document.getElementById('saailLiveStatus');
					if (liveEl) {
						liveEl.textContent = '';
						requestAnimationFrame(() => { liveEl.textContent = 'BibTeX citation copied to clipboard.'; });
					}
					setTimeout(() => { btn.textContent = orig; }, 1600);
				}
			});
		});

		document.querySelectorAll('.copy-ris-inline').forEach((btn) => {
			btn.addEventListener('click', async () => {
				const id = btn.getAttribute('data-ris-code') || '';
				const codeEl = document.getElementById(id);
				const txt = codeEl?.textContent?.trim() || '';
				if (!txt) return;
				let copied = false;
				try {
					await navigator.clipboard.writeText(txt);
					copied = true;
				} catch (_err) {
					const area = document.createElement('textarea');
					area.value = txt;
					area.style.position = 'fixed';
					area.style.opacity = '0';
					document.body.appendChild(area);
					area.select();
					try { copied = document.execCommand('copy'); } catch (_e2) {}
					document.body.removeChild(area);
				}
				if (copied) {
					const orig = btn.getAttribute('data-orig-label') || 'Copy RIS';
					btn.textContent = 'Copied!';
					const liveEl = document.getElementById('saailLiveStatus');
					if (liveEl) {
						liveEl.textContent = '';
						requestAnimationFrame(() => { liveEl.textContent = 'RIS citation copied to clipboard.'; });
					}
					setTimeout(() => { btn.textContent = orig; }, 1600);
				}
			});
		});

		document.querySelectorAll('.download-bib-btn').forEach((btn) => {
			btn.addEventListener('click', () => {
				const slug = btn.getAttribute('data-slug') || 'saail-paper';
				const id = btn.getAttribute('data-bib-code') || '';
				const codeEl = document.getElementById(id);
				const txt = codeEl?.textContent?.trim() || '';
				if (!txt) return;
				const blob = new Blob([txt + '\n'], { type: 'application/x-bibtex;charset=utf-8' });
				const url = URL.createObjectURL(blob);
				const link = document.createElement('a');
				link.href = url;
				link.download = `${slug}.bib`;
				document.body.appendChild(link);
				link.click();
				document.body.removeChild(link);
				setTimeout(() => URL.revokeObjectURL(url), 1000);
				const liveEl = document.getElementById('saailLiveStatus');
				if (liveEl) {
					liveEl.textContent = '';
					requestAnimationFrame(() => { liveEl.textContent = `Downloaded ${slug}.bib.`; });
				}
			});
		});

		function triggerBundleDownload(sourceId: string, filename: string, mime: string) {
			const el = document.getElementById(sourceId);
			const txt = el?.textContent?.trim() || '';
			if (!txt) return;
			const blob = new Blob([txt + '\n'], { type: `${mime};charset=utf-8` });
			const url = URL.createObjectURL(blob);
			const link = document.createElement('a');
			link.href = url;
			link.download = filename;
			document.body.appendChild(link);
			link.click();
			document.body.removeChild(link);
			setTimeout(() => URL.revokeObjectURL(url), 1000);
			const liveEl = document.getElementById('saailLiveStatus');
			if (liveEl) {
				liveEl.textContent = '';
				requestAnimationFrame(() => { liveEl.textContent = `Downloaded ${filename} containing all 20 publications.`; });
			}
		}

		document.getElementById('downloadAllBibBtn')?.addEventListener('click', () => {
			triggerBundleDownload('allBibBundle', 'saail-lab-publications-2025-2026.bib', 'application/x-bibtex');
		});
		document.getElementById('downloadAllRisBtn')?.addEventListener('click', () => {
			triggerBundleDownload('allRisBundle', 'saail-lab-publications-2025-2026.ris', 'application/x-research-info-systems');
		});
	});
</script>

