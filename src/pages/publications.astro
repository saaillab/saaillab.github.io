---
import Layout from '../layouts/Layout.astro';
import ModernHeader from '../components/ModernHeader.astro';
import ModernFooter from '../components/ModernFooter.astro';
---

<Layout
	title="Publications - SAAIL Lab"
	description="Explore our research publications, academic papers, and scholarly contributions in AI for agriculture, healthcare, and responsible AI at SAAIL Lab, IIT Madras Zanzibar."
>
	<ModernHeader />

	<main class="publications-page">
		<section class="publications-hero">
			<div class="container">
				<div class="hero-content">
					<h1>Research Output</h1>
					<p class="hero-description">
						Our research advances AI for agriculture, healthcare, and digital sovereignty across East Africa and the Global South.
					</p>

					<div class="research-metrics">
						<div class="metric-card">
							<span class="metric-number">17</span>
							<span class="metric-label">Publications</span>
						</div>
						<div class="metric-card">
							<span class="metric-number">994</span>
							<span class="metric-label">Citations</span>
						</div>
						<div class="metric-card">
							<span class="metric-number">14</span>
							<span class="metric-label">h-index</span>
						</div>
						<div class="metric-card">
							<span class="metric-number">15</span>
							<span class="metric-label">i10-index</span>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="publications-list">
			<div class="container">
				<!-- Filter and Search Controls -->
				<div class="filter-controls">
					<div class="search-bar">
						<svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor">
							<circle cx="11" cy="11" r="8" stroke-width="2"/>
							<path d="M21 21L16.65 16.65" stroke-width="2" stroke-linecap="round"/>
						</svg>
						<input
							type="text"
							id="search-input"
							placeholder="Search publications by title, author, or keywords..."
							aria-label="Search publications"
						/>
					</div>

					<div class="filter-row">
						<div class="filter-group">
							<label for="type-filter">Type:</label>
							<select id="type-filter" aria-label="Filter by publication type">
								<option value="all">All Types</option>
								<option value="journal">Journal Articles</option>
								<option value="conference">Conferences</option>
								<option value="invited">Invited Talks</option>
							</select>
						</div>

						<div class="filter-group">
							<label for="year-filter">Year:</label>
							<select id="year-filter" aria-label="Filter by year">
								<option value="all">All Years</option>
								<option value="2026">2026</option>
								<option value="2025">2025</option>
							</select>
						</div>

						<div class="filter-group">
							<label for="topic-filter">Topic:</label>
							<select id="topic-filter" aria-label="Filter by topic">
								<option value="all">All Topics</option>
								<option value="AI Sovereignty">AI Sovereignty</option>
								<option value="Digital Sovereignty">Digital Sovereignty</option>
								<option value="Responsible AI">Responsible AI</option>
								<option value="Agriculture">Agriculture</option>
								<option value="Healthcare">Healthcare</option>
								<option value="Medical Imaging">Medical Imaging</option>
								<option value="Deep Learning">Deep Learning</option>
								<option value="Policy">Policy</option>
								<option value="Global South">Global South</option>
								<option value="Foundation Models">Foundation Models</option>
								<option value="Fraud Detection">Fraud Detection</option>
								<option value="Cybersecurity">Cybersecurity</option>
								<option value="Solar Energy">Solar Energy</option>
								<option value="Cassava">Cassava</option>
								<option value="Benchmarking">Benchmarking</option>
								<option value="Zanzibar">Zanzibar</option>
								<option value="East Africa">East Africa</option>
							</select>
						</div>

						<button id="reset-filters" class="reset-btn" aria-label="Reset all filters">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/>
								<path d="M21 3v5h-5"/>
								<path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/>
								<path d="M3 21v-5h5"/>
							</svg>
							Reset
						</button>
					</div>

					<div class="action-row">
						<div class="view-toggle">
							<button id="list-view-btn" class="view-btn active" aria-label="List view">
								<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<line x1="8" y1="6" x2="21" y2="6"/>
									<line x1="8" y1="12" x2="21" y2="12"/>
									<line x1="8" y1="18" x2="21" y2="18"/>
									<line x1="3" y1="6" x2="3.01" y2="6"/>
									<line x1="3" y1="12" x2="3.01" y2="12"/>
									<line x1="3" y1="18" x2="3.01" y2="18"/>
								</svg>
								List
							</button>
							<button id="grid-view-btn" class="view-btn" aria-label="Grid view">
								<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<rect x="3" y="3" width="7" height="7"/>
									<rect x="14" y="3" width="7" height="7"/>
									<rect x="14" y="14" width="7" height="7"/>
									<rect x="3" y="14" width="7" height="7"/>
								</svg>
								Grid
							</button>
						</div>

						<div class="export-actions">
							<button id="export-bibtex" class="export-btn" aria-label="Export all as BibTeX">
								<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
									<polyline points="7 10 12 15 17 10"/>
									<line x1="12" y1="15" x2="12" y2="3"/>
								</svg>
								Export BibTeX
							</button>
							<button id="export-apa" class="export-btn" aria-label="Export all as APA">
								<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
									<polyline points="7 10 12 15 17 10"/>
									<line x1="12" y1="15" x2="12" y2="3"/>
								</svg>
								Export APA
							</button>
						</div>
					</div>

					<div id="results-count" class="results-count"></div>
				</div>

