---
import Layout from '../layouts/Layout.astro';
import ModernHeader from '../components/ModernHeader.astro';
import ModernFooter from '../components/ModernFooter.astro';
import metrics from '../data/scholar-metrics.json';
import { PUBLICATIONS } from '../data/publications';

const saailPubs = PUBLICATIONS.filter((p) => p.isSaailLab !== false).sort((a, b) => {
	if (a.category === 'preprint' && b.category !== 'preprint') return 1;
	if (a.category !== 'preprint' && b.category === 'preprint') return -1;
	if (b.year !== a.year) return b.year - a.year;
	return b.dateISO.localeCompare(a.dateISO);
});

const priorPubs = PUBLICATIONS.filter((p) => p.isSaailLab === false).sort((a, b) => {
	if (b.year !== a.year) return b.year - a.year;
	return b.dateISO.localeCompare(a.dateISO);
});

const publishedCount = saailPubs.filter((p) => p.category !== 'preprint').length;
const underReviewCount = saailPubs.filter((p) => p.category === 'preprint').length;
---

<Layout
	title="Publications | SAAIL Lab | IIT Madras Zanzibar"
	description="Peer-reviewed journal articles, conference papers, and under-review manuscripts from SAAIL Lab at IIT Madras Zanzibar, plus the founding PI pre-IITMZ scholarly archive."
	canonical="https://saaillab.github.io/publications"
>
	<ModernHeader currentPage="publications" />

	<main>
		<section class="page-hero">
			<div class="container">
				<span class="page-eyebrow">Scholarly Record</span>
				<h1 class="page-title">SAAIL Lab Publications</h1>
				<p class="page-lead">
					Peer-reviewed publications and active manuscripts authored at SAAIL Lab (IIT Madras Zanzibar &amp; WSDSAI IIT Madras, 2025 to Present), spanning precision agriculture, computer vision, Responsible AI, AI Policy &amp; GovTech, and healthcare AI.
				</p>

				<div class="metrics-strip">
					<div class="m-chip"><strong>{publishedCount}</strong><span>SAAIL Published / Conf.</span></div>
					<div class="m-chip"><strong>{underReviewCount}</strong><span>Under Peer Review</span></div>
					<div class="m-chip">
						<strong>{metrics.citations.toLocaleString()}</strong>
						<span>Total Career Citations (h-index {metrics.hIndex})</span>
					</div>
				</div>
			</div>
		</section>

		<!-- Primary Section: SAAIL Lab Publications -->
		<section class="section">
			<div class="container">
				<div class="controls-bar">
					<div class="filter-tabs" role="tablist" aria-label="Filter SAAIL Lab publications">
						<button type="button" class="tab-btn is-active" data-filter="all">All SAAIL Lab ({saailPubs.length})</button>
						<button type="button" class="tab-btn" data-filter="published">Published ({publishedCount})</button>
						<button type="button" class="tab-btn" data-filter="preprint">Under Review ({underReviewCount})</button>
						<button type="button" class="tab-btn" data-filter="policy">Responsible AI, Policy &amp; GovTech</button>
						<button type="button" class="tab-btn" data-filter="agri">Agriculture &amp; Vision</button>
					</div>

					<input
						id="pubSearch"
						type="search"
						placeholder="Search title, author, DOI, keyword..."
						aria-label="Search SAAIL Lab publications"
						class="search-input"
					/>
				</div>

				<div class="result-count" id="resultCount">Showing {saailPubs.length} SAAIL Lab works</div>

				<div class="pubs-list" id="saailList">
					{saailPubs.map((pub) => {
						const isUnderReview = pub.category === 'preprint';
						const cleanDoi = pub.doi ? pub.doi.replace(/^https?:\/\/(dx\.)?doi\.org\//i, '').trim() : '';
						const doiHref = cleanDoi ? `https://doi.org/${cleanDoi}` : '';
						const isPolicy = pub.topics.some((t) =>
							t.toLowerCase().includes('policy') || t.toLowerCase().includes('responsible') || t.toLowerCase().includes('govtech')
						);
						const isAgri = pub.topics.some((t) =>
							t.toLowerCase().includes('agriculture') || t.toLowerCase().includes('clove') || t.toLowerCase().includes('cassava')
						);
						const searchText = [
							pub.title,
							isUnderReview ? 'under review' : pub.venue,
							pub.authors.map((a) => a.name).join(' '),
							pub.keywords.join(' '),
							pub.topics.join(' '),
							cleanDoi,
							pub.tldr
						].join(' ').toLowerCase();

						return (
							<article
								class="pub-item"
								data-status={isUnderReview ? 'preprint' : 'published'}
								data-policy={isPolicy ? 'yes' : 'no'}
								data-agri={isAgri ? 'yes' : 'no'}
								data-search={searchText}
							>
								<div class="pub-badges">
									<span class="badge-year">{pub.year}</span>
									<span class={isUnderReview ? 'badge-review' : 'badge-venue'}>
										{isUnderReview ? 'Under Peer Review' : pub.venueShort}
									</span>
									{pub.award && <span class="badge-award">{pub.award}</span>}
									{!isUnderReview && pub.impactFactor && <span class="badge-if">{pub.impactFactor}</span>}
									{typeof pub.citations === 'number' && pub.citations > 0 && (
										<span class="badge-cite">{pub.citations} Citations</span>
									)}
								</div>

								<h2 class="pub-title">
									<a href={`/papers/${pub.slug}/`}>{pub.title}</a>
								</h2>

								<p class="pub-authors">{pub.authors.map((a) => a.name).join(', ')}</p>
								<p class="pub-venue-line">
									{isUnderReview ? `Manuscript Under Peer Review (${pub.year})` : `${pub.venue} (${pub.month} ${pub.year})`}
								</p>
								<p class="pub-tldr">{pub.tldr}</p>

								{pub.highlights && pub.highlights.length > 0 && (
									<div class="pub-highlights-row">
										{pub.highlights.slice(0, 4).map((h) => (
											<span class="hi-pill">
												<strong>{h.value}</strong> {h.label}
											</span>
										))}
									</div>
								)}

								<div class="pub-actions">
									<a href={`/papers/${pub.slug}/`} class="act-btn act-primary">Project Page &amp; Results &rarr;</a>
									{!isUnderReview && doiHref && (
										<a href={doiHref} target="_blank" rel="noopener" class="act-btn act-doi">
											DOI: {cleanDoi} ↗
										</a>
									)}
									{!isUnderReview && pub.paperUrl && pub.paperUrl !== doiHref && (
										<a href={pub.paperUrl} target="_blank" rel="noopener" class="act-btn">Paper / PDF ↗</a>
									)}
									{pub.codeUrl && (
										<a href={pub.codeUrl} target="_blank" rel="noopener" class="act-btn">Code ↗</a>
									)}
									{pub.posterUrl && (
										<a href={pub.posterUrl} target="_blank" rel="noopener" class="act-btn">Poster ↗</a>
									)}
									<button type="button" class="act-btn bib-toggle-btn" data-bib-target={`bib-${pub.slug}`}>BibTeX</button>
								</div>

								<div id={`bib-${pub.slug}`} class="bib-drawer" hidden>
									<div class="bib-drawer-top">
										<span>BibTeX Record</span>
										<button type="button" class="copy-bib-inline" data-bib-code={`code-${pub.slug}`}>Copy</button>
									</div>
									<pre><code id={`code-${pub.slug}`}>{pub.bibtex}</code></pre>
								</div>
							</article>
						);
					})}
				</div>
			</div>
		</section>

		<!-- Clearly Separated Secondary Archive: Founding PI Pre-IITMZ Publications (2015-2024) -->
		<section class="section prior-band" id="prior-works">
			<div class="container">
				<div class="prior-header">
					<span class="page-eyebrow">Scholarly Archive · Pre-IITMZ (2015-2024)</span>
					<h2>Founding PI Prior Publications (Nanjing Agricultural University Era)</h2>
					<p>
						The {priorPubs.length} peer-reviewed works below were published by Dr. Innocent Nyalala during his doctoral and MSc research at Nanjing Agricultural University prior to founding SAAIL Lab at IIT Madras Zanzibar in October 2024. They carry original historical affiliations and are linked here alongside his personal archive at <a href="https://inyalala.github.io" target="_blank" rel="noopener">inyalala.github.io</a>.
					</p>
				</div>

				<div class="prior-list">
					{priorPubs.map((pub) => {
						const cleanDoi = pub.doi ? pub.doi.replace(/^https?:\/\/(dx\.)?doi\.org\//i, '').trim() : '';
						const doiHref = cleanDoi ? `https://doi.org/${cleanDoi}` : '';
						return (
							<article class="prior-row">
								<div class="prior-year">{pub.year}</div>
								<div class="prior-main">
									<h3>
										<a href={`/papers/${pub.slug}/`}>{pub.title}</a>
									</h3>
									<p class="prior-meta">
										{pub.authors.map((a) => a.name).join(', ')} · <em>{pub.venue}</em>
										{typeof pub.citations === 'number' && pub.citations > 0 ? ` · ${pub.citations}+ citations` : ''}
									</p>
									<p class="prior-tldr">{pub.tldr}</p>
								</div>
								<div class="prior-actions">
									<a href={`/papers/${pub.slug}/`} class="act-btn">Summary &amp; Results &rarr;</a>
									{doiHref && (
										<a href={doiHref} target="_blank" rel="noopener" class="act-btn act-doi">DOI ↗</a>
									)}
								</div>
							</article>
						);
					})}
				</div>
			</div>
		</section>
	</main>

	<ModernFooter />
</Layout>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const tabs = document.querySelectorAll('.tab-btn');
		const searchInput = document.getElementById('pubSearch') as HTMLInputElement | null;
		const items = Array.from(document.querySelectorAll('#saailList .pub-item')) as HTMLElement[];
		const countEl = document.getElementById('resultCount');
		let activeFilter = 'all';

		function applyFilter() {
			const q = (searchInput?.value || '').trim().toLowerCase();
			let shown = 0;

			items.forEach((item) => {
				const st = item.getAttribute('data-status') || '';
				const pol = item.getAttribute('data-policy') === 'yes';
				const agr = item.getAttribute('data-agri') === 'yes';
				const hay = item.getAttribute('data-search') || '';

				let fOk = true;
				if (activeFilter === 'published') fOk = st === 'published';
				else if (activeFilter === 'preprint') fOk = st === 'preprint';
				else if (activeFilter === 'policy') fOk = pol;
				else if (activeFilter === 'agri') fOk = agr;

				const qOk = !q || hay.includes(q);
				const vis = fOk && qOk;
				item.style.display = vis ? 'block' : 'none';
				if (vis) shown++;
			});

			if (countEl) {
				countEl.textContent = `Showing ${shown} of ${items.length} SAAIL Lab works`;
			}
		}

		tabs.forEach((tab) => {
			tab.addEventListener('click', () => {
				tabs.forEach((t) => t.classList.remove('is-active'));
				tab.classList.add('is-active');
				activeFilter = tab.getAttribute('data-filter') || 'all';
				applyFilter();
			});
		});

		searchInput?.addEventListener('input', applyFilter);

		document.querySelectorAll('.bib-toggle-btn').forEach((btn) => {
			btn.addEventListener('click', () => {
				const id = btn.getAttribute('data-bib-target') || '';
				const drawer = document.getElementById(id);
				if (drawer) drawer.hidden = !drawer.hidden;
			});
		});

		document.querySelectorAll('.copy-bib-inline').forEach((btn) => {
			btn.addEventListener('click', async () => {
				const id = btn.getAttribute('data-bib-code') || '';
				const codeEl = document.getElementById(id);
				const txt = codeEl?.textContent?.trim() || '';
				if (!txt) return;
				await navigator.clipboard.writeText(txt);
				const orig = btn.textContent;
				btn.textContent = 'Copied!';
				setTimeout(() => { btn.textContent = orig; }, 1600);
			});
		});
	});
</script>

<style>
	.metrics-strip {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
		margin-top: 1.75rem;
	}

	.m-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.45rem 0.95rem;
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		border-radius: 999px;
		font-size: 0.85rem;
	}

	.m-chip strong { color: var(--accent-primary); font-weight: 800; }
	.m-chip span { color: var(--text-secondary); font-weight: 500; }

	.controls-bar {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		margin-bottom: 1.15rem;
	}

	.filter-tabs {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
	}

	.tab-btn {
		padding: 0.48rem 0.95rem;
		border-radius: 999px;
		border: 1px solid var(--border-color);
		background: var(--bg-card);
		color: var(--text-primary);
		font-family: inherit;
		font-size: 0.84rem;
		font-weight: 600;
		cursor: pointer;
	}

	.tab-btn:hover { border-color: var(--accent-primary); color: var(--accent-primary); }

	.tab-btn.is-active {
		background: var(--accent-primary);
		border-color: var(--accent-primary);
		color: #ffffff;
	}

	:global([data-theme="dark"]) .tab-btn.is-active { color: #062111; }

	.search-input {
		padding: 0.5rem 0.9rem;
		border-radius: 999px;
		border: 1px solid var(--border-color);
		background: var(--bg-card);
		color: var(--text-primary);
		font-family: inherit;
		font-size: 0.88rem;
		min-width: 240px;
	}

	.result-count {
		font-size: 0.84rem;
		font-weight: 600;
		color: var(--text-muted);
		margin-bottom: 1.25rem;
	}

	.pubs-list {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.pub-item {
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		border-radius: 1rem;
		padding: 1.5rem 1.75rem;
		box-shadow: 0 2px 10px var(--shadow-light);
	}

	.pub-badges {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-bottom: 0.7rem;
	}

	.pub-badges span {
		font-size: 0.72rem;
		font-weight: 700;
		padding: 0.18rem 0.6rem;
		border-radius: 999px;
	}

	.badge-year { background: var(--accent-primary); color: #ffffff; }
	:global([data-theme="dark"]) .badge-year { color: #062111; }
	.badge-venue { background: #ecfdf5; color: #14532d; border: 1px solid #bbf7d0; }
	.badge-review { background: #fef3c7; color: #92400e; border: 1px solid #fde68a; }
	.badge-award { background: #fef3c7; color: #92400e; border: 1px solid #fde68a; }
	.badge-if { background: #f3f4f6; color: #1f2937; }
	.badge-cite { background: #eff6ff; color: #1e40af; }

	.pub-title { font-size: 1.2rem; line-height: 1.35; margin-bottom: 0.35rem; }
	.pub-title a { color: var(--text-primary); text-decoration: none; }
	.pub-title a:hover { color: var(--accent-primary); text-decoration: underline; }

	.pub-authors { font-size: 0.88rem; color: var(--text-secondary); font-weight: 500; margin-bottom: 0.2rem; }
	.pub-venue-line { font-size: 0.82rem; color: var(--text-muted); font-style: italic; margin-bottom: 0.65rem; }
	.pub-tldr { font-size: 0.94rem; color: var(--text-secondary); line-height: 1.6; margin-bottom: 0.85rem; }

	.pub-highlights-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		margin-bottom: 1rem;
	}

	.hi-pill {
		font-size: 0.78rem;
		color: var(--text-secondary);
		background: var(--bg-secondary);
		border: 1px solid var(--border-color);
		border-radius: 6px;
		padding: 0.22rem 0.6rem;
	}
	.hi-pill strong { color: var(--accent-primary); margin-right: 0.2rem; }

	.pub-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; }

	.act-btn {
		display: inline-flex;
		align-items: center;
		padding: 0.4rem 0.85rem;
		border-radius: 999px;
		font-family: inherit;
		font-size: 0.8rem;
		font-weight: 600;
		text-decoration: none;
		border: 1px solid var(--border-color);
		background: var(--bg-secondary);
		color: var(--text-primary);
		cursor: pointer;
	}
	.act-btn:hover { border-color: var(--accent-primary); color: var(--accent-primary); }

	.act-primary { background: var(--accent-primary); border-color: var(--accent-primary); color: #ffffff; }
	:global([data-theme="dark"]) .act-primary { color: #062111; }
	.act-doi { font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; }

	.bib-drawer {
		margin-top: 1rem;
		border: 1px solid var(--border-color);
		border-radius: 0.75rem;
		background: var(--bg-secondary);
		overflow: hidden;
	}
	.bib-drawer[hidden] { display: none; }
	.bib-drawer-top {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0.5rem 0.9rem;
		font-size: 0.78rem;
		font-weight: 700;
		border-bottom: 1px solid var(--border-color);
	}
	.copy-bib-inline {
		padding: 0.25rem 0.65rem;
		border-radius: 6px;
		border: 1px solid var(--border-color);
		background: var(--bg-card);
		color: var(--accent-primary);
		font-weight: 700;
		font-size: 0.75rem;
		cursor: pointer;
	}
	.bib-drawer pre {
		margin: 0;
		padding: 0.85rem;
		overflow-x: auto;
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.78rem;
		color: var(--text-primary);
	}

	/* Secondary Pre-IITMZ Archive */
	.prior-band {
		background: var(--bg-secondary);
		border-top: 1px solid var(--border-color);
	}
	.prior-header {
		max-width: 820px;
		margin-bottom: 2rem;
	}
	.prior-header h2 {
		font-size: 1.65rem;
		margin-bottom: 0.55rem;
		color: var(--text-primary);
	}
	.prior-header p {
		color: var(--text-secondary);
		font-size: 0.96rem;
		line-height: 1.65;
	}
	.prior-header a {
		color: var(--accent-primary);
		font-weight: 600;
	}
	.prior-list {
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		border-radius: 1rem;
		overflow: hidden;
	}
	.prior-row {
		display: grid;
		grid-template-columns: 72px 1fr auto;
		gap: 1.25rem;
		align-items: start;
		padding: 1.2rem 1.4rem;
		border-bottom: 1px solid var(--border-color);
	}
	.prior-row:last-child { border-bottom: none; }
	.prior-year {
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.88rem;
		font-weight: 700;
		color: var(--text-muted);
	}
	.prior-main h3 { font-size: 1.02rem; margin-bottom: 0.25rem; line-height: 1.35; }
	.prior-main h3 a { color: var(--text-primary); text-decoration: none; }
	.prior-main h3 a:hover { color: var(--accent-primary); text-decoration: underline; }
	.prior-meta { font-size: 0.82rem; color: var(--text-muted); margin-bottom: 0.35rem; }
	.prior-tldr { font-size: 0.88rem; color: var(--text-secondary); }
	.prior-actions { display: flex; flex-wrap: wrap; gap: 0.4rem; }

	@media (max-width: 820px) {
		.prior-row { grid-template-columns: 1fr; gap: 0.6rem; }
	}
</style>
