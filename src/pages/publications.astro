						<h2>2025-2026</h2>
						<div class="year-stats">
							<span class="stat">3 Journal Articles</span>
							<span class="stat">15 Conferences & Workshops</span>
							<span class="stat">2 Invited Talks</span>
						</div>
					</div>

					<!-- May 2026 — CVPR -->
					<div class="publication-item">
						<div class="publication-poster">
							<div class="poster-placeholder document">
								<svg width="100%" height="100%" viewBox="0 0 200 200">
									<rect width="200" height="200" fill="url(#docGradient7)"/>
									<rect x="50" y="40" width="100" height="120" fill="white" rx="4"/>
