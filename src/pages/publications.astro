---
import Layout from '../layouts/Layout.astro';
import ModernHeader from '../components/ModernHeader.astro';
import ModernFooter from '../components/ModernFooter.astro';
import { PUBLICATIONS, ALL_TOPICS, ALL_YEARS } from '../data/publications';

const totalCount = PUBLICATIONS.length;
const journalCount = PUBLICATIONS.filter((p) => p.category === 'journal').length;
const confCount = PUBLICATIONS.filter((p) => p.category === 'conference' || p.category === 'workshop').length;
const citationMap = Object.fromEntries(
  PUBLICATIONS.map((p) => [p.slug, { title: p.title, bibtex: p.bibtex, apa: p.apa }])
);
---

<Layout
  title="Publications & Academic Project Pages | SAAIL Lab"
  description="Complete catalog of 45+ peer-reviewed journal papers, conference proceedings, workshops, and preprints from SAAIL Lab (IIT Madras Zanzibar), each with an interactive academic project page and BibTeX citation."
  canonical="https://saaillab.github.io/publications/"
>
  <ModernHeader currentPage="publications" />

  <main class="pubs-main">
    <!-- Hero -->
    <section class="pubs-hero">
      <div class="pubs-container">
        <div class="hero-eyebrow">OPEN SCIENCE &amp; INDEXED RESEARCH · 2015 – 2026</div>
        <h1>Publications &amp; Project Pages</h1>
        <p class="hero-lead">
          Every manuscript authored at SAAIL Lab features a dedicated academic project page with structured abstracts, reproducible artifacts, visual figures, Highwire Press metadata, and instant BibTeX export.
        </p>

        <div class="pubs-stats">
          <div class="stat-pill"><strong>{totalCount}</strong> Cataloged Works</div>
          <div class="stat-pill"><strong>{journalCount}</strong> Journal Articles</div>
          <div class="stat-pill"><strong>{confCount}</strong> Conferences &amp; Workshops</div>
          <div class="stat-pill"><strong>1,185+</strong> Citations (h-index 15)</div>
          <a href="/cropguard/" class="stat-pill stat-pill-link"><strong>Papers 1-6</strong> CropGuard Hub &rarr;</a>
        </div>
      </div>
    </section>

    <!-- Controls -->
    <section class="pubs-controls-band">
      <div class="pubs-container">
        <div class="controls-bar">
          <div class="search-box">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
            </svg>
            <input
              id="pubSearch"
              type="search"
              placeholder="Search titles, authors, venues, topics, datasets (e.g., CropGuardNet, DGS-Bench, cloves, placenta)..."
              aria-label="Search publications"
            />
          </div>

          <div class="filter-selects">
            <select id="yearFilter" aria-label="Filter by year">
              <option value="all">All Years</option>
              {ALL_YEARS.map((y) => <option value={String(y)}>{y}</option>)}
            </select>

            <select id="topicFilter" aria-label="Filter by topic">
              <option value="all">All Topics</option>
              {ALL_TOPICS.map((t) => <option value={t}>{t}</option>)}
            </select>

            <button id="exportVisibleBtn" type="button" class="export-all-btn">
              Export Filtered .bib
            </button>
          </div>
        </div>

        <div class="category-tabs-row">
          <div class="category-tabs" role="tablist">
            <button type="button" class="cat-tab active" data-cat="all">All ({totalCount})</button>
            <button type="button" class="cat-tab" data-cat="cropguard">CropGuard Series</button>
            <button type="button" class="cat-tab" data-cat="journal">Journals ({journalCount})</button>
            <button type="button" class="cat-tab" data-cat="conf">Conferences &amp; Workshops ({confCount})</button>
            <button type="button" class="cat-tab" data-cat="preprint">Under Review / Preprints</button>
          </div>

          <div class="view-toggle" aria-label="Toggle layout">
            <span id="visibleCountLabel" class="visible-count">Showing {totalCount} of {totalCount}</span>
            <button type="button" id="listViewBtn" class="view-btn active" title="List view">List</button>
            <button type="button" id="gridViewBtn" class="view-btn" title="Grid view">Grid</button>
          </div>
        </div>
      </div>
    </section>

    <!-- Publications List -->
    <section class="pubs-list-band">
      <div class="pubs-container">
        <div id="pubsContainer" class="pubs-list view-list">
          {PUBLICATIONS.map((pub) => {
            const authorNames = pub.authors.map((a) => a.name).join(' ');
            const searchHaystack = `${pub.title} ${authorNames} ${pub.venue} ${pub.venueShort} ${pub.tldr} ${pub.keywords.join(' ')} ${pub.topics.join(' ')} ${pub.award || ''}`.toLowerCase();
            return (
              <article
                class="pub-card"
                data-year={String(pub.year)}
                data-category={pub.category}
                data-series={pub.seriesId || ''}
                data-topics={pub.topics.join('|')}
                data-slug={pub.slug}
                data-search={searchHaystack}
              >
                {pub.teaserImage && (
                  <a href={`/papers/${pub.slug}/`} class="pub-thumb-link" aria-label={`View ${pub.shortTitle || pub.title} project page`}>
                    <img src={pub.teaserImage} alt={pub.shortTitle || pub.title} loading="lazy" class="pub-thumb" />
                  </a>
                )}

                <div class="pub-body">
                  <div class="pub-badges">
                    <span class="badge-year">{pub.year}</span>
                    <span class="badge-venue">{pub.venueShort}</span>
                    {pub.seriesId === 'cropguard' && (
                      <span class="badge-series">CropGuard Paper {pub.seriesNumber}</span>
                    )}
                    {pub.award && <span class="badge-award">{pub.award}</span>}
                    {pub.impactFactor && <span class="badge-metric">{pub.impactFactor}</span>}
                    {typeof pub.citations === 'number' && pub.citations > 0 && (
                      <span class="badge-metric">{pub.citations}+ Citations</span>
                    )}
                  </div>

                  <h2 class="pub-title">
                    <a href={`/papers/${pub.slug}/`}>{pub.title}</a>
                  </h2>

                  <p class="pub-authors">
                    {pub.authors.map((a, idx) => (
                      <>
                        <span class={a.name.includes('Innocent Nyalala') ? 'author-pi' : ''}>{a.name}</span>
                        {idx < pub.authors.length - 1 ? ', ' : ''}
                      </>
                    ))}
                  </p>

                  <p class="pub-tldr">{pub.tldr}</p>

                  <div class="pub-topics">
                    {pub.topics.map((t) => <span class="topic-tag">{t}</span>)}
                  </div>

                  <div class="pub-actions">
                    <a href={`/papers/${pub.slug}/`} class="act-btn act-primary">
                      Project Page &rarr;
                    </a>
                    {(pub.paperUrl || pub.doi) && (
                      <a href={pub.paperUrl || pub.doi} target="_blank" rel="noopener" class="act-btn">
                        Paper
                      </a>
                    )}
                    {pub.codeUrl && (
                      <a href={pub.codeUrl} target="_blank" rel="noopener" class="act-btn">
                        Code
                      </a>
                    )}
                    {pub.datasetUrl && (
                      <a href={pub.datasetUrl} target="_blank" rel="noopener" class="act-btn">
                        Dataset
                      </a>
                    )}
                    {pub.posterUrl && (
                      <a href={pub.posterUrl} target="_blank" rel="noopener" class="act-btn">
                        Poster
                      </a>
                    )}
                    <button type="button" class="act-btn cite-trigger" data-slug={pub.slug}>
                      Cite
                    </button>
                  </div>
                </div>
              </article>
            );
          })}
        </div>

        <div id="emptyState" class="empty-state" hidden>
          <h3>No matching publications found</h3>
          <p>Try clearing the search query or resetting year and topic filters.</p>
          <button type="button" id="resetFiltersBtn" class="act-btn act-primary">Reset All Filters</button>
        </div>
      </div>
    </section>
  </main>

  <!-- Citation Modal -->
  <div id="citeModal" class="cite-modal" hidden role="dialog" aria-modal="true" aria-labelledby="citeModalTitle">
    <div class="cite-backdrop" id="citeBackdrop"></div>
    <div class="cite-dialog">
      <div class="cite-head">
        <h3 id="citeModalTitle">Cite Publication</h3>
        <button type="button" id="closeCiteModal" class="cite-close" aria-label="Close modal">&times;</button>
      </div>
      <p id="citePaperTitle" class="cite-paper-name"></p>

      <div class="cite-block">
        <div class="cite-block-head">
          <span>BibTeX</span>
          <button type="button" id="modalCopyBib" class="copy-pill">Copy BibTeX</button>
        </div>
        <pre id="modalBibPre"></pre>
      </div>

      <div class="cite-block">
        <div class="cite-block-head">
          <span>APA Citation</span>
          <button type="button" id="modalCopyApa" class="copy-pill">Copy APA</button>
        </div>
        <p id="modalApaText" class="cite-apa"></p>
      </div>
    </div>
  </div>

  <script id="citationsData" type="application/json" set:html={JSON.stringify(citationMap)} />

  <script is:inline>
    (function () {
      const searchEl = document.getElementById('pubSearch');
      const yearEl = document.getElementById('yearFilter');
      const topicEl = document.getElementById('topicFilter');
      const catTabs = Array.from(document.querySelectorAll('.cat-tab'));
      const cards = Array.from(document.querySelectorAll('.pub-card'));
      const container = document.getElementById('pubsContainer');
      const countLabel = document.getElementById('visibleCountLabel');
      const emptyState = document.getElementById('emptyState');
      const resetBtn = document.getElementById('resetFiltersBtn');
      const listViewBtn = document.getElementById('listViewBtn');
      const gridViewBtn = document.getElementById('gridViewBtn');
      const exportBtn = document.getElementById('exportVisibleBtn');

      const citationsRaw = document.getElementById('citationsData')?.textContent || '{}';
      const citationsMap = JSON.parse(citationsRaw);

      let activeCat = 'all';

      function applyFilters() {
        const q = (searchEl?.value || '').trim().toLowerCase();
        const yearVal = yearEl?.value || 'all';
        const topicVal = topicEl?.value || 'all';
        let visible = 0;

        cards.forEach(function (card) {
          const cYear = card.getAttribute('data-year') || '';
          const cCat = card.getAttribute('data-category') || '';
          const cSeries = card.getAttribute('data-series') || '';
          const cTopics = (card.getAttribute('data-topics') || '').split('|');
          const cSearch = card.getAttribute('data-search') || '';

          const matchQ = !q || cSearch.includes(q);
          const matchYear = yearVal === 'all' || cYear === yearVal;
          const matchTopic = topicVal === 'all' || cTopics.includes(topicVal);
          let matchCat = true;
          if (activeCat === 'cropguard') matchCat = cSeries === 'cropguard';
          else if (activeCat === 'journal') matchCat = cCat === 'journal';
          else if (activeCat === 'conf') matchCat = cCat === 'conference' || cCat === 'workshop';
          else if (activeCat === 'preprint') matchCat = cCat === 'preprint';

          const show = matchQ && matchYear && matchTopic && matchCat;
          card.style.display = show ? '' : 'none';
          if (show) visible++;
        });

        if (countLabel) {
          countLabel.textContent = 'Showing ' + visible + ' of ' + cards.length;
        }
        if (emptyState) {
          emptyState.hidden = visible > 0;
        }
      }

      searchEl?.addEventListener('input', applyFilters);
      yearEl?.addEventListener('change', applyFilters);
      topicEl?.addEventListener('change', applyFilters);

      catTabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          catTabs.forEach(function (t) { t.classList.remove('active'); });
          tab.classList.add('active');
          activeCat = tab.getAttribute('data-cat') || 'all';
          applyFilters();
        });
      });

      resetBtn?.addEventListener('click', function () {
        if (searchEl) searchEl.value = '';
        if (yearEl) yearEl.value = 'all';
        if (topicEl) topicEl.value = 'all';
        activeCat = 'all';
        catTabs.forEach(function (t) { t.classList.toggle('active', t.getAttribute('data-cat') === 'all'); });
        applyFilters();
      });

      listViewBtn?.addEventListener('click', function () {
        container?.classList.remove('view-grid');
        container?.classList.add('view-list');
        listViewBtn.classList.add('active');
        gridViewBtn?.classList.remove('active');
      });
      gridViewBtn?.addEventListener('click', function () {
        container?.classList.remove('view-list');
        container?.classList.add('view-grid');
        gridViewBtn.classList.add('active');
        listViewBtn?.classList.remove('active');
      });

      exportBtn?.addEventListener('click', function () {
        const bibEntries = [];
        cards.forEach(function (card) {
          if (card.style.display !== 'none') {
            const slug = card.getAttribute('data-slug') || '';
            if (citationsMap[slug]?.bibtex) {
              bibEntries.push(citationsMap[slug].bibtex);
            }
          }
        });
        const blob = new Blob([bibEntries.join('\n\n') + '\n'], { type: 'application/x-bibtex;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'saaillab_publications.bib';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      });

      // Modal
      const modal = document.getElementById('citeModal');
      const closeModalBtn = document.getElementById('closeCiteModal');
      const backdrop = document.getElementById('citeBackdrop');
      const modalTitle = document.getElementById('citePaperTitle');
      const modalBib = document.getElementById('modalBibPre');
      const modalApa = document.getElementById('modalApaText');

      document.querySelectorAll('.cite-trigger').forEach(function (btn) {
        btn.addEventListener('click', function () {
          const slug = btn.getAttribute('data-slug') || '';
          const entry = citationsMap[slug];
          if (!entry || !modal) return;
          if (modalTitle) modalTitle.textContent = entry.title;
          if (modalBib) modalBib.textContent = entry.bibtex;
          if (modalApa) modalApa.textContent = entry.apa;
          modal.hidden = false;
        });
      });

      function closeModal() {
        if (modal) modal.hidden = true;
      }
      closeModalBtn?.addEventListener('click', closeModal);
      backdrop?.addEventListener('click', closeModal);
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && modal && !modal.hidden) closeModal();
      });

      function wireCopy(btnId, sourceId, label) {
        const btn = document.getElementById(btnId);
        const src = document.getElementById(sourceId);
        if (!btn || !src) return;
        btn.addEventListener('click', async function () {
          await navigator.clipboard.writeText(src.textContent || '');
          btn.textContent = 'Copied!';
          setTimeout(function () { btn.textContent = label; }, 1600);
        });
      }
      wireCopy('modalCopyBib', 'modalBibPre', 'Copy BibTeX');
      wireCopy('modalCopyApa', 'modalApaText', 'Copy APA');
    })();
  </script>

  <ModernFooter />
</Layout>

<style>
  .pubs-main {
    background: var(--bg-primary, #ffffff);
    color: var(--text-primary, #0f172a);
    min-height: 80vh;
  }
  .pubs-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .pubs-hero {
    padding: 4.5rem 0 2.5rem;
    text-align: center;
    background: radial-gradient(circle at top center, rgba(37, 99, 235, 0.08), transparent 60%);
    border-bottom: 1px solid var(--border-color, #e2e8f0);
  }
  .hero-eyebrow {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #2563eb;
    margin-bottom: 0.65rem;
  }
  .pubs-hero h1 {
    font-size: clamp(2rem, 3.8vw, 2.9rem);
    font-weight: 800;
    margin: 0 0 0.85rem;
    letter-spacing: -0.02em;
  }
  .hero-lead {
    max-width: 760px;
    margin: 0 auto 1.75rem;
    font-size: 1.06rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .pubs-stats {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.65rem;
  }
  .stat-pill {
    padding: 0.45rem 0.95rem;
    border-radius: 999px;
    background: var(--bg-card, #ffffff);
    border: 1px solid var(--border-color, #e2e8f0);
    font-size: 0.85rem;
    color: var(--text-secondary);
    text-decoration: none;
  }
  .stat-pill strong { color: var(--text-primary); }
  .stat-pill-link {
    background: #eff6ff;
    border-color: #bfdbfe;
    color: #1d4ed8;
    font-weight: 600;
  }
  .stat-pill-link strong { color: #1d4ed8; }

  .pubs-controls-band {
    padding: 1.5rem 0;
    background: var(--bg-secondary, #f8fafc);
    border-bottom: 1px solid var(--border-color, #e2e8f0);
    position: sticky;
    top: 70px;
    z-index: 30;
  }
  .controls-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .search-box {
    flex: 1 1 320px;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0.9rem;
    background: var(--bg-card, #ffffff);
    border: 1px solid var(--border-color, #cbd5e1);
    border-radius: 10px;
    color: var(--text-muted);
  }
  .search-box input {
    border: none;
    outline: none;
    background: transparent;
    width: 100%;
    font-family: inherit;
    font-size: 0.92rem;
    color: var(--text-primary);
  }
  .filter-selects {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .filter-selects select, .export-all-btn {
    padding: 0.55rem 0.85rem;
    background: var(--bg-card, #ffffff);
    color: var(--text-primary);
    border: 1px solid var(--border-color, #cbd5e1);
    border-radius: 10px;
    font-family: inherit;
    font-size: 0.88rem;
    font-weight: 500;
    cursor: pointer;
  }
  .export-all-btn {
    background: #0f172a;
    color: #ffffff;
    border-color: #0f172a;
    font-weight: 600;
  }
  .export-all-btn:hover { background: #2563eb; border-color: #2563eb; }

  .category-tabs-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .category-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .cat-tab {
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--border-color, #cbd5e1);
    background: var(--bg-card, #ffffff);
    color: var(--text-secondary);
    font-family: inherit;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
  }
  .cat-tab.active {
    background: #2563eb;
    border-color: #2563eb;
    color: #ffffff;
  }
  .view-toggle {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }
  .visible-count {
    font-size: 0.82rem;
    color: var(--text-muted);
    margin-right: 0.35rem;
  }
  .view-btn {
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--border-color, #cbd5e1);
    background: var(--bg-card, #ffffff);
    color: var(--text-secondary);
    border-radius: 8px;
    font-family: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
  }
  .view-btn.active {
    background: #0f172a;
    border-color: #0f172a;
    color: #ffffff;
  }

  .pubs-list-band { padding: 2.5rem 0 4.5rem; }
  .pubs-list.view-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .pubs-list.view-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 1.35rem;
  }

  .pub-card {
    display: flex;
    gap: 1.35rem;
    padding: 1.45rem;
    background: var(--bg-card, #ffffff);
    border: 1px solid var(--border-color, #e2e8f0);
    border-radius: 16px;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }
  .view-grid .pub-card {
    flex-direction: column;
    gap: 1rem;
  }
  .pub-card:hover {
    border-color: #93c5fd;
    box-shadow: 0 10px 26px rgba(15, 23, 42, 0.06);
  }
  .pub-thumb-link {
    flex: 0 0 210px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f8fafc;
    border: 1px solid var(--border-color, #e2e8f0);
    border-radius: 10px;
    overflow: hidden;
    padding: 0.4rem;
  }
  .view-grid .pub-thumb-link {
    flex: none;
    height: 170px;
  }
  .pub-thumb {
    max-width: 100%;
    max-height: 150px;
    object-fit: contain;
  }

  .pub-body {
    flex: 1;
    min-width: 0;
  }
  .pub-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.55rem;
  }
  .badge-year, .badge-venue, .badge-series, .badge-award, .badge-metric {
    padding: 0.18rem 0.6rem;
    border-radius: 6px;
    font-size: 0.74rem;
    font-weight: 700;
  }
  .badge-year { background: #0f172a; color: #ffffff; }
  .badge-venue { background: #eff6ff; color: #1d4ed8; }
  .badge-series { background: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0; }
  .badge-award { background: #fef3c7; color: #92400e; }
  .badge-metric { background: #f1f5f9; color: #475569; }

  .pub-title {
    margin: 0 0 0.45rem;
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.38;
  }
  .pub-title a {
    color: var(--text-primary);
    text-decoration: none;
  }
  .pub-title a:hover {
    color: #2563eb;
    text-decoration: underline;
  }
  .pub-authors {
    margin: 0 0 0.55rem;
    font-size: 0.88rem;
    color: var(--text-secondary);
  }
  .author-pi {
    font-weight: 700;
    color: var(--text-primary);
    text-decoration: underline;
    text-decoration-color: rgba(37, 99, 235, 0.35);
    text-underline-offset: 2px;
  }
  .pub-tldr {
    margin: 0 0 0.85rem;
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }
  .pub-topics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 0.95rem;
  }
  .topic-tag {
    padding: 0.14rem 0.5rem;
    border-radius: 5px;
    background: var(--bg-secondary, #f8fafc);
    border: 1px solid var(--border-color, #e2e8f0);
    font-size: 0.72rem;
    color: var(--text-muted);
  }
  .pub-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .act-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.38rem 0.8rem;
    border-radius: 8px;
    border: 1px solid var(--border-color, #cbd5e1);
    background: var(--bg-secondary, #f8fafc);
    color: var(--text-primary);
    font-family: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .act-btn:hover {
