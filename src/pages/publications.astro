---
import Layout from '../layouts/Layout.astro';
import ModernHeader from '../components/ModernHeader.astro';
import ModernFooter from '../components/ModernFooter.astro';
import metrics from '../data/scholar-metrics.json';
import { PUBLICATIONS } from '../data/publications';

const saailPubs = PUBLICATIONS.filter((p) => p.isSaailLab !== false).sort((a, b) => {
	if (a.slug === 'cropguardnet') return -1;
	if (b.slug === 'cropguardnet') return 1;
	if (b.year !== a.year) return b.year - a.year;
	return b.dateISO.localeCompare(a.dateISO);
});

const priorPubs = PUBLICATIONS.filter((p) => p.isSaailLab === false).sort((a, b) => {
	if (b.year !== a.year) return b.year - a.year;
	return b.dateISO.localeCompare(a.dateISO);
});

const publishedCount = saailPubs.filter((p) => p.category !== 'preprint').length;
const underReviewCount = saailPubs.filter((p) => p.category === 'preprint').length;
---

<Layout
	title="AI Publications from Zanzibar | SAAIL Lab · IIT Madras Zanzibar"
	description="42 peer-reviewed AI, deep learning, computer vision, agricultural AI, Swahili NLP, and healthcare ML publications from SAAIL Lab at IIT Madras Zanzibar and Principal Investigator Innocent Nyalala."
	canonical="https://saaillab.github.io/publications/"
>
	<ModernHeader currentPage="publications" />

	<main id="main-content">
		<section class="page-hero">
			<div class="container">
				<span class="page-eyebrow">Scholarly Record · Zanzibar &amp; East Africa AI</span>
				<h1 class="page-title">SAAIL Lab Publications</h1>
				<p class="page-lead">
					Peer-reviewed journal articles, conference papers, and manuscripts authored at SAAIL Lab (IIT Madras Zanzibar, 2025 to Present), covering deep learning for agriculture, computer vision, Responsible AI, Swahili NLP, AI Policy, and clinical machine learning.
				</p>

				<div class="metrics-strip">
					<div class="m-chip"><strong>{publishedCount}</strong><span>SAAIL Published / Conf.</span></div>
					<div class="m-chip"><strong>{underReviewCount}</strong><span>Under Peer Review</span></div>
					<div class="m-chip">
						<strong>{metrics.citations.toLocaleString()}</strong>
						<span>Total Career Citations (h-index {metrics.hIndex})</span>
					</div>
				</div>
			</div>
		</section>

		<!-- Primary Section: SAAIL Lab Publications -->
		<section class="section">
			<div class="container">
				<div class="controls-bar">
					<div class="filter-tabs" role="tablist" aria-label="Filter SAAIL Lab publications">
						<button type="button" role="tab" aria-selected="true" aria-controls="saailList" tabindex="0" class="tab-btn is-active" data-filter="all">All SAAIL Lab ({saailPubs.length})</button>
						<button type="button" role="tab" aria-selected="false" aria-controls="saailList" tabindex="-1" class="tab-btn" data-filter="published">Published ({publishedCount})</button>
						<button type="button" role="tab" aria-selected="false" aria-controls="saailList" tabindex="-1" class="tab-btn" data-filter="preprint">Under Review ({underReviewCount})</button>
						<button type="button" role="tab" aria-selected="false" aria-controls="saailList" tabindex="-1" class="tab-btn" data-filter="policy">Responsible AI, Policy &amp; GovTech</button>
						<button type="button" role="tab" aria-selected="false" aria-controls="saailList" tabindex="-1" class="tab-btn" data-filter="agri">Agriculture &amp; Vision</button>
					</div>

					<input
						id="pubSearch"
						type="search"
						placeholder="Search title, year, author, DOI, keyword..."
						aria-label="Search SAAIL Lab publications"
						class="search-input"
					/>
				</div>

				<div class="result-count" id="resultCount" aria-live="polite">Showing {saailPubs.length} of {saailPubs.length} SAAIL Lab works</div>

				<div class="pubs-list" id="saailList">
					{saailPubs.map((pub) => {
						const isUnderReview = pub.category === 'preprint';
						const cleanDoi = pub.doi ? pub.doi.replace(/^https?:\/\/(dx\.)?doi\.org\//i, '').trim() : '';
						const doiHref = cleanDoi ? `https://doi.org/${cleanDoi}` : '';
						const isPolicy = pub.topics.some((t) =>
							t.toLowerCase().includes('policy') || t.toLowerCase().includes('responsible') || t.toLowerCase().includes('govtech')
						);
						const isAgri = pub.topics.some((t) =>
							t.toLowerCase().includes('agriculture') || t.toLowerCase().includes('clove') || t.toLowerCase().includes('cassava')
						);
						const searchText = [
							String(pub.year),
							pub.venueShort,
							pub.award || '',
							pub.title,
							isUnderReview ? 'under review manuscript' : pub.venue,
							pub.authors.map((a) => a.name).join(' '),
							pub.keywords.join(' '),
							pub.topics.join(' '),
							cleanDoi,
							pub.tldr
						].join(' ').toLowerCase();

						return (
							<article
								class="pub-item"
								data-status={isUnderReview ? 'preprint' : 'published'}
								data-policy={isPolicy ? 'yes' : 'no'}
								data-agri={isAgri ? 'yes' : 'no'}
								data-search={searchText}
							>
								<div class="saail-row-grid">
									<div class="saail-meta-col">
										<span class="badge-year">{pub.year}</span>
										<span class={isUnderReview ? 'badge-review' : 'badge-venue'}>
											{isUnderReview ? 'Under Peer Review' : pub.venueShort}
										</span>
										{pub.award && <span class="badge-award">{pub.award}</span>}
									</div>

									<div class="saail-main-col">
										<h2 class="pub-title">
											<a href={`/papers/${pub.slug}/`}>{pub.title}</a>
										</h2>

										<p class="pub-authors">
											{pub.authors.map((a, i) => (
												<>
													{a.name === 'Innocent Nyalala' ? (
														<strong class="pi-name">{a.name}</strong>
													) : (
														<span>{a.name}</span>
													)}
													{i < pub.authors.length - 1 ? ', ' : ''}
												</>
											))}
										</p>
										<p class="pub-venue-line">
											{isUnderReview ? `Manuscript Under Peer Review (${pub.year})` : `${pub.venue} (${pub.month} ${pub.year})`}
											{!isUnderReview && pub.impactFactor ? ` · ${pub.impactFactor}` : ''}
											{typeof pub.citations === 'number' && pub.citations > 0 ? ` · ${pub.citations} ${pub.citations === 1 ? 'Citation' : 'Citations'}` : ''}
										</p>
										<p class="pub-tldr">{pub.tldr}</p>
									</div>

									<div class="pub-actions">
										<a href={`/papers/${pub.slug}/`} class="act-btn act-primary">Summary &amp; Results &rarr;</a>
										{!isUnderReview && doiHref && (
											<a href={doiHref} target="_blank" rel="noopener" class="act-btn">
												DOI ↗
											</a>
										)}
										{!isUnderReview && pub.paperUrl && pub.paperUrl !== doiHref && (
											<a href={pub.paperUrl} target="_blank" rel="noopener" class="act-btn">Paper ↗</a>
										)}
										{pub.codeUrl && (
											<a href={pub.codeUrl} target="_blank" rel="noopener" class="act-btn">Code ↗</a>
										)}
										{pub.posterUrl && (
											<a href={pub.posterUrl} target="_blank" rel="noopener" class="act-btn">Poster ↗</a>
										)}
										<button type="button" class="act-btn bib-toggle-btn" aria-expanded="false" aria-controls={`bib-${pub.slug}`} data-bib-target={`bib-${pub.slug}`}>BibTeX</button>
									</div>
								</div>

								<div id={`bib-${pub.slug}`} class="bib-drawer" hidden>
									<div class="bib-drawer-top">
										<span>BibTeX Record</span>
										<button type="button" class="copy-bib-inline" data-orig-label="Copy" data-bib-code={`code-${pub.slug}`}>Copy</button>
									</div>
									<pre><code id={`code-${pub.slug}`}>{pub.bibtex}</code></pre>
								</div>
							</article>
						);
					})}
					<div id="noPubResults" class="no-pub-results" hidden>
						No SAAIL Lab works match the selected filter and search terms.
					</div>
				</div>
			</div>
		</section>

		<!-- Clearly Separated Secondary Archive: Founding PI Pre-IITMZ Publications (2015-2024) -->
		<section class="section prior-band" id="prior-works">
			<div class="container">
				<div class="prior-header">
					<span class="page-eyebrow">Scholarly Archive · Pre-IITMZ (2015-2024)</span>
					<h2>Founding PI Prior Publications (Nanjing Agricultural University Era)</h2>
					<p>
						The {priorPubs.length} peer-reviewed works below were published by Innocent Nyalala during his doctoral and MSc research at Nanjing Agricultural University prior to founding SAAIL Lab at IIT Madras Zanzibar in October 2024. They carry original historical affiliations and are linked here alongside his personal archive at <a href="https://inyalala.github.io/" target="_blank" rel="noopener">inyalala.github.io</a>.
					</p>
				</div>

				<div class="prior-list">
					{priorPubs.map((pub) => {
						const cleanDoi = pub.doi ? pub.doi.replace(/^https?:\/\/(dx\.)?doi\.org\//i, '').trim() : '';
						const doiHref = cleanDoi ? `https://doi.org/${cleanDoi}` : '';
						return (
							<article class="prior-row">
								<div class="prior-year">{pub.year}</div>
								<div class="prior-main">
									<h3>
										<a href={`/papers/${pub.slug}/`}>{pub.title}</a>
									</h3>
									<p class="prior-meta">
										{pub.authors.map((a, i) => (
											<>
												{a.name === 'Innocent Nyalala' ? (
													<strong class="pi-name">{a.name}</strong>
												) : (
													<span>{a.name}</span>
												)}
												{i < pub.authors.length - 1 ? ', ' : ''}
											</>
										))} · <em>{pub.venue}</em>
										{typeof pub.citations === 'number' && pub.citations > 0 ? ` · ${pub.citations}+ citations` : ''}
									</p>
									<p class="prior-tldr">{pub.tldr}</p>
								</div>
								<div class="prior-actions">
									<a href={`/papers/${pub.slug}/`} class="act-btn">Summary &amp; Results &rarr;</a>
									{doiHref && (
										<a href={doiHref} target="_blank" rel="noopener" class="act-btn">DOI ↗</a>
									)}
								</div>
							</article>
						);
					})}
				</div>
			</div>
		</section>
	</main>

	<ModernFooter />
</Layout>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const tabs = document.querySelectorAll('.tab-btn');
		const searchInput = document.getElementById('pubSearch') as HTMLInputElement | null;
		const items = Array.from(document.querySelectorAll('#saailList .pub-item')) as HTMLElement[];
		const countEl = document.getElementById('resultCount');
		const emptyEl = document.getElementById('noPubResults');
		let activeFilter = 'all';

		function applyFilter() {
			const q = (searchInput?.value || '').trim().toLowerCase();
			let lastVisible: HTMLElement | null = null;
			let shown = 0;

			items.forEach((item) => {
				item.classList.remove('is-last-visible');
				const st = item.getAttribute('data-status') || '';
				const pol = item.getAttribute('data-policy') === 'yes';
				const agr = item.getAttribute('data-agri') === 'yes';
				const hay = item.getAttribute('data-search') || '';

				let fOk = true;
				if (activeFilter === 'published') fOk = st === 'published';
				else if (activeFilter === 'preprint') fOk = st === 'preprint';
				else if (activeFilter === 'policy') fOk = pol;
				else if (activeFilter === 'agri') fOk = agr;

				const qOk = !q || hay.includes(q);
				const vis = fOk && qOk;
				item.style.display = vis ? 'block' : 'none';
				if (vis) {
					shown++;
					lastVisible = item;
				}
			});

			if (lastVisible) {
				(lastVisible as HTMLElement).classList.add('is-last-visible');
			}
			if (emptyEl) {
				emptyEl.hidden = shown > 0;
			}

			if (countEl) {
				const nextText = `Showing ${shown} of ${items.length} SAAIL Lab works`;
				if (countEl.textContent !== nextText) {
					countEl.textContent = nextText;
				}
			}
		}

		tabs.forEach((tab, idx) => {
			tab.addEventListener('click', () => {
				tabs.forEach((t) => {
					t.classList.remove('is-active');
					t.setAttribute('aria-selected', 'false');
					t.setAttribute('tabindex', '-1');
				});
				tab.classList.add('is-active');
				tab.setAttribute('aria-selected', 'true');
				tab.setAttribute('tabindex', '0');
				activeFilter = tab.getAttribute('data-filter') || 'all';
				applyFilter();
			});
			tab.addEventListener('keydown', (e: Event) => {
				const ke = e as KeyboardEvent;
				let nextIdx: number | null = null;
				if (ke.key === 'ArrowRight') nextIdx = (idx + 1) % tabs.length;
				else if (ke.key === 'ArrowLeft') nextIdx = (idx - 1 + tabs.length) % tabs.length;
				else if (ke.key === 'Home') nextIdx = 0;
				else if (ke.key === 'End') nextIdx = tabs.length - 1;
				if (nextIdx === null) return;
				ke.preventDefault();
				const nextTab = tabs[nextIdx] as HTMLElement;
				nextTab.focus();
				nextTab.click();
			});
		});

		applyFilter();

		searchInput?.addEventListener('input', applyFilter);

		document.querySelectorAll('.bib-toggle-btn').forEach((btn) => {
			btn.addEventListener('click', () => {
				const id = btn.getAttribute('data-bib-target') || '';
				const drawer = document.getElementById(id);
				if (drawer) {
					drawer.hidden = !drawer.hidden;
					btn.setAttribute('aria-expanded', String(!drawer.hidden));
				}
			});
		});

		document.querySelectorAll('.copy-bib-inline').forEach((btn) => {
			btn.addEventListener('click', async () => {
				const id = btn.getAttribute('data-bib-code') || '';
				const codeEl = document.getElementById(id);
				const txt = codeEl?.textContent?.trim() || '';
				if (!txt) return;
				let copied = false;
				try {
					await navigator.clipboard.writeText(txt);
					copied = true;
				} catch (_err) {
					const area = document.createElement('textarea');
					area.value = txt;
					area.style.position = 'fixed';
					area.style.opacity = '0';
					document.body.appendChild(area);
					area.select();
					try { copied = document.execCommand('copy'); } catch (_e2) {}
					document.body.removeChild(area);
				}
				if (copied) {
					const orig = btn.getAttribute('data-orig-label') || 'Copy';
					btn.textContent = 'Copied!';
					setTimeout(() => { btn.textContent = orig; }, 1600);
				}
			});
		});
	});
</script>

<style>
	.metrics-strip {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
		margin-top: 1.75rem;
	}

	.m-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.45rem 0.95rem;
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		border-radius: 999px;
		font-size: 0.85rem;
	}

	.m-chip strong { color: var(--accent-primary); font-weight: 800; }
	.m-chip span { color: var(--text-secondary); font-weight: 500; }

	.controls-bar {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		margin-bottom: 1.15rem;
	}

	.filter-tabs {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
	}

	.tab-btn {
		padding: 0.48rem 0.95rem;
		border-radius: 999px;
		border: 1px solid var(--border-color);
		background: var(--bg-card);
		color: var(--text-primary);
		font-family: inherit;
		font-size: 0.84rem;
		font-weight: 600;
		cursor: pointer;
	}

	.tab-btn:hover { border-color: var(--accent-primary); color: var(--accent-primary); }

	.tab-btn.is-active {
		background: var(--accent-primary);
		border-color: var(--accent-primary);
		color: #ffffff;
	}

	:global([data-theme="dark"]) .tab-btn.is-active { color: #062111; }

	.search-input {
		padding: 0.5rem 0.9rem;
		border-radius: 999px;
		border: 1px solid var(--border-color);
		background: var(--bg-card);
		color: var(--text-primary);
		font-family: inherit;
		font-size: 0.88rem;
		min-width: 240px;
	}

	.result-count {
		font-size: 0.84rem;
		font-weight: 600;
		color: var(--text-muted);
		margin-bottom: 1.25rem;
	}

	.pubs-list {
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		border-radius: 1rem;
		overflow: hidden;
	}

	.pub-item {
		padding: 1.3rem 1.5rem;
		border-bottom: 1px solid var(--border-color);
	}
	.pub-item:last-of-type, .pub-item.is-last-visible { border-bottom: none; }
	.no-pub-results {
		padding: 2rem 1.5rem;
		text-align: center;
		color: var(--text-muted);
		font-weight: 600;
	}
	.no-pub-results[hidden] { display: none; }

	.saail-row-grid {
		display: grid;
		grid-template-columns: 190px 1fr auto;
		gap: 1.35rem;
		align-items: start;
	}

	.saail-meta-col {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.35rem;
	}

	.saail-meta-col span {
		font-size: 0.72rem;
		font-weight: 700;
		padding: 0.18rem 0.6rem;
		border-radius: 999px;
	}

	.badge-year { background: var(--accent-primary); color: #ffffff; font-family: 'JetBrains Mono', monospace; }
	:global([data-theme="dark"]) .badge-year { color: #062111; }
	.badge-venue { background: #ecfdf5; color: #14532d; border: 1px solid #bbf7d0; }
	.badge-review { background: #fef3c7; color: #92400e; border: 1px solid #fde68a; }
	.badge-award { background: #fef3c7; color: #92400e; border: 1px solid #fde68a; border-radius: 6px; }

	.pub-title { font-size: 1.08rem; line-height: 1.35; margin-bottom: 0.3rem; }
	.pub-title a { color: var(--text-primary); text-decoration: none; }
	.pub-title a:hover { color: var(--accent-primary); text-decoration: underline; }

	.pub-authors { font-size: 0.86rem; color: var(--text-secondary); font-weight: 500; margin-bottom: 0.2rem; }
	.pub-venue-line { font-size: 0.82rem; color: var(--text-muted); font-style: italic; margin-bottom: 0.45rem; }
	.pub-tldr { font-size: 0.9rem; color: var(--text-secondary); line-height: 1.55; margin-bottom: 0; }

	.pub-actions { display: flex; flex-wrap: wrap; gap: 0.4rem; justify-content: flex-end; max-width: 290px; }

	.act-btn {
		display: inline-flex;
		align-items: center;
		padding: 0.4rem 0.85rem;
		border-radius: 999px;
		font-family: inherit;
		font-size: 0.8rem;
		font-weight: 600;
		text-decoration: none;
		border: 1px solid var(--border-color);
		background: var(--bg-secondary);
		color: var(--text-primary);
		cursor: pointer;
	}
	.act-btn:not(.act-primary):hover { border-color: var(--accent-primary); color: var(--accent-primary); }

	.act-primary { background: var(--accent-primary); border-color: var(--accent-primary); color: #ffffff; }
	.act-primary:hover { background: var(--accent-secondary); border-color: var(--accent-secondary); color: #ffffff; }
	:global([data-theme="dark"]) .act-primary,
	:global([data-theme="dark"]) .act-primary:hover { color: #062111; }

	.bib-drawer {
		margin-top: 1rem;
		border: 1px solid var(--border-color);
		border-radius: 0.75rem;
		background: var(--bg-secondary);
		overflow: hidden;
	}
	.bib-drawer[hidden] { display: none; }
	.bib-drawer-top {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0.5rem 0.9rem;
		font-size: 0.78rem;
		font-weight: 700;
		border-bottom: 1px solid var(--border-color);
	}
	.copy-bib-inline {
		padding: 0.25rem 0.65rem;
		border-radius: 6px;
		border: 1px solid var(--border-color);
		background: var(--bg-card);
		color: var(--accent-primary);
		font-weight: 700;
		font-size: 0.75rem;
		cursor: pointer;
	}
	.bib-drawer pre {
		margin: 0;
		padding: 0.85rem;
		overflow-x: auto;
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.78rem;
		color: var(--text-primary);
	}

	/* Secondary Pre-IITMZ Archive */
	.prior-band {
		background: var(--bg-secondary);
		border-top: 1px solid var(--border-color);
	}
	.prior-header {
		max-width: 100%;
		margin-bottom: 2rem;
	}

	.pi-name {
		color: var(--accent-primary);
		font-weight: 800;
	}
	.prior-header h2 {
		font-size: 1.65rem;
		margin-bottom: 0.55rem;
		color: var(--text-primary);
	}
	.prior-header p {
		color: var(--text-secondary);
		font-size: 0.96rem;
		line-height: 1.65;
	}
	.prior-header a {
		color: var(--accent-primary);
		font-weight: 600;
	}
	.prior-list {
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		border-radius: 1rem;
		overflow: hidden;
	}
	.prior-row {
		display: grid;
		grid-template-columns: 72px 1fr auto;
		gap: 1.25rem;
		align-items: start;
		padding: 1.2rem 1.4rem;
		border-bottom: 1px solid var(--border-color);
	}
	.prior-row:last-child { border-bottom: none; }
	.prior-year {
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.88rem;
		font-weight: 700;
		color: var(--text-muted);
	}
	.prior-main h3 { font-size: 1.02rem; margin-bottom: 0.25rem; line-height: 1.35; }
	.prior-main h3 a { color: var(--text-primary); text-decoration: none; }
