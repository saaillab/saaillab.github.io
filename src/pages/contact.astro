---
import Layout from '../layouts/Layout.astro';
import ModernHeader from '../components/ModernHeader.astro';
import ModernFooter from '../components/ModernFooter.astro';
---

<Layout
	title="Contact Us | SAAIL Lab | IIT Madras Zanzibar"
	description="Contact SAAIL Lab at the School of Engineering and Science, Indian Institute of Technology Madras Zanzibar (Room 105 F1, Bweleo). Reach us at saail_lab@iitmz.ac.in."
	canonical="https://saaillab.github.io/contact/"
>
	<ModernHeader currentPage="contact" />

	<main id="main-content">
		<section class="page-hero">
			<div class="container">
				<span class="page-eyebrow">Reach SAAIL Lab</span>
				<h1 class="page-title">Contact Us</h1>
				<p class="page-lead">
					Connect with our research team at the School of Engineering and Science, IIT Madras Zanzibar regarding collaborations, open datasets, visiting stays, and student research fellowships.
				</p>
			</div>
		</section>

		<section class="section">
			<div class="container">
				<div class="contact-layout">
					<!-- Left: Official Lab Email FormSubmit (saail_lab@iitmz.ac.in) + Direct Compose Fallbacks -->
					<div class="form-card">
						<h2>Send a Research Inquiry</h2>
						<p class="form-intro">
							Messages route directly to <a href="mailto:saail_lab@iitmz.ac.in">saail_lab@iitmz.ac.in</a>. You can submit below or launch your mail client directly with prefilled details.
						</p>

						<div id="formBanner" class="form-banner" hidden role="status" aria-live="polite" tabindex="-1"></div>

						<form id="saailContactForm" class="contact-form" action="https://formsubmit.co/ajax/saail_lab@iitmz.ac.in" method="POST">
							<input type="hidden" name="_subject" value="New Research Inquiry · SAAIL Lab Website" />
							<input type="hidden" name="_template" value="table" />
							<input type="hidden" name="_captcha" value="false" />
							<div class="form-row">
								<div class="form-group">
									<label for="firstName">First Name *</label>
									<input type="text" id="firstName" name="firstName" required autocomplete="given-name" placeholder="e.g., Umniya" />
								</div>
								<div class="form-group">
									<label for="lastName">Last Name *</label>
									<input type="text" id="lastName" name="lastName" required autocomplete="family-name" placeholder="e.g., Hassan" />
								</div>
							</div>

							<div class="form-row">
								<div class="form-group">
									<label for="email">Email Address *</label>
									<input type="email" id="email" name="email" required autocomplete="email" placeholder="you@institution.edu" />
								</div>
								<div class="form-group">
									<label for="institution">Institution / Organization</label>
									<input type="text" id="institution" name="institution" autocomplete="organization" placeholder="University, agency, or cooperative" />
								</div>
							</div>

							<div class="form-group">
								<label for="topic">Inquiry Topic *</label>
								<select id="topic" name="topic" required>
									<option value="">Select a topic...</option>
									<option value="Agriculture & Blue Economy Research">Precision Agriculture &amp; Blue Economy Collaboration</option>
									<option value="Swahili NLP & Dira Provenance">Swahili NLP, Corpus &amp; Dira Provenance</option>
									<option value="Responsible AI & DGS-Bench">Responsible AI, Audits &amp; Governance</option>
									<option value="Healthcare & Clinical AI">Healthcare &amp; PlacentaVision Clinical ML</option>
									<option value="MTech or BS Student Inquiry">MTech DSAI / BS Fellowship Inquiry</option>
									<option value="Dataset or Code Access">Dataset, Benchmark, or Code Access</option>
									<option value="General Inquiry">General Lab Inquiry</option>
								</select>
							</div>

							<div class="form-group">
								<label for="portfolioUrl">CV, Paper, or GitHub Link (Optional)</label>
								<input type="url" id="portfolioUrl" name="portfolioUrl" autocomplete="url" placeholder="https://github.com/... or Google Drive link" />
							</div>

							<div class="form-group">
								<label for="message">Message *</label>
								<textarea id="message" name="message" rows="5" required placeholder="Share details of your research proposal, question, or background..."></textarea>
							</div>

							<div class="submit-actions">
								<button type="submit" id="submitContactBtn" class="btn btn-primary submit-btn">
									Send to saail_lab@iitmz.ac.in &rarr;
								</button>
								<div class="direct-compose-row">
									<button type="button" id="mailtoComposeBtn" class="direct-btn">Open Email App</button>
									<button type="button" id="gmailComposeBtn" class="direct-btn">Open in Gmail Web</button>
									<button type="button" id="copyEmailBtn" class="direct-btn">Copy Lab Email</button>
								</div>
							</div>
						</form>
					</div>

					<!-- Right: Campus Location, Official Lab Email & High-Contrast Profile Links -->
					<div class="info-stack">
						<div class="info-card">
							<h2>Campus Location &amp; Map</h2>
							<div class="map-wrap">
								<iframe
									src="https://maps.google.com/maps?q=-6.29556,39.28768+(IIT%20Madras%20Zanzibar)&t=&z=14&ie=UTF8&iwloc=&output=embed"
									width="100%"
									height="250"
									style="border:0;"
									allowfullscreen=""
									loading="lazy"
									referrerpolicy="no-referrer-when-downgrade"
									title="IIT Madras Zanzibar Bweleo Campus Map"
								></iframe>
							</div>
							<a
								href="https://maps.google.com/?q=-6.29556,39.28768"
								target="_blank"
								rel="noopener"
								class="map-ext-link"
							>
								Open IIT Madras Zanzibar in Google Maps ↗
							</a>

							<dl class="dir-list">
								<div class="dir-item">
									<dt>Laboratory Address</dt>
									<dd>
										Room 105 (F1), School of Engineering &amp; Science<br />
										Indian Institute of Technology Madras Zanzibar<br />
										Bweleo, Zanzibar, Tanzania
									</dd>
								</div>
								<div class="dir-item">
									<dt>Official Lab Email</dt>
									<dd>
										<a href="mailto:saail_lab@iitmz.ac.in" class="lab-email-link">saail_lab@iitmz.ac.in</a>
									</dd>
								</div>
								<div class="dir-item">
									<dt>Faculty Profile</dt>
									<dd>
										<a href="https://www.iitmz.ac.in/schools/engineering-and-science/faculty/prof-innocent-nyalala" target="_blank" rel="noopener" class="lab-email-link">PI IITMZ Faculty Profile ↗</a>
									</dd>
								</div>
							</dl>
						</div>

						<div class="info-card">
							<h2>Academic Profiles &amp; Code</h2>
							<p class="profiles-sub">Follow our open-source benchmarks, peer-reviewed publications, and lab updates.</p>
							<div class="social-grid">
								<a href="https://github.com/saaillab" target="_blank" rel="noopener" class="social-chip">
									<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
										<path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.09-.745.083-.729.083-.729 1.205.084 1.84 1.237 1.84 1.237 1.07 1.835 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.31.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .322.216.698.825.576C20.565 21.795 24 17.298 24 12c0-6.63-5.37-12-12-12z"/>
									</svg>
									<span>GitHub</span>
								</a>
								<a href="https://scholar.google.com/citations?user=jYVzIZUAAAAJ&hl=en" target="_blank" rel="noopener" class="social-chip">
									<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
										<path d="M5.242 13.769L0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.748-6.758 4.269zM12 10a7 7 0 1 0 0 14 7 7 0 0 0 0-14z"/>
									</svg>
									<span>Google Scholar</span>
								</a>
								<a href="https://www.linkedin.com/company/saail-lab/" target="_blank" rel="noopener" class="social-chip">
									<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
										<path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
									</svg>
									<span>LinkedIn</span>
								</a>
								<a href="https://orcid.org/0000-0002-7969-437X" target="_blank" rel="noopener" class="social-chip">
									<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
										<path d="M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zM7.369 4.378c.525 0 .947.431.947.947s-.422.947-.947.947a.95.95 0 0 1-.947-.947c0-.525.422-.947.947-.947zm-.722 3.038h1.444v10.041H6.647V7.416zm3.562 0h3.9c3.712 0 5.344 2.653 5.344 5.025 0 2.578-2.016 5.025-5.325 5.025h-3.919V7.416zm1.444 1.303v7.444h2.297c3.272 0 4.022-2.484 4.022-3.722 0-2.016-1.284-3.722-4.097-3.722h-2.222z"/>
									</svg>
									<span>ORCID</span>
								</a>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>
	</main>

	<ModernFooter />
</Layout>

<script>
	document.addEventListener('DOMContentLoaded', function () {
		const LAB_EMAIL = 'saail_lab@iitmz.ac.in';
		const form = document.getElementById('saailContactForm');
		const banner = document.getElementById('formBanner');
		const submitBtn = document.getElementById('submitContactBtn');
		const mailtoBtn = document.getElementById('mailtoComposeBtn');
		const gmailBtn = document.getElementById('gmailComposeBtn');
		const copyBtn = document.getElementById('copyEmailBtn');

		function buildDraft() {
			const fd = form instanceof HTMLFormElement ? new FormData(form) : new FormData();
			const first = String(fd.get('firstName') || '').trim();
			const last = String(fd.get('lastName') || '').trim();
			const email = String(fd.get('email') || '').trim();
			const inst = String(fd.get('institution') || '').trim();
			const topic = String(fd.get('topic') || 'Research Inquiry').trim();
			const url = String(fd.get('portfolioUrl') || '').trim();
			const msg = String(fd.get('message') || '').trim();
			const subject = `[SAAIL Lab Inquiry] ${topic}${first || last ? ` - ${first} ${last}`.trim() : ''}`;
			const lines = [
				`Name: ${`${first} ${last}`.trim() || 'Prospective Collaborator'}`,
				email ? `Email: ${email}` : '',
				inst ? `Institution: ${inst}` : '',
				`Topic: ${topic}`,
				url ? `Link: ${url}` : '',
				'',
				msg
			].filter((v, idx, arr) => v !== '' || idx === arr.length - 2);
			return { subject, body: lines.join('\n') };
		}

		function showBanner(ok: boolean, text: string) {
			if (!banner) return;
			banner.hidden = false;
			banner.setAttribute('role', ok ? 'status' : 'alert');
			banner.className = `form-banner ${ok ? 'banner-ok' : 'banner-err'}`;
			banner.textContent = text;
			const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			banner.scrollIntoView({ behavior: prefersReduced ? 'auto' : 'smooth', block: 'nearest' });
			banner.focus();
		}

		mailtoBtn?.addEventListener('click', function () {
			const { subject, body } = buildDraft();
			window.location.href = `mailto:${LAB_EMAIL}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
		});

		gmailBtn?.addEventListener('click', function () {
			const { subject, body } = buildDraft();
			const gmailUrl = `https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(LAB_EMAIL)}&su=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
			window.open(gmailUrl, '_blank', 'noopener');
		});

		copyBtn?.addEventListener('click', async function () {
			try {
				await navigator.clipboard.writeText(LAB_EMAIL);
				showBanner(true, `Copied ${LAB_EMAIL} to clipboard.`);
			} catch (_e) {
				showBanner(true, `Official lab inbox: ${LAB_EMAIL}`);
			}
		});

		if (!(form instanceof HTMLFormElement)) return;

		form.addEventListener('submit', async function (e) {
			e.preventDefault();
			if (submitBtn instanceof HTMLButtonElement) {
				submitBtn.disabled = true;
				submitBtn.textContent = 'Sending...';
			}
			try {
				const formData = new FormData(form);
				const response = await fetch(form.action, {
					method: 'POST',
					body: formData,
					headers: { Accept: 'application/json' }
				});
				if (response.ok) {
					showBanner(true, 'Inquiry transmitted toward saail_lab@iitmz.ac.in. You can also keep a copy via "Open Email App" or "Open in Gmail Web" below.');
					form.reset();
				} else {
					showBanner(false, 'Direct endpoint delivery did not confirm; please use "Open Email App" or "Open in Gmail Web" below to send straight to saail_lab@iitmz.ac.in.');
				}
			} catch (_err) {
				showBanner(false, 'Network blocked form submission. Click "Open Email App" or "Open in Gmail Web" below to send directly to saail_lab@iitmz.ac.in.');
			} finally {
				if (submitBtn instanceof HTMLButtonElement) {
					submitBtn.disabled = false;
					submitBtn.textContent = 'Send to saail_lab@iitmz.ac.in →';
				}
			}
		});
	});
</script>

<style>
	.contact-layout {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
		gap: 2.25rem;
		align-items: start;
	}

	.form-card, .info-card {
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		border-radius: 1.1rem;
		padding: 2rem;
		box-shadow: 0 6px 20px var(--shadow-light);
	}

	.form-card h2, .info-card h2 {
		font-size: 1.45rem;
		color: var(--text-primary);
		margin-bottom: 0.45rem;
	}

	.form-intro, .profiles-sub {
		font-size: 0.94rem;
		color: var(--text-secondary);
		margin-bottom: 1.35rem;
		line-height: 1.55;
	}

	.form-intro a, .lab-email-link, .map-ext-link {
		color: var(--accent-primary);
		font-weight: 700;
		text-decoration: none;
	}

	.form-intro a:hover, .lab-email-link:hover, .map-ext-link:hover { text-decoration: underline; }

	.form-banner {
		padding: 0.9rem 1rem;
		border-radius: 0.7rem;
		font-size: 0.9rem;
		font-weight: 600;
		margin-bottom: 1.25rem;
	}
	.banner-ok { background: #ecfdf5; color: #14532d; border: 1px solid #bbf7d0; }
	.banner-err { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }

	.contact-form { display: flex; flex-direction: column; gap: 1.1rem; }

	.form-row {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}

	.form-group { display: flex; flex-direction: column; gap: 0.35rem; }
	.form-group label { font-size: 0.85rem; font-weight: 700; color: var(--text-primary); }

	.form-group input, .form-group select, .form-group textarea {
		width: 100%;
		padding: 0.75rem 0.9rem;
		border: 1px solid var(--border-color);
		border-radius: 0.65rem;
		background: var(--bg-secondary);
		color: var(--text-primary);
		font-family: inherit;
		font-size: 0.94rem;
	}

	.form-group input:focus-visible, .form-group select:focus-visible, .form-group textarea:focus-visible {
		outline: 2px solid var(--accent-primary);
		outline-offset: 2px;
		background: var(--bg-card);
	}

	.submit-actions {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		align-items: flex-start;
	}

	.submit-btn {
		align-self: flex-start;
		padding: 0.85rem 1.75rem;
		font-size: 0.96rem;
	}

	.direct-compose-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem;
	}

	.direct-btn {
		padding: 0.48rem 0.9rem;
		border-radius: 999px;
		border: 1px solid var(--border-color);
		background: var(--bg-secondary);
		color: var(--text-primary);
		font-size: 0.82rem;
		font-weight: 600;
		cursor: pointer;
		transition: all 0.16s ease;
	}

	.direct-btn:hover {
		border-color: var(--accent-primary);
		color: var(--accent-primary);
	}

	.info-stack { display: flex; flex-direction: column; gap: 1.5rem; }

	.map-wrap {
		border-radius: 0.85rem;
		overflow: hidden;
		border: 1px solid var(--border-color);
		margin: 0.85rem 0 0.6rem;
		background: var(--bg-secondary);
	}

	.map-ext-link { display: inline-block; font-size: 0.86rem; margin-bottom: 1.2rem; }

	.dir-list { display: flex; flex-direction: column; gap: 1rem; margin: 0; }
	.dir-item dt {
		font-size: 0.75rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--text-muted);
		margin-bottom: 0.2rem;
	}
	.dir-item dd {
		margin: 0;
		font-size: 0.94rem;
		color: var(--text-secondary);
		line-height: 1.58;
	}

	.social-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
	}

	.social-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.72rem 0.95rem;
		border-radius: 0.7rem;
		background: var(--bg-secondary);
		border: 1px solid var(--border-color);
		color: var(--accent-primary);
		text-decoration: none;
		font-size: 0.88rem;
		font-weight: 700;
		transition: border-color 0.16s ease, background 0.16s ease, transform 0.16s ease;
	}

	.social-chip:hover {
		background: var(--accent-primary);
		border-color: var(--accent-primary);
		color: #ffffff;
		transform: translateY(-2px);
	}
	:global([data-theme="dark"]) .social-chip:hover { color: #062111; }

	@media (max-width: 960px) {
		.contact-layout { grid-template-columns: minmax(0, 1fr); }
	}
	@media (max-width: 600px) {
		.form-row, .social-grid { grid-template-columns: minmax(0, 1fr); }
		.form-card, .info-card { padding: 1.25rem; min-width: 0; }
		.form-group, .form-group select { min-width: 0; max-width: 100%; }
	}
</style>
