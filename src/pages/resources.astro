---
import Layout from '../layouts/Layout.astro';
import ModernHeader from '../components/ModernHeader.astro';
import ModernFooter from '../components/ModernFooter.astro';
---

<Layout
	title="Resources & Reproducibility Ledger | SAAIL Lab | IIT Madras Zanzibar"
	description="Open science artifacts, dataset manifests, offline edge mobile tools, citation standards, and student fellowship pathways at SAAIL Lab, IIT Madras Zanzibar."
	canonical="https://saaillab.github.io/resources/"
>
	<ModernHeader currentPage="resources" />

	<main id="main-content">
		<section class="page-hero">
			<div class="container">
				<span class="page-eyebrow">Open Science &amp; Reproducibility</span>
				<h1 class="page-title">Reproducibility Ledger &amp; Lab Resources</h1>
				<p class="page-lead">
					SAAIL Lab publishes verifiable dataset manifests, ONNX/TFLite deployment binaries, peer-reviewed BibTeX records, and structured research onboarding at IIT Madras Zanzibar under <a href="https://creativecommons.org/licenses/by-nc/4.0/" target="_blank" rel="license noopener">CC BY-NC 4.0</a>.
				</p>
			</div>
		</section>

		<section class="section">
			<div class="container ledger-wrap">
				<!-- Group 1: Datasets & Evaluation Manifests -->
				<div class="ledger-group">
					<div class="ledger-head">
						<div>
							<span class="group-kicker">01 · Open Benchmarks &amp; Audit Manifests</span>
							<h2>Verified Datasets &amp; Leakage-Controlled Splits</h2>
						</div>
						<a href="/datasets/" class="btn btn-secondary">Browse Full Dataset Catalog &rarr;</a>
					</div>
					<div class="ledger-rows">
						<article class="ledger-row">
							<div class="row-tag">CVPR 2026 · ETRI Q2</div>
							<div class="row-main">
								<h3>CLOVES-4603 &amp; ZSTC-Clove-V1 Commercial Clove Benchmarks</h3>
								<p>Lot-aware stratified 70/10/20 splits and foreground clove masks calibrated with certified ZSTC Saateni graders across four official quality tiers.</p>
							</div>
							<div class="row-actions">
								<a href="/papers/cloves-4603/" class="row-link">Paper Page</a>
								<a href="https://github.com/saaillab/CLOVES-4603" target="_blank" rel="noopener" class="row-link">GitHub ↗</a>
							</div>
						</article>

						<article class="ledger-row">
							<div class="row-tag">Zero-Leakage Audit</div>
							<div class="row-main">
								<h3>CropGuardNet Deduplicated Splits &amp; DGS-Bench Suites</h3>
								<p>UUID specimen grouping and 64-bit DCT perceptual hash manifests purging 80,238 PlantVillage duplicates alongside Kaggle-ready DGS-Bench field/lab balance tests.</p>
							</div>
							<div class="row-actions">
								<a href="/papers/cropguardnet/" class="row-link">CropGuardNet</a>
								<a href="/papers/dgs-bench/" class="row-link">DGS-Bench</a>
							</div>
						</article>

						<article class="ledger-row">
							<div class="row-tag">Swahili NLP</div>
							<div class="row-main">
								<h3>Zanzibar Swahili Corpus &amp; Dira Provenance Benchmark</h3>
								<p>Coastal Kiunguja prose and spoken agricultural QA corpora paired with stylometric detectors distinguishing natural native Swahili from machine-translated text.</p>
							</div>
							<div class="row-actions">
								<a href="/projects/swahili-dira/" class="row-link">Project Site</a>
								<a href="/datasets/#language" class="row-link">Catalog Entry</a>
							</div>
						</article>
					</div>
				</div>

				<!-- Group 2: Software & Offline Field Prototypes -->
				<div class="ledger-group">
					<div class="ledger-head">
						<div>
							<span class="group-kicker">02 · Codebases &amp; Edge Binaries</span>
							<h2>Open-Source Repositories &amp; Field Prototypes</h2>
						</div>
						<a href="/tools/" class="btn btn-secondary">All Software &amp; Apps &rarr;</a>
					</div>
					<div class="ledger-rows">
						<article class="ledger-row">
							<div class="row-tag">PyTorch · ONNX</div>
							<div class="row-main">
								<h3>SAAIL Lab GitHub Organization (7 Public Repositories)</h3>
								<p>Maintained training scripts, EER XAI faithfulness evaluators, and reproducibility workflows across CropGuardNet, DGS-Bench, CLOVES-4603, CARA-FM, and DDR.</p>
							</div>
							<div class="row-actions">
								<a href="/github/" class="row-link">Repo Index</a>
								<a href="https://github.com/saaillab" target="_blank" rel="noopener" class="row-link">GitHub Org ↗</a>
							</div>
						</article>

						<article class="ledger-row">
							<div class="row-tag">Flutter · TFLite INT8</div>
							<div class="row-main">
								<h3>Ubora-AI &amp; Maize Foliar Offline Field Applications</h3>
								<p>Quantized on-device Android inspection tools enabling connectivity-independent ZSTC clove grading and maize lesion segmentation on budget smartphones.</p>
							</div>
							<div class="row-actions">
								<a href="/tools/" class="row-link">Inspect Tools</a>
								<a href="/projects/ubora-ai/" class="row-link">Ubora-AI Site</a>
							</div>
						</article>
					</div>
				</div>

				<!-- Group 3: Scholarly Writing, Citations & Onboarding -->
				<div class="ledger-group">
					<div class="ledger-head">
						<div>
							<span class="group-kicker">03 · Academic Workflows &amp; Supervision</span>
							<h2>Citations, Reporting Checklists &amp; Joining the Lab</h2>
						</div>
						<a href="/publications/" class="btn btn-secondary">All 20 SAAIL Lab Publications &rarr;</a>
					</div>
					<div class="ledger-rows">
						<article class="ledger-row">
							<div class="row-tag">BibTeX Citations</div>
							<div class="row-main">
								<h3>Per-Paper Citation Records &amp; DOI Archive</h3>
								<p>Every SAAIL Lab paper includes 1-click copy-ready BibTeX citations, official DOI links, and structured technical summaries.</p>
							</div>
							<div class="row-actions">
								<a href="/publications/" class="row-link">Publications</a>
								<a href="https://scholar.google.com/citations?user=jYVzIZUAAAAJ&hl=en" target="_blank" rel="noopener" class="row-link">Google Scholar ↗</a>
							</div>
						</article>

						<article class="ledger-row">
							<div class="row-tag">Clinical &amp; Agricultural AI</div>
							<div class="row-main">
								<h3>AgriAI Bias Card &amp; PlacentaVision Morphometry Protocols</h3>
								<p>Standardized five-dimension dataset representativeness rubrics and quality-controlled bedside placental segmentation workflows.</p>
							</div>
							<div class="row-actions">
								<a href="/papers/auditing-crop-datasets-dsa2026/" class="row-link">AgriAI Audit</a>
								<a href="/projects/placentavision/" class="row-link">PlacentaVision</a>
							</div>
						</article>

						<article class="ledger-row">
							<div class="row-tag">IITMZ Fellowships</div>
							<div class="row-main">
								<h3>Prospective MTech DSAI, BS Fellows &amp; Visiting Collaborators</h3>
								<p>Research expectations, project matching areas, and application instructions for joining SAAIL Lab at Bweleo Campus, Zanzibar.</p>
							</div>
							<div class="row-actions">
								<a href="/hiring/" class="row-link">Open Roles</a>
								<a href="/contact/" class="row-link">Contact Lab</a>
							</div>
						</article>
					</div>
				</div>
				<!-- Group 4: Speaking & Upcoming Meetings -->
				<div class="ledger-group" id="speaking">
					<div class="ledger-head">
						<div>
							<span class="group-kicker">04 · Speaking &amp; Conference Calendar</span>
							<h2>Upcoming Meetings &amp; Conference Schedule</h2>
						</div>
						<a href="/news/" class="btn btn-secondary">All Lab News &amp; Awards &rarr;</a>
					</div>

					<div class="speaking-featured">
						<div class="speaking-meta">
							<span class="speaking-badge">Upcoming · December 2&ndash;3, 2026</span>
							<span class="speaking-loc">Zanzibar State Trading Corporation (ZSTC)</span>
						</div>
						<h3>5th ZSTC Conference</h3>
						<p>
							Innocent Nyalala will attend the 5th Conference for the Zanzibar State Trading Corporation (ZSTC) on December 2&ndash;3, 2026. Session schedule and presentation details will be shared following the event.
						</p>
						<div class="row-actions">
							<a href="/projects/ubora-ai/" class="row-link">Ubora-AI ZSTC Grading</a>
							<a href="/tools/#live-demo" class="row-link">Live Clove ONNX Demo</a>
						</div>
					</div>

					<div class="ledger-rows">
						<article class="ledger-row">
							<div class="row-tag">August 2026</div>
							<div class="row-main">
								<h3>Deep Learning Indaba 2026 (Pan-Atlantic University, Lagos)</h3>
								<p>Best Poster Award for DGS-Bench (selected 18 of 114 submissions), quantifying deployment gap evaluation mirages across East African smallholder crop diagnostics.</p>
							</div>
							<div class="row-actions">
								<a href="/papers/dgs-bench/" class="row-link">DGS-Bench Paper</a>
								<a href="/gallery/#dli-2026" class="row-link">Lagos Gallery</a>
							</div>
						</article>

						<article class="ledger-row">
							<div class="row-tag">July 2026</div>
							<div class="row-main">
								<h3>Data Science Africa 2026 (Makerere University, Kampala)</h3>
								<p>Oral talk and three empirical studies on Ugandan cassava low-shot transfer, DCGAN scarcity failure, and the AgriAI Bias Card benchmark rubric.</p>
							</div>
							<div class="row-actions">
								<a href="/papers/dcgan-cassava-dsa2026/" class="row-link">DSA Oral Study</a>
								<a href="/gallery/#dsa-2026" class="row-link">Kampala Gallery</a>
							</div>
						</article>

						<article class="ledger-row">
							<div class="row-tag">March &amp; June 2026</div>
							<div class="row-main">
								<h3>CVPR 2026 V4A, 3rd TAIS (Oxford) &amp; ICLR 2026 Workshops</h3>
								<p>Peer-reviewed workshop presentations across commercial clove benchmarking (CLOVES-4603), East African AI policy harmonization at Oxford Martin School, and Dynamic Data Re-weighting in Rio de Janeiro.</p>
							</div>
							<div class="row-actions">
								<a href="/papers/cloves-4603/" class="row-link">CLOVES-4603</a>
								<a href="/papers/ai-policy-harmonization-tais2026/" class="row-link">TAIS Oxford</a>
							</div>
						</article>
					</div>
				</div>

				<!-- Group 5: Official Media & Press Kit -->
				<div class="ledger-group" id="media-kit">
					<div class="ledger-head">
						<div>
							<span class="group-kicker">05 · Press, Bios &amp; Visual Assets</span>
							<h2>Official Lab Media &amp; Press Kit</h2>
						</div>
						<a href="/contact/" class="btn btn-secondary">Press &amp; Media Inquiries &rarr;</a>
					</div>

					<div class="media-grid">
						<div class="media-asset-card">
							<img src="/images/logo/saail-crest.png" alt="SAAIL Lab official circular crest" width="72" height="72" class="media-thumb" />
							<div>
								<h3>SAAIL Lab Crest</h3>
								<p>Circular botanical emblem (PNG)</p>
								<a href="/images/logo/saail-crest.png" download="saail-lab-crest.png" class="row-link">Download PNG</a>
							</div>
						</div>
						<div class="media-asset-card">
							<img src="/images/logo/saail-logo.png" alt="SAAIL Lab horizontal banner logo" width="120" height="52" class="media-thumb media-wide" />
							<div>
								<h3>SAAIL Lab Full Logo</h3>
								<p>Horizontal wordmark + crest (PNG)</p>
								<a href="/images/logo/saail-logo.png" download="saail-lab-logo.png" class="row-link">Download PNG</a>
							</div>
						</div>
						<div class="media-asset-card">
							<img src="/images/people/innocent-nyalala-saail-lab-zanzibar.jpg" alt="Innocent Nyalala, Principal Investigator of SAAIL Lab at IIT Madras Zanzibar" width="72" height="72" class="media-thumb" />
							<div>
								<h3>PI Portrait</h3>
								<p>Innocent Nyalala high-res photo</p>
								<a href="/images/people/innocent-nyalala-saail-lab-zanzibar.jpg" download="innocent-nyalala-portrait.jpg" class="row-link">Download JPG</a>
							</div>
						</div>
					</div>

					<div class="bio-copy-grid">
						<div class="bio-box">
							<div class="bio-box-head">
								<h3>Approved Lab Description</h3>
								<button type="button" class="copy-bio-btn" data-bio-target="labBioText">Copy Bio</button>
							</div>
							<p id="labBioText">
								The Sustainable AI for Agriculture and Intelligent Livelihoods (SAAIL) Lab at the School of Engineering and Science, IIT Madras Zanzibar, develops lightweight deep learning, Swahili NLP, deployment gap audits, and clinical ML systems built for East African agricultural, coastal, and healthcare settings.
							</p>
						</div>
						<div class="bio-box">
							<div class="bio-box-head">
								<h3>Principal Investigator Bio</h3>
								<button type="button" class="copy-bio-btn" data-bio-target="piBioText">Copy Bio</button>
							</div>
							<p id="piBioText">
								Innocent Nyalala is an Assistant Professor at IIT Madras Zanzibar and Associate Research Fellow at the Wadhwani School of Data Science and AI, IIT Madras. He leads SAAIL Lab across agricultural vision, compositional explainability, Swahili language benchmarks, and maternal clinical machine learning.
							</p>
						</div>
					</div>
				</div>
			</div>
		</section>
	</main>

	<ModernFooter />
</Layout>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		document.querySelectorAll('.copy-bio-btn').forEach((btn) => {
			btn.addEventListener('click', async () => {
				const tid = btn.getAttribute('data-bio-target') || '';
				const el = document.getElementById(tid);
				const txt = el?.textContent?.trim() || '';
				if (!txt) return;
				let ok = false;
				try {
					await navigator.clipboard.writeText(txt);
					ok = true;
				} catch (_e) {
					const area = document.createElement('textarea');
					area.value = txt;
					area.style.position = 'fixed';
					area.style.opacity = '0';
					document.body.appendChild(area);
					area.select();
					try { ok = document.execCommand('copy'); } catch (_e2) {}
					document.body.removeChild(area);
				}
				if (ok) {
					btn.textContent = 'Copied!';
					const liveEl = document.getElementById('saailLiveStatus');
					if (liveEl) {
						liveEl.textContent = '';
						requestAnimationFrame(() => { liveEl.textContent = 'Biography text copied to clipboard.'; });
					}
					setTimeout(() => { btn.textContent = 'Copy Bio'; }, 1600);
				}
			});
		});
	});
</script>

<style>
	.ledger-wrap {
		display: flex;
		flex-direction: column;
		gap: 3rem;
	}

	.ledger-head {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		flex-wrap: wrap;
		gap: 1rem;
		padding-bottom: 1rem;
		border-bottom: 2px solid var(--border-color);
		margin-bottom: 0.75rem;
	}

	.group-kicker {
		display: block;
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.76rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--accent-primary);
		margin-bottom: 0.3rem;
	}

	.ledger-head h2 {
		font-size: 1.5rem;
		color: var(--text-primary);
		margin: 0;
	}

	.ledger-rows {
		display: flex;
		flex-direction: column;
	}

	.ledger-row {
		display: grid;
		grid-template-columns: 165px minmax(0, 1fr) auto;
		gap: 1.5rem;
		align-items: center;
		padding: 1.35rem 0.5rem;
		border-bottom: 1px solid var(--border-color);
	}

	.row-tag {
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.76rem;
		font-weight: 700;
		color: var(--accent-primary);
		background: rgba(20, 83, 45, 0.08);
		border: 1px solid rgba(20, 83, 45, 0.2);
		padding: 0.28rem 0.65rem;
		border-radius: 6px;
		text-align: center;
	}
	:global([data-theme="dark"]) .row-tag {
		background: rgba(34, 197, 94, 0.14);
		border-color: rgba(34, 197, 94, 0.3);
	}

	.row-main h3 {
		font-size: 1.06rem;
		color: var(--text-primary);
		margin: 0 0 0.3rem;
	}

	.row-main p {
		margin: 0;
		font-size: 0.92rem;
		line-height: 1.58;
		color: var(--text-secondary);
	}

	.row-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem;
	}

	.row-link {
		display: inline-block;
		padding: 0.42rem 0.85rem;
		border-radius: 999px;
		border: 1px solid var(--border-color);
		background: var(--bg-secondary);
		color: var(--text-primary);
		font-size: 0.82rem;
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
		transition: all 0.16s ease;
	}

	.row-link:hover {
		border-color: var(--accent-primary);
		color: var(--accent-primary);
	}

	.speaking-featured {
		background: var(--bg-card);
		border: 1.5px solid var(--accent-primary);
		border-radius: 1rem;
		padding: 1.4rem 1.5rem;
		margin-bottom: 1.25rem;
		box-shadow: 0 4px 16px var(--shadow-light);
	}
	.speaking-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.65rem;
		margin-bottom: 0.55rem;
	}
	.speaking-badge {
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.74rem;
		font-weight: 800;
		padding: 0.22rem 0.65rem;
		border-radius: 999px;
		background: #ecfdf5;
		color: #14532d;
	}
	:global([data-theme="dark"]) .speaking-badge {
		background: rgba(52, 211, 153, 0.16);
		color: #34d399;
	}
	.speaking-loc {
		font-size: 0.82rem;
		font-weight: 600;
		color: var(--text-muted);
	}
	.speaking-featured h3 {
		font-size: 1.28rem;
		color: var(--text-primary);
		margin: 0 0 0.45rem;
	}
	.speaking-featured p {
		font-size: 0.94rem;
		line-height: 1.6;
		color: var(--text-secondary);
		margin: 0 0 0.85rem;
	}
	.media-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
		margin-bottom: 1.25rem;
	}
	.media-asset-card {
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		border-radius: 0.9rem;
		padding: 1.1rem;
		display: flex;
		align-items: center;
		gap: 1rem;
	}
	.media-thumb {
		width: 68px;
		height: 68px;
		object-fit: cover;
		object-position: center top;
		border-radius: 0.55rem;
		background: #ffffff;
		border: 1px solid var(--border-color);
		flex-shrink: 0;
		padding: 3px;
	}
	.media-wide {
		width: 96px;
		height: 56px;
		object-fit: contain;
	}
	.media-asset-card h3 {
		font-size: 0.98rem;
		color: var(--text-primary);
		margin: 0 0 0.2rem;
	}
	.media-asset-card p {
		font-size: 0.8rem;
		color: var(--text-muted);
		margin: 0 0 0.5rem;
	}
	.bio-copy-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}
	.bio-box {
		background: var(--bg-secondary);
		border: 1px solid var(--border-color);
		border-radius: 0.9rem;
		padding: 1.15rem;
	}
	.bio-box-head {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 0.55rem;
	}
	.bio-box-head h3 {
		font-size: 0.95rem;
		color: var(--text-primary);
		margin: 0;
	}
	.copy-bio-btn {
		padding: 0.25rem 0.65rem;
		border-radius: 6px;
		border: 1px solid var(--border-color);
		background: var(--bg-card);
		color: var(--accent-primary);
		font-family: inherit;
		font-size: 0.74rem;
		font-weight: 700;
		cursor: pointer;
	}
	.copy-bio-btn:hover { border-color: var(--accent-primary); }
	.bio-box p {
		margin: 0;
		font-size: 0.88rem;
		line-height: 1.6;
		color: var(--text-secondary);
	}

	@media (max-width: 820px) {
		.ledger-row {
			grid-template-columns: minmax(0, 1fr);
			gap: 0.75rem;
			padding: 1.25rem 0;
		}
		.media-grid,
		.bio-copy-grid {
			grid-template-columns: minmax(0, 1fr);
		}
		.row-tag {
			width: fit-content;
		}
	}
</style>
