---
import Layout from '../layouts/Layout.astro';
import ModernHeader from '../components/ModernHeader.astro';
import ModernFooter from '../components/ModernFooter.astro';
---

<Layout
	title="Resources & Reproducibility Ledger | SAAIL Lab | IIT Madras Zanzibar"
	description="Open science artifacts, dataset manifests, offline edge mobile tools, citation standards, and student fellowship pathways at SAAIL Lab, IIT Madras Zanzibar."
	canonical="https://saaillab.github.io/resources/"
>
	<ModernHeader currentPage="resources" />

	<main id="main-content">
		<section class="page-hero">
			<div class="container">
				<span class="page-eyebrow">Open Science &amp; Reproducibility</span>
				<h1 class="page-title">Reproducibility Ledger &amp; Lab Resources</h1>
				<p class="page-lead">
					SAAIL Lab publishes verifiable dataset manifests, ONNX/TFLite deployment binaries, peer-reviewed BibTeX records, and structured research onboarding at IIT Madras Zanzibar.
				</p>
			</div>
		</section>

		<section class="section">
			<div class="container ledger-wrap">
				<!-- Group 1: Datasets & Evaluation Manifests -->
				<div class="ledger-group">
					<div class="ledger-head">
						<div>
							<span class="group-kicker">01 · Open Benchmarks &amp; Audit Manifests</span>
							<h2>Verified Datasets &amp; Leakage-Controlled Splits</h2>
						</div>
						<a href="/datasets/" class="btn btn-secondary">Browse Full Dataset Catalog &rarr;</a>
					</div>
					<div class="ledger-rows">
						<article class="ledger-row">
							<div class="row-tag">CVPR 2026 · ETRI Q2</div>
							<div class="row-main">
								<h3>CLOVES-4603 &amp; ZSTC-Clove-V1 Commercial Clove Benchmarks</h3>
								<p>Lot-aware stratified 70/10/20 splits and foreground clove masks calibrated with certified ZSTC Saateni graders across four official quality tiers.</p>
							</div>
							<div class="row-actions">
								<a href="/papers/cloves-4603/" class="row-link">Paper Page</a>
								<a href="https://github.com/saaillab/CLOVES-4603" target="_blank" rel="noopener" class="row-link">GitHub ↗</a>
							</div>
						</article>

						<article class="ledger-row">
							<div class="row-tag">Zero-Leakage Audit</div>
							<div class="row-main">
								<h3>CropGuardNet Deduplicated Splits &amp; DGS-Bench Harnesses</h3>
								<p>UUID specimen grouping and 64-bit DCT perceptual hash manifests purging 80,238 PlantVillage duplicates alongside Kaggle-ready DGS-Bench field/lab balance tests.</p>
							</div>
							<div class="row-actions">
								<a href="/papers/cropguardnet/" class="row-link">CropGuardNet</a>
								<a href="/papers/dgs-bench/" class="row-link">DGS-Bench</a>
							</div>
						</article>

						<article class="ledger-row">
							<div class="row-tag">Swahili NLP</div>
							<div class="row-main">
								<h3>Zanzibar Swahili Corpus &amp; Dira Provenance Benchmark</h3>
								<p>Coastal Kiunguja prose and spoken agricultural QA corpora paired with stylometric detectors distinguishing natural native Swahili from machine-translated text.</p>
							</div>
							<div class="row-actions">
								<a href="/projects/swahili-dira/" class="row-link">Project Site</a>
								<a href="/datasets/#language" class="row-link">Catalog Entry</a>
							</div>
						</article>
					</div>
				</div>

				<!-- Group 2: Software & Offline Field Prototypes -->
				<div class="ledger-group">
					<div class="ledger-head">
						<div>
							<span class="group-kicker">02 · Codebases &amp; Edge Binaries</span>
							<h2>Open-Source Repositories &amp; Field Prototypes</h2>
						</div>
						<a href="/tools/" class="btn btn-secondary">All Software &amp; Apps &rarr;</a>
					</div>
					<div class="ledger-rows">
						<article class="ledger-row">
							<div class="row-tag">PyTorch · ONNX</div>
							<div class="row-main">
								<h3>SAAIL Lab GitHub Organization (7 Public Repositories)</h3>
								<p>Maintained training scripts, EER XAI faithfulness evaluators, and reproducibility workflows across CropGuardNet, DGS-Bench, CLOVES-4603, CARA-FM, and DDR.</p>
							</div>
							<div class="row-actions">
								<a href="/github/" class="row-link">Repo Index</a>
								<a href="https://github.com/saaillab" target="_blank" rel="noopener" class="row-link">GitHub Org ↗</a>
							</div>
						</article>

						<article class="ledger-row">
							<div class="row-tag">Flutter · TFLite INT8</div>
							<div class="row-main">
								<h3>Ubora-AI &amp; Maize Foliar Offline Field Applications</h3>
								<p>Quantized on-device Android inspection tools enabling connectivity-independent ZSTC clove grading and maize lesion segmentation on budget smartphones.</p>
							</div>
							<div class="row-actions">
								<a href="/tools/" class="row-link">Inspect Tools</a>
								<a href="/projects/ubora-ai/" class="row-link">Ubora-AI Site</a>
							</div>
						</article>
					</div>
				</div>

				<!-- Group 3: Scholarly Writing, Citations & Onboarding -->
				<div class="ledger-group">
					<div class="ledger-head">
						<div>
							<span class="group-kicker">03 · Academic Workflows &amp; Supervision</span>
							<h2>Citations, Reporting Checklists &amp; Joining the Lab</h2>
						</div>
						<a href="/publications/" class="btn btn-secondary">All 42 Publications &rarr;</a>
					</div>
					<div class="ledger-rows">
						<article class="ledger-row">
							<div class="row-tag">BibTeX &amp; APA</div>
							<div class="row-main">
								<h3>Per-Paper Citation Records &amp; DOI Archive</h3>
								<p>Every SAAIL Lab paper and prior Nanjing Agricultural University work includes copy-ready BibTeX/APA citations, official DOI links, and full technical abstracts.</p>
							</div>
							<div class="row-actions">
								<a href="/publications/" class="row-link">Publications</a>
								<a href="https://scholar.google.com/citations?user=jYVzIZUAAAAJ&hl=en" target="_blank" rel="noopener" class="row-link">Google Scholar ↗</a>
							</div>
						</article>

						<article class="ledger-row">
							<div class="row-tag">Clinical &amp; Agricultural AI</div>
							<div class="row-main">
								<h3>AgriAI Bias Card &amp; PlacentaVision Morphometry Protocols</h3>
								<p>Standardized five-dimension dataset representativeness rubrics and quality-controlled bedside placental segmentation workflows.</p>
							</div>
							<div class="row-actions">
								<a href="/papers/auditing-crop-datasets-dsa2026/" class="row-link">AgriAI Audit</a>
								<a href="/projects/placentavision/" class="row-link">PlacentaVision</a>
							</div>
						</article>

						<article class="ledger-row">
							<div class="row-tag">IITMZ Fellowships</div>
							<div class="row-main">
								<h3>Prospective MTech DSAI, BS Fellows &amp; Visiting Collaborators</h3>
								<p>Research expectations, project matching areas, and application instructions for joining SAAIL Lab at Bweleo Campus, Zanzibar.</p>
							</div>
							<div class="row-actions">
								<a href="/hiring/" class="row-link">Open Roles</a>
								<a href="/contact/" class="row-link">Contact Lab</a>
							</div>
						</article>
					</div>
				</div>
			</div>
		</section>
	</main>

	<ModernFooter />
</Layout>

<style>
	.ledger-wrap {
		display: flex;
		flex-direction: column;
		gap: 3rem;
	}

	.ledger-head {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		flex-wrap: wrap;
		gap: 1rem;
		padding-bottom: 1rem;
		border-bottom: 2px solid var(--border-color);
		margin-bottom: 0.75rem;
	}

	.group-kicker {
		display: block;
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.76rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--accent-primary);
		margin-bottom: 0.3rem;
	}

	.ledger-head h2 {
		font-size: 1.5rem;
		color: var(--text-primary);
		margin: 0;
	}

	.ledger-rows {
		display: flex;
		flex-direction: column;
	}

	.ledger-row {
		display: grid;
		grid-template-columns: 165px minmax(0, 1fr) auto;
		gap: 1.5rem;
		align-items: center;
		padding: 1.35rem 0.5rem;
		border-bottom: 1px solid var(--border-color);
	}

	.row-tag {
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.76rem;
		font-weight: 700;
		color: var(--accent-primary);
		background: rgba(20, 83, 45, 0.08);
		border: 1px solid rgba(20, 83, 45, 0.2);
		padding: 0.28rem 0.65rem;
		border-radius: 6px;
		text-align: center;
	}

	.row-main h3 {
		font-size: 1.06rem;
		color: var(--text-primary);
		margin: 0 0 0.3rem;
	}

	.row-main p {
		margin: 0;
		font-size: 0.92rem;
		line-height: 1.58;
		color: var(--text-secondary);
	}

	.row-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem;
	}

	.row-link {
		display: inline-block;
		padding: 0.42rem 0.85rem;
		border-radius: 999px;
		border: 1px solid var(--border-color);
		background: var(--bg-secondary);
		color: var(--text-primary);
		font-size: 0.82rem;
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
		transition: all 0.16s ease;
	}

	.row-link:hover {
		border-color: var(--accent-primary);
		color: var(--accent-primary);
	}

	@media (max-width: 820px) {
		.ledger-row {
			grid-template-columns: 1fr;
			gap: 0.75rem;
			padding: 1.25rem 0;
		}
		.row-tag {
			width: fit-content;
		}
	}
</style>
