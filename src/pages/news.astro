									View on LinkedIn
								</a>
							</div>
						</div>
					</article>

					<!-- Editorial Board -->
					<article class="story" data-cat="lab"
						data-title="Appointed to Editorial Board — Discover Artificial Intelligence"
						data-date="9 Dec 2025"
						data-body="Innocent Nyalala has been appointed as Editorial Board Member of Discover Artificial Intelligence, a Springer Nature open-access journal publishing original research across all areas of artificial intelligence. This appointment recognises his sustained contributions to responsible AI research and AI for agriculture in Africa."
						data-tags="Editorial Board,Springer Nature,Academic Service"
						data-cta-label="View Editorial Board"
						data-cta-href="https://link.springer.com/journal/44163/editorial-board"
						data-external="true">
