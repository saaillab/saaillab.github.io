---
import Layout from '../layouts/Layout.astro';
import ModernHeader from '../components/ModernHeader.astro';
import ModernFooter from '../components/ModernFooter.astro';
---

<Layout
	title="News & Updates — SAAIL Lab"
	description="Latest research news, publications, awards, and milestones from SAAIL Lab at IIT Madras Zanzibar."
>
	<ModernHeader />

	<main class="news-page">

		<!-- ═══════════════════════════════════ HERO ═══════════════════════════════════ -->
		<section class="hero">
			<div class="hero-canvas">
				<div class="hero-orb hero-orb--1"></div>
				<div class="hero-orb hero-orb--2"></div>
				<div class="hero-orb hero-orb--3"></div>
			</div>
			<div class="container hero-inner">
				<div class="hero-kicker">
					<span class="kicker-dot"></span>
					SAAIL Lab · IIT Madras Zanzibar
				</div>
				<h1 class="hero-heading">
					News<br/><em>&amp;</em> Updates
				</h1>
				<p class="hero-body">
					Research breakthroughs, paper acceptances, awards, and milestones
					from East Africa's AI frontier.
				</p>
				<div class="hero-chips">
					<div class="hero-chip">
						<span class="chip-num">33+</span>
						<span class="chip-label">Publications</span>
					</div>
					<div class="hero-chip">
						<span class="chip-num">11</span>
						<span class="chip-label">Papers in 2026</span>
					</div>
					<div class="hero-chip hero-chip--gold">
						<span class="chip-num">🏆🏆</span>
						<span class="chip-label">Best Poster DLI 2025 &amp; 2026</span>
					</div>
				</div>
			</div>
		</section>

		<!-- ════════════════════════════════ FILTER BAR ════════════════════════════════ -->
		<div class="filter-wrap" id="filter-wrap">
			<div class="container filter-inner">
				<nav class="filter-nav" aria-label="Filter news">
					<button class="fpill fpill--active" data-cat="all">All</button>
					<button class="fpill" data-cat="publication">Publications</button>
					<button class="fpill" data-cat="award">Awards</button>
					<button class="fpill" data-cat="talk">Talks</button>
					<button class="fpill" data-cat="lab">Lab</button>
				</nav>
				<span class="filter-count" id="filter-count"></span>
			</div>
		</div>

		<!-- ════════════════════════════════ STORIES ════════════════════════════════ -->
		<section class="stories-section">
			<div class="container">

				<!-- Featured -->
				<div class="story story--featured" data-cat="publication"
					data-title="10 Papers Accepted — AAIAC 2026, DSA 2026, CV4A@CVPR & ICLR 2026"
					data-date="May 2026"
					data-body="SAAIL Lab's most productive academic season to date: 10 papers accepted across four prestigious international venues.

AAIAC 2026 (Dar es Salaam, Tanzania · 22–23 July): Five papers by Patrick Ndowo and Innocent Nyalala — covering EAC Regional AI Strategy analysis, leakage-free fraud detection benchmarks for mobile banking, physics-informed solar irradiance forecasting for Tanzanian off-grid mini-grids, hybrid ML frameworks for African military 5G cyber-defence, and insurgency hotspot prediction in the Sahel.

DSA 2026 (Makerere University, Kampala · 23–24 July): Three papers including an oral presentation on DCGAN augmentation failure under extreme data scarcity for cassava disease classification, and two poster presentations on auditing crop disease benchmark datasets and few-shot transfer learning under East African field conditions.

CV4A@CVPR 2026 (May 2026): CLOVES-4603 — benchmarking classical texture features and fine-tuned deep models for clove quality grading by Innocent Nyalala and Patrick Vincent.

ICLR 2026 Workshop on Trustworthy AI-Interpretability (March 2026): Unifying Perspectives on Learning Biases — a data-centric intervention for holistic fairness, robustness, and generalization by Patrick Vincent and Innocent Nyalala."
					data-tags="AAIAC 2026,DSA 2026,CVPR 2026,ICLR 2026,10 Papers"
					data-cta-label="View All Publications"
					data-cta-href="/publications">
					<div class="featured-inner">
						<div class="featured-left">
							<div class="featured-meta">
								<span class="sbadge sbadge--publication">Publications</span>
								<span class="sdate">May 2026</span>
							</div>
							<h2 class="featured-title">10 Papers Accepted —<br/>AAIAC · DSA · CVPR · ICLR</h2>
							<p class="featured-body">A landmark academic season for SAAIL Lab. Five papers at AAIAC 2026 in Dar es Salaam, three at DSA 2026 in Kampala (1 oral + 2 posters), one at CV4A@CVPR 2026, and one at the ICLR 2026 Trustworthy AI Workshop.</p>
							<div class="featured-actions">
								<button class="sbtn sbtn--light" data-open>Read full story</button>
								<a href="/publications" class="sbtn sbtn--ghost">View publications →</a>
							</div>
						</div>
						<div class="featured-right" aria-hidden="true">
							<div class="featured-venues">
								<div class="venue-pill venue-pill--blue">AAIAC 2026 · 5 papers</div>
								<div class="venue-pill venue-pill--green">DSA 2026 · 3 papers</div>
								<div class="venue-pill venue-pill--orange">CV4A@CVPR 2026</div>
								<div class="venue-pill venue-pill--purple">ICLR 2026 Workshop</div>
							</div>
						</div>
					</div>
				</div>

				<!-- Grid -->
				<div class="grid" id="stories-grid">

					<!-- DLI 2026 Best Poster Award -->
					<article class="story story--award" data-cat="award"
						data-title="Best Poster Award — Deep Learning Indaba 2026, Lagos"
						data-date="6 Aug 2026"
						data-body="SAAIL Lab wins the Best Poster Award at Deep Learning Indaba 2026, held in Lagos, Nigeria (3–8 August 2026). The winning poster presented DGS-Bench: a benchmark for Deep Grounding and Segmentation of agricultural scenes, one of just 18 papers accepted out of 114 submissions — a 15.82% acceptance rate. This is SAAIL Lab's second consecutive Best Poster Award at the Indaba, following the CARA-FMs award in Kigali in 2025. DLI 2026 marks the 9th edition of Africa's premier machine learning conference; the next edition will be held in South Africa, marking the 10th anniversary of the Indaba."
						data-tags="Best Poster,Award,Deep Learning Indaba,Lagos,DGS-Bench,Nigeria"
						data-cta-label="View on LinkedIn"
						data-cta-href="https://www.linkedin.com/in/innocentnyalala/"
						data-external="true"
						data-linkedin="true">
						<div class="story-stripe story-stripe--award"></div>
						<div class="story-body">
							<div class="story-meta">
								<span class="sbadge sbadge--award">🏆 Award</span>
								<span class="sdate">6 Aug 2026</span>
							</div>
							<h3 class="story-title">Best Poster Award — Deep Learning Indaba 2026, Lagos</h3>
							<p class="story-preview">DGS-Bench wins Best Poster at DLI 2026 in Nigeria — SAAIL Lab's second consecutive award at Africa's premier ML conference.</p>
							<div class="story-foot">
								<a href="https://www.linkedin.com/in/innocentnyalala/" target="_blank" rel="noopener" class="sbtn sbtn--sm sbtn--linkedin">
