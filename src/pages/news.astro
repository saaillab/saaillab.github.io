const awardsCount = NEWS_ITEMS.filter((n) => n.category === 'awards').length;
const confCount = NEWS_ITEMS.filter((n) => n.category === 'conferences').length;
const pubCount = NEWS_ITEMS.filter((n) => n.category === 'publications').length;
---

<Layout
	title="News, Awards & Lab Milestones | SAAIL Lab · IIT Madras Zanzibar"
	description="Verified awards, travel grants, workshop talks, journal milestones, and student graduations from SAAIL Lab at IIT Madras Zanzibar (2024-2026)."
	canonical="https://saaillab.github.io/news/"
>
	<ModernHeader currentPage="news" />

	<main id="main-content">
		<section class="page-hero">
			<div class="container">
				<span class="page-eyebrow">Chronological Lab Record · 2024&ndash;2026</span>
				<h1 class="page-title">News, Awards &amp; Lab Milestones</h1>
				<p class="page-lead">
					Awards, competitive grants, peer-reviewed acceptances, workshop talks, and graduation milestones from SAAIL Lab at IIT Madras Zanzibar. Subscribe via <a href="/feed.xml" class="inline-rss-link">RSS Feed</a> for publication updates.
				</p>
			</div>
		</section>

		<section class="section">
			<div class="container">
				<div class="news-controls">
					<div class="filter-tabs" role="tablist" aria-label="Filter SAAIL Lab news">
						<button type="button" role="tab" aria-selected="true" aria-controls="newsTimeline" tabindex="0" class="tab-btn is-active" data-filter="all">All Updates ({NEWS_ITEMS.length})</button>
						<button type="button" role="tab" aria-selected="false" aria-controls="newsTimeline" tabindex="-1" class="tab-btn" data-filter="awards">Awards &amp; Grants ({awardsCount})</button>
						<button type="button" role="tab" aria-selected="false" aria-controls="newsTimeline" tabindex="-1" class="tab-btn" data-filter="conferences">Conferences &amp; Talks ({confCount})</button>
						<button type="button" role="tab" aria-selected="false" aria-controls="newsTimeline" tabindex="-1" class="tab-btn" data-filter="publications">Publications &amp; Lab ({pubCount})</button>
					</div>
					<a href="/feed.xml" class="btn btn-secondary rss-btn">Subscribe RSS ↗</a>
				</div>

				<div class="news-count" id="newsCount" aria-live="polite">Showing {NEWS_ITEMS.length} of {NEWS_ITEMS.length} verified milestones</div>

				<div class="news-timeline" id="newsTimeline">
					{NEWS_ITEMS.map((item) => (
						<article id={item.id} class="news-card" data-category={item.category}>
							<div class="news-meta-col">
								<span class="news-date">{item.dateLabel}</span>
								<span class:list={['news-badge', `badge-${item.category}`]}>{item.badge}</span>
							</div>
							<div class="news-body">
								<h2>{item.title}</h2>
								<p>{item.summary}</p>
								<div class="news-links">
									{item.links.map((lk) => (
										<a href={lk.href} class="news-pill">{lk.label} &rarr;</a>
									))}
								</div>
							</div>
						</article>
					))}
				</div>
			</div>
		</section>
	</main>

	<ModernFooter />
</Layout>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const tabs = Array.from(document.querySelectorAll('.filter-tabs .tab-btn')) as HTMLElement[];
		const cards = Array.from(document.querySelectorAll('#newsTimeline .news-card')) as HTMLElement[];
		const countEl = document.getElementById('newsCount');

		function filterNews(filter: string) {
			let shown = 0;
			cards.forEach((card) => {
				const cat = card.getAttribute('data-category') || '';
				const vis = filter === 'all' || cat === filter;
				card.style.display = vis ? 'grid' : 'none';
				if (vis) shown++;
			});
			if (countEl) {
				countEl.textContent = `Showing ${shown} of ${cards.length} verified milestones`;
			}
		}

		tabs.forEach((tab, idx) => {
			tab.addEventListener('click', () => {
				tabs.forEach((t) => {
					t.classList.remove('is-active');
					t.setAttribute('aria-selected', 'false');
					t.setAttribute('tabindex', '-1');
				});
				tab.classList.add('is-active');
				tab.setAttribute('aria-selected', 'true');
				tab.setAttribute('tabindex', '0');
				filterNews(tab.getAttribute('data-filter') || 'all');
			});

			tab.addEventListener('keydown', (e: KeyboardEvent) => {
				let nextIdx: number | null = null;
				if (e.key === 'ArrowRight') nextIdx = (idx + 1) % tabs.length;
				else if (e.key === 'ArrowLeft') nextIdx = (idx - 1 + tabs.length) % tabs.length;
				else if (e.key === 'Home') nextIdx = 0;
				else if (e.key === 'End') nextIdx = tabs.length - 1;
				if (nextIdx === null) return;
				e.preventDefault();
				tabs[nextIdx].focus();
				tabs[nextIdx].click();
			});
		});
	});
</script>

<style>
	.inline-rss-link {
		color: var(--accent-primary);
		font-weight: 700;
		text-decoration: underline;
	}
	.news-controls {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		margin-bottom: 1rem;
	}
	.filter-tabs {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
	}
	.tab-btn {
		padding: 0.48rem 0.95rem;
		border-radius: 999px;
		border: 1px solid var(--border-color);
		background: var(--bg-card);
		color: var(--text-primary);
		font-family: inherit;
		font-size: 0.84rem;
		font-weight: 600;
		cursor: pointer;
	}
	.tab-btn:hover { border-color: var(--accent-primary); color: var(--accent-primary); }
	.tab-btn.is-active {
		background: var(--accent-primary);
		border-color: var(--accent-primary);
		color: #ffffff;
	}
	:global([data-theme="dark"]) .tab-btn.is-active { color: #062111; }

	.news-count {
		font-size: 0.84rem;
		font-weight: 600;
		color: var(--text-muted);
		margin-bottom: 1.25rem;
	}

	.news-timeline {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.news-card {
		display: grid;
		grid-template-columns: 210px minmax(0, 1fr);
		gap: 1.35rem;
		align-items: start;
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		border-radius: 1rem;
		padding: 1.4rem 1.55rem;
		box-shadow: 0 3px 12px var(--shadow-light);
	}

	.news-meta-col {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.45rem;
	}
	.news-date {
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.8rem;
		font-weight: 700;
		color: var(--text-muted);
	}
	.news-badge {
		font-size: 0.72rem;
		font-weight: 800;
		padding: 0.22rem 0.65rem;
		border-radius: 999px;
		text-transform: uppercase;
		letter-spacing: 0.03em;
	}
	.badge-awards { background: #fef3c7; color: #92400e; }
	.badge-conferences { background: #ecfdf5; color: #14532d; }
	.badge-publications { background: #e0f2fe; color: #075985; }
	:global([data-theme="dark"]) .badge-awards { background: rgba(245, 158, 11, 0.18); color: #fbbf24; }
	:global([data-theme="dark"]) .badge-conferences { background: rgba(52, 211, 153, 0.16); color: #34d399; }
	:global([data-theme="dark"]) .badge-publications { background: rgba(56, 189, 248, 0.16); color: #38bdf8; }

	.news-body h2 {
		font-size: 1.15rem;
		color: var(--text-primary);
		line-height: 1.35;
		margin-bottom: 0.45rem;
	}
	.news-body p {
		font-size: 0.92rem;
		color: var(--text-secondary);
		line-height: 1.62;
		margin-bottom: 0.75rem;
	}
	.news-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
	}
	.news-pill {
		font-size: 0.78rem;
		font-weight: 700;
		padding: 0.24rem 0.7rem;
		border-radius: 999px;
		background: var(--bg-secondary);
		border: 1px solid var(--border-color);
		color: var(--accent-primary);
		text-decoration: none;
	}
	.news-pill:hover {
		border-color: var(--accent-primary);
		background: rgba(20, 83, 45, 0.08);
	}
	:global([data-theme="dark"]) .news-pill:hover {
		background: rgba(52, 211, 153, 0.14);
	}

	@media (max-width: 760px) {
		.news-card {
			grid-template-columns: minmax(0, 1fr);
			gap: 0.75rem;
		}
	}
</style>
