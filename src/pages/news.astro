<script>
(function() {
	/* ── Filter ── */
	var pills = Array.from(document.querySelectorAll('.fpill'));
	var cards = Array.from(document.querySelectorAll('.story'));
	var noEl  = document.getElementById('no-stories');
	var countEl = document.getElementById('filter-count');

	function updateCount(n, total) {
		if (countEl) countEl.textContent = n === total ? n + ' stories' : n + ' of ' + total + ' stories';
	}

	pills.forEach(function(pill) {
		pill.addEventListener('click', function() {
			pills.forEach(function(p) { p.classList.remove('fpill--active'); });
			pill.classList.add('fpill--active');
			var f = pill.getAttribute('data-cat');
			var shown = 0;
			cards.forEach(function(card) {
				var match = f === 'all' || card.getAttribute('data-cat') === f;
				card.style.display = match ? '' : 'none';
				if (match) shown++;
			});
			if (noEl) noEl.style.display = shown === 0 ? 'block' : 'none';
			updateCount(shown, cards.length);
		});
	});
	updateCount(cards.length, cards.length);

	/* ── Scroll-reveal ── */
	var observer = new IntersectionObserver(function(entries) {
		entries.forEach(function(e) {
			if (e.isIntersecting) {
				e.target.classList.add('is-visible');
				observer.unobserve(e.target);
			}
		});
	}, { threshold: 0.07 });

	cards.forEach(function(card, i) {
		card.style.transitionDelay = (i * 45) + 'ms';
		observer.observe(card);
	});

	/* ── Modal ── */
	var modal   = document.getElementById('modal');
	var scrim   = document.getElementById('modal-scrim');
	var closeX  = document.getElementById('modal-x');

	function openModal(card) {
		var title = card.getAttribute('data-title') || '';
		var date  = card.getAttribute('data-date') || '';
		var body  = card.getAttribute('data-body') || '';
		var tags  = (card.getAttribute('data-tags') || '').split(',').filter(Boolean);
		var cat   = card.getAttribute('data-cat') || '';
		var ctaHref  = card.getAttribute('data-cta-href') || '';
		var ctaLabel = card.getAttribute('data-cta-label') || 'View';
		var ext   = card.getAttribute('data-external') === 'true';

		var badgeLabels = { publication:'Publication', award:'Award', talk:'Talk', lab:'Lab', milestone:'Milestone' };
		var badgeEl = document.getElementById('modal-badge-el');
		if (badgeEl) {
			badgeEl.textContent = badgeLabels[cat] || cat;
			badgeEl.className = 'sbadge sbadge--' + cat;
		}
		var dateEl = document.getElementById('modal-date-el');
		if (dateEl) dateEl.textContent = date;
		var titleEl = document.getElementById('modal-title-el');
		if (titleEl) titleEl.textContent = title;
		var bodyEl = document.getElementById('modal-body-el');
		if (bodyEl) bodyEl.textContent = body;

		var tagsEl = document.getElementById('modal-tags-el');
		if (tagsEl) tagsEl.innerHTML = tags.map(function(t) {
			return '<span class="modal-tag">' + t + '</span>';
		}).join('');

		var actionsEl = document.getElementById('modal-actions-el');
		if (actionsEl) {
			actionsEl.innerHTML = '';
			if (ctaHref) {
				var a = document.createElement('a');
				a.href = ctaHref;
				a.textContent = ctaLabel + (ext ? ' ↗' : '');
				a.className = 'modal-btn modal-btn--primary';
				if (ext) { a.target = '_blank'; a.rel = 'noopener'; }
				actionsEl.appendChild(a);
			}
			var cb = document.createElement('button');
			cb.textContent = 'Close';
			cb.className = 'modal-btn modal-btn--ghost';
			cb.addEventListener('click', closeModal);
			actionsEl.appendChild(cb);
		}

		if (modal) modal.classList.add('is-open');
		document.body.style.overflow = 'hidden';
	}

	function closeModal() {
		if (modal) modal.classList.remove('is-open');
		document.body.style.overflow = '';
	}

	/* Open triggers */
	document.querySelectorAll('[data-open]').forEach(function(btn) {
		btn.addEventListener('click', function(e) {
			var card = btn.closest('.story');
			if (card) openModal(card);
		});
	});

	/* Featured card click */
	var featured = document.querySelector('.story--featured');
	if (featured) {
		featured.addEventListener('click', function(e) {
			var tag = e.target.tagName;
			if (tag !== 'A' && tag !== 'BUTTON') openModal(featured);
		});
	}

	if (closeX) closeX.addEventListener('click', closeModal);
	if (scrim)  scrim.addEventListener('click', closeModal);
	document.addEventListener('keydown', function(e) {
		if (e.key === 'Escape') closeModal();
	});

	/* Sticky filter bar highlight */
	var filterWrap = document.getElementById('filter-wrap');
	window.addEventListener('scroll', function() {
		if (!filterWrap) return;
		filterWrap.style.boxShadow = window.scrollY > 200
			? '0 2px 16px rgba(0,0,0,0.08)'
			: 'none';
	}, { passive: true });
})();
</script>
