---
import AcademicProjectPage from '../../components/AcademicProjectPage.astro';
import { PUBLICATIONS, type Publication } from '../../data/publications';

export function getStaticPaths() {
  return PUBLICATIONS.filter((p) => p.isSaailLab !== false).map((pub) => ({
    params: { slug: pub.slug },
    props: { pub }
  }));
}

interface Props {
  pub: Publication;
}

const { pub } = Astro.props;
---

<AcademicProjectPage pub={pub} />
