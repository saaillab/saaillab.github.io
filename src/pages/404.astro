---
import Layout from '../layouts/Layout.astro';
import ModernHeader from '../components/ModernHeader.astro';
import ModernFooter from '../components/ModernFooter.astro';
---

<Layout
	title="Page Not Found | SAAIL Lab · IIT Madras Zanzibar"
	description="The requested page could not be found on SAAIL Lab. Browse SAAIL Lab publications, active projects, datasets, or open the PI archive for pre-2025 works."
	canonical="https://saaillab.github.io/404.html"
	noindex={true}
>
	<ModernHeader />

	<main id="main-content">
		<section class="notfound-section">
			<div class="container">
				<div class="notfound-card">
					<span class="page-eyebrow" data-i18n="err404.eyebrow">Error 404 · Page Not Found</span>
					<h1 data-i18n="err404.title">That page has moved or no longer resides on the SAAIL Lab site.</h1>
					<p>
						SAAIL Lab publications cover work authored at IIT Madras Zanzibar from October 2024 onward. Earlier pre-IITMZ journal articles and Nanjing Agricultural University theses (2015&ndash;2024) are hosted on Innocent Nyalala&rsquo;s personal site at <a href="https://inyalala.github.io/publications/" target="_blank" rel="noopener">inyalala.github.io/publications</a>.
					</p>

					<div class="notfound-actions">
						<a href="/" class="btn btn-primary">SAAIL Lab Home</a>
						<a href="/publications/" class="btn btn-secondary">Lab Publications (20)</a>
						<a href="/projects/" class="btn btn-secondary">Active Projects</a>
						<a href="/datasets/" class="btn btn-secondary">Datasets &amp; Tools</a>
						<button type="button" id="openSearchFrom404" class="btn btn-secondary">Quick Search (Ctrl K)</button>
						<a href="https://inyalala.github.io/publications/" target="_blank" rel="noopener" class="btn btn-secondary">PI Personal Archive &#8599;</a>
					</div>
				</div>
			</div>
		</section>
	</main>

	<ModernFooter />
</Layout>

<script>
	document.getElementById('openSearchFrom404')?.addEventListener('click', () => {
		document.getElementById('siteSearchBtn')?.click();
	});
</script>

<style>
	.notfound-section {
		padding: calc(var(--header-height, 74px) + 4.5rem) 0 5rem;
	}
	.notfound-card {
		max-width: 760px;
		margin: 0 auto;
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		border-radius: 1.25rem;
		padding: 2.5rem;
		box-shadow: 0 10px 30px var(--shadow-light);
	}
	.notfound-card h1 {
		font-size: clamp(1.65rem, 3vw, 2.2rem);
		color: var(--text-primary);
		margin-bottom: 0.9rem;
		line-height: 1.25;
	}
	.notfound-card p {
		font-size: 1rem;
		color: var(--text-secondary);
		line-height: 1.7;
		margin-bottom: 1.65rem;
	}
	.notfound-card p a {
		color: var(--accent-primary);
		font-weight: 600;
	}
	.notfound-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
	}
	@media (max-width: 640px) {
		.notfound-card { padding: 1.6rem; }
	}
</style>
