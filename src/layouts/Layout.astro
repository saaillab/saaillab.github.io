		        "addressCountry": "TZ"
		      },
		      "geo": {
		        "@type": "GeoCoordinates",
		        "latitude": -6.1659,
		        "longitude": 39.2026
		      },
		      "parentOrganization": {
		        "@type": "CollegeOrUniversity",
		        "name": "Indian Institute of Technology Madras Zanzibar",
		        "url": "https://www.iitmz.ac.in"
		      },
		      "areaServed": [
		        {"@type": "Place", "name": "Zanzibar"},
		        {"@type": "Country", "name": "Tanzania"},
		        {"@type": "Country", "name": "Kenya"},
		        {"@type": "Place", "name": "East Africa"}
		      ],
		      "knowsAbout": [
		        "Artificial Intelligence in Zanzibar",
		        "Deep Learning Research",
		        "Machine Learning",
		        "Computer Vision",
		        "AI for Agriculture and Blue Economy",
		        "AI for Healthcare and Clinical Imaging",
		        "Swahili Natural Language Processing",
		        "Explainable and Responsible AI",
		        "Zanzibar Commodity Grading"
		      ],
		      "sameAs": [
		        "https://www.iitmz.ac.in/",
		        "https://github.com/saaillab",
		        "https://inyalala.github.io/",
		        "https://scholar.google.com/citations?user=jYVzIZUAAAAJ&hl=en",
		        "https://www.linkedin.com/company/saail-lab/",
		        "https://www.researchgate.net/profile/Innocent-Nyalala"
		      ]
		    },
		    {
		      "@type": "Person",
		      "@id": "https://inyalala.github.io/#person",
		      "name": "Innocent Nyalala",
		      "jobTitle": "Assistant Professor & Principal Investigator, SAAIL Lab",
