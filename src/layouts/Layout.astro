---
export interface Props {
	title?: string;
	description?: string;
	canonical?: string;
	ogImage?: string;
}

const {
	title = "SAAIL Lab | IIT Madras Zanzibar",
	description = "Sustainable AI for Agriculture & Intelligent Livelihoods Lab (SAAIL Lab) at the School of Engineering and Science, IIT Madras Zanzibar. Research in precision agriculture, Swahili NLP and AI safety (CultureSEEDS), responsible AI, and healthcare ML.",
	canonical = "https://saaillab.github.io/",
	ogImage = "https://saaillab.github.io/images/logo/saail-logo.png"
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes" />
		<link rel="icon" type="image/png" href="/images/logo/saail-crest.png" />
		<link rel="apple-touch-icon" href="/images/logo/saail-crest.png" />

		<!-- Performance Optimization -->
		<link rel="dns-prefetch" href="https://fonts.googleapis.com" />
		<link rel="dns-prefetch" href="https://fonts.gstatic.com" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />

		<!-- Academic & Research SEO -->
		<meta name="keywords" content="SAAIL Lab, Sustainable AI for Agriculture and Intelligent Livelihoods, IIT Madras Zanzibar, Innocent Nyalala, CropGuardNet, DGS-Bench, CLOVES-4603, ZSTC-Clove-V1, CARA-FM, ETRI Journal, CultureSEEDS, Google DeepMind, Swahili NLP, Zanzibar Swahili Corpus, CashewAI, SeaweedAI, PlacentaVision, Responsible AI, Explainable AI, East Africa AI, 1270 citations, h-index 15" />
		<meta name="author" content="SAAIL Lab" />
		<meta name="dc.creator" content="SAAIL Lab" />
		<meta name="dc.title" content={title} />
		<meta name="dc.subject" content="Artificial Intelligence, Sustainable Agriculture, Swahili NLP, AI Safety, Medical Imaging, East Africa" />
		<meta name="dc.description" content={description} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
		<meta name="googlebot" content="index, follow" />
		<meta name="bingbot" content="index, follow" />
		<link rel="canonical" href={canonical} />

		<!-- Geographic and Regional SEO -->
		<meta name="geo.region" content="TZ-15" />
		<meta name="geo.placename" content="Zanzibar, Tanzania" />
		<meta name="geo.position" content="-6.29556;39.28768" />
		<meta name="ICBM" content="-6.29556, 39.28768" />
		<meta name="coverage" content="East Africa" />
		<meta name="distribution" content="global" />
		<meta name="target" content="all" />
		<meta name="audience" content="researchers, students, academics, AI practitioners, agricultural technologists" />

		<!-- Cross-site relationship -->
		<link rel="author" href="https://inyalala.github.io/" />
		<link rel="me" href="https://inyalala.github.io/" />
		<link rel="alternate" hreflang="en" href={canonical} />

		<!-- Open Graph -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content="SAAIL Lab | IIT Madras Zanzibar" />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:alt" content="SAAIL Lab | Sustainable AI for Agriculture & Intelligent Livelihoods" />
		<meta property="og:locale" content="en_US" />

		<!-- Twitter Cards -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:site" content="@saaillab" />

		<!-- Theme Initialization -->
		<script is:inline>
			const theme = localStorage.getItem('theme') || 'light';
			document.documentElement.setAttribute('data-theme', theme);
		</script>

		<title>{title}</title>

		<!-- Schema.org Structured Data -->
		<script type="application/ld+json">
		{
		  "@context": "https://schema.org",
		  "@graph": [
		    {
		      "@type": "ResearchOrganization",
		      "@id": "https://saaillab.github.io/#organization",
		      "name": "SAAIL Lab",
		      "alternateName": ["Sustainable AI for Agriculture & Intelligent Livelihoods", "SAAIL Laboratory"],
		      "description": "Research laboratory at the School of Engineering and Science, Indian Institute of Technology Madras Zanzibar advancing precision agriculture, Swahili NLP and AI safety (CultureSEEDS), responsible AI governance, and clinical healthcare ML.",
		      "url": "https://saaillab.github.io/",
		      "logo": {
		        "@type": "ImageObject",
		        "url": "https://saaillab.github.io/images/logo/saail-crest.png"
		      },
		      "image": "https://saaillab.github.io/images/logo/saail-logo.png",
		      "email": "saail_lab@iitmz.ac.in",
		      "parentOrganization": {
		        "@type": "EducationalOrganization",
		        "name": "Indian Institute of Technology Madras Zanzibar",
		        "url": "https://www.iitmz.ac.in"
		      },
		      "areaServed": [
		        {"@type": "Country", "name": "Tanzania"},
		        {"@type": "Country", "name": "Kenya"},
		        {"@type": "Place", "name": "East Africa"}
		      ],
		      "knowsAbout": [
		        "Sustainable Agriculture AI",
		        "Swahili Natural Language Processing",
		        "Multilingual AI Safety Evaluation",
		        "Computer Vision for Commodity Grading",
		        "Explainable and Responsible AI",
		        "Healthcare and Placental Imaging"
		      ],
		      "sameAs": [
		        "https://github.com/saaillab",
		        "https://inyalala.github.io/",
		        "https://scholar.google.com/citations?user=jYVzIZUAAAAJ&hl=en",
		        "https://www.linkedin.com/company/saail-lab/",
		        "https://www.researchgate.net/profile/Innocent-Nyalala"
		      ]
		    },
		    {
		      "@type": "Person",
		      "@id": "https://inyalala.github.io/#person",
		      "name": "Innocent Nyalala",
		      "honorificPrefix": "Dr",
		      "jobTitle": "Assistant Professor & Principal Investigator, SAAIL Lab",
		      "url": "https://inyalala.github.io/",
		      "email": "innocent@iitmz.ac.in",
		      "affiliation": [
		        "Indian Institute of Technology Madras Zanzibar, Zanzibar, Tanzania",
		        "Wadhwani School of Data Science and Artificial Intelligence, Indian Institute of Technology Madras, Chennai, India"
		      ],
		      "sameAs": [
		        "https://scholar.google.com/citations?user=jYVzIZUAAAAJ&hl=en",
		        "https://orcid.org/0000-0002-7969-437X",
		        "https://www.researchgate.net/profile/Innocent-Nyalala",
		        "https://www.linkedin.com/in/innocentnyalala/"
		      ]
		    },
		    {
		      "@type": "WebSite",
		      "@id": "https://saaillab.github.io/#website",
		      "url": "https://saaillab.github.io/",
		      "name": "SAAIL Lab | IIT Madras Zanzibar",
		      "publisher": {"@id": "https://saaillab.github.io/#organization"},
		      "inLanguage": "en-US"
		    }
		  ]
		}
		</script>

		<!-- Google Analytics -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-4MEPY7MLVN"></script>
		<script>
		  window.dataLayer = window.dataLayer || [];
		  function gtag(){dataLayer.push(arguments);}
		  gtag('js', new Date());
		  gtag('config', 'G-4MEPY7MLVN');
		</script>
	</head>
	<body>
		<a href="#main-content" class="skip-link">Skip to main content</a>
		<slot />

		<button id="backToTop" type="button" class="back-to-top" aria-label="Back to top">
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
				<path d="M12 19V5M5 12L12 5L19 12"/>
			</svg>
		</button>

		<script>
			document.addEventListener('DOMContentLoaded', function() {
				const backToTopBtn = document.getElementById('backToTop');
				window.addEventListener('scroll', function() {
					if (window.scrollY > 320) {
						backToTopBtn?.classList.add('visible');
					} else {
						backToTopBtn?.classList.remove('visible');
					}
				});
				backToTopBtn?.addEventListener('click', function() {
					const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
					window.scrollTo({ top: 0, behavior: prefersReduced ? 'auto' : 'smooth' });
				});
			});
		</script>
	</body>
</html>

<style is:global>
	:root {
		color-scheme: light;
		/* SAAIL Lab Editorial Palette: Botanical Forest, Warm Stone, Zanzibari Spice Amber */
		--bg-primary: #ffffff;
		--bg-secondary: #f7f7f2;
		--bg-tertiary: #e6eae3;
		--bg-card: #ffffff;
		--text-primary: #0c1a12;
		--text-secondary: #2b3a32;
		--text-muted: #5a6b61;
		--accent-primary: #14532d;
		--accent-secondary: #15803d;
		--accent-blue: #14532d;
		--accent-green: #15803d;
		--accent-gold: #b45309;
		--border-color: #dde3da;
		--shadow-light: rgba(12, 26, 18, 0.06);
		--shadow-medium: rgba(12, 26, 18, 0.12);
		--accent-blue-rgb: 20, 83, 45;
		--header-height: 74px;
	}

	[data-theme="dark"] {
		color-scheme: dark;
		--bg-primary: #08120c;
		--bg-secondary: #0f1f16;
		--bg-tertiary: #193023;
		--bg-card: #0f1f16;
		--text-primary: #edf3ef;
		--text-secondary: #c8d6cd;
		--text-muted: #8fa698;
		--accent-primary: #22c55e;
		--accent-secondary: #4ade80;
		--accent-blue: #22c55e;
		--accent-green: #4ade80;
		--accent-gold: #f59e0b;
		--border-color: #213d2c;
		--shadow-light: rgba(0, 0, 0, 0.35);
		--shadow-medium: rgba(0, 0, 0, 0.5);
		--accent-blue-rgb: 34, 197, 94;
	}

	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
		scroll-padding-top: calc(var(--header-height) + 18px);
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
		text-rendering: optimizeLegibility;
	}

	body {
		display: flex;
		flex-direction: column;
		font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
		line-height: 1.65;
		color: var(--text-primary);
		background-color: var(--bg-primary);
		transition: background-color 0.25s ease, color 0.25s ease;
		overflow-x: hidden;
		min-height: 100vh;
	}

	.skip-link {
		position: absolute;
		left: -9999px;
		top: 0;
		background: var(--accent-primary);
		color: #ffffff;
		padding: 0.65rem 1.1rem;
		font-weight: 700;
		z-index: 2000;
		text-decoration: none;
	}
	[data-theme="dark"] .skip-link { color: #062111; }
	.skip-link:focus {
		left: 1rem;
		top: 1rem;
		border-radius: 0.5rem;
	}

	h1, h2, h3, h4 {
		font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
		letter-spacing: -0.02em;
	}

	/* Ensure fixed navigation header NEVER clips the top of any page */
	main {
		padding-top: var(--header-height);
		flex: 1 0 auto;
	}

	:focus-visible {
		outline: 2px solid var(--accent-primary);
		outline-offset: 2px;
	}

	@media (prefers-reduced-motion: reduce) {
		*, *::before, *::after {
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.01ms !important;
			scroll-behavior: auto !important;
		}
	}

	.container {
		max-width: 1320px;
		margin: 0 auto;
		padding: 0 1.25rem;
		width: 100%;
	}

	img {
		max-width: 100%;
		height: auto;
		display: block;
	}

	.section {
		padding: 4.5rem 0;
	}

	.section-title {
		font-size: clamp(1.75rem, 3vw, 2.35rem);
		font-weight: 800;
		text-align: center;
		margin-bottom: 2.5rem;
		color: var(--text-primary);
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.45rem;
		padding: 0.72rem 1.45rem;
		border-radius: 999px;
		text-decoration: none;
		font-weight: 600;
		font-size: 0.94rem;
		transition: all 0.2s ease;
		border: 1px solid transparent;
		cursor: pointer;
	}

	.btn-primary {
		background: var(--accent-primary);
		color: #ffffff;
		box-shadow: 0 4px 12px var(--shadow-light);
	}

	.btn-primary:hover {
		background: var(--accent-secondary);
		transform: translateY(-2px);
		box-shadow: 0 8px 20px var(--shadow-medium);
	}

	[data-theme="dark"] .btn-primary {
		color: #062111;
	}

	.btn-secondary {
		background: var(--bg-primary);
		color: var(--accent-primary);
		border: 1.5px solid var(--border-color);
	}

	.btn-secondary:hover {
		border-color: var(--accent-primary);
		background: var(--bg-secondary);
		transform: translateY(-2px);
	}

	.card {
		background: var(--bg-card);
		border-radius: 1rem;
		padding: 1.75rem;
		box-shadow: 0 2px 10px var(--shadow-light);
		transition: all 0.25s ease;
		border: 1px solid var(--border-color);
	}

	.card:hover {
		transform: translateY(-3px);
		box-shadow: 0 12px 26px var(--shadow-medium);
		border-color: rgba(20, 83, 45, 0.28);
	}

	/* Clean architectural eyebrow & page hero helpers */
	.page-hero {
		background: var(--bg-secondary);
		border-bottom: 1px solid var(--border-color);
		padding: 3.25rem 0 2.75rem;
		text-align: center;
	}

	.page-eyebrow {
		display: inline-block;
		font-size: 0.76rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--accent-gold);
		margin-bottom: 0.65rem;
	}

	.page-title {
		font-size: clamp(2rem, 3.8vw, 2.85rem);
		font-weight: 800;
		color: var(--text-primary);
		margin-bottom: 0.85rem;
		line-height: 1.15;
	}

	.page-lead {
		max-width: 720px;
		margin: 0 auto;
		font-size: 1.08rem;
		color: var(--text-secondary);
		line-height: 1.65;
	}

	@media (max-width: 768px) {
		.section {
			padding: 2.75rem 0;
		}
		.page-hero {
			padding: 2.25rem 0 2rem;
		}
	}

	/* Back to Top Button */
	.back-to-top {
		position: fixed;
		bottom: 1.75rem;
		right: 1.75rem;
		width: 46px;
		height: 46px;
		background: var(--accent-primary);
		color: #ffffff;
		border: none;
		border-radius: 50%;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 4px 14px var(--shadow-medium);
		transition: all 0.25s ease;
		opacity: 0;
		visibility: hidden;
		transform: translateY(16px);
		z-index: 900;
	}

	[data-theme="dark"] .back-to-top {
		color: #062111;
	}

	.back-to-top.visible {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}

	.back-to-top:hover {
		transform: translateY(-2px);
		background: var(--accent-secondary);
	}
</style>
