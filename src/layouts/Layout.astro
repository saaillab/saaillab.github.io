		      "affiliation": [
		        { "@type": "CollegeOrUniversity", "name": "Indian Institute of Technology Madras Zanzibar", "url": "https://www.iitmz.ac.in/" },
		        { "@type": "CollegeOrUniversity", "name": "Wadhwani School of Data Science and Artificial Intelligence, Indian Institute of Technology Madras" }
		      ],
		      "image": {
		        "@type": "ImageObject",
		        "@id": "https://saaillab.github.io/images/people/innocent-nyalala-saail-lab-zanzibar.jpg#image",
		        "url": "https://saaillab.github.io/images/people/innocent-nyalala-saail-lab-zanzibar.jpg",
		        "caption": "Innocent Nyalala, Principal Investigator of SAAIL Lab at IIT Madras Zanzibar"
		      },
		      "knowsAbout": [
		        "Artificial Intelligence",
		        "Deep Learning",
		        "Machine Learning",
		        "Computer Vision",
		        "Precision Agriculture AI",
		        "Healthcare Artificial Intelligence",
		        "Swahili Natural Language Processing",
		        "Explainable and Responsible AI",
		        "Zanzibar and East Africa AI Research"
		      ],
		      "url": "https://inyalala.github.io/",
		      "email": "innocent@iitmz.ac.in",
		      "sameAs": [
		        "https://www.iitmz.ac.in/schools/engineering-and-science/faculty/prof-innocent-nyalala",
		        "https://scholar.google.com/citations?user=jYVzIZUAAAAJ&hl=en",
		        "https://orcid.org/0000-0002-7969-437X",
		        "https://www.researchgate.net/profile/Innocent-Nyalala",
		        "https://www.linkedin.com/in/innocentnyalala/"
		      ]
		    },
		    {
		      "@type": "WebSite",
		      "@id": "https://saaillab.github.io/#website",
		      "url": "https://saaillab.github.io/",
		      "name": "SAAIL Lab | AI Research Lab at IIT Madras Zanzibar",
		      "alternateName": "Sustainable AI for Agriculture and Intelligent Livelihoods Lab",
		      "description": "Official research portal of SAAIL Lab at IIT Madras Zanzibar, East Africa.",
		      "publisher": {"@id": "https://saaillab.github.io/#organization"},
