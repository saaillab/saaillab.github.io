---
export interface Props {
	title?: string;
	description?: string;
	canonical?: string;
	ogImage?: string;
	noindex?: boolean;
}

const {
	title = "SAAIL Lab | AI Research Lab at IIT Madras Zanzibar",
	description = "Sustainable AI for Agriculture and Intelligent Livelihoods Lab (SAAIL Lab) at the School of Engineering and Science, IIT Madras Zanzibar, led by Innocent Nyalala. Flagship AI, deep learning, machine learning, computer vision, Swahili NLP, agricultural AI, and healthcare AI research in Zanzibar, Tanzania, and East Africa.",
	canonical = "https://saaillab.github.io/",
	ogImage = "https://saaillab.github.io/images/og/saail-lab-zanzibar-og.jpg",
	noindex = false
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#14532d" />
		<meta name="thumbnail" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="geo.region" content="TZ-07" />
		<meta name="geo.placename" content="Zanzibar, Tanzania" />
		<meta name="geo.position" content="-6.1659;39.2026" />
		<meta name="ICBM" content="-6.1659, 39.2026" />

		<!-- Performance Optimization -->
		<link rel="dns-prefetch" href="https://fonts.googleapis.com" />
		<link rel="dns-prefetch" href="https://fonts.gstatic.com" />
		<link rel="dns-prefetch" href="https://visitor-badge.laobi.icu" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />

		<!-- Academic & Research SEO -->
		<meta name="keywords" content="SAAIL Lab, AI labs in Zanzibar, AI lab Zanzibar, AI research Zanzibar, deep learning Zanzibar, machine learning Zanzibar, computer vision Zanzibar, Swahili NLP Zanzibar, AI for agriculture Zanzibar, AI for healthcare Zanzibar, East Africa AI research lab, Tanzania AI research, IIT Madras Zanzibar, IIT Madras Zanzibar AI Lab, Innocent Nyalala, Sustainable AI for Agriculture and Intelligent Livelihoods, CropGuardNet, DGS-Bench, CLOVES-4603, ZSTC-Clove-V1, CARA-FM, ETRI Journal, Zanzibar Swahili Corpus, Dira Benchmark, CashewAI, SeaweedAI, PlacentaVision, Responsible AI, Explainable AI, 1270 citations, h-index 15" />
		<meta name="author" content="SAAIL Lab" />
		<meta name="dc.creator" content="SAAIL Lab" />
		<meta name="dc.title" content={title} />
		<meta name="dc.subject" content="Artificial Intelligence, Sustainable Agriculture, Swahili NLP, AI Safety, Medical Imaging, East Africa" />
		<meta name="dc.description" content={description} />
		<meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
		<meta name="googlebot" content={noindex ? "noindex, follow" : "index, follow"} />
		<meta name="bingbot" content={noindex ? "noindex, follow" : "index, follow"} />
		<link rel="canonical" href={canonical} />
		<link rel="alternate" type="application/rss+xml" title="SAAIL Lab Publications & Updates" href="https://saaillab.github.io/feed.xml" />

		<!-- Geographic and Regional SEO -->
		<meta name="geo.region" content="TZ-15" />
		<meta name="geo.placename" content="Zanzibar, Tanzania" />
		<meta name="geo.position" content="-6.29556;39.28768" />
		<meta name="ICBM" content="-6.29556, 39.28768" />
		<meta name="coverage" content="East Africa" />
		<meta name="distribution" content="global" />
		<meta name="target" content="all" />
		<meta name="audience" content="researchers, students, academics, AI practitioners, agricultural technologists" />

		<!-- Cross-site relationship -->
		<link rel="author" href="https://inyalala.github.io/" />
		<link rel="me" href="https://inyalala.github.io/" />
		<link rel="alternate" hreflang="en" href={canonical} />

		<!-- Open Graph -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content="SAAIL Lab | IIT Madras Zanzibar" />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:alt" content="SAAIL Lab | Sustainable AI for Agriculture & Intelligent Livelihoods" />
		<meta property="og:locale" content="en_US" />

		<!-- Twitter Cards -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:site" content="@saaillab" />

		<!-- Theme Initialization -->
		<script is:inline>
			const theme = localStorage.getItem('theme') || 'light';
			document.documentElement.setAttribute('data-theme', theme);
		</script>

		<title>{title}</title>

		<!-- Schema.org Structured Data -->
		<script type="application/ld+json">
		{
		  "@context": "https://schema.org",
		  "@graph": [
		    {
		      "@type": "ResearchOrganization",
		      "@id": "https://saaillab.github.io/#organization",
		      "name": "SAAIL Lab",
		      "alternateName": [
		        "Sustainable AI for Agriculture & Intelligent Livelihoods",
		        "SAAIL Laboratory",
		        "IIT Madras Zanzibar AI Lab",
		        "Zanzibar AI Research Lab"
		      ],
		      "description": "Leading artificial intelligence, deep learning, machine learning, computer vision, and Swahili NLP research laboratory at IIT Madras Zanzibar in Tanzania, East Africa. Directed by Innocent Nyalala across precision agriculture, blue economy sensing, responsible AI, and clinical healthcare ML.",
		      "url": "https://saaillab.github.io/",
		      "logo": {
		        "@type": "ImageObject",
		        "url": "https://saaillab.github.io/images/logo/saail-crest.png"
		      },
		      "image": [
		        "https://saaillab.github.io/images/og/saail-lab-zanzibar-og.jpg",
		        "https://saaillab.github.io/images/people/innocent-nyalala-saail-lab-zanzibar.jpg",
		        "https://saaillab.github.io/images/logo/saail-logo.png"
		      ],
		      "email": "saail_lab@iitmz.ac.in",
		      "foundingDate": "2024-10",
		      "founder": { "@id": "https://inyalala.github.io/#person" },
		      "director": { "@id": "https://inyalala.github.io/#person" },
		      "address": {
		        "@type": "PostalAddress",
		        "streetAddress": "IIT Madras Zanzibar Campus, Bweleo",
		        "addressLocality": "Zanzibar",
